@{
    ViewData["Title"] = "About & Institutional Support";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card card-3d p-4 p-md-5 mb-4">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <img src="~/images/branding/varp-university-logo.png" alt="VARP UNIVERSITY" style="height: 48px; width: auto; object-fit: contain;" asp-append-version="true" />
                    <div>
                        <h2 class="fw-bold mb-0" style="color: #1F2C58;">Campus Event Hub</h2>
                        <span class="text-muted small fw-semibold">VARP UNIVERSITY &bull; College Event &amp; Workshop Registration System</span>
                    </div>
                </div>

                <div class="mb-4">
                    <h5 class="fw-bold text-dark">About the Platform</h5>
                    <p class="text-muted">
                        Campus Event Hub is the official centralized event and workshop management portal for VARP UNIVERSITY. Built on high-performance .NET 10 LTS and SQL Server 2025 Express, the platform coordinates institutional hackathons, academic symposia, technical workshops, and cultural events across all university departments.
                    </p>
                </div>

                <div class="mb-4">
                    <h5 class="fw-bold text-dark">Data Privacy &amp; Institutional Governance</h5>
                    <p class="text-muted">
                        All student registrations, attendance telemetry, and certificate verifications are governed by VARP UNIVERSITY data protection policies. Personal academic identifiers, email communications, and event histories are encrypted and accessible exclusively to authorized university coordinators and administrators.
                    </p>
                </div>

                <div class="border-top pt-4 mt-2 d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <span class="text-muted small">&copy; @DateTime.UtcNow.Year VARP UNIVERSITY. All institutional rights reserved.</span>
                    <a asp-action="Index" class="btn btn-3d-primary btn-sm">Return to Event Catalog</a>
                </div>
            </div>
        </div>
    </div>
</div>
