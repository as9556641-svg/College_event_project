@model CollegeEventRegistration.Web.Models.Home.HomeViewModel
@using CollegeEventRegistration.Web.Models.Home
@{
    ViewData["Title"] = "Campus Event Hub";
    var isSignedIn = Context.User.Identity?.IsAuthenticated == true;

    string CatalogueUrl(int? categoryId = null)
    {
        var catalogue = Url.Action("Index", "Events", new { area = "Student", categoryId });
        return isSignedIn
            ? catalogue ?? "#"
            : Url.Action("Login", "Account", new { returnUrl = catalogue }) ?? "#";
    }

    string EventUrl(int eventId)
    {
        var details = Url.Action("Details", "Events", new { area = "Student", id = eventId });
        return isSignedIn
            ? details ?? "#"
            : Url.Action("Login", "Account", new { returnUrl = details }) ?? "#";
    }
}

@section Styles {
    <link rel="preload" as="image" href="~/images/hero/campus-dusk.jpg" />
    <link rel="stylesheet" href="~/css/homepage.css" asp-append-version="true" />
}

<!-- ============================== HERO ==============================
     The hero is rendered inside <main>, so it is a plain header element rather
     than a second banner landmark. -->
<header class="hp-hero">
    <nav class="site-nav site-nav--overlay" aria-label="Public">
        <partial name="_PublicNavbar" />
    </nav>

    <div class="hp-wrap hp-hero__inner">
        <div class="hp-hero__copy">
            <h1>Choose a category,<br />then the event.</h1>
            <p class="hp-hero__sub">
                Campus events are grouped into five categories, maintained by VAP UNIVERSITY
                departments and reviewed before publication.
            </p>
            <div class="hp-hero__actions">
                <a class="hp-btn hp-btn--lg" href="#categories">
                    Browse categories
                    <partial name="_Icon" model="@("arrow-right")" />
                </a>
                <a class="hp-hero__quiet" href="#upcoming-events">
                    See upcoming events
                    <partial name="_Icon" model="@("arrow-right")" />
                </a>
            </div>
        </div>
    </div>
</header>

<!-- ============================ CATEGORIES ============================ -->
<section class="hp-section hp-categories" id="categories" aria-labelledby="categories-heading">
    <div class="hp-wrap">
        <div class="hp-section__head">
            <div>
                <h2 id="categories-heading">Explore by event category</h2>
                <p class="hp-section__lede">Each category opens the catalogue filtered to that category.</p>
            </div>
            <div class="hp-railctl">
                <button class="hp-railctl__btn" type="button" data-rail-prev aria-label="Previous categories" aria-controls="category-rail">
                    <partial name="_Icon" model="@("chevron-left")" />
                </button>
                <button class="hp-railctl__btn" type="button" data-rail-next aria-label="Next categories" aria-controls="category-rail">
                    <partial name="_Icon" model="@("chevron-right")" />
                </button>
            </div>
        </div>

        @if (Model.Categories.Count > 0)
        {
            <ul class="hp-rail" id="category-rail" data-rail tabindex="0" aria-label="Event categories">
                @foreach (var category in Model.Categories)
                {
                    <li class="hp-rail__item">
                        <a class="hp-category" href="@CatalogueUrl(category.Id)">
                            <span class="hp-category__icon"><partial name="_Icon" model="@category.IconName" /></span>
                            <h3>@category.Name</h3>
                            <span class="hp-category__foot">
                                <span class="hp-category__count">
                                    <b>@category.PublishedCount</b> event@(category.PublishedCount == 1 ? "" : "s")
                                </span>
                                <span class="hp-category__arrow" aria-hidden="true"><partial name="_Icon" model="@("arrow-right")" /></span>
                            </span>
                        </a>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="hp-note">No event categories are active right now.</p>
        }
    </div>
</section>

<!-- ======================== ACCREDITED SCHEDULE ======================== -->
<section class="hp-section" id="accredited-schedule" aria-labelledby="schedule-heading">
    <div class="hp-wrap hp-schedule">
        <div class="hp-schedule__intro">
            <h2 id="schedule-heading">Accredited schedule</h2>
            <p>Four stages run between a faculty proposal and the certificate in your student record.</p>
            <span class="hp-schedule__note">
                <partial name="_Icon" model="@("shield-check")" />
                Department review on every event
            </span>
        </div>

        <ol class="hp-timeline">
            <li class="hp-timeline__item">
                <h3><em>Stage 1</em> Faculty proposal and department review</h3>
                <p>Coordinators submit the outline, venue, capacity and eligibility. The department academic committee reviews the proposal before the date is fixed.</p>
            </li>
            <li class="hp-timeline__item">
                <h3><em>Stage 2</em> Approval and publication</h3>
                <p>An administrator approves the event. It is published to the catalogue with its registration window, fee, mode and seat count.</p>
            </li>
            <li class="hp-timeline__item">
                <h3><em>Stage 3</em> Registration and QR admission pass</h3>
                <p>Students register inside the window. Each confirmed registration reserves a seat and issues an admission pass to the student portal.</p>
            </li>
            <li class="hp-timeline__item">
                <h3><em>Stage 4</em> Attendance and certificate</h3>
                <p>Coordinators scan passes at the venue door. Attendance is written against the registration and the certificate is issued from it.</p>
            </li>
        </ol>
    </div>
</section>

<!-- ===================== UPCOMING & FEATURED EVENTS ===================== -->
<section class="hp-section" id="upcoming-events" aria-labelledby="events-heading">
    <div class="hp-wrap">
        <div class="hp-section__head">
            <div>
                <h2 id="events-heading">Upcoming &amp; featured events</h2>
                <p class="hp-section__lede">Published events, ordered by start date.</p>
            </div>
            <a class="hp-textlink" href="@CatalogueUrl()">
                All events
                <partial name="_Icon" model="@("arrow-right")" />
            </a>
        </div>

        @if (Model.HasEvents)
        {
            <div class="hp-events">
                @foreach (var (evt, index) in Model.FeaturedEvents.Select((item, position) => (item, position)))
                {
                    var isLead = index == 0;
                    <article class="hp-event-card">
                        <a class="hp-event-card__media @(isLead ? "hp-event-card__media--tall" : "hp-event-card__media--mid")" href="@EventUrl(evt.Id)" tabindex="-1" aria-hidden="true">
                            <img src="@evt.ImageUrl" alt="@evt.ImageAlt" width="1024" height="768" loading="lazy" decoding="async" />
                            <span class="hp-event-card__tag">@evt.CategoryName</span>
                        </a>
                        <div class="hp-event-card__body">
                            <p class="hp-event-card__date">
                                <partial name="_Icon" model="@("calendar")" />
                                <span>@evt.DateLabel</span>
                                @if (!string.IsNullOrWhiteSpace(evt.DepartmentShortName))
                                {
                                    <span class="hp-event-card__dept">@evt.DepartmentShortName</span>
                                }
                            </p>
                            <h3><a href="@EventUrl(evt.Id)">@evt.Title</a></h3>
                            <p class="hp-event-card__facts">
                                <span class="hp-event-card__price">@evt.PriceLabel</span>
                                <span>Capacity <b>@evt.Capacity</b></span>
                            </p>
                            <div class="hp-event-card__foot">
                                <span class="hp-event-card__mode">
                                    <partial name="_Icon" model="@(evt.IsOnline ? "globe" : "map-pin")" />
                                    @(string.IsNullOrWhiteSpace(evt.Venue) ? evt.ModeLabel : evt.Venue)
                                </span>
                                <a class="hp-event-card__link @(isLead ? "hp-event-card__link--button" : "hp-event-card__link--quiet")" href="@EventUrl(evt.Id)">
                                    View event
                                    <partial name="_Icon" model="@("arrow-right")" />
                                </a>
                            </div>
                        </div>
                    </article>
                }
            </div>

            @if (Model.MoreEvents.Count > 0)
            {
                <ul class="hp-event-list">
                    @foreach (var evt in Model.MoreEvents)
                    {
                        <li>
                            <a class="hp-event-row" href="@EventUrl(evt.Id)">
                                <span class="hp-event-row__date">@evt.DateLabel</span>
                                <span class="hp-event-row__main">
                                    <span class="hp-event-row__title">@evt.Title</span>
                                    <span class="hp-event-row__meta">
                                        <span>@evt.CategoryName</span>
                                        @if (!string.IsNullOrWhiteSpace(evt.DepartmentName))
                                        {
                                            <span><partial name="_Icon" model="@("building")" />@evt.DepartmentName</span>
                                        }
                                        <span>
                                            <partial name="_Icon" model="@(evt.IsOnline ? "globe" : "map-pin")" />
                                            @(string.IsNullOrWhiteSpace(evt.Venue) ? evt.ModeLabel : evt.Venue)
                                        </span>
                                    </span>
                                </span>
                                <span class="hp-event-row__price">@evt.PriceLabel</span>
                                <span class="hp-event-row__chevron" aria-hidden="true"><partial name="_Icon" model="@("chevron-right")" /></span>
                            </a>
                        </li>
                    }
                </ul>
            }
        }
        else
        {
            <div class="hp-empty">
                <h3>No events are published right now.</h3>
                <p>Department coordinators publish new workshops, contests and lectures throughout the term. Sign in to check the catalogue for registration windows.</p>
                <div class="hp-empty__actions">
                    @if (isSignedIn)
                    {
                        <a class="hp-btn" href="@CatalogueUrl()">Open the catalogue</a>
                    }
                    else
                    {
                        <a class="hp-btn" href="@Url.Action("Register", "Account")">Create student account</a>
                        <a class="hp-btn hp-btn--ghost" href="@Url.Action("Login", "Account")">Sign in</a>
                    }
                </div>
            </div>
        }
    </div>
</section>

<!-- ========================= HOW THE HUB WORKS ========================= -->
<section class="hp-section hp-institution" id="about" aria-labelledby="institution-heading">
    <div class="hp-wrap">
        <div class="hp-section__head">
            <div>
                <h2 id="institution-heading">How the hub works</h2>
                <p class="hp-section__lede">Academic review, practical sessions and the certificate record.</p>
            </div>
        </div>

        <div class="hp-panel">
            <div class="hp-panel__topics" role="tablist" aria-label="How the hub works" aria-orientation="vertical">
                <button class="hp-panel__tab is-active" type="button" role="tab" id="tab-review" aria-controls="panel-review" aria-selected="true" tabindex="0">
                    <span>Academic review</span>
                    <partial name="_Icon" model="@("shield-check")" />
                </button>
                <button class="hp-panel__tab" type="button" role="tab" id="tab-practice" aria-controls="panel-practice" aria-selected="false" tabindex="-1">
                    <span>Practical sessions</span>
                    <partial name="_Icon" model="@("flask")" />
                </button>
                <button class="hp-panel__tab" type="button" role="tab" id="tab-certificates" aria-controls="panel-certificates" aria-selected="false" tabindex="-1">
                    <span>Certificates</span>
                    <partial name="_Icon" model="@("award")" />
                </button>
            </div>

            <div class="hp-panel__body">
                <div class="hp-panel__pane is-active" role="tabpanel" id="panel-review" aria-labelledby="tab-review" tabindex="0">
                    <h3>Every event is reviewed before it is listed</h3>
                    <p>Department committees check syllabus alignment, venue capacity and speaker credentials. An administrator then approves publication and fixes the registration window.</p>
                    <ul class="hp-panel__facts">
                        <li><partial name="_Icon" model="@("check")" /> Department academic committee review</li>
                        <li><partial name="_Icon" model="@("check")" /> Administrator approval before publication</li>
                        <li><partial name="_Icon" model="@("check")" /> Eligibility rules set per event</li>
                    </ul>
                </div>
                <div class="hp-panel__pane" role="tabpanel" id="panel-practice" aria-labelledby="tab-practice" tabindex="0" hidden>
                    <h3>Sessions run in department labs and studios</h3>
                    <p>Workshops, contests and symposiums are held in department facilities, led by faculty coordinators with visiting practitioners where the proposal specifies them.</p>
                    <ul class="hp-panel__facts">
                        <li><partial name="_Icon" model="@("check")" /> Session schedule with venue and speaker</li>
                        <li><partial name="_Icon" model="@("check")" /> Capacity fixed at approval</li>
                        <li><partial name="_Icon" model="@("check")" /> Offline, online or hybrid mode</li>
                    </ul>
                </div>
                <div class="hp-panel__pane" role="tabpanel" id="panel-certificates" aria-labelledby="tab-certificates" tabindex="0" hidden>
                    <h3>Certificates come from the attendance record</h3>
                    <p>Passes are scanned at the venue door and attendance is written against the registration. The certificate is generated from that record and stays in the student portal.</p>
                    <ul class="hp-panel__facts">
                        <li><partial name="_Icon" model="@("check")" /> QR admission pass per registration</li>
                        <li><partial name="_Icon" model="@("check")" /> Certificate available after the event</li>
                        <li><partial name="_Icon" model="@("check")" /> Certificate verification by code</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============================ ACCOUNT ENTRY ============================ -->
<section class="hp-section" aria-labelledby="account-heading">
    <div class="hp-wrap hp-cta">
        <div>
            @if (isSignedIn)
            {
                <h2 id="account-heading">Continue with your registered events</h2>
                <p>Registration windows, admission passes and certificates for every event you joined.</p>
            }
            else
            {
                <h2 id="account-heading">Create a student account</h2>
                <p>One account for event registration, admission passes and certificates.</p>
            }
        </div>
        <div class="hp-cta__actions">
            @if (isSignedIn)
            {
                <a class="hp-btn hp-btn--lg" href="@CatalogueUrl()">
                    Browse available events
                    <partial name="_Icon" model="@("arrow-right")" />
                </a>
                <a class="hp-btn hp-btn--ghost" href="@Url.Action("Index", "Dashboard", new { area = "Student" })">Student portal</a>
            }
            else
            {
                <a class="hp-btn hp-btn--lg" href="@Url.Action("Register", "Account")">
                    Create student account
                    <partial name="_Icon" model="@("arrow-right")" />
                </a>
                <a class="hp-btn hp-btn--ghost" href="@Url.Action("Login", "Account")">Sign in</a>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/homepage.js" asp-append-version="true"></script>
}
