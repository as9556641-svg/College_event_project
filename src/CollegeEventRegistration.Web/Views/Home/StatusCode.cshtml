@model int
@{
    int statusCode = Model;
    ViewData["Title"] = statusCode switch
    {
        400 => "Bad Request",
        401 => "Unauthorized Access",
        403 => "Access Forbidden",
        404 => "Page or Resource Not Found",
        429 => "Too Many Requests",
        _ => "System Notice"
    };

    var heading = statusCode switch
    {
        400 => "400 - Invalid Request",
        401 => "401 - Authentication Required",
        403 => "403 - Access Forbidden",
        404 => "404 - Resource Not Found",
        429 => "429 - Rate Limit Exceeded",
        _ => $"{statusCode} - Server Response"
    };

    var description = statusCode switch
    {
        400 => "The server could not understand the request or required parameters are missing.",
        401 => "You must be signed in with authorized credentials to view this resource.",
        403 => "You do not have administrative or coordinator authorization to access this area.",
        404 => "The event, page, or document you requested could not be found or has been archived.",
        429 => "Too many requests were received in a short timeframe. Please wait a few moments before retrying.",
        _ => "An unexpected status occurred while fulfilling your request."
    };
}

<div class="container my-5 py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm p-4 p-md-5 rounded-4">
                <div class="mb-3 text-secondary">
                    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                </div>
                <h1 class="display-6 fw-bold text-dark mb-2">@heading</h1>
                <p class="text-muted mb-4 lead fs-6">
                    @description
                </p>

                @if (ViewBag.RequestId != null)
                {
                    <div class="alert alert-light border small text-muted text-break mb-4">
                        Incident Trace ID: <code class="text-dark fw-bold">@ViewBag.RequestId</code>
                    </div>
                }

                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2">
                        Home
                    </a>
                    <a href="javascript:history.back()" class="btn btn-outline-secondary px-4 py-2">
                        Go Back
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
