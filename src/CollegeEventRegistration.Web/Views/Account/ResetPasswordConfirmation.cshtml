@{
    ViewData["Title"] = "Password Reset Confirmed";
    Layout = "_Layout";
}

<div class="container my-5 py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-sm p-4 p-md-5 rounded-4">
                <div class="mb-3 text-success">
                    <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                </div>
                <h3 class="fw-bold text-dark mb-2">Password Reset Complete</h3>
                <p class="text-muted small mb-4">
                    Your password has been successfully updated. You may now sign in using your new credentials.
                </p>
                <a asp-action="Login" class="btn btn-primary w-100 py-2 fw-semibold">
                    Sign In
                </a>
            </div>
        </div>
    </div>
</div>
