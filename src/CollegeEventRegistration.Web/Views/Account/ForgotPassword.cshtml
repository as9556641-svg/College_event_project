@model CollegeEventRegistration.Web.Models.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Password Recovery - VAP UNIVERSITY";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-page-container">
    <div class="auth-card" style="max-width: 460px;">
        <div class="text-center mb-4">
            <div class="text-center mb-3">
                <img src="~/images/branding/vap-university-logo.png" 
                     alt="VAP University Logo" 
                     style="height: 52px; width: auto; object-fit: contain; max-width: 240px;" 
                     asp-append-version="true" />
            </div>
            <div class="auth-system-kicker" style="color: #0BA9AC;">VAP UNIVERSITY &bull; PASSWORD RECOVERY</div>
            <h1 class="auth-card-title" style="color: #1F2C58;">Reset Password</h1>
            <p class="auth-card-subtitle">Enter your registered institutional email to receive recovery instructions</p>
        </div>

        <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="auth-form" novalidate>
            @Html.AntiForgeryToken()

            <div class="auth-form-group mb-4">
                <label asp-for="Email" class="auth-form-label" for="forgotEmailInput">College Email Address</label>
                <div class="auth-input-container">
                    <span class="auth-input-lead-icon" aria-hidden="true">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                        </svg>
                    </span>
                    <input asp-for="Email"
                           class="auth-input-control"
                           id="forgotEmailInput"
                           type="email"
                           placeholder="name@college.edu"
                           autocomplete="email"
                           required
                           aria-required="true" />
                </div>
                <span asp-validation-for="Email" class="auth-validation-message"></span>
            </div>

            <button type="submit" class="btn-auth-vap btn-auth-primary mb-3" id="btnForgotSubmit" data-loading-text="Sending link...">
                <span class="btn-spinner" aria-hidden="true"></span>
                <span class="btn-text">Send Password Reset Link</span>
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </button>

            <div class="text-center pt-3 border-top border-slate-100">
                <a asp-controller="Account" asp-action="Login" class="auth-vap-subtle-link d-inline-flex align-items-center gap-1">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    <span>Return to Sign In</span>
                </a>
            </div>
        </form>
    </div>

    <div class="auth-portal-tagline text-center mt-3">
        <span>&copy; @DateTime.UtcNow.Year VAP UNIVERSITY &bull; Campus Event Hub</span>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
