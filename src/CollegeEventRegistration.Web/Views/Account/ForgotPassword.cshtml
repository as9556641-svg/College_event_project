@model CollegeEventRegistration.Web.Models.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Password Recovery";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-page-container">
    <div class="auth-card-shell" style="max-width: 500px;">
        <div class="p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="auth-logo-badge justify-content-center">
                    <div class="auth-logo-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    </div>
                    <span>PORTAL RECOVERY</span>
                </div>
                <h2 class="auth-form-title">Reset Password</h2>
                <p class="auth-form-subtitle">Enter your registered institutional email to receive recovery instructions</p>
            </div>

            <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="auth-form" novalidate>
                @Html.AntiForgeryToken()

                <div class="auth-field-wrapper">
                    <input asp-for="Email" class="auth-floating-input" id="forgotEmail" placeholder=" " required />
                    <span class="auth-field-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                    </span>
                    <label asp-for="Email" class="auth-floating-label" for="forgotEmail">Registered Email Address</label>
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>

                <button type="submit" class="btn-auth-primary" id="btnForgotSubmit">
                    <span class="btn-spinner" aria-hidden="true"></span>
                    <span class="btn-text">Send Password Reset Link</span>
                </button>

                <div class="text-center mt-4">
                    <a asp-controller="Account" asp-action="Login" class="auth-link small">
                        &larr; Return to Sign In
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth.js" asp-append-version="true"></script>
}

