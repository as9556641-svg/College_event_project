@model CollegeEventRegistration.Web.Models.Account.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_Layout";
}

<div class="container my-5 py-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-sm p-4 rounded-4">
                <div class="text-center mb-4">
                    <img src="~/images/branding/vap-university-logo.png" alt="VAP UNIVERSITY Logo" style="height: 48px; width: auto;" asp-append-version="true" />
                    <h3 class="fw-bold text-dark mt-3 mb-1">Set New Password</h3>
                    <p class="text-muted small">Enter your new credentials for Campus Event Hub.</p>
                </div>

                <form asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Token" />
                    <input type="hidden" asp-for="Email" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold text-muted">Account Email</label>
                        <input asp-for="Email" class="form-control" disabled />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-semibold text-muted">New Password</label>
                        <input asp-for="Password" class="form-control" placeholder="Minimum 8 characters" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-muted">Confirm New Password</label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Re-enter password" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                        Reset Password
                    </button>
                </form>

                <div class="text-center mt-4">
                    <a asp-action="Login" class="text-decoration-none small text-muted">
                        &larr; Back to Sign In
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
