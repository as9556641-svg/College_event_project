@model CollegeEventRegistration.Web.Models.Account.RegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Student Signup - VAP UNIVERSITY";
    var departments = ViewData["Departments"] as IEnumerable<CollegeEventRegistration.Core.Entities.Department> ?? Enumerable.Empty<CollegeEventRegistration.Core.Entities.Department>();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Campus Event Hub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <!-- Split-Screen Registration Container (Part 3) -->
    <div class="auth-split-wrapper reg-split-wrapper">
        <!-- =================================================================
             LEFT SIDE — Registration Form (Controlled Width ~440px, White Background)
             ================================================================= -->
        <div class="reg-split-left">
            <div class="reg-form-container">
                <!-- University Branding & Header -->
                <div class="reg-brand-header mb-4">
                    <a asp-controller="Home" asp-action="Index" class="d-inline-flex align-items-center gap-2 text-decoration-none">
                        <img src="~/images/branding/vap-university-logo.png" 
                             alt="VAP University Logo" 
                             class="reg-brand-logo" 
                             asp-append-version="true" />
                        <div class="text-start">
                            <div class="reg-brand-title">VAP UNIVERSITY</div>
                            <div class="reg-brand-subtitle">Campus Event Hub</div>
                        </div>
                    </a>
                </div>

                <!-- Card Heading -->
                <div class="reg-heading-block mb-4">
                    <h1 class="reg-title">Student Signup</h1>
                    <p class="reg-subtitle">Create your student account to discover workshops, enroll in hackathons, and access verified credentials.</p>
                </div>

                <!-- Server-Side Validation Summary -->
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="auth-alert-summary mb-3" role="alert">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="auth-alert-icon flex-shrink-0">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        <div class="auth-alert-content">
                            <div asp-validation-summary="ModelOnly"></div>
                        </div>
                    </div>
                }

                <!-- Primary Registration Form -->
                <form asp-controller="Account" asp-action="Register" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" class="auth-form" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CollegeName" value="VAP UNIVERSITY" />
                    <input type="hidden" asp-for="ReturnUrl" />

                    <!-- Full Name (First Name & Last Name) -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <div class="auth-form-group mb-0">
                                <label asp-for="FirstName" class="auth-form-label" for="regFirstName">First Name</label>
                                <div class="auth-input-container">
                                    <span class="auth-input-lead-icon" aria-hidden="true">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                    </span>
                                    <input asp-for="FirstName"
                                           class="auth-input-control"
                                           id="regFirstName"
                                           placeholder="e.g. Rahul"
                                           autocomplete="given-name"
                                           required
                                           aria-required="true" />
                                </div>
                                <span asp-validation-for="FirstName" class="auth-validation-message"></span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="auth-form-group mb-0">
                                <label asp-for="LastName" class="auth-form-label" for="regLastName">Last Name</label>
                                <div class="auth-input-container">
                                    <span class="auth-input-lead-icon" aria-hidden="true">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                    </span>
                                    <input asp-for="LastName"
                                           class="auth-input-control"
                                           id="regLastName"
                                           placeholder="e.g. Sharma"
                                           autocomplete="family-name"
                                           required
                                           aria-required="true" />
                                </div>
                                <span asp-validation-for="LastName" class="auth-validation-message"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Academic Department -->
                    <div class="auth-form-group mb-3">
                        <label asp-for="Department" class="auth-form-label" for="regDepartment">Academic Department</label>
                        <div class="auth-input-container">
                            <span class="auth-input-lead-icon" aria-hidden="true">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                            </span>
                            <select asp-for="Department" class="auth-input-control auth-select-control" id="regDepartment" required aria-required="true">
                                <option value="" disabled selected>-- Select Department --</option>
                                @foreach (var dept in departments)
                                {
                                    <option value="@dept.Name">@dept.Name (@dept.Code)</option>
                                }
                            </select>
                        </div>
                        <span asp-validation-for="Department" class="auth-validation-message"></span>
                    </div>

                    <!-- Email Address -->
                    <div class="auth-form-group mb-3">
                        <label asp-for="Email" class="auth-form-label" for="regEmail">Email Address</label>
                        <div class="auth-input-container">
                            <span class="auth-input-lead-icon" aria-hidden="true">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
                            </span>
                            <input asp-for="Email"
                                   class="auth-input-control"
                                   id="regEmail"
                                   type="email"
                                   placeholder="name@college.edu or personal email"
                                   autocomplete="email"
                                   required
                                   aria-required="true" />
                        </div>
                        <span asp-validation-for="Email" class="auth-validation-message"></span>
                    </div>

                    <!-- Student Roll / ID (Optional) -->
                    <div class="auth-form-group mb-3">
                        <label asp-for="RollNumber" class="auth-form-label" for="regRollNumber">Roll / Student ID (Optional)</label>
                        <div class="auth-input-container">
                            <span class="auth-input-lead-icon" aria-hidden="true">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="M7 15h0M2 9h20"></path></svg>
                            </span>
                            <input asp-for="RollNumber"
                                   class="auth-input-control"
                                   id="regRollNumber"
                                   placeholder="e.g. CS2026-042" />
                        </div>
                        <span asp-validation-for="RollNumber" class="auth-validation-message"></span>
                    </div>

                    <!-- Password -->
                    <div class="auth-form-group mb-3">
                        <label asp-for="Password" class="auth-form-label" for="regPassword">Password (Min. 8 characters)</label>
                        <div class="auth-input-container">
                            <span class="auth-input-lead-icon" aria-hidden="true">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                            </span>
                            <input asp-for="Password"
                                   type="password"
                                   class="auth-input-control"
                                   id="regPassword"
                                   placeholder="Create password"
                                   autocomplete="new-password"
                                   required
                                   aria-required="true" />
                            <button type="button"
                                    class="auth-password-toggle"
                                    data-target="regPassword"
                                    aria-label="Show password"
                                    title="Show password"
                                    tabindex="0">
                                <svg class="icon-eye-open" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                <svg class="icon-eye-closed" style="display: none;" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="auth-validation-message"></span>
                    </div>

                    <!-- Confirm Password -->
                    <div class="auth-form-group mb-4">
                        <label asp-for="ConfirmPassword" class="auth-form-label" for="regConfirmPassword">Confirm Password</label>
                        <div class="auth-input-container">
                            <span class="auth-input-lead-icon" aria-hidden="true">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                            </span>
                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   class="auth-input-control"
                                   id="regConfirmPassword"
                                   placeholder="Re-enter password"
                                   autocomplete="new-password"
                                   required
                                   aria-required="true" />
                            <button type="button"
                                    class="auth-password-toggle"
                                    data-target="regConfirmPassword"
                                    aria-label="Show password"
                                    title="Show password"
                                    tabindex="0">
                                <svg class="icon-eye-open" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                <svg class="icon-eye-closed" style="display: none;" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="auth-validation-message"></span>
                    </div>

                    <!-- Primary Action Button: Create Account -->
                    <button type="submit" class="btn-auth-vap btn-auth-primary w-100 mb-3" id="submitRegisterBtn" data-loading-text="Creating Account...">
                        <span class="btn-spinner" aria-hidden="true"></span>
                        <span class="btn-text">Create Account</span>
                    </button>
                </form>

                <!-- Footer: Existing Sign In Link -->
                <div class="text-center pt-3 border-top border-slate-100">
                    <p class="auth-register-text mb-0">
                        Already have an account?
                        <a asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" class="auth-vap-link ms-1">
                            Sign in here
                        </a>
                    </p>
                </div>
            </div>
        </div>

        <!-- =================================================================
             RIGHT SIDE — Illustration Panel (Purple Background #712DFC, Centered)
             ================================================================= -->
        <div class="reg-split-right">
            <div class="reg-illustration-wrapper">
                <img src="~/images/branding/student-reading-illustration.png" 
                     alt="Student reading books illustration" 
                     class="reg-illustration-img" 
                     asp-append-version="true" />
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/auth.js" asp-append-version="true"></script>
</body>
</html>
