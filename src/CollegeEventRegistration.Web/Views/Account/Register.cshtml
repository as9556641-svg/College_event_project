@model CollegeEventRegistration.Web.Models.Account.RegisterViewModel
@{
    ViewData["Title"] = "Student Registration - College Event & Workshop Registration";
    var departments = ViewData["Departments"] as IEnumerable<CollegeEventRegistration.Core.Entities.Department> ?? Enumerable.Empty<CollegeEventRegistration.Core.Entities.Department>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-page-container">
    <div class="auth-card-wide">
        <!-- Institutional Header & Branding -->
        <div class="auth-card-header text-center mb-4">
            <div class="auth-brand-badge mb-3">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
                    <path d="M6 6h10"></path>
                    <path d="M6 10h10"></path>
                    <path d="M6 14h6"></path>
                </svg>
            </div>
            <div class="auth-system-kicker">CENTRAL UNIVERSITY &bull; STUDENT ENROLLMENT</div>
            <h1 class="auth-card-title">Create Student Account</h1>
            <p class="auth-card-subtitle">Register to discover workshops, enroll in hackathons, and receive verified certificates</p>
        </div>

        <!-- Server-Side Validation Summary -->
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div class="auth-alert-summary mb-4" role="alert">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="auth-alert-icon">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <div class="auth-alert-content">
                    <div asp-validation-summary="ModelOnly"></div>
                </div>
            </div>
        }

        <!-- Primary Registration Form -->
        <form asp-controller="Account" asp-action="Register" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" class="auth-form" novalidate>
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <!-- First Name -->
                <div class="col-md-6">
                    <div class="auth-form-group mb-0">
                        <label asp-for="FirstName" class="auth-form-label" for="regFirstName">First Name</label>
                        <div class="auth-input-container">
                            <span class="auth-input-lead-icon" aria-hidden="true">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="12" cy="7" r="4"></circle>
                                </svg>
                            </span>
                            <input asp-for="FirstName"
                                   class="auth-input-control"
                                   id="regFirstName"
                                   placeholder="e.g. Rahul"
                                   autocomplete="given-name"
                                   required
                                   aria-required="true" />
                        </div>
                        <span asp-validation-for="FirstName" class="auth-validation-message"></span>
                    </div>
                </div>

                <!-- Last Name -->
                <div class="col-md-6">
                    <div class="auth-form-group mb-0">
                        <label asp-for="LastName" class="auth-form-label" for="regLastName">Last Name</label>
                        <div class="auth-input-container">
                            <span class="auth-input-lead-icon" aria-hidden="true">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="12" cy="7" r="4"></circle>
                                </svg>
                            </span>
                            <input asp-for="LastName"
                                   class="auth-input-control"
                                   id="regLastName"
                                   placeholder="e.g. Sharma"
                                   autocomplete="family-name"
                                   required
                                   aria-required="true" />
                        </div>
                        <span asp-validation-for="LastName" class="auth-validation-message"></span>
                    </div>
                </div>

                <!-- College / Personal Email Address -->
                <div class="col-12">
                    <div class="auth-form-group mb-0">
                        <label asp-for="Email" class="auth-form-label" for="regEmail">College / Personal Email Address</label>
                        <div class="auth-input-container">
                            <span class="auth-input-lead-icon" aria-hidden="true">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                                </svg>
                            </span>
                            <input asp-for="Email"
                                   class="auth-input-control"
                                   id="regEmail"
                                   type="email"
                                   placeholder="name@college.edu or personal email"
                                   autocomplete="email"
                                   required
                                   aria-required="true" />
                        </div>
                        <span asp-validation-for="Email" class="auth-validation-message"></span>
                    </div>
                </div>

                <!-- Password -->
                <div class="col-md-6">
                    <div class="auth-form-group mb-0">
                        <label asp-for="Password" class="auth-form-label" for="regPassword">Password (Min. 8 characters)</label>
                        <div class="auth-input-container">
                            <span class="auth-input-lead-icon" aria-hidden="true">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                            </span>
                            <input asp-for="Password"
                                   type="password"
                                   class="auth-input-control"
                                   id="regPassword"
                                   placeholder="Create password"
                                   autocomplete="new-password"
                                   required
                                   aria-required="true" />
                            <button type="button"
                                    class="auth-password-toggle"
                                    data-target="regPassword"
                                    aria-label="Show password"
                                    title="Show password"
                                    tabindex="0">
                                <svg class="icon-eye-open" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                                <svg class="icon-eye-closed" style="display: none;" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                    <line x1="1" y1="1" x2="23" y2="23"></line>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="auth-validation-message"></span>
                    </div>
                </div>

                <!-- Confirm Password -->
                <div class="col-md-6">
                    <div class="auth-form-group mb-0">
                        <label asp-for="ConfirmPassword" class="auth-form-label" for="regConfirmPassword">Confirm Password</label>
                        <div class="auth-input-container">
                            <span class="auth-input-lead-icon" aria-hidden="true">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                            </span>
                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   class="auth-input-control"
                                   id="regConfirmPassword"
                                   placeholder="Re-enter password"
                                   autocomplete="new-password"
                                   required
                                   aria-required="true" />
                            <button type="button"
                                    class="auth-password-toggle"
                                    data-target="regConfirmPassword"
                                    aria-label="Show password"
                                    title="Show password"
                                    tabindex="0">
                                <svg class="icon-eye-open" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                                <svg class="icon-eye-closed" style="display: none;" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                    <line x1="1" y1="1" x2="23" y2="23"></line>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="auth-validation-message"></span>
                    </div>
                </div>

                <!-- Academic Department -->
                <div class="col-md-7">
                    <div class="auth-form-group mb-0">
                        <label asp-for="Department" class="auth-form-label" for="regDepartment">Academic Department</label>
                        <div class="auth-input-container">
                            <span class="auth-input-lead-icon" aria-hidden="true">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                                </svg>
                            </span>
                            <select asp-for="Department" class="auth-input-control auth-select-control" id="regDepartment" required aria-required="true">
                                <option value="" disabled selected>-- Select Academic Department --</option>
                                @foreach (var dept in departments)
                                {
                                    <option value="@dept.Name">@dept.Name (@dept.Code)</option>
                                }
                            </select>
                        </div>
                        <span asp-validation-for="Department" class="auth-validation-message"></span>
                    </div>
                </div>

                <!-- Student Roll / ID Number -->
                <div class="col-md-5">
                    <div class="auth-form-group mb-0">
                        <label asp-for="RollNumber" class="auth-form-label" for="regRollNumber">Roll / Student ID (Optional)</label>
                        <div class="auth-input-container">
                            <span class="auth-input-lead-icon" aria-hidden="true">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                                    <path d="M7 15h0M2 9h20"></path>
                                </svg>
                            </span>
                            <input asp-for="RollNumber"
                                   class="auth-input-control"
                                   id="regRollNumber"
                                   placeholder="e.g. CS2026-042" />
                        </div>
                        <span asp-validation-for="RollNumber" class="auth-validation-message"></span>
                    </div>
                </div>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn-auth-primary mt-4 mb-3" id="submitRegisterBtn" data-loading-text="Creating account...">
                <span class="btn-spinner" aria-hidden="true"></span>
                <span class="btn-text">Complete Student Registration</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </button>
        </form>

        <!-- Secondary Navigation (Back to Login) -->
        <div class="auth-card-footer text-center pt-3 border-top border-slate-100">
            <p class="auth-register-text mb-0">
                Already have an account?
                <a asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" class="auth-register-link">
                    Sign in here
                </a>
            </p>
        </div>
    </div>

    <!-- Minimal Institutional Platform Badge -->
    <div class="auth-portal-tagline text-center mt-3">
        <span>&copy; @DateTime.UtcNow.Year College Event &amp; Workshop Registration &bull; Secure Institutional Portal</span>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
