@{
    ViewData["Title"] = "Access Restricted - VARP UNIVERSITY";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: calc(100vh - 220px);">
    <div class="card card-3d p-4 p-md-5 text-center" style="max-width: 520px; border-radius: 1.25rem;">
        <div class="mb-3">
            <img src="~/images/branding/varp-university-logo.png" 
                 alt="VARP University Logo" 
                 style="height: 48px; width: auto; object-fit: contain; max-width: 220px;" 
                 asp-append-version="true" />
        </div>

        <div class="d-inline-flex align-items-center justify-content-center mb-3 mx-auto" 
             style="width: 64px; height: 64px; border-radius: 50%; background: #FEF2F2; color: #DC2626;">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="15" y1="9" x2="9" y2="15"></line>
                <line x1="9" y1="9" x2="15" y2="15"></line>
            </svg>
        </div>

        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill mb-2 align-self-center">
            Authorization Boundary Enforced
        </span>

        <h3 class="fw-bold mb-2" style="color: #1F2C58;">Access Restricted</h3>
        <p class="text-muted small mb-4">
            You do not possess the required institutional role credentials to access this protected VARP UNIVERSITY workspace. 
            If you believe this is an error, please contact your department administrator.
        </p>

        <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                Return to Campus Catalog
            </a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-auth-varp" style="width: auto; padding: 0.5rem 1.5rem; text-decoration: none;">
                Switch Account
            </a>
        </div>
    </div>
</div>
