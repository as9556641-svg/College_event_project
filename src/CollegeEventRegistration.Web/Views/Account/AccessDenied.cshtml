@{
    ViewData["Title"] = "Access Restricted - VAP UNIVERSITY";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-page-container">
    <div class="auth-card text-center" style="max-width: 520px;">
        <div class="mb-3">
            <img src="~/images/branding/vap-university-logo.png" 
                 alt="VAP University Logo" 
                 style="height: 48px; width: auto; object-fit: contain; max-width: 220px;" 
                 asp-append-version="true" />
        </div>

        <div class="d-inline-flex align-items-center justify-content-center mb-3 mx-auto" 
             style="width: 64px; height: 64px; border-radius: 50%; background: #FEF2F2; color: #DC2626;">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="15" y1="9" x2="9" y2="15"></line>
                <line x1="9" y1="9" x2="15" y2="15"></line>
            </svg>
        </div>

        <div class="auth-system-kicker text-danger mb-2">
            Authorization Boundary Enforced
        </div>

        <h2 class="auth-card-title mb-2" style="color: #1F2C58;">Access Restricted</h2>
        <p class="auth-card-subtitle text-muted mb-4" style="font-size: 0.92rem; line-height: 1.55;">
            You do not possess the required institutional role credentials to access this protected VAP UNIVERSITY workspace. 
            If you believe this is an error, please contact your department administrator.
        </p>

        <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-pill small">
                Return to Campus Catalog
            </a>
            <a asp-controller="Account" asp-action="Login" class="btn-auth-vap text-decoration-none px-4 py-2 rounded-pill" style="width: auto;">
                Switch Account
            </a>
        </div>
    </div>

    <div class="auth-portal-tagline text-center mt-3">
        <span>&copy; @DateTime.UtcNow.Year VAP UNIVERSITY &bull; Campus Event Hub</span>
    </div>
</div>
