@model CollegeEventRegistration.Web.Models.Account.LoginViewModel
@{
    ViewData["Title"] = "Portal Login - College Event & Workshop Registration";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-page-container">
    <div class="auth-card">
        <!-- Brand & Institutional Identity Header -->
        <div class="auth-card-header text-center mb-4">
            <div class="auth-brand-badge mb-3">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
                    <path d="M6 6h10"></path>
                    <path d="M6 10h10"></path>
                    <path d="M6 14h6"></path>
                </svg>
            </div>
            <div class="auth-system-kicker">CENTRAL UNIVERSITY &bull; EVENT HUB</div>
            <h1 class="auth-card-title">Sign in to your account</h1>
            <p class="auth-card-subtitle">Enter your institutional credentials to continue</p>
        </div>

        <!-- Server-Side Validation Summary -->
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div class="auth-alert-summary mb-4" role="alert">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="auth-alert-icon">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <div class="auth-alert-content">
                    <div asp-validation-summary="ModelOnly"></div>
                </div>
            </div>
        }

        <!-- Primary Authentication Form -->
        <form asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" class="auth-form" novalidate>
            @Html.AntiForgeryToken()

            <!-- College Email Address -->
            <div class="auth-form-group mb-3">
                <label asp-for="Email" class="auth-form-label" for="loginEmailInput">College Email Address</label>
                <div class="auth-input-container">
                    <span class="auth-input-lead-icon" aria-hidden="true">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                        </svg>
                    </span>
                    <input asp-for="Email"
                           class="auth-input-control"
                           id="loginEmailInput"
                           type="email"
                           placeholder="name@college.edu"
                           autocomplete="username"
                           required
                           aria-required="true" />
                </div>
                <span asp-validation-for="Email" class="auth-validation-message"></span>
            </div>

            <!-- Password Field with Visibility Toggle -->
            <div class="auth-form-group mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label asp-for="Password" class="auth-form-label mb-0" for="loginPasswordInput">Password</label>
                    <a asp-controller="Account" asp-action="ForgotPassword" class="auth-link-subtle" tabindex="4">
                        Forgot password?
                    </a>
                </div>
                <div class="auth-input-container">
                    <span class="auth-input-lead-icon" aria-hidden="true">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                    </span>
                    <input asp-for="Password"
                           type="password"
                           class="auth-input-control"
                           id="loginPasswordInput"
                           placeholder="Enter your password"
                           autocomplete="current-password"
                           required
                           aria-required="true" />
                    <button type="button"
                            class="auth-password-toggle"
                            data-target="loginPasswordInput"
                            aria-label="Show password"
                            title="Show password"
                            tabindex="0">
                        <!-- Eye Open Icon -->
                        <svg class="icon-eye-open" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                        <!-- Eye Closed Icon -->
                        <svg class="icon-eye-closed" style="display: none;" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                            <line x1="1" y1="1" x2="23" y2="23"></line>
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="Password" class="auth-validation-message"></span>
            </div>

            <!-- Keep me signed in Checkbox -->
            <div class="auth-checkbox-row mb-4">
                <label class="auth-checkbox-label" for="rememberMeCheck">
                    <input asp-for="RememberMe" type="checkbox" id="rememberMeCheck" class="auth-checkbox-input" />
                    <span>Keep me signed in on this device</span>
                </label>
            </div>

            <!-- Tactile 3D Action Button -->
            <button type="submit" class="btn-auth-primary mb-3" id="submitLoginBtn">
                <span class="btn-spinner" aria-hidden="true"></span>
                <span class="btn-text">Sign In</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </button>
        </form>

        <!-- Secondary Navigation (Student Registration) -->
        <div class="auth-card-footer text-center pt-3 border-top border-slate-100">
            <p class="auth-register-text mb-0">
                New student attendee?
                <a asp-controller="Account" asp-action="Register" asp-route-returnurl="@ViewData["ReturnUrl"]" class="auth-register-link">
                    Create an account
                </a>
            </p>
        </div>
    </div>

    <!-- Minimal Institutional Platform Badge -->
    <div class="auth-portal-tagline text-center mt-3">
        <span>&copy; @DateTime.UtcNow.Year College Event &amp; Workshop Registration &bull; Secure Institutional Portal</span>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
