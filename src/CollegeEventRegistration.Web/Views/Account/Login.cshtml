@model CollegeEventRegistration.Web.Models.Account.LoginViewModel
@{
    ViewData["Title"] = "Portal Login - Campus Events & Workshops";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-page-container">
    <div class="auth-card-shell">
        <div class="row g-0">
            <!-- Left Side: Institutional Visual Showcase -->
            <div class="col-lg-6 auth-brand-side d-none d-lg-flex">
                <div>
                    <div class="brand-badge-pill animate-entrance-1">
                        <span class="pulse-dot"></span>
                        <span>Campus Portal &bull; Central University</span>
                    </div>

                    <h1 class="brand-heading animate-entrance-2">
                        Ignite Innovation.<br />
                        Register, Attend &amp; Excel.
                    </h1>

                    <p class="brand-tagline animate-entrance-3">
                        The unified institution gateway for technical workshops, national symposiums, hackathons, and dynamic digital credentials.
                    </p>

                    <div class="auth-feature-cards animate-entrance-4">
                        <div class="auth-feature-item">
                            <div class="auth-feature-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="3" width="7" height="7"></rect>
                                    <rect x="14" y="3" width="7" height="7"></rect>
                                    <rect x="14" y="14" width="7" height="7"></rect>
                                    <rect x="3" y="14" width="7" height="7"></rect>
                                </svg>
                            </div>
                            <div class="auth-feature-text">
                                <h6>Instant QR Check-ins</h6>
                                <p>Seamless fast-track event verification and attendance tracking</p>
                            </div>
                        </div>

                        <div class="auth-feature-item">
                            <div class="auth-feature-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 15l-2 5l9-11h-7l2-5l-9 11h7z"></path>
                                </svg>
                            </div>
                            <div class="auth-feature-text">
                                <h6>Verified Digital Certificates</h6>
                                <p>Tamper-proof verifiable completion certificates with unique serials</p>
                            </div>
                        </div>

                        <div class="auth-feature-item">
                            <div class="auth-feature-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="9" cy="7" r="4"></circle>
                                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                </svg>
                            </div>
                            <div class="auth-feature-text">
                                <h6>Role-Based Workspaces</h6>
                                <p>Dedicated portals for SuperAdmins, Deans, Coordinators &amp; Students</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="auth-brand-footer">
                    <span>&copy; @DateTime.UtcNow.Year Central University Event Hub</span>
                    <span>.NET 10 LTS &bull; Secure Auth</span>
                </div>
            </div>

            <!-- Right Side: Premium Authentication Form -->
            <div class="col-lg-6 auth-form-side">
                <div class="auth-form-header animate-entrance-1">
                    <div class="auth-logo-badge">
                        <div class="auth-logo-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                                <polyline points="2 17 12 22 22 17"></polyline>
                                <polyline points="2 12 12 17 22 12"></polyline>
                            </svg>
                        </div>
                        <span>EVENT HUB PORTAL</span>
                    </div>
                    <h2 class="auth-form-title">Welcome Back</h2>
                    <p class="auth-form-subtitle">Please enter your institutional credentials to continue</p>
                </div>

                <!-- Server-Side Validation Summary -->
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="auth-alert-summary" role="alert">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 mt-0.5">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        <div>
                            <div asp-validation-summary="ModelOnly"></div>
                        </div>
                    </div>
                }

                <form asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" class="auth-form animate-entrance-2" novalidate>
                    @Html.AntiForgeryToken()

                    <!-- Email Field -->
                    <div class="auth-field-wrapper">
                        <input asp-for="Email" 
                               class="auth-floating-input" 
                               id="loginEmailInput" 
                               placeholder=" " 
                               autocomplete="username" 
                               required 
                               aria-required="true" />
                        <span class="auth-field-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                <polyline points="22,6 12,13 2,6"></polyline>
                            </svg>
                        </span>
                        <label asp-for="Email" class="auth-floating-label" for="loginEmailInput">College Email Address</label>
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>

                    <!-- Password Field -->
                    <div class="auth-field-wrapper">
                        <input asp-for="Password" 
                               type="password" 
                               class="auth-floating-input" 
                               id="loginPasswordInput" 
                               placeholder=" " 
                               autocomplete="current-password" 
                               required 
                               aria-required="true" />
                        <span class="auth-field-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                        </span>
                        <label asp-for="Password" class="auth-floating-label" for="loginPasswordInput">Password</label>
                        
                        <!-- Smooth Password Visibility Toggle -->
                        <button type="button" 
                                class="auth-password-toggle" 
                                data-target="loginPasswordInput" 
                                aria-label="Show password" 
                                title="Show password" 
                                tabindex="0">
                            <!-- Eye Open -->
                            <svg class="icon-eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <!-- Eye Closed -->
                            <svg class="icon-eye-closed" style="display: none;" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        </button>
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>

                    <!-- Remember Me & Forgot Password Row -->
                    <div class="auth-aux-row animate-entrance-3">
                        <label class="auth-custom-checkbox">
                            <input asp-for="RememberMe" type="checkbox" id="rememberMeCheck" />
                            <span>Keep me signed in</span>
                        </label>
                        <a asp-controller="Account" asp-action="ForgotPassword" class="auth-link">
                            Forgot password?
                        </a>
                    </div>

                    <!-- Primary 3D Submit Button -->
                    <button type="submit" class="btn-auth-primary animate-entrance-4" id="submitLoginBtn">
                        <span class="btn-spinner" aria-hidden="true"></span>
                        <span class="btn-text">Sign In to Campus Hub</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </button>
                </form>

                <!-- Alternate Action (Student Registration) -->
                <div class="text-center mt-4 pt-3 border-top border-slate-100 animate-entrance-4">
                    <p class="text-muted small mb-0">
                        New student attendee? 
                        <a asp-controller="Account" asp-action="Register" asp-route-returnurl="@ViewData["ReturnUrl"]" class="auth-link fw-semibold">
                            Create a student account
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
