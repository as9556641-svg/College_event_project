@model CollegeEventRegistration.Web.Models.Account.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Sign In - VAP UNIVERSITY | Campus Event Hub";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body class="auth-body m-0 p-0 overflow-hidden-desktop" style="overflow-x: hidden;">
    <div class="auth-split-wrapper">
        <!-- LEFT PANEL (DESKTOP): 50% Full-Height University Campus Photo -->
        <div class="auth-split-left" aria-hidden="true">
            <img src="~/images/branding/vap-university-campus.jpg"
                 alt="VAP University Campus"
                 class="auth-campus-img"
                 asp-append-version="true" />

            <div class="auth-campus-overlay">
                <!-- Bottom-Left Institutional Welcome Message -->
                <div class="auth-campus-bottom-message">
                    <span class="auth-campus-kicker">Academic Excellence &amp; Innovation</span>
                    <h2 class="auth-campus-headline">VAP UNIVERSITY</h2>
                    <p class="auth-campus-lead">
                        Campus Event Hub &mdash; Register for accredited technical symposiums, research conferences, workshops, and national hackathons.
                    </p>
                </div>
            </div>
        </div>

        <!-- RIGHT PANEL (50%): Dedicated Form Area (Desktop Clean White / Mobile Elevated Card) -->
        <div class="auth-split-right">
            <!-- Top Navigation Bar: Official Logo on Left, Back to Catalog on Right -->
            <div class="auth-split-topbar">
                <a asp-controller="Home" asp-action="Index" class="auth-desktop-brand" title="VAP UNIVERSITY Campus Event Hub">
                    <img src="~/images/branding/vap-university-logo.png"
                         alt="VAP University"
                         class="auth-desktop-logo"
                         asp-append-version="true" />
                </a>
                <a asp-controller="Home" asp-action="Index" class="auth-back-link" title="Return to Event Catalog">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    <span>Back to Catalog</span>
                </a>
            </div>

            <!-- Mobile Top Branding (Visible only on mobile screens < 992px) -->
            <div class="auth-mobile-header d-lg-none text-center">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none">
                    <img src="~/images/branding/vap-university-logo.png"
                         alt="VAP University Logo"
                         class="auth-mobile-logo"
                         asp-append-version="true" />
                </a>
                <div class="auth-mobile-title">VAP UNIVERSITY</div>
                <div class="auth-mobile-subtitle">Campus Event Hub</div>
            </div>

            <!-- Authentication Form Container / Mobile Card -->
            <div class="auth-form-card">
                <!-- Card Heading -->
                <div class="auth-card-heading">
                    <h1 class="auth-title">Welcome Back</h1>
                    <p class="auth-subtitle">Sign in to continue to Campus Event Hub.</p>
                </div>

                <!-- Server-Side Validation Summary -->
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="auth-alert-summary mb-3" role="alert">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="auth-alert-icon">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        <div class="auth-alert-content">
                            <div asp-validation-summary="ModelOnly"></div>
                        </div>
                    </div>
                }

                <!-- Primary Authentication Form -->
                <form asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" class="auth-form" novalidate>
                    @Html.AntiForgeryToken()

                    <!-- Email Address -->
                    <div class="auth-form-group mb-3">
                        <label asp-for="Email" class="auth-form-label" for="loginEmailInput">Email Address</label>
                        <div class="auth-input-container">
                            <span class="auth-input-lead-icon" aria-hidden="true">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                                </svg>
                            </span>
                            <input asp-for="Email"
                                   class="auth-input-control"
                                   id="loginEmailInput"
                                   type="email"
                                   placeholder="name@college.edu"
                                   autocomplete="username"
                                   required
                                   aria-required="true" />
                        </div>
                        <span asp-validation-for="Email" class="auth-validation-message"></span>
                    </div>

                    <!-- Password Field with Visibility Toggle -->
                    <div class="auth-form-group mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="Password" class="auth-form-label mb-0" for="loginPasswordInput">Password</label>
                            <a asp-controller="Account" asp-action="ForgotPassword" class="auth-vap-subtle-link" tabindex="4">
                                Forgot Password?
                            </a>
                        </div>
                        <div class="auth-input-container">
                            <span class="auth-input-lead-icon" aria-hidden="true">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                            </span>
                            <input asp-for="Password"
                                   type="password"
                                   class="auth-input-control"
                                   id="loginPasswordInput"
                                   placeholder="Enter your password"
                                   autocomplete="current-password"
                                   required
                                   aria-required="true" />
                            <button type="button"
                                    class="auth-password-toggle"
                                    data-target="loginPasswordInput"
                                    aria-label="Show password"
                                    title="Show password"
                                    tabindex="0">
                                <!-- Eye Open Icon -->
                                <svg class="icon-eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                                <!-- Eye Closed Icon -->
                                <svg class="icon-eye-closed" style="display: none;" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                    <line x1="1" y1="1" x2="23" y2="23"></line>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="auth-validation-message"></span>
                    </div>

                    <!-- Remember Me Checkbox -->
                    <div class="auth-checkbox-row mb-4">
                        <label class="auth-checkbox-label" for="rememberMeCheck">
                            <input asp-for="RememberMe" type="checkbox" id="rememberMeCheck" class="auth-checkbox-input" />
                            <span>Remember Me</span>
                        </label>
                    </div>

                    <!-- Primary Action: Log In Button -->
                    <button type="submit" class="btn-auth-vap btn-auth-primary mb-3" id="submitLoginBtn">
                        <span class="btn-spinner" aria-hidden="true"></span>
                        <span class="btn-text">Log In</span>
                    </button>
                </form>

                <!-- Social Auth Divider -->
                <div class="auth-divider my-3">
                    <span class="auth-divider-line"></span>
                    <span class="auth-divider-text">or continue with</span>
                    <span class="auth-divider-line"></span>
                </div>

                <!-- Google Sign-In Setup Notification (Informational) -->
                <div id="googleAuthAlert" class="alert alert-info alert-dismissible fade show p-2 mb-2" style="display: none; font-size: 0.82rem;" role="alert">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1 inline-block align-text-top"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                    <strong>Google Sign-In:</strong> OAuth Client ID configuration in <code>appsettings.json</code> is required for live SSO redirection.
                    <button type="button" class="btn-close p-2" onclick="document.getElementById('googleAuthAlert').style.display='none';" aria-label="Close"></button>
                </div>

                <!-- Google Sign-In Button -->
                <button type="button" class="btn-auth-google w-100 mb-3" id="btnGoogleSignIn" title="Sign in with Google">
                    <svg class="google-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                    </svg>
                    <span>Sign in with Google</span>
                </button>

                <!-- Below button: Don't have an account? Create Student Account -->
                <div class="text-center pt-2 border-top border-slate-100">
                    <p class="auth-register-text mb-0">
                        Don't have an account?
                        <a asp-controller="Account" asp-action="Register" asp-route-returnurl="@ViewData["ReturnUrl"]" class="auth-vap-link ms-1">
                            Create Student Account
                        </a>
                    </p>
                </div>
            </div>

            <!-- Institutional Footer Tagline -->
            <div class="auth-portal-tagline text-center mt-4">
                <span>&copy; @DateTime.UtcNow.Year VAP UNIVERSITY &bull; Campus Event Hub</span>
            </div>
        </div>
    </div>

    <!-- Core Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth.js" asp-append-version="true"></script>
</body>
</html>
