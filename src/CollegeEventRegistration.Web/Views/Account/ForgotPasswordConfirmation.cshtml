@{
    ViewData["Title"] = "Password Recovery Dispatched";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-page-container">
    <div class="auth-card-shell" style="max-width: 500px;">
        <div class="p-4 p-md-5 text-center">
            <div class="d-inline-flex align-items-center justify-content-center mb-3" 
                 style="width: 64px; height: 64px; border-radius: 50%; background: #ECFDF5; color: #059669;">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>

            <h3 class="auth-form-title">Check Your Inbox</h3>
            <p class="auth-form-subtitle mb-4">
                @(ViewBag.Message ?? "If your email is registered in our portal, a password reset link has been dispatched.")
            </p>

            <a asp-controller="Account" asp-action="Login" class="btn btn-auth-primary">
                Return to Login
            </a>
        </div>
    </div>
</div>
