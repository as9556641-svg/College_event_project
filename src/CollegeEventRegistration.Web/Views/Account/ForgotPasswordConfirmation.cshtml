@{
    ViewData["Title"] = "Password Recovery Dispatched - VAP UNIVERSITY";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-page-container">
    <div class="auth-card text-center" style="max-width: 460px;">
        <div class="mb-3">
            <img src="~/images/branding/vap-university-logo.png" 
                 alt="VAP University Logo" 
                 style="height: 52px; width: auto; object-fit: contain; max-width: 240px;" 
                 asp-append-version="true" />
        </div>

        <div class="d-inline-flex align-items-center justify-content-center mb-3 mx-auto" 
             style="width: 60px; height: 60px; border-radius: 50%; background: #E6FFFA; color: #0BA9AC;">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
        </div>

        <h2 class="auth-card-title" style="color: #1F2C58;">Check Your Inbox</h2>
        <p class="auth-card-subtitle mb-4">
            @(ViewBag.Message ?? "If your email is registered in our portal, password recovery instructions have been dispatched.")
        </p>

        <a asp-controller="Account" asp-action="Login" class="btn-auth-vap text-decoration-none">
            Return to Sign In
        </a>
    </div>

    <div class="auth-portal-tagline text-center mt-3">
        <span>&copy; @DateTime.UtcNow.Year VAP UNIVERSITY &bull; Campus Event Hub</span>
    </div>
</div>
