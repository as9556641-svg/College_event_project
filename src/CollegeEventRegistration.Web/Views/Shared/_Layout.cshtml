<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - College Event & Workshop Registration System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CollegeEventRegistration.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom sticky-top">
            <div class="container">
                <a class="navbar-brand navbar-brand-custom d-flex align-items-center gap-2 text-decoration-none" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/branding/varp-university-logo.png" alt="VARP UNIVERSITY" style="height: 38px; width: auto; object-fit: contain;" asp-append-version="true" />
                    <div class="d-flex flex-column text-start">
                        <span class="fw-bold" style="color: #1F2C58; font-size: 1.05rem; line-height: 1.15; letter-spacing: -0.01em;">Campus Event Hub</span>
                        <span class="text-muted" style="font-size: 0.68rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;">VARP UNIVERSITY</span>
                    </div>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" 
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom active" asp-area="" asp-controller="Home" asp-action="Index">Catalog</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="Privacy">About & Support</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4 mb-5">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-custom">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>&copy; @DateTime.UtcNow.Year - VARP UNIVERSITY &bull; Campus Event Hub (.NET 10 LTS)</span>
            <div class="d-flex gap-3 align-items-center">
                <span class="text-muted small d-none d-md-inline">College Event &amp; Workshop Registration System</span>
                <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted">Privacy &amp; Policy</a>
                <span class="badge badge-role badge-role-student">Online Platform</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
