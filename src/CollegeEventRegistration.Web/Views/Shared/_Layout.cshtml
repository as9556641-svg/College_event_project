<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1F2C58" />
    <title>@ViewData["Title"] - VAP UNIVERSITY | Campus Event Hub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CollegeEventRegistration.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    bool isHomePage = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase)
                      && (string.IsNullOrEmpty(currentAction) || string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase));
}
<body class="public-site-body @(isHomePage ? "is-home-page" : "has-site-nav")">
    @if (!isHomePage)
    {
        <!-- Shared public header: the homepage renders the same navbar inside its hero -->
        <header class="site-header">
            <nav class="site-nav site-nav--solid" aria-label="Public">
                <partial name="_PublicNavbar" />
            </nav>
        </header>
    }

    <main role="main" class="public-main-content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="site-footer__inner">
            <div class="site-footer__grid">
                <div>
                    <a class="site-footer__brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="VAP UNIVERSITY Campus Event Hub, home">
                        <span class="site-brand__chip">
                            <img src="~/images/branding/vap-university-logo.png" alt="VAP UNIVERSITY" asp-append-version="true" />
                        </span>
                        <span class="site-footer__words">
                            <b>Campus Event Hub</b>
                            <span>VAP University</span>
                        </span>
                    </a>
                    <p class="site-footer__about">
                        Event registration for VAP UNIVERSITY students, faculty coordinators and academic departments.
                    </p>
                </div>

                <div>
                    <h4 class="site-footer__heading">Sections</h4>
                    <ul class="site-footer__list">
                        <li><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="categories">Categories</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="accredited-schedule">Accredited schedule</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="upcoming-events">Upcoming events</a></li>
                    </ul>
                </div>

                <div>
                    <h4 class="site-footer__heading">Portals</h4>
                    <ul class="site-footer__list">
                        <li><a asp-area="Student" asp-controller="Dashboard" asp-action="Index">Student portal</a></li>
                        <li><a asp-area="Coordinator" asp-controller="Dashboard" asp-action="Index">Coordinator workspace</a></li>
                        <li><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Administration</a></li>
                        <li><a asp-area="" asp-controller="Certificates" asp-action="Verify">Verify a certificate</a></li>
                    </ul>
                </div>

                <div>
                    <h4 class="site-footer__heading">Campus &amp; support</h4>
                    <div class="site-footer__contact">
                        <div>
                            <partial name="_Icon" model="@("map-pin")" />
                            <span>Directorate of Student Co-Curricular Affairs<br />VAP UNIVERSITY Main Campus</span>
                        </div>
                        <div>
                            <partial name="_Icon" model="@("mail")" />
                            <span>admin@college.edu</span>
                        </div>
                        <div>
                            <partial name="_Icon" model="@("clock")" />
                            <span>Mon &ndash; Fri, 9:00 AM &ndash; 5:00 PM IST</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="site-footer__base">
                <span>&copy; @DateTime.UtcNow.Year VAP UNIVERSITY &middot; Campus Event Hub</span>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Data privacy</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
