@using Microsoft.AspNetCore.Identity
@using CollegeEventRegistration.Core.Entities
@using CollegeEventRegistration.Core.Enums
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var roles = currentUser != null ? await UserManager.GetRolesAsync(currentUser) : new List<string>();
    var primaryRole = roles.FirstOrDefault() ?? nameof(UserRole.Student);

    <div class="nav-user">
        <button class="nav-user__trigger" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                title="@(currentUser?.FullName ?? User.Identity?.Name)"
                aria-label="Account menu for @(currentUser?.FullName ?? User.Identity?.Name)">
            <span class="nav-user__avatar" aria-hidden="true">@(currentUser?.FirstName?.FirstOrDefault() ?? 'U')</span>
            <span class="nav-user__name">@(currentUser?.FullName ?? User.Identity?.Name)</span>
            <span class="nav-user__role">@primaryRole</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li class="nav-user__summary">
                <span class="nav-user__summary-name">@(currentUser?.FullName ?? "User")</span>
                <span class="nav-user__summary-mail">@currentUser?.Email</span>
            </li>
            @if (User.IsInRole(nameof(UserRole.SuperAdmin)))
            {
                <li><a class="dropdown-item" asp-area="SuperAdmin" asp-controller="Dashboard" asp-action="Index">System governance</a></li>
            }
            else if (User.IsInRole(nameof(UserRole.Admin)))
            {
                <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Administration</a></li>
            }
            else if (User.IsInRole(nameof(UserRole.Coordinator)))
            {
                <li><a class="dropdown-item" asp-area="Coordinator" asp-controller="Dashboard" asp-action="Index">Coordinator workspace</a></li>
            }
            else
            {
                <li><a class="dropdown-item" asp-area="Student" asp-controller="Dashboard" asp-action="Index">Student portal</a></li>
                <li><a class="dropdown-item" asp-area="Student" asp-controller="Events" asp-action="Index">Catalogue</a></li>
            }
            <li><hr class="dropdown-divider" /></li>
            <li>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="dropdown-item nav-user__signout">Sign out</button>
                </form>
            </li>
        </ul>
    </div>
}
else
{
    <a class="nav-btn nav-btn--ghost" asp-area="" asp-controller="Account" asp-action="Login">Sign in</a>
    <a class="nav-btn nav-btn--solid" asp-area="" asp-controller="Account" asp-action="Register">Create account</a>
}
