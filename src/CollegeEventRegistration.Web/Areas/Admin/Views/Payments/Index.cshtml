@model CollegeEventRegistration.Core.DTOs.PagedResult<CollegeEventRegistration.Core.DTOs.PaymentSummaryDto>
@using CollegeEventRegistration.Core.Enums
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Institutional Payments";
    var criteria = (CollegeEventRegistration.Core.DTOs.PaymentFilterCriteria)(ViewBag.Criteria ?? new CollegeEventRegistration.Core.DTOs.PaymentFilterCriteria());
    var eventsList = (List<SelectListItem>)(ViewBag.EventsList ?? new List<SelectListItem>());
    var deptsList = (List<SelectListItem>)(ViewBag.DepartmentsList ?? new List<SelectListItem>());
}

<div class="dash-page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge badge-role badge-role-admin">University Governance</span>
            <span class="text-muted small">Financial Ledger</span>
        </div>
        <h2 class="dash-page-title">Institutional Payments &amp; Revenue Ledger</h2>
    </div>
</div>

<!-- Search & Filtering Toolbar -->
<div class="dash-panel mb-4 p-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small fw-semibold text-muted">Search</label>
            <input type="text" name="SearchTerm" class="form-control" placeholder="Student name, order ID, txn ID..." value="@criteria.SearchTerm" />
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold text-muted">Event</label>
            <select name="EventId" class="form-select">
                <option value="">All Events</option>
                @foreach (var ev in eventsList)
                {
                    <option value="@ev.Value" selected="@ev.Selected">@ev.Text</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold text-muted">Department</label>
            <select name="DepartmentId" class="form-select">
                <option value="">All Departments</option>
                @foreach (var dept in deptsList)
                {
                    <option value="@dept.Value" selected="@dept.Selected">@dept.Text</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold text-muted">Status</label>
            <select name="Status" class="form-select">
                <option value="">All Statuses</option>
                <option value="@PaymentStatus.Success" selected="@(criteria.Status == PaymentStatus.Success)">Success</option>
                <option value="@PaymentStatus.Pending" selected="@(criteria.Status == PaymentStatus.Pending)">Pending</option>
                <option value="@PaymentStatus.Failed" selected="@(criteria.Status == PaymentStatus.Failed)">Failed</option>
                <option value="@PaymentStatus.Refunded" selected="@(criteria.Status == PaymentStatus.Refunded)">Refunded</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">Apply</button>
            @if (criteria.EventId.HasValue || criteria.Status.HasValue || criteria.DepartmentId.HasValue || !string.IsNullOrWhiteSpace(criteria.SearchTerm))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            }
        </div>
    </form>
</div>

<!-- Payments Master Table -->
<div class="dash-panel">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Transaction / Order</th>
                    <th>Event</th>
                    <th>Participant</th>
                    <th>Amount</th>
                    <th>Channel</th>
                    <th>Status</th>
                    <th class="text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count > 0)
                {
                    @foreach (var p in Model.Items)
                    {
                        <tr>
                            <td class="ps-3">
                                <span class="font-monospace fw-semibold text-primary">@(p.TransactionId ?? p.OrderId ?? "N/A")</span>
                                <div class="small text-muted font-monospace">Reg: @p.RegistrationNumber</div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark text-truncate" style="max-width: 180px;">@p.EventTitle</div>
                                <span class="badge bg-light text-dark border small">@p.EventDepartmentCode</span>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@p.StudentName</div>
                                <div class="small text-muted">@p.StudentEmail</div>
                            </td>
                            <td>
                                <span class="fw-bold text-dark">&#8377;@p.Amount.ToString("F2")</span>
                            </td>
                            <td class="small text-muted">
                                @(p.PaymentMethod ?? "Razorpay Gateway")
                            </td>
                            <td>
                                @switch (p.Status)
                                {
                                    case PaymentStatus.Success:
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Success</span>
                                        break;
                                    case PaymentStatus.Pending:
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Pending</span>
                                        break;
                                    case PaymentStatus.Failed:
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Failed</span>
                                        break;
                                    case PaymentStatus.Refunded:
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">Refunded</span>
                                        break;
                                }
                            </td>
                            <td class="text-end pe-3">
                                <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-outline-primary btn-sm">
                                    Details
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            No payment transactions found matching your criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3 border-top">
            <span class="text-muted small">Showing @Model.Items.Count of @Model.TotalCount payments</span>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-route-PageNumber="@(Model.PageNumber - 1)" asp-route-EventId="@criteria.EventId" asp-route-DepartmentId="@criteria.DepartmentId" asp-route-Status="@criteria.Status" asp-route-SearchTerm="@criteria.SearchTerm">&laquo;</a>
                    </li>
                    @for (int pg = 1; pg <= Model.TotalPages; pg++)
                    {
                        <li class="page-item @(pg == Model.PageNumber ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-PageNumber="@pg" asp-route-EventId="@criteria.EventId" asp-route-DepartmentId="@criteria.DepartmentId" asp-route-Status="@criteria.Status" asp-route-SearchTerm="@criteria.SearchTerm">@pg</a>
                        </li>
                    }
                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-route-PageNumber="@(Model.PageNumber + 1)" asp-route-EventId="@criteria.EventId" asp-route-DepartmentId="@criteria.DepartmentId" asp-route-Status="@criteria.Status" asp-route-SearchTerm="@criteria.SearchTerm">&raquo;</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
