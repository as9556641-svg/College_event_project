@model CollegeEventRegistration.Core.DTOs.PaymentSummaryDto
@using CollegeEventRegistration.Core.Enums
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = $"Payment Details - {Model.TransactionId ?? Model.OrderId}";
}

<div class="dash-page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <a asp-action="Index" class="text-decoration-none text-muted small">&larr; Back to Payments Ledger</a>
        </div>
        <h2 class="dash-page-title">Transaction: @(Model.TransactionId ?? Model.OrderId)</h2>
    </div>
    <div>
        @switch (Model.Status)
        {
            case PaymentStatus.Success:
                <span class="badge bg-success-subtle text-success border border-success-subtle fs-6 px-3 py-2">Success</span>
                break;
            case PaymentStatus.Pending:
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle fs-6 px-3 py-2">Pending</span>
                break;
            case PaymentStatus.Failed:
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle fs-6 px-3 py-2">Failed</span>
                break;
            case PaymentStatus.Refunded:
                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle fs-6 px-3 py-2">Refunded</span>
                break;
        }
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Transaction Details (8 Cols) -->
    <div class="col-lg-8">
        <div class="dash-panel mb-4">
            <h5 class="dash-panel-title mb-3">Transaction Metadata</h5>
            <div class="row g-3 small">
                <div class="col-sm-6">
                    <span class="text-muted d-block">Transaction ID:</span>
                    <strong class="text-dark font-monospace">@(Model.TransactionId ?? "Pending Confirmation")</strong>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted d-block">Gateway Order ID:</span>
                    <strong class="text-dark font-monospace">@Model.OrderId</strong>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted d-block">Gross Amount:</span>
                    <strong class="text-success fs-5">&#8377;@Model.Amount.ToString("F2") @Model.Currency</strong>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted d-block">Payment Method:</span>
                    <strong class="text-dark">@(Model.PaymentMethod ?? "Razorpay Gateway")</strong>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted d-block">Initiated At:</span>
                    <strong class="text-dark">@Model.InitiatedAt.ToString("dd MMM yyyy, hh:mm:ss") UTC</strong>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted d-block">Completed At:</span>
                    <strong class="text-dark">@(Model.CompletedAt?.ToString("dd MMM yyyy, hh:mm:ss") ?? "N/A") UTC</strong>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.FailureReason))
                {
                    <div class="col-sm-12">
                        <span class="text-muted d-block">Failure / Abort Reason:</span>
                        <strong class="text-danger">@Model.FailureReason</strong>
                    </div>
                }
            </div>
        </div>

        <div class="dash-panel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="dash-panel-title mb-0">Event Reference</h5>
                <a asp-area="Admin" asp-controller="Registrations" asp-action="Details" asp-route-id="@Model.RegistrationId" class="btn btn-sm btn-outline-primary">
                    View Registration Pass &rarr;
                </a>
            </div>
            <h4 class="fw-bold text-dark mb-1">@Model.EventTitle</h4>
            <div class="small text-muted mb-2">Registration Number: <strong class="font-monospace text-dark">@Model.RegistrationNumber</strong></div>
        </div>
    </div>

    <!-- Right Column: Student Profile (4 Cols) -->
    <div class="col-lg-4">
        <div class="dash-panel">
            <h5 class="dash-panel-title mb-3">Payer Information</h5>
            <div class="d-flex align-items-center gap-3 mb-3 pb-3 border-bottom">
                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold fs-5" style="width: 48px; height: 48px;">
                    @(!string.IsNullOrEmpty(Model.StudentName) ? Model.StudentName.Substring(0, 1).ToUpper() : "S")
                </div>
                <div>
                    <div class="fw-bold text-dark">@Model.StudentName</div>
                    <div class="small text-muted">@Model.StudentEmail</div>
                </div>
            </div>

            <div class="d-flex flex-column gap-2 small">
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Roll Number:</span>
                    <strong class="text-dark">@(Model.StudentRollNumber ?? "N/A")</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Department:</span>
                    <strong class="text-dark">@(Model.StudentDepartment ?? "N/A")</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Institution:</span>
                    <strong class="text-dark">@(Model.StudentCollegeName ?? "VAP UNIVERSITY")</strong>
                </div>
            </div>
        </div>
    </div>
</div>
