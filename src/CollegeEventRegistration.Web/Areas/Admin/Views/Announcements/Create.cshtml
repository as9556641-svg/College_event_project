@model CollegeEventRegistration.Core.DTOs.CreateAnnouncementDto
@using CollegeEventRegistration.Core.Enums

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Create Campus Announcement";
    var departments = ViewBag.Departments as dynamic;
    var events = ViewBag.Events as dynamic;
}

<div class="dash-page-header mb-4">
    <div class="d-flex align-items-center gap-2 mb-1">
        <span class="badge badge-role badge-role-admin">Administrator</span>
        <span class="text-muted small">Campus Communications</span>
    </div>
    <h2 class="dash-page-title">Create Announcement</h2>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control" placeholder="Announcement headline" required maxlength="200" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="AudienceType" class="form-label fw-semibold">Target Audience <span class="text-danger">*</span></label>
                            <select asp-for="AudienceType" id="audienceSelect" asp-items="Html.GetEnumSelectList<AnnouncementAudience>()" class="form-select" onchange="toggleAudienceFields()"></select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Priority" class="form-label fw-semibold">Priority Level</label>
                            <select asp-for="Priority" asp-items="Html.GetEnumSelectList<AnnouncementPriority>()" class="form-select"></select>
                        </div>
                    </div>

                    <div class="mb-3" id="departmentField" style="display:none;">
                        <label asp-for="DepartmentId" class="form-label fw-semibold">Target Department</label>
                        <select asp-for="DepartmentId" class="form-select">
                            <option value="">-- Select Department --</option>
                            @if (departments != null)
                            {
                                foreach (var d in departments)
                                {
                                    <option value="@d.Id">@d.Name (@d.Code)</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3" id="roleField" style="display:none;">
                        <label asp-for="TargetRole" class="form-label fw-semibold">Target Role</label>
                        <select asp-for="TargetRole" class="form-select">
                            <option value="">-- Select Role --</option>
                            <option value="Student">Students Only</option>
                            <option value="Coordinator">Coordinators Only</option>
                            <option value="Admin">Administrators Only</option>
                        </select>
                    </div>

                    <div class="mb-3" id="eventField" style="display:none;">
                        <label asp-for="EventId" class="form-label fw-semibold">Target Event Participants</label>
                        <select asp-for="EventId" class="form-select">
                            <option value="">-- Select Event --</option>
                            @if (events != null)
                            {
                                foreach (var ev in events)
                                {
                                    <option value="@ev.Id">@ev.Title</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ExpiresAt" class="form-label fw-semibold">Expiration Date (Optional)</label>
                        <input asp-for="ExpiresAt" type="datetime-local" class="form-control" />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Content" class="form-label fw-semibold">Content <span class="text-danger">*</span></label>
                        <textarea asp-for="Content" class="form-control" rows="6" placeholder="Announcement details..." required maxlength="4000"></textarea>
                        <span asp-validation-for="Content" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="PublishImmediately" class="form-check-input" type="checkbox" id="publishCheck" />
                        <label class="form-check-label fw-medium text-dark" for="publishCheck">
                            Publish immediately and broadcast notifications to target audience
                        </label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-send me-1"></i> Create Announcement
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleAudienceFields() {
            var val = document.getElementById("audienceSelect").value;
            // AnnouncementAudience: All = 1, Department = 2, Role = 3, EventParticipants = 4
            document.getElementById("departmentField").style.display = (val === "2" || val === "Department") ? "block" : "none";
            document.getElementById("roleField").style.display = (val === "3" || val === "Role") ? "block" : "none";
            document.getElementById("eventField").style.display = (val === "4" || val === "EventParticipants") ? "block" : "none";
        }
        document.addEventListener("DOMContentLoaded", toggleAudienceFields);
    </script>
}
