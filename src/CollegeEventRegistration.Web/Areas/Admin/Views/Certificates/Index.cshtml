@model List<CollegeEventRegistration.Core.DTOs.CertificateDetailDto>
@using CollegeEventRegistration.Core.DTOs
@using CollegeEventRegistration.Core.Enums

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Certificates Ledger";
    var departments = ViewBag.Departments as dynamic;
    var events = ViewBag.Events as dynamic;
    var criteria = (CertificateFilterCriteria)(ViewBag.Criteria ?? new CertificateFilterCriteria());
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
}

<div class="dash-page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge badge-role badge-role-admin">Administration</span>
            <span class="text-muted small">Campus-Wide Credential Management</span>
        </div>
        <h2 class="dash-page-title">Certificates Ledger</h2>
    </div>
    <div class="d-flex gap-2">
        @if (criteria.EventId.HasValue && criteria.EventId.Value > 0)
        {
            <a asp-action="Template" asp-route-eventId="@criteria.EventId.Value" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
                <i class="bi bi-gear"></i> Configure Template
            </a>
            <form asp-action="BatchIssue" asp-route-eventId="@criteria.EventId.Value" method="post" class="d-inline" onsubmit="return confirm('Generate certificates for all eligible checked-in attendees of this event?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success d-inline-flex align-items-center gap-2">
                    <i class="bi bi-award-fill"></i> Batch Issue Certificates
                </button>
            </form>
        }
    </div>
</div>

<!-- Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["WarningMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <i class="bi bi-x-circle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Filters Card -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <select name="DepartmentId" class="form-select" onchange="this.form.submit()">
                    <option value="">-- All Departments --</option>
                    @if (departments != null)
                    {
                        foreach (var dept in departments)
                        {
                            <option value="@dept.Id" selected="@(criteria.DepartmentId == dept.Id)">@dept.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="EventId" class="form-select" onchange="this.form.submit()">
                    <option value="">-- All Events --</option>
                    @if (events != null)
                    {
                        foreach (var ev in events)
                        {
                            <option value="@ev.Id" selected="@(criteria.EventId == ev.Id)">@ev.Title</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="Status" class="form-select" onchange="this.form.submit()">
                    <option value="">-- All Statuses --</option>
                    <option value="@((int)CertificateStatus.Active)" selected="@(criteria.Status == CertificateStatus.Active)">Active</option>
                    <option value="@((int)CertificateStatus.Revoked)" selected="@(criteria.Status == CertificateStatus.Revoked)">Revoked</option>
                </select>
            </div>
            <div class="col-md-3">
                <input type="text" name="SearchTerm" value="@criteria.SearchTerm" class="form-control" placeholder="Search student, code..." />
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search"></i></button>
            </div>
        </form>
    </div>
</div>

<!-- Ledger Table -->
@if (Model == null || !Model.Any())
{
    <div class="card shadow-sm border-0 text-center py-5">
        <div class="card-body">
            <div class="d-inline-flex align-items-center justify-content-center bg-light text-muted rounded-circle p-3 mb-3" style="width: 64px; height: 64px;">
                <i class="bi bi-award fs-1"></i>
            </div>
            <h5 class="fw-bold text-dark">No Certificates Found</h5>
            <p class="text-muted">No certificates match the selected filters.</p>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm border-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Certificate No</th>
                        <th>Student Name</th>
                        <th>Roll No</th>
                        <th>Department</th>
                        <th>Event</th>
                        <th>Issue Date</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cert in Model)
                    {
                        <tr>
                            <td class="ps-4 font-monospace fw-bold text-primary">@cert.CertificateNumber</td>
                            <td class="fw-semibold text-dark">@cert.StudentFullName</td>
                            <td class="text-muted font-monospace">@(cert.StudentRollNumber ?? "N/A")</td>
                            <td>@cert.EventDepartmentName</td>
                            <td>@cert.EventTitle</td>
                            <td>@cert.IssuedAt.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (cert.Status == CertificateStatus.Active)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger">Revoked</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@cert.Id" class="btn btn-outline-secondary" title="View Details">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                    <a asp-action="Download" asp-route-id="@cert.Id" class="btn btn-outline-primary" title="Download PDF">
                                        <i class="bi bi-download"></i> PDF
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
