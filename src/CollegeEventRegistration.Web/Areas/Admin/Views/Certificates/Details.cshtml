@model CollegeEventRegistration.Core.DTOs.CertificateDetailDto
@using CollegeEventRegistration.Core.Enums

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = $"Certificate - {Model.CertificateNumber}";
}

<div class="dash-page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index">Certificates</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.CertificateNumber</li>
            </ol>
        </nav>
        <h2 class="dash-page-title">Certificate Record</h2>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Ledger
        </a>
        <a asp-action="Download" asp-route-id="@Model.Id" class="btn btn-primary d-inline-flex align-items-center gap-2">
            <i class="bi bi-download"></i> Download PDF
        </a>
    </div>
</div>

<!-- Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <i class="bi bi-x-circle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold text-dark mb-0">Certificate Information</h5>
                <span class="badge @(Model.Status == CertificateStatus.Active ? "bg-success" : "bg-danger") px-3 py-2">
                    @Model.Status
                </span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="text-muted small">Certificate Number</div>
                        <div class="fw-bold font-monospace fs-6 text-primary">@Model.CertificateNumber</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Verification Token</div>
                        <div class="font-monospace small text-dark">@Model.VerificationToken</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Recipient Student</div>
                        <div class="fw-bold text-dark fs-5">@Model.StudentFullName</div>
                        <div class="text-muted small">Roll: @(Model.StudentRollNumber ?? "N/A") &bull; @Model.StudentDepartment</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Event Name</div>
                        <div class="fw-bold text-dark fs-5">@Model.EventTitle</div>
                        <div class="text-muted small">Dept: @Model.EventDepartmentName &bull; @Model.EventCategoryName</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Registration Number</div>
                        <div class="font-monospace text-dark">@Model.RegistrationNumber</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Issue Date</div>
                        <div class="text-dark">@Model.IssuedAt.ToString("dd MMMM yyyy, hh:mm tt") UTC</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Authorized Signatory</div>
                        <div class="fw-semibold text-dark">@Model.SignatoryName (@Model.SignatoryTitle)</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Issued By</div>
                        <div class="text-dark">@(Model.IssuedByUserName ?? "Automated System")</div>
                    </div>
                    @if (Model.Status == CertificateStatus.Revoked)
                    {
                        <div class="col-12">
                            <div class="alert alert-danger mb-0">
                                <div class="fw-bold"><i class="bi bi-exclamation-triangle-fill me-1"></i> Revocation Notice</div>
                                <div>Reason: @Model.RevocationReason</div>
                                <div class="small mt-1">Revoked on: @Model.RevokedAt?.ToString("dd MMM yyyy HH:mm") UTC by @(Model.RevokedByUserName ?? "Administrator")</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (Model.Status == CertificateStatus.Active)
        {
            <!-- Revocation Action Card -->
            <div class="card shadow-sm border-danger border-opacity-50">
                <div class="card-header bg-danger bg-opacity-10 py-3">
                    <h6 class="fw-bold text-danger mb-0"><i class="bi bi-shield-x me-2"></i>Revoke Certificate</h6>
                </div>
                <div class="card-body">
                    <p class="text-muted small">
                        Revoking this certificate immediately invalidates its digital authenticity on the public verification portal.
                        A non-empty revocation reason is required and will be logged in the immutable audit trail.
                    </p>
                    <form asp-action="Revoke" method="post" onsubmit="return confirm('Are you sure you want to officially REVOKE this certificate? This action will invalidate all copies.');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="certificateId" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Reason for Revocation <span class="text-danger">*</span></label>
                            <input type="text" name="revocationReason" class="form-control" placeholder="e.g. Disciplinary action, attendance fraud, or administrative recall" required />
                        </div>
                        <button type="submit" class="btn btn-danger fw-semibold">
                            <i class="bi bi-x-octagon me-1"></i> Confirm Revocation
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-shield-check text-success me-2"></i>Public Verification</h6>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">
                    Verify this credential on the public verification portal:
                </p>
                <div class="d-grid gap-2">
                    <a asp-controller="Certificates" asp-action="Verify" asp-route-id="@Model.VerificationToken" asp-area="" target="_blank" class="btn btn-outline-primary">
                        <i class="bi bi-box-arrow-up-right me-1"></i> Public Portal Verification
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
