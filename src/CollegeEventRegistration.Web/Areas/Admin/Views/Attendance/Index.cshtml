@model CollegeEventRegistration.Core.DTOs.PagedResult<CollegeEventRegistration.Core.DTOs.AttendanceRecordDto>
@using CollegeEventRegistration.Core.DTOs
@using CollegeEventRegistration.Core.Enums
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Campus Attendance Ledger";
    var filter = ViewBag.FilterCriteria as AttendanceFilterCriteria ?? new AttendanceFilterCriteria();
    var events = ViewBag.Events as List<SelectListItem> ?? new List<SelectListItem>();
    var departments = ViewBag.Departments as List<SelectListItem> ?? new List<SelectListItem>();
}

<div class="dash-page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge badge-role badge-role-admin">University Governance</span>
            <span class="text-muted small">Campus Event Hub</span>
        </div>
        <h2 class="dash-page-title">Campus Attendance Ledger</h2>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <span>@TempData["ErrorMessage"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Campus Overview Metrics -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-4">
        <div class="dash-stat-card border-start border-4 border-success">
            <div class="text-muted small fw-semibold text-uppercase">Total Campus Attendances</div>
            <div class="fs-3 fw-bold text-success mt-1">@ViewBag.TotalAttendances</div>
            <div class="text-muted small mt-1">Verified check-in entries across all events</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="dash-stat-card">
            <div class="text-muted small fw-semibold text-uppercase">Total Confirmed Registrations</div>
            <div class="fs-3 fw-bold text-dark mt-1">@ViewBag.TotalRegistrations</div>
            <div class="text-muted small mt-1">Active registered campus attendees</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="dash-stat-card border-start border-4 border-primary">
            <div class="text-muted small fw-semibold text-uppercase">Overall Admission Rate</div>
            <div class="fs-3 fw-bold text-primary mt-1">@ViewBag.OverallRate%</div>
            <div class="text-muted small mt-1">University-wide check-in ratio</div>
        </div>
    </div>
</div>

<!-- Filters Bar -->
<div class="dash-panel mb-4 p-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small fw-semibold text-muted">Search</label>
            <input type="text" name="SearchTerm" class="form-control" placeholder="Student, roll #, reg #, ticket..." value="@filter.SearchTerm" />
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold text-muted">Event</label>
            <select name="EventId" class="form-select">
                <option value="">All Events</option>
                @foreach (var ev in events)
                {
                    <option value="@ev.Value" selected="@ev.Selected">@ev.Text</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold text-muted">Department</label>
            <select name="DepartmentId" class="form-select">
                <option value="">All Departments</option>
                @foreach (var dept in departments)
                {
                    <option value="@dept.Value" selected="@dept.Selected">@dept.Text</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold text-muted">Check-In Method</label>
            <select name="CheckInMethod" class="form-select">
                <option value="">All Methods</option>
                <option value="1" selected="@(filter.CheckInMethod == CheckInMethod.QrCode)">QR Code Scan</option>
                <option value="2" selected="@(filter.CheckInMethod == CheckInMethod.Manual)">Manual Entry</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </form>
</div>

<!-- Attendance Master Table -->
<div class="dash-panel">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0">Attendance Audit Trail</h5>
        <span class="badge bg-light text-dark border">@Model.TotalCount Total Records</span>
    </div>

    @if (Model == null || !Model.Items.Any())
    {
        <div class="text-center py-5">
            <div class="text-muted mb-2">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
            </div>
            <h6 class="fw-bold mb-1">No Attendance Records Found</h6>
            <p class="text-muted small">No verified check-in records match the current filter criteria.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Student Attendee</th>
                        <th>Roll Number</th>
                        <th>Event</th>
                        <th>Registration #</th>
                        <th>Ticket Code</th>
                        <th>Check-In Time</th>
                        <th>Method</th>
                        <th>Verified By</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold text-dark">@record.StudentName</div>
                                <div class="text-muted small">@record.StudentEmail</div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(record.StudentRollNumber))
                                {
                                    <span class="font-monospace fw-bold small text-secondary">@record.StudentRollNumber</span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold small text-truncate" style="max-width: 180px;" title="@record.EventTitle">
                                    @record.EventTitle
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border font-monospace">@record.RegistrationNumber</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(record.TicketCode))
                                {
                                    <span class="font-monospace small text-primary fw-semibold">@record.TicketCode</span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold small">@record.CheckedInAt.ToString("dd MMM yyyy")</div>
                                <div class="text-muted small">@record.CheckedInAt.ToString("HH:mm:ss") UTC</div>
                            </td>
                            <td>
                                @if (record.CheckInMethod == CheckInMethod.QrCode)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        QR Scan
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-info-subtle text-info border border-info-subtle">
                                        Manual
                                    </span>
                                }
                            </td>
                            <td>
                                <span class="small fw-semibold text-secondary">@record.CheckedInByName</span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@record.Id" class="btn btn-outline-secondary btn-sm" title="Inspect Record">
                                    Audit
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                <span class="text-muted small">Page @Model.PageNumber of @Model.TotalPages</span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageNumber="@(Model.PageNumber - 1)"
                               asp-route-EventId="@filter.EventId"
                               asp-route-DepartmentId="@filter.DepartmentId"
                               asp-route-CheckInMethod="@filter.CheckInMethod"
                               asp-route-SearchTerm="@filter.SearchTerm">Previous</a>
                        </li>
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageNumber="@(Model.PageNumber + 1)"
                               asp-route-EventId="@filter.EventId"
                               asp-route-DepartmentId="@filter.DepartmentId"
                               asp-route-CheckInMethod="@filter.CheckInMethod"
                               asp-route-SearchTerm="@filter.SearchTerm">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    }
</div>
