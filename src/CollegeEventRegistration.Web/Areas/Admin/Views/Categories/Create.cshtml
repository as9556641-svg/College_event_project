@model CollegeEventRegistration.Web.Areas.Admin.Models.CategoryCreateViewModel
@{
    ViewData["Title"] = "Add Event Category";
    Layout = "_DashboardLayout";
}

<div class="container-fluid px-0" style="max-width: 760px;">
    <!-- Breadcrumb & Header -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2 small">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">Administration</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Categories</a></li>
            <li class="breadcrumb-item active" aria-current="page">New Category</li>
        </ol>
    </nav>
    <div class="mb-4">
        <h1 class="h3 fw-bold text-dark mb-1">Create Event Category</h1>
        <p class="text-muted small">Define a new category taxonomy for events, workshops, hackathons, and symposiums.</p>
    </div>

    <!-- Form Card -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small mb-4" role="alert"></div>

                <div class="row g-3">
                    <!-- Category Name -->
                    <div class="col-12">
                        <label asp-for="Name" class="form-label fw-semibold text-dark small"></label>
                        <input asp-for="Name" class="form-control rounded-3 py-2" placeholder="e.g. Technical Symposium, Cultural Fest, Robotics" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                        <div class="form-text small">A clean, unique URL slug will be automatically generated from this name.</div>
                    </div>

                    <!-- Icon Class -->
                    <div class="col-12">
                        <label asp-for="IconClass" class="form-label fw-semibold text-dark small"></label>
                        <input asp-for="IconClass" class="form-control rounded-3 py-2 font-monospace" placeholder="e.g. bi-cpu, bi-code-square, bi-trophy, bi-palette" />
                        <span asp-validation-for="IconClass" class="text-danger small"></span>
                        <div class="form-text small">Bootstrap Icons class name (e.g. <code>bi-laptop</code>, <code>bi-rocket-takeoff</code>).</div>
                    </div>

                    <!-- Description -->
                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold text-dark small"></label>
                        <textarea asp-for="Description" class="form-control rounded-3" rows="3" placeholder="Explain what kind of events belong in this category..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 rounded-pill shadow-sm">Save Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

