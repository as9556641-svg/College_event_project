@model CollegeEventRegistration.Web.Areas.Admin.Models.CategoryEditViewModel
@{
    ViewData["Title"] = "Edit Category";
    Layout = "_DashboardLayout";
}

<div class="container-fluid px-0" style="max-width: 760px;">
    <!-- Breadcrumb & Header -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2 small">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">Administration</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Categories</a></li>
            <li class="breadcrumb-item active" aria-current="page">Edit Category</li>
        </ol>
    </nav>
    <div class="mb-4">
        <h1 class="h3 fw-bold text-dark mb-1">Edit Event Category</h1>
        <p class="text-muted small">Update taxonomy, display icon, or status for @Model.Name.</p>
    </div>

    <!-- Form Card -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small mb-4" role="alert"></div>

                <div class="row g-3">
                    <!-- Category Name -->
                    <div class="col-12">
                        <label asp-for="Name" class="form-label fw-semibold text-dark small"></label>
                        <input asp-for="Name" class="form-control rounded-3 py-2" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <!-- Slug (Readonly) -->
                    <div class="col-12">
                        <label asp-for="Slug" class="form-label fw-semibold text-dark small"></label>
                        <input asp-for="Slug" class="form-control rounded-3 py-2 font-monospace bg-light" readonly />
                        <div class="form-text small">Slug will automatically update if the name is modified.</div>
                    </div>

                    <!-- Icon Class -->
                    <div class="col-12">
                        <label asp-for="IconClass" class="form-label fw-semibold text-dark small"></label>
                        <input asp-for="IconClass" class="form-control rounded-3 py-2 font-monospace" placeholder="e.g. bi-cpu, bi-code-square" />
                        <span asp-validation-for="IconClass" class="text-danger small"></span>
                    </div>

                    <!-- Description -->
                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold text-dark small"></label>
                        <textarea asp-for="Description" class="form-control rounded-3" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <!-- Active Switch -->
                    <div class="col-12 pt-2">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" asp-for="IsActive" id="isActiveSwitch">
                            <label class="form-check-label fw-semibold text-dark small" for="isActiveSwitch">Category is Active and Available for New Events</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 rounded-pill shadow-sm">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

