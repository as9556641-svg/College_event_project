@model CollegeEventRegistration.Web.Areas.Admin.Models.UserCreateViewModel
@{
    ViewData["Title"] = "Add Coordinator or Student";
    Layout = "_DashboardLayout";
    var area = "Admin";
}

<div class="container-fluid px-0">
    <!-- Header Block -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-area="@area" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-area="@area" asp-controller="Users" asp-action="Index" class="text-decoration-none">Staff &amp; Students</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Add Account</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold text-dark mb-0">Add Coordinator or Student</h1>
            <p class="text-muted small mb-0">Provision an event coordinator or student account for campus activities.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary px-3 py-2 rounded-pill shadow-sm">
                Cancel &amp; Return
            </a>
        </div>
    </div>

    <!-- Form Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-white border-0 py-3 px-4">
            <h5 class="fw-bold text-dark mb-0">Account Details</h5>
        </div>
        <div class="card-body p-4 pt-0">
            <form asp-action="Create" method="post" class="needs-validation">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4"></div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label fw-semibold small text-muted"></label>
                        <input asp-for="FirstName" class="form-control bg-light border-0 py-2" placeholder="e.g. Rahul" required />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label fw-semibold small text-muted"></label>
                        <input asp-for="LastName" class="form-control bg-light border-0 py-2" placeholder="e.g. Sharma" required />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold small text-muted"></label>
                        <input asp-for="Email" type="email" class="form-control bg-light border-0 py-2" placeholder="name@college.edu" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Role" class="form-label fw-semibold small text-muted"></label>
                        <select asp-for="Role" class="form-select bg-light border-0 py-2" required>
                            <option value="">-- Select Role (Coordinator or Student) --</option>
                            @foreach (var r in Model.AvailableRoles)
                            {
                                <option value="@r.Value">@r.Text</option>
                            }
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label fw-semibold small text-muted"></label>
                        <input asp-for="Password" type="password" class="form-control bg-light border-0 py-2" placeholder="At least 8 characters" required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold small text-muted"></label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control bg-light border-0 py-2" placeholder="Confirm password" required />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4" />
                <h6 class="fw-bold text-dark mb-3">Department &amp; Student Identifiers</h6>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Department" class="form-label fw-semibold small text-muted"></label>
                        <select asp-for="Department" class="form-select bg-light border-0 py-2">
                            <option value="">-- Select Academic Department --</option>
                            @foreach (var d in Model.AvailableDepartments)
                            {
                                <option value="@d.Value">@d.Text</option>
                            }
                        </select>
                        <span asp-validation-for="Department" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CollegeName" class="form-label fw-semibold small text-muted"></label>
                        <input asp-for="CollegeName" class="form-control bg-light border-0 py-2" value="VAP UNIVERSITY" />
                        <span asp-validation-for="CollegeName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="RollNumber" class="form-label fw-semibold small text-muted"></label>
                        <input asp-for="RollNumber" class="form-control bg-light border-0 py-2" placeholder="Roll Number or Staff ID" />
                        <span asp-validation-for="RollNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="YearOfStudy" class="form-label fw-semibold small text-muted"></label>
                        <select asp-for="YearOfStudy" class="form-select bg-light border-0 py-2">
                            <option value="">N/A (Staff)</option>
                            <option value="1">Year 1</option>
                            <option value="2">Year 2</option>
                            <option value="3">Year 3</option>
                            <option value="4">Year 4</option>
                        </select>
                        <span asp-validation-for="YearOfStudy" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold small text-muted"></label>
                        <input asp-for="PhoneNumber" class="form-control bg-light border-0 py-2" placeholder="e.g. +91 9876543210" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light px-4 py-2 rounded-pill">Cancel</a>
                    <button type="submit" class="btn btn-primary px-5 py-2 rounded-pill shadow-sm">Create Account</button>
                </div>
            </form>
        </div>
    </div>
</div>
