@model CollegeEventRegistration.Web.Areas.Admin.Models.UserListViewModel
@{
    ViewData["Title"] = "Coordinator & Student Management";
    Layout = "_DashboardLayout";
    var area = "Admin";
}

<div class="container-fluid px-0">
    <!-- Header Block -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-area="@area" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Staff &amp; Students</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold text-dark mb-0">Coordinator &amp; Student Management</h1>
            <p class="text-muted small mb-0">Oversee campus event coordinators, student accounts, and operational departmental roles.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 py-2 shadow-sm rounded-pill">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>Add Coordinator / Student</span>
            </a>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center gap-2 mb-4" role="alert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success flex-shrink-0">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center gap-2 mb-4" role="alert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-danger flex-shrink-0">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="15" y1="9" x2="9" y2="15"></line>
                <line x1="9" y1="9" x2="15" y2="15"></line>
            </svg>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search & Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0 ps-3">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                        </span>
                        <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control bg-light border-0 py-2" placeholder="Search by name, email, roll number..." />
                    </div>
                </div>

                <div class="col-md-3">
                    <select name="role" class="form-select bg-light border-0 py-2">
                        <option value="">All Permitted Roles</option>
                        @foreach (var r in Model.RolesList)
                        {
                            <option value="@r.Value" selected="@r.Selected">@r.Text</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <select name="status" class="form-select bg-light border-0 py-2">
                        <option value="all" selected="@(Model.Status == "all")">All Status</option>
                        <option value="active" selected="@(Model.Status == "active")">Active</option>
                        <option value="inactive" selected="@(Model.Status == "inactive")">Inactive</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-3 py-2 rounded-pill flex-grow-1">Filter</button>
                    @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.Role) || Model.Status != "all")
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary px-3 py-2 rounded-pill">Reset</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Users Table Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-dark mb-0">Managed Accounts (@Model.TotalCount)</h5>
            <span class="text-muted small">Page @Model.PagedUsers.PageNumber of @Math.Max(1, Model.PagedUsers.TotalPages)</span>
        </div>

        @if (!Model.PagedUsers.Items.Any())
        {
            <div class="text-center py-5">
                <div class="rounded-circle bg-light text-muted p-4 d-inline-flex mb-3">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                    </svg>
                </div>
                <h4 class="fw-bold text-dark">No Accounts Found</h4>
                <p class="text-muted">No coordinators or students match your criteria.</p>
                <a asp-action="Index" class="btn btn-primary px-4 py-2 rounded-pill">Reset Filters</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light table-light">
                        <tr class="small text-muted text-uppercase">
                            <th class="ps-4">User &amp; Contact</th>
                            <th>Department</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Joined</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.PagedUsers.Items)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary fw-bold d-flex align-items-center justify-content-center flex-shrink-0" style="width: 42px; height: 42px; font-size: 0.95rem;">
                                            @(string.IsNullOrEmpty(user.FirstName) ? "U" : user.FirstName[0].ToString().ToUpper())@(string.IsNullOrEmpty(user.LastName) ? "" : user.LastName[0].ToString().ToUpper())
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">
                                                <a asp-action="Details" asp-route-id="@user.Id" class="text-decoration-none text-dark hover-primary">
                                                    @user.FullName
                                                </a>
                                            </div>
                                            <div class="small text-muted font-monospace">@user.Email</div>
                                            @if (!string.IsNullOrEmpty(user.RollNumber))
                                            {
                                                <div class="small text-secondary">Roll: @user.RollNumber</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@(string.IsNullOrEmpty(user.Department) ? "General" : user.Department)</div>
                                    <div class="small text-muted">@(string.IsNullOrEmpty(user.CollegeName) ? "VAP UNIVERSITY" : user.CollegeName)</div>
                                </td>
                                <td>
                                    @foreach (var r in user.Roles)
                                    {
                                        @if (r == "Coordinator")
                                        {
                                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2 py-1">Coordinator</span>
                                        }
                                        else if (r == "Student")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Student</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-2 py-1">@r</span>
                                        }
                                    }
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 rounded-pill">Deactivated</span>
                                    }
                                </td>
                                <td class="text-muted small">
                                    @user.CreatedAt.ToString("MMM dd, yyyy")
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2 align-items-center">
                                        <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-sm">
                                            Details
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                            Edit
                                        </a>
                                        <form asp-action="ToggleStatus" asp-route-id="@user.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to @(user.IsActive ? "deactivate" : "activate") this account?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success") rounded-pill px-3">
                                                @(user.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.PagedUsers.TotalPages > 1)
            {
                <div class="card-footer bg-white border-0 py-3">
                    <nav aria-label="Page navigation" class="d-flex justify-content-center">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(!Model.PagedUsers.HasPreviousPage ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PagedUsers.PageNumber - 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-role="@Model.Role" asp-route-status="@Model.Status" asp-route-department="@Model.Department">Previous</a>
                            </li>
                            @for (int p = 1; p <= Model.PagedUsers.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.PagedUsers.PageNumber ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@p" asp-route-searchTerm="@Model.SearchTerm" asp-route-role="@Model.Role" asp-route-status="@Model.Status" asp-route-department="@Model.Department">@p</a>
                                </li>
                            }
                            <li class="page-item @(!Model.PagedUsers.HasNextPage ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PagedUsers.PageNumber + 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-role="@Model.Role" asp-route-status="@Model.Status" asp-route-department="@Model.Department">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>
