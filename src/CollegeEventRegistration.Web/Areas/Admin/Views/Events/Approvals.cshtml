@model CollegeEventRegistration.Web.Areas.Admin.Models.EventApprovalsQueueViewModel
@using CollegeEventRegistration.Core.Enums
@{
    ViewData["Title"] = "Event Approvals Queue";
    Layout = "_DashboardLayout";
    var area = ViewContext.RouteData.Values["area"]?.ToString() ?? "Admin";
}

<div class="container-fluid px-0">
    <!-- Header Block -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-area="@area" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-area="@area" asp-controller="Events" asp-action="Index" class="text-decoration-none">Events</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Approvals Queue</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold text-dark mb-0">Pending Event Approvals</h1>
            <p class="text-muted small mb-0">Administrative review and authorization queue for proposed campus events and workshops.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill shadow-sm">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                <span>View All Events</span>
            </a>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center gap-2 mb-4" role="alert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success flex-shrink-0">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center gap-2 mb-4" role="alert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-danger flex-shrink-0">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="15" y1="9" x2="9" y2="15"></line>
                <line x1="9" y1="9" x2="15" y2="15"></line>
            </svg>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat Summary Banner -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 bg-warning bg-opacity-10 border border-warning-subtle p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-warning-emphasis small fw-bold text-uppercase">Awaiting Administrative Review</div>
                        <h2 class="display-6 fw-bold text-dark mb-0">@Model.TotalPendingCount</h2>
                    </div>
                    <div class="rounded-circle bg-warning text-dark p-3">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 d-flex justify-content-center">
                <form method="get" asp-action="Approvals" class="row g-2 align-items-center">
                    <div class="col-md-9">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0 ps-3">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted">
                                    <circle cx="11" cy="11" r="8"></circle>
                                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                </svg>
                            </span>
                            <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control bg-light border-0 py-2" placeholder="Search by title, department, or coordinator..." />
                        </div>
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-3 py-2 rounded-pill flex-grow-1">Filter</button>
                        @if (!string.IsNullOrEmpty(Model.SearchTerm))
                        {
                            <a asp-action="Approvals" class="btn btn-outline-secondary px-3 py-2 rounded-pill">Reset</a>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Approvals Table Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-dark mb-0">Pending Proposals (@Model.TotalPendingCount)</h5>
            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-semibold">Action Required</span>
        </div>

        @if (!Model.PendingEvents.Any())
        {
            <div class="text-center py-5">
                <div class="rounded-circle bg-success bg-opacity-10 text-success p-4 d-inline-flex mb-3">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                </div>
                <h4 class="fw-bold text-dark">Queue Cleared!</h4>
                <p class="text-muted">There are currently no event proposals awaiting review.</p>
                <a asp-action="Index" class="btn btn-primary px-4 py-2 rounded-pill">Return to Events Dashboard</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light table-light">
                        <tr class="small text-muted text-uppercase">
                            <th class="ps-4">Event ID &amp; Title</th>
                            <th>Department &amp; Category</th>
                            <th>Submitted By</th>
                            <th>Event Dates</th>
                            <th>Capacity / Fee</th>
                            <th class="text-end pe-4">Decisions &amp; Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.PendingEvents)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark hover-primary">
                                            @item.Title
                                        </a>
                                    </div>
                                    <div class="small text-muted d-flex align-items-center gap-2 mt-1">
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace">#EV-@item.Id.ToString("D4")</span>
                                        <span class="badge bg-secondary-subtle text-secondary">@item.EventMode</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@item.DepartmentName</div>
                                    <div class="small text-muted">@item.CategoryName</div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@item.CreatorName</div>
                                    <div class="small text-muted font-monospace">@item.CreatorEmail</div>
                                    <div class="text-muted smaller">Submitted: @item.CreatedAt.ToString("MMM dd, yyyy")</div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@item.EventStartDate.ToString("MMM dd, yyyy")</div>
                                    <div class="small text-muted">@item.EventStartDate.ToString("hh:mm tt") - @item.EventEndDate.ToString("hh:mm tt")</div>
                                </td>
                                <td>
                                    <div><strong>@item.TotalCapacity</strong> seats</div>
                                    <div class="small">
                                        @if (item.EventType == EventType.Free)
                                        {
                                            <span class="badge bg-success-subtle text-success">Free</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info-subtle text-info-emphasis">₹@item.RegistrationFee.ToString("F2")</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2 align-items-center">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-sm">
                                            Inspect
                                        </a>

                                        @if (item.CanCurrentUserApprove)
                                        {
                                            <form asp-action="Approve" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Officially authorize and approve this event proposal?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="returnUrl" value="@Url.Action("Approvals", "Events", new { area = "Admin" })" />
                                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 shadow-sm">
                                                    Approve
                                                </button>
                                            </form>

                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 shadow-sm"
                                                    data-bs-toggle="modal" data-bs-target="#rejectModal-@item.Id">
                                                Reject...
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle p-2 small" title="@item.RestrictionReason">
                                                Self-Approval Restricted
                                            </span>
                                        }
                                    </div>

                                    <!-- Rejection Modal for this row -->
                                    <div class="modal fade" id="rejectModal-@item.Id" tabindex="-1" aria-labelledby="rejectModalLabel-@item.Id" aria-hidden="true" data-bs-backdrop="static">
                                        <div class="modal-dialog modal-dialog-centered text-start">
                                            <div class="modal-content border-0 shadow-lg rounded-4">
                                                <form asp-action="Reject" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="EventId" value="@item.Id" />
                                                    <input type="hidden" name="EventTitle" value="@item.Title" />
                                                    <input type="hidden" name="Action" value="Reject" />
                                                    <input type="hidden" name="returnUrl" value="@Url.Action("Approvals", "Events", new { area = "Admin" })" />

                                                    <div class="modal-header border-0 pb-0">
                                                        <h5 class="modal-title fw-bold text-danger" id="rejectModalLabel-@item.Id">Decline Event Proposal</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body p-4">
                                                        <p class="text-muted small mb-3">
                                                            Declining <strong>@item.Title</strong> (#EV-@item.Id.ToString("D4")).
                                                            Please provide actionable feedback explaining why this proposal requires revision.
                                                        </p>
                                                        <div class="mb-3">
                                                            <label class="form-label fw-bold small text-muted">Feedback / Rejection Reason <span class="text-danger">*</span></label>
                                                            <textarea name="RejectionReason" class="form-control rounded-3" rows="4" placeholder="Detail scheduling conflict, venue constraints, or missing session details..." required minlength="5"></textarea>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer border-0 pt-0">
                                                        <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-danger rounded-pill px-4">Confirm Rejection</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="card-footer bg-white border-0 py-3">
                    <nav aria-label="Page navigation" class="d-flex justify-content-center">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Approvals" asp-route-pageNumber="@(Model.CurrentPage - 1)" asp-route-searchTerm="@Model.SearchTerm">Previous</a>
                            </li>
                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Approvals" asp-route-pageNumber="@p" asp-route-searchTerm="@Model.SearchTerm">@p</a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Approvals" asp-route-pageNumber="@(Model.CurrentPage + 1)" asp-route-searchTerm="@Model.SearchTerm">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>
