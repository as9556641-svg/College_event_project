@model CollegeEventRegistration.Web.Areas.Admin.Models.EventWizardViewModel
@using CollegeEventRegistration.Core.Enums
@{
    ViewData["Title"] = Model.IsEditMode ? "Edit Event" : "Create Event Wizard";
    Layout = "_DashboardLayout";
    var area = ViewContext.RouteData.Values["area"]?.ToString() ?? "Admin";
}

<div class="container-fluid px-0" style="max-width: 1040px;">
    <!-- Breadcrumb & Header -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2 small">
            <li class="breadcrumb-item"><a asp-area="@area" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-area="@area" asp-controller="Events" asp-action="Index" class="text-decoration-none">Events</a></li>
            <li class="breadcrumb-item active" aria-current="page">@(Model.IsEditMode ? "Edit Event" : "Create Event Wizard")</li>
        </ol>
    </nav>
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">@(Model.IsEditMode ? "Modify Event Proposal" : "Multi-Step Event Creation Wizard")</h1>
            <p class="text-muted small mb-0">Follow the 6-stage workflow to configure schedule, eligibility, sessions, coordinators, and promotional banner.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary px-3 py-2 rounded-pill small">Discard & Exit</a>
        </div>
    </div>

    <!-- Stepper Indicator -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3 p-md-4">
            <div class="wizard-stepper d-flex justify-content-between align-items-center position-relative">
                <button type="button" class="step-indicator active text-center btn btn-link p-0 text-decoration-none" onclick="goToStep(1)" id="step-btn-1">
                    <div class="step-circle mx-auto mb-1">1</div>
                    <div class="step-label small fw-semibold">Basic Info</div>
                </button>
                <div class="step-connector"></div>
                <button type="button" class="step-indicator text-center btn btn-link p-0 text-decoration-none" onclick="goToStep(2)" id="step-btn-2">
                    <div class="step-circle mx-auto mb-1">2</div>
                    <div class="step-label small fw-semibold">Schedule</div>
                </button>
                <div class="step-connector"></div>
                <button type="button" class="step-indicator text-center btn btn-link p-0 text-decoration-none" onclick="goToStep(3)" id="step-btn-3">
                    <div class="step-circle mx-auto mb-1">3</div>
                    <div class="step-label small fw-semibold">Eligibility</div>
                </button>
                <div class="step-connector"></div>
                <button type="button" class="step-indicator text-center btn btn-link p-0 text-decoration-none" onclick="goToStep(4)" id="step-btn-4">
                    <div class="step-circle mx-auto mb-1">4</div>
                    <div class="step-label small fw-semibold">Sessions</div>
                </button>
                <div class="step-connector"></div>
                <button type="button" class="step-indicator text-center btn btn-link p-0 text-decoration-none" onclick="goToStep(5)" id="step-btn-5">
                    <div class="step-circle mx-auto mb-1">5</div>
                    <div class="step-label small fw-semibold">Coordinators</div>
                </button>
                <div class="step-connector"></div>
                <button type="button" class="step-indicator text-center btn btn-link p-0 text-decoration-none" onclick="goToStep(6)" id="step-btn-6">
                    <div class="step-circle mx-auto mb-1">6</div>
                    <div class="step-label small fw-semibold">Banner & Submit</div>
                </button>
            </div>
        </div>
    </div>

    <!-- Main Wizard Form Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
        <div class="card-body p-4 p-md-5">
            <form asp-action="@(Model.IsEditMode ? "Edit" : "Create")" method="post" enctype="multipart/form-data" id="wizardForm">
                @Html.AntiForgeryToken()
                @if (Model.IsEditMode)
                {
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ExistingBannerUrl" />
                }

                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small mb-4" role="alert"></div>

                <!-- STAGE 1: BASIC INFORMATION -->
                <div class="wizard-pane active" id="pane-1">
                    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                        <span class="badge bg-primary rounded-circle p-2">01</span>
                        <h5 class="fw-bold text-dark mb-0">Stage 1: Basic Event Information</h5>
                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Title" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="Title" class="form-control rounded-3 py-2" placeholder="e.g. National Hackathon 2026: AI & Next-Gen Cloud" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EventCategoryId" class="form-label fw-semibold text-dark small"></label>
                            <select asp-for="EventCategoryId" asp-items="Model.Categories" class="form-select rounded-3 py-2">
                                <option value="">-- Select Event Category --</option>
                            </select>
                            <span asp-validation-for="EventCategoryId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DepartmentId" class="form-label fw-semibold text-dark small"></label>
                            <select asp-for="DepartmentId" asp-items="Model.Departments" class="form-select rounded-3 py-2">
                                <option value="">-- Select Organizing Department --</option>
                            </select>
                            <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="ShortDescription" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="ShortDescription" class="form-control rounded-3 py-2" placeholder="1-2 sentences summarizing event purpose and target audience..." />
                            <span asp-validation-for="ShortDescription" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold text-dark small"></label>
                            <textarea asp-for="Description" class="form-control rounded-3" rows="5" placeholder="Provide complete event syllabus, expected outcomes, prerequisite knowledge, and schedule details..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <button type="button" class="btn btn-primary px-4 rounded-pill shadow-sm" onclick="goToStep(2)">Proceed to Schedule &raquo;</button>
                    </div>
                </div>

                <!-- STAGE 2: SCHEDULE & DETAILS -->
                <div class="wizard-pane d-none" id="pane-2">
                    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                        <span class="badge bg-primary rounded-circle p-2">02</span>
                        <h5 class="fw-bold text-dark mb-0">Stage 2: Event Details & Schedule</h5>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="EventType" class="form-label fw-semibold text-dark small"></label>
                            <select asp-for="EventType" class="form-select rounded-3 py-2" id="eventTypeSelect" onchange="toggleFeeField()">
                                <option value="@EventType.Free">Free (No registration charges)</option>
                                <option value="@EventType.Paid">Paid (Requires payment registration)</option>
                            </select>
                        </div>

                        <div class="col-md-6" id="feeContainer" style="@(Model.EventType == EventType.Paid ? "" : "display:none;")">
                            <label asp-for="RegistrationFee" class="form-label fw-semibold text-dark small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">₹</span>
                                <input asp-for="RegistrationFee" class="form-control rounded-end-3 py-2" type="number" step="0.01" min="0" />
                            </div>
                            <span asp-validation-for="RegistrationFee" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EventMode" class="form-label fw-semibold text-dark small"></label>
                            <select asp-for="EventMode" class="form-select rounded-3 py-2" id="eventModeSelect" onchange="toggleModeFields()">
                                <option value="@EventMode.Offline">In-Person (On-Campus)</option>
                                <option value="@EventMode.Online">Online / Virtual</option>
                                <option value="@EventMode.Hybrid">Hybrid (In-Person + Online Streaming)</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TotalCapacity" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="TotalCapacity" class="form-control rounded-3 py-2" type="number" min="1" />
                            <span asp-validation-for="TotalCapacity" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6" id="venueContainer">
                            <label asp-for="Venue" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="Venue" class="form-control rounded-3 py-2" placeholder="e.g. Main Auditorium / Seminar Hall B" />
                            <span asp-validation-for="Venue" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6" id="onlineUrlContainer">
                            <label asp-for="OnlineMeetingUrl" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="OnlineMeetingUrl" class="form-control rounded-3 py-2" placeholder="https://meet.google.com/xyz or Zoom Link" />
                            <span asp-validation-for="OnlineMeetingUrl" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="RegistrationStartDate" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="RegistrationStartDate" class="form-control rounded-3 py-2" type="datetime-local" />
                            <span asp-validation-for="RegistrationStartDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="RegistrationEndDate" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="RegistrationEndDate" class="form-control rounded-3 py-2" type="datetime-local" />
                            <span asp-validation-for="RegistrationEndDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EventStartDate" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="EventStartDate" class="form-control rounded-3 py-2" type="datetime-local" />
                            <span asp-validation-for="EventStartDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EventEndDate" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="EventEndDate" class="form-control rounded-3 py-2" type="datetime-local" />
                            <span asp-validation-for="EventEndDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                        <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" onclick="goToStep(1)">&laquo; Back</button>
                        <button type="button" class="btn btn-primary px-4 rounded-pill shadow-sm" onclick="goToStep(3)">Proceed to Eligibility &raquo;</button>
                    </div>
                </div>

                <!-- STAGE 3: ELIGIBILITY CRITERIA -->
                <div class="wizard-pane d-none" id="pane-3">
                    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                        <span class="badge bg-primary rounded-circle p-2">03</span>
                        <h5 class="fw-bold text-dark mb-0">Stage 3: Student Eligibility & Requirements</h5>
                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold text-dark small">Department Restrictions (Select specific departments or leave all unselected for all departments)</label>
                            <div class="row g-2 p-3 bg-light rounded-3 border">
                                @foreach (var dept in Model.Departments)
                                {
                                    <div class="col-sm-6 col-md-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="EligibleDepartmentIds" value="@dept.Value" id="dept_@dept.Value" @(Model.EligibleDepartmentIds != null && Model.EligibleDepartmentIds.Contains(int.Parse(dept.Value)) ? "checked" : "")>
                                            <label class="form-check-label small" for="dept_@dept.Value">
                                                @dept.Text
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="YearOfStudy" class="form-label fw-semibold text-dark small"></label>
                            <select asp-for="YearOfStudy" class="form-select rounded-3 py-2">
                                <option value="">Open to All Years (1st to 5th Year)</option>
                                <option value="1">1st Year Only</option>
                                <option value="2">2nd Year Only</option>
                                <option value="3">3rd Year Only</option>
                                <option value="4">4th Year Only</option>
                                <option value="5">5th Year Only</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MinimumCgpa" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="MinimumCgpa" class="form-control rounded-3 py-2" type="number" step="0.1" min="0" max="10" placeholder="e.g. 7.5 (Leave blank if no cutoff)" />
                            <span asp-validation-for="MinimumCgpa" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch pt-2">
                                <input class="form-check-input" type="checkbox" role="switch" asp-for="IsOpenToOtherColleges" id="otherCollegesSwitch">
                                <label class="form-check-label fw-semibold text-dark small" for="otherCollegesSwitch">Allow registrations from accredited external universities and colleges</label>
                            </div>
                        </div>

                        <div class="col-12">
                            <label asp-for="EligibilityRemarks" class="form-label fw-semibold text-dark small"></label>
                            <textarea asp-for="EligibilityRemarks" class="form-control rounded-3" rows="2" placeholder="e.g. Participants must bring valid college ID and laptops with Python 3.12 installed."></textarea>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                        <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" onclick="goToStep(2)">&laquo; Back</button>
                        <button type="button" class="btn btn-primary px-4 rounded-pill shadow-sm" onclick="goToStep(4)">Proceed to Sessions &raquo;</button>
                    </div>
                </div>

                <!-- STAGE 4: AGENDA & SESSIONS -->
                <div class="wizard-pane d-none" id="pane-4">
                    <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-primary rounded-circle p-2">04</span>
                            <h5 class="fw-bold text-dark mb-0">Stage 4: Agenda & Workshop Sessions</h5>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="addSessionRow()">
                            + Add Session
                        </button>
                    </div>

                    <p class="text-muted small">Configure detailed timeline, guest speakers, keynotes, and breakout rooms.</p>

                    <div id="sessionsContainer" class="d-flex flex-column gap-3 mb-3">
                        @if (Model.Sessions != null && Model.Sessions.Count > 0)
                        {
                            @for (int i = 0; i < Model.Sessions.Count; i++)
                            {
                                <div class="card border rounded-3 p-3 session-card position-relative" data-index="@i">
                                    <button type="button" class="btn-close position-absolute top-0 end-0 m-2" onclick="removeSession(this)" aria-label="Remove"></button>
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <label class="form-label small fw-semibold">Session Title</label>
                                            <input name="Sessions[@i].SessionTitle" value="@Model.Sessions[i].SessionTitle" class="form-control form-control-sm" required />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small fw-semibold">Speaker Name</label>
                                            <input name="Sessions[@i].SpeakerName" value="@Model.Sessions[i].SpeakerName" class="form-control form-control-sm" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small fw-semibold">Date</label>
                                            <input type="date" name="Sessions[@i].SessionDate" value="@Model.Sessions[i].SessionDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small fw-semibold">Start Time</label>
                                            <input type="time" name="Sessions[@i].StartTime" value="@Model.Sessions[i].StartTime.ToString(@"hh\:mm")" class="form-control form-control-sm" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small fw-semibold">End Time</label>
                                            <input type="time" name="Sessions[@i].EndTime" value="@Model.Sessions[i].EndTime.ToString(@"hh\:mm")" class="form-control form-control-sm" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small fw-semibold">Speaker Bio / Org</label>
                                            <input name="Sessions[@i].SpeakerDesignation" value="@Model.Sessions[i].SpeakerDesignation" class="form-control form-control-sm" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small fw-semibold">Room / Venue</label>
                                            <input name="Sessions[@i].VenueOrRoom" value="@Model.Sessions[i].VenueOrRoom" class="form-control form-control-sm" />
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <div id="noSessionsNotice" class="text-center py-4 bg-light rounded-3 text-muted small @(Model.Sessions != null && Model.Sessions.Count > 0 ? "d-none" : "")">
                        No individual breakout sessions configured. You may click <strong>+ Add Session</strong> or proceed directly.
                    </div>

                    <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                        <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" onclick="goToStep(3)">&laquo; Back</button>
                        <button type="button" class="btn btn-primary px-4 rounded-pill shadow-sm" onclick="goToStep(5)">Proceed to Coordinators &raquo;</button>
                    </div>
                </div>

                <!-- STAGE 5: COORDINATOR ASSIGNMENT -->
                <div class="wizard-pane d-none" id="pane-5">
                    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                        <span class="badge bg-primary rounded-circle p-2">05</span>
                        <h5 class="fw-bold text-dark mb-0">Stage 5: Coordinator Assignment</h5>
                    </div>

                    <p class="text-muted small">Designate faculty or staff coordinators responsible for organizing, checking attendance, and managing participants.</p>

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold text-dark small">Assign Event Coordinators</label>
                            <div class="row g-2 p-3 bg-light rounded-3 border" style="max-height: 280px; overflow-y: auto;">
                                @foreach (var coord in Model.AvailableCoordinators)
                                {
                                    <div class="col-sm-6">
                                        <div class="form-check p-2 rounded-2 bg-white border">
                                            <input class="form-check-input ms-0 me-2" type="checkbox" name="CoordinatorUserIds" value="@coord.Id" id="coord_@coord.Id" @(Model.CoordinatorUserIds != null && Model.CoordinatorUserIds.Contains(coord.Id) ? "checked" : "")>
                                            <label class="form-check-label small" for="coord_@coord.Id">
                                                <strong>@coord.FullName</strong>
                                                <div class="text-muted" style="font-size: 0.75rem;">@coord.Email (@coord.DepartmentName)</div>
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PrimaryCoordinatorUserId" class="form-label fw-semibold text-dark small"></label>
                            <select asp-for="PrimaryCoordinatorUserId" class="form-select rounded-3 py-2">
                                <option value="">-- Designate Lead Coordinator (Optional) --</option>
                                @foreach (var coord in Model.AvailableCoordinators)
                                {
                                    <option value="@coord.Id">@coord.FullName (@coord.Email)</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                        <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" onclick="goToStep(4)">&laquo; Back</button>
                        <button type="button" class="btn btn-primary px-4 rounded-pill shadow-sm" onclick="goToStep(6)">Proceed to Banner & Submit &raquo;</button>
                    </div>
                </div>

                <!-- STAGE 6: BANNER & SUBMISSION -->
                <div class="wizard-pane d-none" id="pane-6">
                    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                        <span class="badge bg-primary rounded-circle p-2">06</span>
                        <h5 class="fw-bold text-dark mb-0">Stage 6: Promotional Banner & Submission</h5>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-7">
                            <label asp-for="BannerFile" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="BannerFile" type="file" class="form-control rounded-3 py-2" accept=".jpg,.jpeg,.png,.webp" id="bannerFileInput" onchange="previewBanner(this)" />
                            <span asp-validation-for="BannerFile" class="text-danger small"></span>
                            <div class="form-text small">Accepted formats: JPG, PNG, WEBP. Maximum file size: 5 MB. Image is validated on server with magic byte inspection.</div>

                            <div class="mt-4 p-3 bg-light rounded-3 border">
                                <h6 class="fw-bold text-dark small mb-2">Publishing Workflow Options:</h6>
                                <p class="text-muted small mb-0">
                                    &bull; <strong>Save as Draft:</strong> Saves event in Draft status. You can edit details and add sessions later.<br />
                                    &bull; <strong>Submit for Approval:</strong> Sends proposal directly to Campus Administration for review.
                                </p>
                            </div>
                        </div>

                        <div class="col-md-5">
                            <label class="form-label fw-semibold text-dark small">Banner Live Preview</label>
                            <div class="card rounded-3 border overflow-hidden shadow-sm" style="height: 200px; background: #e2e8f0;">
                                <img id="bannerPreviewImg" src="@(string.IsNullOrEmpty(Model.ExistingBannerUrl) ? "" : Model.ExistingBannerUrl)" alt="Banner Preview" class="w-100 h-100 @(string.IsNullOrEmpty(Model.ExistingBannerUrl) ? "d-none" : "")" style="object-fit: cover;" />
                                <div id="bannerPlaceholder" class="w-100 h-100 d-flex flex-column align-items-center justify-content-center text-muted small p-3 text-center @(string.IsNullOrEmpty(Model.ExistingBannerUrl) ? "" : "d-none")">
                                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mb-2 opacity-50">
                                        <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
                                        <circle cx="9" cy="9" r="2"></circle>
                                        <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
                                    </svg>
                                    <span>Select a banner image to preview</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Submission Action Buttons -->
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3 mt-4 pt-4 border-top">
                        <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" onclick="goToStep(5)">&laquo; Back</button>
                        
                        <div class="d-flex gap-2">
                            <button type="submit" name="submitAction" value="Draft" class="btn btn-outline-primary px-4 rounded-pill">
                                Save as Draft
                            </button>
                            <button type="submit" name="submitAction" value="SubmitForApproval" class="btn btn-primary px-4 rounded-pill shadow-sm">
                                Submit for Approval &raquo;
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let currentStep = 1;
        const totalSteps = 6;

        function goToStep(step) {
            if (step < 1 || step > totalSteps) return;

            // Update panes
            for (let i = 1; i <= totalSteps; i++) {
                const pane = document.getElementById('pane-' + i);
                const btn = document.getElementById('step-btn-' + i);
                if (i === step) {
                    pane.classList.remove('d-none');
                    pane.classList.add('active');
                    btn.classList.add('active');
                } else {
                    pane.classList.add('d-none');
                    pane.classList.remove('active');
                    if (i < step) {
                        btn.classList.add('completed');
                        btn.classList.remove('active');
                    } else {
                        btn.classList.remove('completed');
                        btn.classList.remove('active');
                    }
                }
            }
            currentStep = step;
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function toggleFeeField() {
            const select = document.getElementById('eventTypeSelect');
            const feeContainer = document.getElementById('feeContainer');
            if (select.value === '@((int)EventType.Paid)') {
                feeContainer.style.display = '';
            } else {
                feeContainer.style.display = 'none';
            }
        }

        function toggleModeFields() {
            const select = document.getElementById('eventModeSelect');
            const venueContainer = document.getElementById('venueContainer');
            const onlineUrlContainer = document.getElementById('onlineUrlContainer');
            const mode = select.value;

            // Offline (0)
            if (mode === '0') {
                venueContainer.style.display = '';
                onlineUrlContainer.style.display = 'none';
            } else if (mode === '1') { // Online
                venueContainer.style.display = 'none';
                onlineUrlContainer.style.display = '';
            } else { // Hybrid
                venueContainer.style.display = '';
                onlineUrlContainer.style.display = '';
            }
        }

        function previewBanner(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = document.getElementById('bannerPreviewImg');
                    const placeholder = document.getElementById('bannerPlaceholder');
                    img.src = e.target.result;
                    img.classList.remove('d-none');
                    placeholder.classList.add('d-none');
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        let sessionIndex = @(Model.Sessions?.Count ?? 0);
        function addSessionRow() {
            const container = document.getElementById('sessionsContainer');
            const notice = document.getElementById('noSessionsNotice');
            notice.classList.add('d-none');

            const card = document.createElement('div');
            card.className = 'card border rounded-3 p-3 session-card position-relative';
            card.innerHTML = `
                <button type="button" class="btn-close position-absolute top-0 end-0 m-2" onclick="removeSession(this)" aria-label="Remove"></button>
                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Session Title</label>
                        <input name="Sessions[${sessionIndex}].SessionTitle" class="form-control form-control-sm" placeholder="e.g. Keynote: Future of AI" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Speaker Name</label>
                        <input name="Sessions[${sessionIndex}].SpeakerName" class="form-control form-control-sm" placeholder="e.g. Dr. Priya Sharma" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Date</label>
                        <input type="date" name="Sessions[${sessionIndex}].SessionDate" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Start Time</label>
                        <input type="time" name="Sessions[${sessionIndex}].StartTime" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">End Time</label>
                        <input type="time" name="Sessions[${sessionIndex}].EndTime" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Speaker Bio / Org</label>
                        <input name="Sessions[${sessionIndex}].SpeakerDesignation" class="form-control form-control-sm" placeholder="e.g. Senior Staff Scientist at DeepMind" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Room / Venue</label>
                        <input name="Sessions[${sessionIndex}].VenueOrRoom" class="form-control form-control-sm" placeholder="e.g. Lab 402" />
                    </div>
                </div>
            `;
            container.appendChild(card);
            sessionIndex++;
        }

        function removeSession(btn) {
            const card = btn.closest('.session-card');
            card.remove();
            const container = document.getElementById('sessionsContainer');
            if (container.children.length === 0) {
                document.getElementById('noSessionsNotice').classList.remove('d-none');
            }
        }

        // Initialize display conditions on load
        document.addEventListener('DOMContentLoaded', function() {
            toggleFeeField();
            toggleModeFields();
        });
    </script>
    <style>
        .wizard-stepper {
            display: flex;
            align-items: center;
        }
        .step-indicator {
            flex: 0 0 auto;
            color: #64748b;
        }
        .step-circle {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: #f1f5f9;
            color: #475569;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            border: 2px solid #cbd5e1;
            transition: all 0.2s ease;
        }
        .step-indicator.active .step-circle {
            background: #3B82F6;
            color: white;
            border-color: #3B82F6;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.2);
        }
        .step-indicator.completed .step-circle {
            background: #10B981;
            color: white;
            border-color: #10B981;
        }
        .step-connector {
            flex: 1 1 auto;
            height: 2px;
            background: #e2e8f0;
            margin: 0 10px;
            margin-bottom: 22px;
        }
    </style>
}

