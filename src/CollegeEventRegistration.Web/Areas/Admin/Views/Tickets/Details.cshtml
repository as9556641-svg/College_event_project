@model CollegeEventRegistration.Core.DTOs.TicketDto
@using CollegeEventRegistration.Core.DTOs
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = $"Ticket #{Model.TicketCode}";
}

<div class="dash-page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <a asp-action="Index" class="text-decoration-none text-muted small">Tickets Ledger</a>
            <span class="text-muted small">/</span>
            <span class="badge badge-role badge-role-admin">University Governance</span>
        </div>
        <h2 class="dash-page-title">Admission Ticket Audit Details</h2>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Ledger</a>
    </div>
</div>

<div class="row g-4">
    <!-- Ticket Summary Card -->
    <div class="col-lg-8">
        <div class="dash-panel p-4">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                <div>
                    <span class="text-muted small">Ticket Reference</span>
                    <h3 class="fw-bold font-monospace text-dark mb-0">@Model.TicketCode</h3>
                </div>
                <div>
                    @if (Model.Status == TicketStatus.Valid)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle fs-6 px-3 py-2">Valid Pass</span>
                    }
                    else if (Model.Status == TicketStatus.Used)
                    {
                        <span class="badge bg-info-subtle text-info border border-info-subtle fs-6 px-3 py-2">Used / Checked-In</span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle fs-6 px-3 py-2">Cancelled / Inactive</span>
                    }
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-sm-6">
                    <span class="text-muted small d-block">Event Title</span>
                    <strong class="text-dark">@Model.EventTitle</strong>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted small d-block">Registration Number</span>
                    <strong class="text-dark font-monospace">@Model.RegistrationNumber</strong>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted small d-block">Event Date & Time</span>
                    <strong class="text-dark">@Model.EventStartDate.ToString("MMM dd, yyyy HH:mm") UTC</strong>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted small d-block">Venue</span>
                    <strong class="text-dark">@(Model.EventVenue ?? "Campus Auditorium")</strong>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted small d-block">Issued Timestamp</span>
                    <strong class="text-dark">@Model.IssuedAt.ToString("MMM dd, yyyy HH:mm:ss") UTC</strong>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted small d-block">Admission Check-in</span>
                    <strong class="text-dark">@(Model.IsUsed ? $"Used on {Model.UsedAt:MMM dd, yyyy HH:mm} UTC" : "Not yet checked-in")</strong>
                </div>
            </div>

            <div class="border-top pt-3">
                <h6 class="fw-bold text-dark mb-2">Cryptographic Token Data</h6>
                <div class="p-3 bg-light rounded font-monospace small text-break">
                    @Model.QrCodeData
                </div>
            </div>
        </div>
    </div>

    <!-- QR Code & Attendee Profile -->
    <div class="col-lg-4">
        <div class="dash-panel p-4 text-center mb-4">
            <h6 class="fw-bold text-dark mb-3">Ticket QR Code</h6>
            <div class="p-2 bg-white border rounded shadow-sm d-inline-block mb-3">
                <img src="@Model.QrCodeBase64" alt="QR Code" style="width: 180px; height: 180px; image-rendering: pixelated;" />
            </div>
            <div class="small text-muted font-monospace">@Model.TicketCode</div>
        </div>

        <div class="dash-panel p-4">
            <h6 class="fw-bold text-dark mb-3">Attendee Information</h6>
            <div class="small">
                <div class="mb-2"><strong class="text-dark">Name:</strong> @Model.StudentName</div>
                <div class="mb-2"><strong class="text-dark">Roll Number:</strong> @(Model.StudentRollNumber ?? "N/A")</div>
                <div class="mb-2"><strong class="text-dark">Department:</strong> @(Model.StudentDepartment ?? "N/A")</div>
                <div><strong class="text-dark">Institution:</strong> @(Model.StudentCollegeName ?? "VAP UNIVERSITY")</div>
            </div>
        </div>
    </div>
</div>
