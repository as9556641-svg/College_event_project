@model CollegeEventRegistration.Core.Entities.ApplicationUser
@{
    ViewData["Title"] = "Institutional Admin Dashboard";
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge badge-role badge-role-admin">Admin Portal</span>
            <span class="text-muted small">Campus Event Management</span>
        </div>
        <h2 class="fw-bold mb-0" style="color: #0F172A; letter-spacing: -0.02em;">Welcome, @(Model?.FullName ?? "Administrator")</h2>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-2 bg-white rounded-pill border shadow-sm">
            <span class="dash-pulse-dot"></span>
            <span class="fw-semibold text-success small">Campus Active</span>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="dash-metric-card">
            <div>
                <div class="dash-metric-header">
                    <span class="dash-metric-label">Campus Events</span>
                    <div class="dash-metric-icon-wrap icon-wrap-blue">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                    </div>
                </div>
                <div class="dash-metric-value text-primary">@ViewBag.TotalEvents</div>
            </div>
            <p class="dash-metric-subtext">Workshops, symposia &amp; hackathons</p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="dash-metric-card">
            <div>
                <div class="dash-metric-header">
                    <span class="dash-metric-label">Pending Approval</span>
                    <div class="dash-metric-icon-wrap icon-wrap-amber">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                    </div>
                </div>
                <div class="dash-metric-value text-warning">@ViewBag.PendingApproval</div>
            </div>
            <p class="dash-metric-subtext">Awaiting institutional review</p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="dash-metric-card">
            <div>
                <div class="dash-metric-header">
                    <span class="dash-metric-label">Registrations</span>
                    <div class="dash-metric-icon-wrap icon-wrap-green">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                        </svg>
                    </div>
                </div>
                <div class="dash-metric-value" style="color: #059669;">@ViewBag.TotalRegistrations</div>
            </div>
            <p class="dash-metric-subtext">Total attendee registrations</p>
        </div>
    </div>
</div>
