@model CollegeEventRegistration.Core.DTOs.PagedResult<CollegeEventRegistration.Core.DTOs.FeedbackItemDto>
@using CollegeEventRegistration.Core.DTOs
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Event Feedback & Ratings";
    var summary = ViewBag.Summary as EventFeedbackSummaryDto;
    var selectedEventId = (int)(ViewBag.SelectedEventId ?? 0);
    var coordinatedEvents = ViewBag.CoordinatedEvents as List<SelectListItem> ?? new List<SelectListItem>();
    var criteria = ViewBag.Criteria as FeedbackFilterCriteria ?? new FeedbackFilterCriteria();
}

<div class="dash-page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge badge-role badge-role-coord">Faculty Coordinator</span>
            <span class="text-muted small">Post-Event Quality Assessment</span>
        </div>
        <h2 class="dash-page-title">@(summary?.EventTitle ?? "Event Feedback & Ratings")</h2>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="Coordinator" asp-controller="Attendance" asp-action="Index" asp-route-eventId="@selectedEventId" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
            <span>View Attendance</span>
        </a>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <span>@TempData["ErrorMessage"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <span>@TempData["SuccessMessage"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Event Switcher -->
@if (coordinatedEvents.Any())
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" class="d-flex flex-wrap align-items-center gap-3">
                <label for="eventSelect" class="form-label fw-bold text-dark mb-0">Select Event:</label>
                <div class="flex-grow-1" style="max-width: 450px;">
                    <select id="eventSelect" name="eventId" class="form-select" onchange="this.form.submit()">
                        @foreach (var ev in coordinatedEvents)
                        {
                            <option value="@ev.Value" selected="@ev.Selected">@ev.Text</option>
                        }
                    </select>
                </div>
                <noscript>
                    <button type="submit" class="btn btn-secondary btn-sm">Load</button>
                </noscript>
            </form>
        </div>
    </div>
}

@if (summary != null)
{
    <!-- Analytics & Summary Metrics -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 h-100 bg-white">
                <div class="text-muted small fw-medium">Overall Rating</div>
                <div class="d-flex align-items-baseline gap-2 mt-1">
                    <span class="display-6 fw-bold text-warning">@summary.AverageOverallRating.ToString("F1")</span>
                    <span class="text-muted">/ 5.0</span>
                </div>
                <div class="text-warning small mt-1">
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= Math.Round(summary.AverageOverallRating))
                        {
                            <span>&#9733;</span>
                        }
                        else
                        {
                            <span class="text-muted opacity-25">&#9733;</span>
                        }
                    }
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 h-100 bg-white">
                <div class="text-muted small fw-medium">Total Evaluations</div>
                <div class="display-6 fw-bold text-primary mt-1">@summary.TotalFeedbacks</div>
                <div class="small text-muted mt-1">From @summary.TotalAttendees verified attendees (@summary.FeedbackSubmissionRate%)</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 h-100 bg-white">
                <div class="text-muted small fw-medium">Content Quality</div>
                <div class="h3 fw-bold text-success mt-1">@summary.AverageContentRating.ToString("F1") ★</div>
                <div class="small text-muted">Curriculum &amp; depth</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 h-100 bg-white">
                <div class="text-muted small fw-medium">Speaker &amp; Venue</div>
                <div class="d-flex justify-content-between mt-2">
                    <span class="small text-muted">Speaker:</span>
                    <span class="fw-bold text-dark">@summary.AverageSpeakerRating.ToString("F1") ★</span>
                </div>
                <div class="d-flex justify-content-between mt-1">
                    <span class="small text-muted">Venue:</span>
                    <span class="fw-bold text-dark">@summary.AverageVenueRating.ToString("F1") ★</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Rating Distribution Histogram -->
    <div class="card border-0 shadow-sm p-4 mb-4 bg-white">
        <h5 class="fw-bold text-dark mb-3">Rating Breakdown</h5>
        <div class="row g-2">
            @for (int star = 5; star >= 1; star--)
            {
                var count = summary.RatingDistribution.ContainsKey(star) ? summary.RatingDistribution[star] : 0;
                var pct = summary.TotalFeedbacks > 0 ? (int)Math.Round((double)count / summary.TotalFeedbacks * 100) : 0;
                <div class="col-12 d-flex align-items-center gap-3">
                    <div class="text-muted small fw-medium" style="width: 60px;">@star Stars</div>
                    <div class="progress flex-grow-1" style="height: 10px;">
                        <div class="progress-bar bg-warning" role="progressbar" style="width: @pct%;" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="text-muted small text-end" style="width: 80px;">@count (@pct%)</div>
                </div>
            }
        </div>
    </div>

    <!-- Filter & Search Bar -->
    <div class="card border-0 shadow-sm p-3 mb-4 bg-white">
        <form method="get" class="row g-2 align-items-center">
            <input type="hidden" name="eventId" value="@selectedEventId" />
            <div class="col-md-5">
                <input type="text" name="SearchTerm" class="form-control form-control-sm" placeholder="Search comments or student..." value="@criteria.SearchTerm" />
            </div>
            <div class="col-md-3">
                <select name="MinRating" class="form-select form-select-sm">
                    <option value="">All Ratings</option>
                    <option value="5" selected="@(criteria.MinRating == 5)">5 Stars Only</option>
                    <option value="4" selected="@(criteria.MinRating == 4)">4+ Stars</option>
                    <option value="3" selected="@(criteria.MinRating == 3)">3+ Stars</option>
                    <option value="2" selected="@(criteria.MinRating == 2)">2+ Stars</option>
                    <option value="1" selected="@(criteria.MinRating == 1)">1+ Stars</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary fw-medium px-3">Filter</button>
                <a asp-action="Index" asp-route-eventId="@selectedEventId" class="btn btn-sm btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>

    <!-- Feedback Records Table -->
    <div class="card border-0 shadow-sm bg-white mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
            <h5 class="fw-bold text-dark mb-0">Participant Reviews &amp; Comments</h5>
            <span class="badge bg-secondary-subtle text-secondary">@(Model?.TotalCount ?? 0) Total</span>
        </div>
        <div class="card-body p-0">
            @if (Model != null && Model.Items.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase text-muted">
                            <tr>
                                <th class="ps-3">Student</th>
                                <th>Rating</th>
                                <th>Breakdown</th>
                                <th>Comments &amp; Reflections</th>
                                <th>Submitted At</th>
                                <th class="text-end pe-3">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <div class="fw-bold text-dark">@item.StudentName</div>
                                        @if (!item.IsAnonymous && !string.IsNullOrWhiteSpace(item.StudentRollNumber))
                                        {
                                            <div class="text-muted small">@item.StudentRollNumber</div>
                                        }
                                        else if (item.IsAnonymous)
                                        {
                                            <span class="badge bg-light text-muted border">Anonymous</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="text-warning fw-bold">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= item.OverallRating)
                                                {
                                                    <span>&#9733;</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted opacity-25">&#9733;</span>
                                                }
                                            }
                                            <span class="text-dark small ms-1">(@item.OverallRating/5)</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small text-muted" style="font-size: 0.78rem;">
                                            <div>Content: <strong>@item.ContentQualityRating★</strong></div>
                                            <div>Speaker: <strong>@item.SpeakerRating★</strong></div>
                                            <div>Venue: <strong>@item.VenueRating★</strong></div>
                                        </div>
                                    </td>
                                    <td style="max-width: 320px;">
                                        @if (!string.IsNullOrWhiteSpace(item.Comments))
                                        {
                                            <div class="text-truncate small text-dark" title="@item.Comments">@item.Comments</div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small fst-italic">No comment</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="small text-muted">@item.SubmittedAt.ToString("MMM dd, yyyy HH:mm")</div>
                                    </td>
                                    <td class="text-end pe-3">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                            Inspect
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center p-3 border-top">
                        <div class="text-muted small">
                            Showing page @Model.PageNumber of @Model.TotalPages
                        </div>
                        <div class="btn-group">
                            @if (Model.HasPreviousPage)
                            {
                                <a asp-action="Index" asp-route-eventId="@selectedEventId" asp-route-PageNumber="@(Model.PageNumber - 1)" asp-route-SearchTerm="@criteria.SearchTerm" asp-route-MinRating="@criteria.MinRating" class="btn btn-sm btn-outline-secondary">&laquo; Prev</a>
                            }
                            @if (Model.HasNextPage)
                            {
                                <a asp-action="Index" asp-route-eventId="@selectedEventId" asp-route-PageNumber="@(Model.PageNumber + 1)" asp-route-SearchTerm="@criteria.SearchTerm" asp-route-MinRating="@criteria.MinRating" class="btn btn-sm btn-outline-secondary">Next &raquo;</a>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="p-4 text-center text-muted">
                    <div class="small">No feedback records found for this event.</div>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm p-4 text-center text-muted bg-white">
        <div class="h5 fw-bold text-dark">No Events Assigned</div>
        <p class="small mb-0">You are not currently assigned to coordinate any events.</p>
    </div>
}
