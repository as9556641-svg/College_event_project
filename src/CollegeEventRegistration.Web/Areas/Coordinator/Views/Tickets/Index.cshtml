@model CollegeEventRegistration.Core.DTOs.PagedResult<CollegeEventRegistration.Core.DTOs.TicketDto>
@using CollegeEventRegistration.Core.DTOs
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = $"Event Tickets - {ViewBag.EventTitle}";
    var criteria = (TicketFilterCriteria)(ViewBag.Criteria ?? new TicketFilterCriteria());
    var eventId = (int)(ViewBag.EventId ?? 0);
}

<div class="dash-page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge badge-role badge-role-coord">Faculty Coordinator</span>
            <span class="text-muted small">Event Admission Passes</span>
        </div>
        <h2 class="dash-page-title">Admission Tickets — @ViewBag.EventTitle</h2>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Switch Event</a>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <span>@TempData["ErrorMessage"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Filters -->
<div class="dash-panel mb-4 p-3">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-5">
            <label class="form-label small fw-semibold text-muted">Select Event</label>
            <select name="eventId" class="form-select" onchange="this.form.submit()">
                @foreach (var ev in (List<SelectListItem>)(ViewBag.CoordinatedEvents ?? new List<SelectListItem>()))
                {
                    <option value="@ev.Value" selected="@ev.Selected">@ev.Text</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label small fw-semibold text-muted">Search Student / Ticket</label>
            <input type="text" name="SearchTerm" class="form-control" placeholder="Search by name, roll no, ticket code..." value="@criteria.SearchTerm" />
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold text-muted">Admission Status</label>
            <select name="IsUsed" class="form-select" onchange="this.form.submit()">
                <option value="">All Statuses</option>
                <option value="false" selected="@(criteria.IsUsed == false)">Unused / Active</option>
                <option value="true" selected="@(criteria.IsUsed == true)">Used / Admitted</option>
            </select>
        </div>
    </form>
</div>

<!-- Tickets Table -->
<div class="dash-panel">
    @if (Model == null || !Model.Items.Any())
    {
        <div class="text-center py-5 text-muted">
            <h5 class="fw-bold text-dark mb-1">No Tickets Issued</h5>
            <p class="small mb-0">No eligible admission tickets have been issued yet for this event.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Ticket Code</th>
                        <th>Attendee</th>
                        <th>Roll Number</th>
                        <th>Registration #</th>
                        <th>Issued At</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Items)
                    {
                        <tr>
                            <td>
                                <span class="font-monospace fw-bold text-dark">@t.TicketCode</span>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@t.StudentName</div>
                                <div class="small text-muted">@(t.StudentDepartment ?? "N/A")</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@(t.StudentRollNumber ?? "N/A")</span>
                            </td>
                            <td>
                                <span class="font-monospace text-muted small">@t.RegistrationNumber</span>
                            </td>
                            <td>
                                <div class="small text-dark">@t.IssuedAt.ToString("dd MMM yyyy")</div>
                                <div class="small text-muted">@t.IssuedAt.ToString("HH:mm") UTC</div>
                            </td>
                            <td>
                                @if (t.Status == TicketStatus.Valid)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Valid</span>
                                }
                                else if (t.Status == TicketStatus.Used)
                                {
                                    <span class="badge bg-info-subtle text-info border border-info-subtle">Used</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Cancelled</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">
                                    Inspect
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="d-flex justify-content-between align-items-center p-3 border-top">
                <div class="small text-muted">
                    Showing @Model.Items.Count of @Model.TotalCount total tickets
                </div>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-route-eventId="@eventId" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-searchTerm="@criteria.SearchTerm" asp-route-isUsed="@criteria.IsUsed">Previous</a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-eventId="@eventId" asp-route-pageNumber="@p" asp-route-searchTerm="@criteria.SearchTerm" asp-route-isUsed="@criteria.IsUsed">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-route-eventId="@eventId" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-searchTerm="@criteria.SearchTerm" asp-route-isUsed="@criteria.IsUsed">Next</a>
                    </li>
                </ul>
            </div>
        }
    }
</div>
