@model IEnumerable<CollegeEventRegistration.Core.Entities.Event>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Select Event - Tickets";
}

<div class="dash-page-header">
    <div class="d-flex align-items-center gap-2 mb-1">
        <span class="badge badge-role badge-role-coord">Faculty Coordinator</span>
        <span class="text-muted small">Event Admission Passes</span>
    </div>
    <h2 class="dash-page-title">Select Event to Manage Tickets</h2>
</div>

<div class="dash-panel">
    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <h5 class="fw-bold text-dark mb-1">No Coordinated Events</h5>
            <p class="small mb-0">You are currently not assigned to any events.</p>
        </div>
    }
    else
    {
        <div class="list-group list-group-flush">
            @foreach (var ev in Model)
            {
                <a asp-action="Index" asp-route-eventId="@ev.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                    <div>
                        <h6 class="fw-bold mb-1 text-dark">@ev.Title</h6>
                        <div class="small text-muted">
                            <span>@ev.EventStartDate.ToString("MMM dd, yyyy")</span> •
                            <span>@(ev.Venue ?? "Campus")</span> •
                            <span class="badge bg-light text-dark border">@ev.EventType</span>
                        </div>
                    </div>
                    <div>
                        <span class="badge bg-primary rounded-pill px-3 py-2">View Tickets &rarr;</span>
                    </div>
                </a>
            }
        </div>
    }
</div>
