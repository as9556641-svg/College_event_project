@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Attendance Management";
}

<div class="dash-page-header">
    <div class="d-flex align-items-center gap-2 mb-1">
        <span class="badge badge-role badge-role-coord">Faculty Coordinator</span>
        <span class="text-muted small">Attendance & Check-In</span>
    </div>
    <h2 class="dash-page-title">Attendance Management</h2>
</div>

<div class="dash-panel text-center py-5">
    <div class="py-4">
        <div class="mb-3 text-muted">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
        </div>
        <h5 class="fw-bold mb-2">No Events Assigned</h5>
        <p class="text-muted mb-4">You are not currently designated as an event organizer or coordinator for any published campus events.</p>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-primary">Return to Dashboard</a>
    </div>
</div>
