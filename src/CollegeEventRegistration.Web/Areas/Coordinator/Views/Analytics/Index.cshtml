@model CollegeEventRegistration.Core.DTOs.CoordinatorAnalyticsDto
@using CollegeEventRegistration.Core.DTOs
@using System.Text.Json
@{
    ViewData["Title"] = "Coordinator Event Analytics";
    Layout = "_DashboardLayout";
    var filter = ViewBag.Filter as AnalyticsFilterDto ?? new AnalyticsFilterDto();
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="h3 mb-1 text-dark fw-bold">Event Analytics & Reports</h1>
            <p class="text-muted small mb-0">Performance telemetry, participant registration conversion, attendance adherence, and satisfaction ratings for your assigned events.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="ExportPdf" 
               asp-route-eventId="@filter.EventId"
               asp-route-periodPreset="@filter.PeriodPreset"
               class="btn btn-outline-danger btn-sm d-flex align-items-center gap-1 shadow-sm">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                <span>Export Summary PDF</span>
            </a>
            <div class="dropdown">
                <button class="btn btn-primary btn-sm dropdown-toggle d-flex align-items-center gap-1 shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    <span>Export CSV</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow">
                    <li><a class="dropdown-item small" asp-action="ExportCsv" asp-route-reportType="events" asp-route-eventId="@filter.EventId">Event Performance CSV</a></li>
                    <li><a class="dropdown-item small" asp-action="ExportCsv" asp-route-reportType="registrations" asp-route-eventId="@filter.EventId">Participant Registrations CSV</a></li>
                    <li><a class="dropdown-item small" asp-action="ExportCsv" asp-route-reportType="attendance" asp-route-eventId="@filter.EventId">Attendance Check-In CSV</a></li>
                    <li><a class="dropdown-item small" asp-action="ExportCsv" asp-route-reportType="feedback" asp-route-eventId="@filter.EventId">Event Feedback CSV</a></li>
                    <li><a class="dropdown-item small" asp-action="ExportCsv" asp-route-reportType="certificates" asp-route-eventId="@filter.EventId">Certificates Issued CSV</a></li>
                </ul>
            </div>
            <a asp-action="EventPerformance" class="btn btn-outline-secondary btn-sm shadow-sm">Detailed Table</a>
        </div>
    </div>

    <!-- Scoped Event Selector & Filter -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-end">
                <div class="col-md-5 col-sm-6">
                    <label class="form-label small fw-semibold text-muted mb-1">Focus Event</label>
                    <select name="EventId" class="form-select form-select-sm">
                        <option value="">All My Assigned Events (@Model.AssignedEventsCount)</option>
                        @foreach (var ev in Model.AssignedEvents)
                        {
                            <option value="@ev.Id" selected="@(filter.EventId == ev.Id)">@ev.Title (@ev.Status - @ev.StartDate.ToString("MMM yyyy"))</option>
                        }
                    </select>
                </div>
                <div class="col-md-4 col-sm-6">
                    <label class="form-label small fw-semibold text-muted mb-1">Reporting Period</label>
                    <select name="PeriodPreset" class="form-select form-select-sm">
                        <option value="all" selected="@(filter.PeriodPreset == "all" || string.IsNullOrEmpty(filter.PeriodPreset))">All Time</option>
                        <option value="last7days" selected="@(filter.PeriodPreset == "last7days")">Last 7 Days</option>
                        <option value="last30days" selected="@(filter.PeriodPreset == "last30days")">Last 30 Days</option>
                        <option value="last90days" selected="@(filter.PeriodPreset == "last90days")">Last 90 Days</option>
                        <option value="currentmonth" selected="@(filter.PeriodPreset == "currentmonth")">Current Month</option>
                    </select>
                </div>
                <div class="col-md-3 col-sm-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm flex-fill">Update View</button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Scoped KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-primary">
                <div class="card-body p-3">
                    <div class="text-uppercase text-muted small fw-bold">Assigned Events</div>
                    <div class="h3 fw-bold my-1 text-dark">@Model.AssignedEventsCount</div>
                    <div class="small text-muted"><span class="text-success fw-semibold">@Model.PublishedEventsCount</span> Active/Published</div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-success">
                <div class="card-body p-3">
                    <div class="text-uppercase text-muted small fw-bold">Registrations</div>
                    <div class="h3 fw-bold my-1 text-dark">@Model.TotalRegistrations</div>
                    <div class="small text-muted"><span class="text-success fw-semibold">@Model.ConfirmedRegistrations</span> Confirmed</div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-info">
                <div class="card-body p-3">
                    <div class="text-uppercase text-muted small fw-bold">Attendance</div>
                    <div class="h3 fw-bold my-1 text-dark">@Model.AttendancePercentage%</div>
                    <div class="small text-muted"><span class="text-dark fw-semibold">@Model.CheckedInCount</span> / @Model.EligibleAttendanceCount Checked In</div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-warning">
                <div class="card-body p-3">
                    <div class="text-uppercase text-muted small fw-bold">Event Revenue</div>
                    <div class="h3 fw-bold my-1 text-dark">₹@Model.VerifiedRevenue.ToString("N0")</div>
                    <div class="small text-muted">Verified Receipts</div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-secondary">
                <div class="card-body p-3">
                    <div class="text-uppercase text-muted small fw-bold">Feedback Rating</div>
                    <div class="h3 fw-bold my-1 text-dark">@Model.AverageFeedbackRating <span class="text-warning small fs-6">★</span></div>
                    <div class="small text-muted"><span class="text-dark fw-semibold">@Model.FeedbackSubmissions</span> Reviews</div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-danger">
                <div class="card-body p-3">
                    <div class="text-uppercase text-muted small fw-bold">Certificates</div>
                    <div class="h3 fw-bold my-1 text-dark">@Model.CertificatesIssued</div>
                    <div class="small text-muted">Issued to Attendees</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scoped Visualizations -->
    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-0 pt-3 px-3">
                    <h6 class="fw-bold mb-0 text-dark">Participant Registration Flow</h6>
                </div>
                <div class="card-body p-3">
                    <canvas id="chartCoordRegs" height="220"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-0 pt-3 px-3">
                    <h6 class="fw-bold mb-0 text-dark">Attendance Ratio</h6>
                </div>
                <div class="card-body p-3 d-flex flex-column justify-content-center align-items-center">
                    <div style="width: 190px; height: 190px;">
                        <canvas id="chartCoordAtt"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-0 pt-3 px-3">
                    <h6 class="fw-bold mb-0 text-dark">Feedback Rating Spread</h6>
                </div>
                <div class="card-body p-3 d-flex flex-column justify-content-center align-items-center">
                    <div style="width: 190px; height: 190px;">
                        <canvas id="chartCoordFeed"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Event Performance Breakdown Table -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0 text-dark">Assigned Event Performance Breakdown</h6>
            <a asp-action="EventPerformance" class="btn btn-link btn-sm text-decoration-none p-0">Detailed View &rarr;</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Event Title</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th>Confirmed</th>
                            <th>Attendance</th>
                            <th>Revenue</th>
                            <th>Rating</th>
                            <th class="pe-3">Certs</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.EventPerformance.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">No assigned events found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var ev in Model.EventPerformance)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-dark">@ev.EventTitle</td>
                                    <td><span class="badge @(ev.Status == CollegeEventRegistration.Core.Enums.EventStatus.Published ? "bg-success" : "bg-primary")">@ev.Status</span></td>
                                    <td>@ev.StartDate.ToString("MMM dd, yyyy")</td>
                                    <td class="fw-bold text-success">@ev.ConfirmedRegistrations / @ev.TotalCapacity</td>
                                    <td>@ev.AttendanceCount (@ev.AttendancePercentage%)</td>
                                    <td class="fw-bold">₹@ev.VerifiedRevenue.ToString("N0")</td>
                                    <td>@(ev.FeedbackCount > 0 ? $"{ev.AverageRating:F1} ★" : "N/A")</td>
                                    <td class="pe-3 fw-semibold text-primary">@ev.CertificatesIssued</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const regLabels = @Html.Raw(JsonSerializer.Serialize(Model.RegistrationTrend.Select(x => x.Label)));
            const regCounts = @Html.Raw(JsonSerializer.Serialize(Model.RegistrationTrend.Select(x => x.Count)));

            const attLabels = @Html.Raw(JsonSerializer.Serialize(Model.AttendanceDistribution.Select(x => x.Category)));
            const attCounts = @Html.Raw(JsonSerializer.Serialize(Model.AttendanceDistribution.Select(x => x.Count)));

            const feedLabels = @Html.Raw(JsonSerializer.Serialize(Model.FeedbackRatingDistribution.Select(x => x.Category)));
            const feedCounts = @Html.Raw(JsonSerializer.Serialize(Model.FeedbackRatingDistribution.Select(x => x.Count)));

            const ctxReg = document.getElementById('chartCoordRegs');
            if (ctxReg) {
                new Chart(ctxReg, {
                    type: 'line',
                    data: {
                        labels: regLabels.length ? regLabels : ['No Data'],
                        datasets: [{
                            label: 'Registrations',
                            data: regCounts.length ? regCounts : [0],
                            borderColor: '#712dfc',
                            backgroundColor: 'rgba(113, 45, 252, 0.1)',
                            fill: true,
                            tension: 0.35,
                            borderWidth: 2,
                            pointRadius: 4,
                            pointBackgroundColor: '#712dfc'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
                    }
                });
            }

            const ctxAtt = document.getElementById('chartCoordAtt');
            if (ctxAtt) {
                new Chart(ctxAtt, {
                    type: 'doughnut',
                    data: {
                        labels: attLabels.length ? attLabels : ['No Data'],
                        datasets: [{
                            data: attCounts.length ? attCounts : [1],
                            backgroundColor: ['#10b981', '#cbd5e1']
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom' } }
                    }
                });
            }

            const ctxFeed = document.getElementById('chartCoordFeed');
            if (ctxFeed) {
                new Chart(ctxFeed, {
                    type: 'doughnut',
                    data: {
                        labels: feedLabels.length ? feedLabels : ['No Data'],
                        datasets: [{
                            data: feedCounts.length ? feedCounts : [1],
                            backgroundColor: ['#ef4444', '#f97316', '#facc15', '#38bdf8', '#22c55e']
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom' } }
                    }
                });
            }
        });
    </script>
}
