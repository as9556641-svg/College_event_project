@model CollegeEventRegistration.Core.DTOs.PagedResult<CollegeEventRegistration.Core.DTOs.EventPerformanceReportItemDto>
@using CollegeEventRegistration.Core.DTOs
@{
    ViewData["Title"] = "Assigned Events Performance";
    Layout = "_DashboardLayout";
    var filter = ViewBag.Filter as AnalyticsFilterDto ?? new AnalyticsFilterDto();
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-action="Index" class="text-decoration-none text-muted small">&larr; Back to Event Analytics</a>
            </div>
            <h1 class="h3 mb-0 text-dark fw-bold">Assigned Events Performance</h1>
            <p class="text-muted small mb-0">Detailed breakdown of registrations, verified payments, attendance rates, and feedback for your assigned events.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ExportCsv" asp-route-reportType="events" 
               asp-route-periodPreset="@filter.PeriodPreset"
               asp-route-searchTerm="@filter.SearchTerm"
               class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1 shadow-sm">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                <span>Export CSV</span>
            </a>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="EventPerformance" class="row g-2 align-items-end">
                <div class="col-md-5 col-sm-6">
                    <label class="form-label small fw-semibold text-muted mb-1">Search Event</label>
                    <input type="text" name="SearchTerm" value="@filter.SearchTerm" class="form-control form-control-sm" placeholder="Title, Venue..." />
                </div>
                <div class="col-md-4 col-sm-6">
                    <label class="form-label small fw-semibold text-muted mb-1">Reporting Period</label>
                    <select name="PeriodPreset" class="form-select form-select-sm">
                        <option value="all" selected="@(filter.PeriodPreset == "all" || string.IsNullOrEmpty(filter.PeriodPreset))">All Time</option>
                        <option value="last7days" selected="@(filter.PeriodPreset == "last7days")">Last 7 Days</option>
                        <option value="last30days" selected="@(filter.PeriodPreset == "last30days")">Last 30 Days</option>
                        <option value="last90days" selected="@(filter.PeriodPreset == "last90days")">Last 90 Days</option>
                        <option value="currentmonth" selected="@(filter.PeriodPreset == "currentmonth")">Current Month</option>
                    </select>
                </div>
                <div class="col-md-3 col-sm-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm flex-fill">Apply</button>
                    <a asp-action="EventPerformance" class="btn btn-outline-secondary btn-sm">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Event Title</th>
                            <th>Department</th>
                            <th>Category</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Registrations</th>
                            <th>Attendance</th>
                            <th>Revenue</th>
                            <th>Rating</th>
                            <th class="pe-3">Certs</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Items.Any())
                        {
                            <tr>
                                <td colspan="10" class="text-center py-5 text-muted">
                                    No assigned events match the selected criteria.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var ev in Model.Items)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <div class="fw-bold text-dark">@ev.EventTitle</div>
                                        <div class="small text-muted">ID: #@ev.EventId &bull; Cap: @ev.TotalCapacity</div>
                                    </td>
                                    <td><span class="badge bg-secondary-subtle text-secondary">@ev.DepartmentName</span></td>
                                    <td>@ev.CategoryName</td>
                                    <td>@ev.StartDate.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <span class="badge @(ev.Status == CollegeEventRegistration.Core.Enums.EventStatus.Published ? "bg-success" : (ev.Status == CollegeEventRegistration.Core.Enums.EventStatus.Cancelled ? "bg-danger" : "bg-primary"))">
                                            @ev.Status
                                        </span>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-success">@ev.ConfirmedRegistrations</span>
                                        <span class="text-muted small">/ @ev.TotalRegistrations total</span>
                                        @if (ev.WaitlistedRegistrations > 0)
                                        {
                                            <div class="small text-warning">@ev.WaitlistedRegistrations waitlist</div>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@ev.AttendanceCount / @ev.ConfirmedRegistrations</div>
                                        <div class="small text-muted">@ev.AttendancePercentage%</div>
                                    </td>
                                    <td class="fw-bold text-dark">
                                        @(ev.VerifiedRevenue > 0 ? $"₹{ev.VerifiedRevenue:N0}" : "Free")
                                    </td>
                                    <td>
                                        @if (ev.FeedbackCount > 0)
                                        {
                                            <span class="fw-semibold text-dark">@ev.AverageRating.ToString("F1")</span>
                                            <span class="text-warning">★</span>
                                            <span class="small text-muted">(@ev.FeedbackCount)</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">None</span>
                                        }
                                    </td>
                                    <td class="pe-3 fw-semibold text-primary">
                                        @ev.CertificatesIssued
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-transparent border-top p-3 d-flex justify-content-between align-items-center">
                <span class="small text-muted">Showing page @Model.PageNumber of @Model.TotalPages (@Model.TotalCount total events)</span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="EventPerformance" 
                               asp-route-page="@(Model.PageNumber - 1)" 
                               asp-route-searchTerm="@filter.SearchTerm"
                               asp-route-periodPreset="@filter.PeriodPreset">Previous</a>
                        </li>
                        <li class="page-item active"><span class="page-link">@Model.PageNumber</span></li>
                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="EventPerformance" 
                               asp-route-page="@(Model.PageNumber + 1)" 
                               asp-route-searchTerm="@filter.SearchTerm"
                               asp-route-periodPreset="@filter.PeriodPreset">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
