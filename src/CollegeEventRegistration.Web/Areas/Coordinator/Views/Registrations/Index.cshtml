@model CollegeEventRegistration.Core.DTOs.PagedResult<CollegeEventRegistration.Core.DTOs.RegistrationSummaryDto>
@using CollegeEventRegistration.Core.Enums
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Participant Registrations";
    var criteria = (CollegeEventRegistration.Core.DTOs.RegistrationFilterCriteria)(ViewBag.Criteria ?? new CollegeEventRegistration.Core.DTOs.RegistrationFilterCriteria());
    var eventsList = (List<SelectListItem>)(ViewBag.CoordinatedEvents ?? new List<SelectListItem>());
}

<div class="dash-page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge badge-role badge-role-coord">Faculty Coordinator</span>
            <span class="text-muted small">Participant Management</span>
        </div>
        <h2 class="dash-page-title">Event Registrations &amp; Participants</h2>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <div class="d-flex align-items-center gap-2">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            <span>@TempData["SuccessMessage"]</span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <div class="d-flex align-items-center gap-2">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <span>@TempData["ErrorMessage"]</span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!eventsList.Any())
{
    <div class="dash-panel text-center py-5">
        <div class="dash-empty-state-icon-wrap mx-auto mb-3" style="width: 56px; height: 56px; background-color: #F1F5F9; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
        </div>
        <h5 class="fw-bold text-dark mb-1">No Coordinated Events</h5>
        <p class="text-muted small mb-0">You are currently not assigned to coordinate any events.</p>
    </div>
}
else
{
    <!-- Filter and Selection Panel -->
    <div class="dash-panel mb-4 p-3">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label small fw-semibold text-muted">Select Event</label>
                <select name="EventId" class="form-select" onchange="this.form.submit()">
                    @foreach (var ev in eventsList)
                    {
                        <option value="@ev.Value" selected="@ev.Selected">@ev.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted">Search Student</label>
                <input type="text" name="SearchTerm" class="form-control" placeholder="Search by name, roll no, email..." value="@criteria.SearchTerm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Status</label>
                <select name="Status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="@RegistrationStatus.Confirmed" selected="@(criteria.Status == RegistrationStatus.Confirmed)">Confirmed</option>
                    <option value="@RegistrationStatus.Pending" selected="@(criteria.Status == RegistrationStatus.Pending)">Pending</option>
                    <option value="@RegistrationStatus.Waitlisted" selected="@(criteria.Status == RegistrationStatus.Waitlisted)">Waitlisted</option>
                    <option value="@RegistrationStatus.Cancelled" selected="@(criteria.Status == RegistrationStatus.Cancelled)">Cancelled</option>
                </select>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
            </div>
        </form>
    </div>

    <!-- Registrations Table -->
    <div class="dash-panel">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Registration #</th>
                        <th>Student Name</th>
                        <th>Roll No &amp; Dept</th>
                        <th>Registered At</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Manage Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count > 0)
                    {
                        @foreach (var reg in Model.Items)
                        {
                            <tr>
                                <td class="ps-3">
                                    <span class="font-monospace fw-semibold text-primary">@reg.RegistrationNumber</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@reg.StudentName</div>
                                    <div class="small text-muted">@reg.StudentEmail</div>
                                </td>
                                <td class="small">
                                    <div>@(reg.StudentRollNumber ?? "N/A")</div>
                                    <div class="text-muted">@(reg.StudentDepartment ?? "N/A") @(reg.StudentYearOfStudy.HasValue ? $"• Year {reg.StudentYearOfStudy}" : "")</div>
                                </td>
                                <td class="small text-muted text-nowrap">
                                    @reg.RegisteredAt.ToString("MMM dd, yyyy HH:mm") UTC
                                </td>
                                <td>
                                    @switch (reg.Status)
                                    {
                                        case RegistrationStatus.Confirmed:
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">Confirmed</span>
                                            break;
                                        case RegistrationStatus.Pending:
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Pending Review</span>
                                            break;
                                        case RegistrationStatus.Waitlisted:
                                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">Waitlisted</span>
                                            break;
                                        case RegistrationStatus.Cancelled:
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Cancelled</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="dropdown d-inline-block">
                                        <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            Update
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border py-1">
                                            @if (reg.Status != RegistrationStatus.Confirmed)
                                            {
                                                <li>
                                                    <form asp-action="UpdateStatus" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="RegistrationId" value="@reg.Id" />
                                                        <input type="hidden" name="NewStatus" value="@RegistrationStatus.Confirmed" />
                                                        <input type="hidden" name="returnEventId" value="@reg.EventId" />
                                                        <button type="submit" class="dropdown-item small text-success py-1 d-flex align-items-center gap-2">
                                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                                            <span>Approve / Confirm</span>
                                                        </button>
                                                    </form>
                                                </li>
                                            }
                                            @if (reg.Status != RegistrationStatus.Waitlisted)
                                            {
                                                <li>
                                                    <form asp-action="UpdateStatus" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="RegistrationId" value="@reg.Id" />
                                                        <input type="hidden" name="NewStatus" value="@RegistrationStatus.Waitlisted" />
                                                        <input type="hidden" name="returnEventId" value="@reg.EventId" />
                                                        <button type="submit" class="dropdown-item small text-info-emphasis py-1 d-flex align-items-center gap-2">
                                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                                            <span>Move to Waitlist</span>
                                                        </button>
                                                    </form>
                                                </li>
                                            }
                                            @if (reg.Status != RegistrationStatus.Cancelled)
                                            {
                                                <li>
                                                    <form asp-action="UpdateStatus" method="post" onsubmit="return confirm('Cancel this student registration?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="RegistrationId" value="@reg.Id" />
                                                        <input type="hidden" name="NewStatus" value="@RegistrationStatus.Cancelled" />
                                                        <input type="hidden" name="returnEventId" value="@reg.EventId" />
                                                        <button type="submit" class="dropdown-item small text-danger py-1 d-flex align-items-center gap-2">
                                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                                                            <span>Cancel Registration</span>
                                                        </button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                No student registrations found for this event matching the criteria.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3 border-top">
                <span class="text-muted small">Showing @Model.Items.Count of @Model.TotalCount registrations</span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-route-PageNumber="@(Model.PageNumber - 1)" asp-route-EventId="@criteria.EventId" asp-route-Status="@criteria.Status" asp-route-SearchTerm="@criteria.SearchTerm">&laquo;</a>
                        </li>
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-PageNumber="@p" asp-route-EventId="@criteria.EventId" asp-route-Status="@criteria.Status" asp-route-SearchTerm="@criteria.SearchTerm">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-route-PageNumber="@(Model.PageNumber + 1)" asp-route-EventId="@criteria.EventId" asp-route-Status="@criteria.Status" asp-route-SearchTerm="@criteria.SearchTerm">&raquo;</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
}
