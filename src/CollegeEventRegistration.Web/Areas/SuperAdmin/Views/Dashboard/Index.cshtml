@model CollegeEventRegistration.Web.Areas.SuperAdmin.Models.SuperAdminDashboardViewModel
@{
    ViewData["Title"] = "System Governance Dashboard";
}

<!-- Welcome & System Header -->
<div class="row align-items-center mb-4">
    <div class="col-lg-8">
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge badge-role badge-role-admin">Super Admin Portal</span>
            <span class="text-muted small">System Governance &amp; Operations</span>
        </div>
        <h2 class="fw-bold mb-1" style="color: #0F172A; letter-spacing: -0.02em;">
            Welcome, @(Model?.CurrentUser?.FullName ?? "Root Administrator")
        </h2>
        <p class="text-muted small mb-0">
            Real-time telemetry and management controls for VAP UNIVERSITY's event ecosystem.
        </p>
    </div>
    <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-2 bg-white rounded-pill border shadow-sm">
            <span class="dash-pulse-dot"></span>
            <span class="fw-semibold text-success small">System Operational</span>
            <span class="text-muted small">&bull; .NET 10 LTS</span>
        </div>
    </div>
</div>

<!-- Primary Metric Cards Grid -->
<div class="row g-3 g-xl-4 mb-4">
    <!-- Total Users -->
    <div class="col-sm-6 col-xl-4">
        <div class="dash-metric-card">
            <div>
                <div class="dash-metric-header">
                    <span class="dash-metric-label">Total Users</span>
                    <div class="dash-metric-icon-wrap icon-wrap-blue">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </div>
                </div>
                <div class="dash-metric-value text-primary">@Model?.TotalUsers</div>
            </div>
            <p class="dash-metric-subtext">Registered across all system roles</p>
        </div>
    </div>

    <!-- Departments -->
    <div class="col-sm-6 col-xl-4">
        <div class="dash-metric-card">
            <div>
                <div class="dash-metric-header">
                    <span class="dash-metric-label">Departments</span>
                    <div class="dash-metric-icon-wrap icon-wrap-green">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                        </svg>
                    </div>
                </div>
                <div class="dash-metric-value" style="color: #059669;">@Model?.TotalDepartments</div>
            </div>
            <p class="dash-metric-subtext">Active academic departments</p>
        </div>
    </div>

    <!-- Event Categories -->
    <div class="col-sm-6 col-xl-4">
        <div class="dash-metric-card">
            <div>
                <div class="dash-metric-header">
                    <span class="dash-metric-label">Categories</span>
                    <div class="dash-metric-icon-wrap icon-wrap-purple">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="8" y1="6" x2="21" y2="6"></line>
                            <line x1="8" y1="12" x2="21" y2="12"></line>
                            <line x1="8" y1="18" x2="21" y2="18"></line>
                            <line x1="3" y1="6" x2="3.01" y2="6"></line>
                            <line x1="3" y1="12" x2="3.01" y2="12"></line>
                            <line x1="3" y1="18" x2="3.01" y2="18"></line>
                        </svg>
                    </div>
                </div>
                <div class="dash-metric-value" style="color: #7C3AED;">@Model?.TotalCategories</div>
            </div>
            <p class="dash-metric-subtext">Configured event classifications</p>
        </div>
    </div>

    <!-- Total Events -->
    <div class="col-sm-6 col-xl-4">
        <div class="dash-metric-card">
            <div>
                <div class="dash-metric-header">
                    <span class="dash-metric-label">Total Events</span>
                    <div class="dash-metric-icon-wrap icon-wrap-blue">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                    </div>
                </div>
                <div class="dash-metric-value">@Model?.TotalEvents</div>
            </div>
            <p class="dash-metric-subtext">Workshops, hackathons &amp; seminars</p>
        </div>
    </div>

    <!-- Pending Approvals -->
    <div class="col-sm-6 col-xl-4">
        <div class="dash-metric-card">
            <div>
                <div class="dash-metric-header">
                    <span class="dash-metric-label">Pending Approval</span>
                    <div class="dash-metric-icon-wrap icon-wrap-amber">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                    </div>
                </div>
                <div class="dash-metric-value text-warning">@Model?.PendingApprovals</div>
            </div>
            <p class="dash-metric-subtext">Draft events awaiting admin review</p>
        </div>
    </div>

    <!-- Database Engine -->
    <div class="col-sm-6 col-xl-4">
        <div class="dash-metric-card">
            <div>
                <div class="dash-metric-header">
                    <span class="dash-metric-label">Database Engine</span>
                    <div class="dash-metric-icon-wrap icon-wrap-green">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                            <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                            <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                        </svg>
                    </div>
                </div>
                <div class="dash-metric-value-sm">SQL 2025</div>
            </div>
            <p class="dash-metric-subtext">Express Edition &bull; localhost\SQLEXPRESS</p>
        </div>
    </div>
</div>

<!-- Secondary Activity & Architecture Section -->
<div class="row g-3 g-xl-4 mb-4">
    <!-- Real Database-Backed Recent Activity / Audit Log -->
    <div class="col-lg-8">
        <div class="dash-panel h-100">
            <div class="dash-panel-header">
                <h5 class="dash-panel-title d-flex align-items-center gap-2">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
                        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                    </svg>
                    <span>System Audit Trail &amp; Activity</span>
                </h5>
                <span class="badge bg-light text-muted border">Live Logs</span>
            </div>
            <div class="dash-panel-body p-0">
                @if (Model?.RecentAuditLogs != null && Model.RecentAuditLogs.Any())
                {
                    <div class="table-responsive">
                        <table class="dash-table">
                            <thead>
                                <tr>
                                    <th>Timestamp (UTC)</th>
                                    <th>Action</th>
                                    <th>Entity</th>
                                    <th>Operator</th>
                                    <th>IP Address</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var log in Model.RecentAuditLogs)
                                {
                                    <tr>
                                        <td class="text-nowrap small text-muted">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        <td>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                                @log.Action
                                            </span>
                                        </td>
                                        <td>@log.EntityName</td>
                                        <td>@(log.User?.FullName ?? log.UserId ?? "System")</td>
                                        <td class="text-muted small">@(log.IpAddress ?? "Localhost")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="dash-empty-state">
                        <div class="dash-empty-state-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                            </svg>
                        </div>
                        <h6 class="dash-empty-state-title">No Audit Entries Recorded Yet</h6>
                        <p class="dash-empty-state-desc">
                            Database audit trail is active. Administrative events, role assignments, and security operations will be logged here.
                        </p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Governance Modules Overview -->
    <div class="col-lg-4">
        <div class="dash-panel h-100">
            <div class="dash-panel-header">
                <h5 class="dash-panel-title d-flex align-items-center gap-2">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
                        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                        <polyline points="2 17 12 22 22 17"></polyline>
                        <polyline points="2 12 12 17 22 12"></polyline>
                    </svg>
                    <span>System Architecture</span>
                </h5>
                <span class="badge badge-role badge-role-admin">Status</span>
            </div>
            <div class="dash-panel-body p-3">
                <div class="d-flex flex-column gap-2">
                    <div class="dash-arch-item">
                        <span class="dash-arch-badge bg-success-subtle text-success">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                        </span>
                        <div>
                            <div class="fw-semibold small text-dark">Phase 1: Foundation &amp; Setup</div>
                            <div class="text-muted" style="font-size: 0.76rem;">Clean Architecture, .NET 10 LTS, Git initialized</div>
                        </div>
                    </div>

                    <div class="dash-arch-item">
                        <span class="dash-arch-badge bg-success-subtle text-success">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                        </span>
                        <div>
                            <div class="fw-semibold small text-dark">Phase 2: Database &amp; Identity</div>
                            <div class="text-muted" style="font-size: 0.76rem;">22 Tables, EF Core Migrations, Protected SuperAdmin</div>
                        </div>
                    </div>

                    <div class="dash-arch-item">
                        <span class="dash-arch-badge bg-success-subtle text-success">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                        </span>
                        <div>
                            <div class="fw-semibold small text-dark">Phase 3 &amp; 3.1: Authentication UI</div>
                            <div class="text-muted" style="font-size: 0.76rem;">Centered card design, CSRF protection, secure auth</div>
                        </div>
                    </div>

                    <div class="dash-arch-item">
                        <span class="dash-arch-badge bg-secondary-subtle text-secondary">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="8" x2="12" y2="12"></line>
                                <line x1="12" y1="16" x2="12.01" y2="16"></line>
                            </svg>
                        </span>
                        <div>
                            <div class="fw-semibold small text-dark">Phase 4: Event Management &amp; Workspaces</div>
                            <div class="text-muted" style="font-size: 0.76rem;">Department, category &amp; event CRUD operations (Upcoming)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
