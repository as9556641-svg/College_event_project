@model CollegeEventRegistration.Core.Entities.ApplicationUser
@{
    ViewData["Title"] = "Super Admin Governance Dashboard";
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge badge-role badge-role-admin">Super Admin Portal</span>
            <span class="text-muted small">System Governance & Operations</span>
        </div>
        <h2 class="fw-bold mb-0">Welcome, @(Model?.FullName ?? "Administrator")</h2>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
            System Operational
        </span>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-3">
        <div class="card card-3d p-4 h-100">
            <span class="text-muted small text-uppercase fw-semibold">Total Users</span>
            <h3 class="fw-bold my-2 text-primary">@ViewBag.TotalUsers</h3>
            <span class="text-muted small">Registered in system</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-3d p-4 h-100">
            <span class="text-muted small text-uppercase fw-semibold">Departments</span>
            <h3 class="fw-bold my-2 text-primary">@ViewBag.TotalDepartments</h3>
            <span class="text-muted small">Active departments</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-3d p-4 h-100">
            <span class="text-muted small text-uppercase fw-semibold">Event Categories</span>
            <h3 class="fw-bold my-2 text-primary">@ViewBag.TotalCategories</h3>
            <span class="text-muted small">System categories</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-3d p-4 h-100">
            <span class="text-muted small text-uppercase fw-semibold">Total Events</span>
            <h3 class="fw-bold my-2 text-primary">@ViewBag.TotalEvents</h3>
            <span class="text-muted small">Workshops & contests</span>
        </div>
    </div>
</div>

