@model CollegeEventRegistration.Web.Areas.SuperAdmin.Models.DepartmentDetailsViewModel
@{
    ViewData["Title"] = $"{Model.Department.Name} Details";
    Layout = "_DashboardLayout";
}

<div class="container-fluid px-0" style="max-width: 960px;">
    <!-- Breadcrumb & Header -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2 small">
            <li class="breadcrumb-item"><a asp-area="SuperAdmin" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">Governance</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Departments</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Department.Code</li>
        </ol>
    </nav>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 fw-bold font-monospace">@Model.Department.Code</span>
                @if (Model.Department.IsActive)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Active</span>
                }
                else
                {
                    <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">Inactive</span>
                }
            </div>
            <h1 class="h3 fw-bold text-dark mb-0">@Model.Department.Name</h1>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Department.Id" class="btn btn-outline-primary px-3 rounded-pill">
                Edit Department
            </a>
            @if (Model.CanDelete)
            {
                <form asp-action="Delete" asp-route-id="@Model.Department.Id" method="post" onsubmit="return confirm('Are you sure you want to permanently delete this department?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger px-3 rounded-pill">Delete</button>
                </form>
            }
        </div>
    </div>

    @if (!Model.CanDelete && !string.IsNullOrEmpty(Model.DeleteBlockReason))
    {
        <div class="alert alert-warning border-0 rounded-3 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-warning flex-shrink-0">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                <line x1="12" y1="9" x2="12" y2="13"></line>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
            <div class="small">@Model.DeleteBlockReason</div>
        </div>
    }

    <!-- Stat Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="text-muted small fw-semibold text-uppercase">Faculty & Students</div>
                <div class="h2 fw-bold text-dark mb-0 mt-2">@Model.UserCount</div>
                <div class="small text-muted mt-1">Registered members</div>
            </div>
        </div>
        <div class="col-sm-6 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="text-muted small fw-semibold text-uppercase">Organized Events</div>
                <div class="h2 fw-bold text-primary mb-0 mt-2">@Model.EventCount</div>
                <div class="small text-muted mt-1">All recorded events</div>
            </div>
        </div>
        <div class="col-sm-6 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="text-muted small fw-semibold text-uppercase">Head of Department</div>
                <div class="h5 fw-bold text-dark mb-0 mt-2">@(string.IsNullOrEmpty(Model.Department.HeadOfDepartment) ? "Not Assigned" : Model.Department.HeadOfDepartment)</div>
                <div class="small text-muted mt-1">Lead Academic Officer</div>
            </div>
        </div>
    </div>

    <!-- Description & Info Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
            <h5 class="fw-bold text-dark mb-0">Department Profile</h5>
        </div>
        <div class="card-body p-4">
            <p class="text-muted mb-3">
                @(string.IsNullOrEmpty(Model.Department.Description) ? "No description provided for this department." : Model.Department.Description)
            </p>
            <div class="row g-2 pt-2 border-top text-muted small">
                <div class="col-sm-6">Created: <strong class="text-dark">@Model.Department.CreatedAt.ToString("MMM dd, yyyy HH:mm")</strong></div>
                @if (Model.Department.UpdatedAt.HasValue)
                {
                    <div class="col-sm-6">Last Updated: <strong class="text-dark">@Model.Department.UpdatedAt.Value.ToString("MMM dd, yyyy HH:mm")</strong></div>
                }
            </div>
        </div>
    </div>

    <!-- Associated Events Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2">
            <h5 class="fw-bold text-dark mb-0">Recent Events by @Model.Department.Code</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4 text-secondary small fw-semibold">Event Title</th>
                        <th class="text-secondary small fw-semibold">Schedule</th>
                        <th class="text-secondary small fw-semibold text-center">Status</th>
                        <th class="pe-4 text-secondary small fw-semibold text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.AssociatedEvents.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted small">
                                No events have been hosted by this department yet.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var ev in Model.AssociatedEvents)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-semibold text-dark">@ev.Title</div>
                                    <div class="text-muted small font-monospace">#EV-@ev.Id.ToString("D4")</div>
                                </td>
                                <td>
                                    <div class="small text-dark">@ev.EventStartDate.ToString("MMM dd, yyyy")</div>
                                    <div class="small text-muted">@ev.EventStartDate.ToString("hh:mm tt")</div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border px-2 py-1">@ev.Status</span>
                                </td>
                                <td class="pe-4 text-end">
                                    <a asp-area="Admin" asp-controller="Events" asp-action="Details" asp-route-id="@ev.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        View
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
