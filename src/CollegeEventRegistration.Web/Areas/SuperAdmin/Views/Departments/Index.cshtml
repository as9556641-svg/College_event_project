@model CollegeEventRegistration.Web.Areas.SuperAdmin.Models.DepartmentIndexViewModel
@{
    ViewData["Title"] = "Department Governance";
    Layout = "_DashboardLayout";
}

<div class="container-fluid px-0">
    <!-- Header Block -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-area="SuperAdmin" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">Governance</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Departments</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold text-dark mb-0">Department Management</h1>
            <p class="text-muted small mb-0">Manage university academic departments, administrative divisions, and organizational codes.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 py-2 shadow-sm rounded-pill">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>Add Department</span>
            </a>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center gap-2 mb-4" role="alert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success flex-shrink-0">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center gap-2 mb-4" role="alert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-danger flex-shrink-0">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="15" y1="9" x2="9" y2="15"></line>
                <line x1="9" y1="9" x2="15" y2="15"></line>
            </svg>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search & Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-md-8 col-lg-6">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0 text-muted ps-3">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                        </span>
                        <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control border-start-0 ps-0" placeholder="Search by name, code, or department head..." />
                        <button type="submit" class="btn btn-outline-primary px-3">Search</button>
                        @if (!string.IsNullOrEmpty(Model.SearchTerm))
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary px-3">Clear</a>
                        }
                    </div>
                </div>
                <div class="col-md-4 col-lg-6 text-md-end text-muted small">
                    Total Departments: <strong class="text-dark">@Model.Departments.Count</strong>
                </div>
            </form>
        </div>
    </div>

    <!-- Departments Table Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4 text-secondary small fw-semibold text-uppercase" style="width: 120px;">Code</th>
                        <th class="text-secondary small fw-semibold text-uppercase">Department Name</th>
                        <th class="text-secondary small fw-semibold text-uppercase">Head of Department</th>
                        <th class="text-secondary small fw-semibold text-uppercase text-center">Faculty / Students</th>
                        <th class="text-secondary small fw-semibold text-uppercase text-center">Events</th>
                        <th class="text-secondary small fw-semibold text-uppercase text-center">Status</th>
                        <th class="pe-4 text-secondary small fw-semibold text-uppercase text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Departments.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mb-2 text-muted opacity-50">
                                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                                </svg>
                                <div>No departments found matching your criteria.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var dept in Model.Departments)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 fw-bold font-monospace">@dept.Code</span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@dept.Name</div>
                                    @if (!string.IsNullOrEmpty(dept.Description))
                                    {
                                        <div class="text-muted small text-truncate" style="max-width: 320px;">@dept.Description</div>
                                    }
                                </td>
                                <td>
                                    <span class="text-secondary small">@(string.IsNullOrEmpty(dept.HeadOfDepartment) ? "—" : dept.HeadOfDepartment)</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border px-2 py-1">@dept.UserCount</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border px-2 py-1">@dept.EventCount</span>
                                </td>
                                <td class="text-center">
                                    @if (dept.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">Inactive</span>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-light border rounded-pill px-3" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            Manage
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                                            <li>
                                                <a asp-action="Details" asp-route-id="@dept.Id" class="dropdown-item py-2">
                                                    View Details
                                                </a>
                                            </li>
                                            <li>
                                                <a asp-action="Edit" asp-route-id="@dept.Id" class="dropdown-item py-2">
                                                    Edit Department
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <form asp-action="ToggleStatus" asp-route-id="@dept.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item py-2 @(dept.IsActive ? "text-warning" : "text-success")">
                                                        @(dept.IsActive ? "Deactivate" : "Activate")
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

