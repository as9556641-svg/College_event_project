@model CollegeEventRegistration.Web.Areas.Admin.Models.UserDetailsViewModel
@{
    ViewData["Title"] = $"User Details - {Model.User.FullName}";
    Layout = "_DashboardLayout";
    var area = "SuperAdmin";
}

<div class="container-fluid px-0">
    <!-- Header Block -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-area="@area" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-area="@area" asp-controller="Users" asp-action="Index" class="text-decoration-none">Users</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.User.FullName</li>
                </ol>
            </nav>
            <div class="d-flex align-items-center gap-3">
                <h1 class="h3 fw-bold text-dark mb-0">@Model.User.FullName</h1>
                @if (Model.User.IsActive)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">Active Account</span>
                }
                else
                {
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill">Deactivated</span>
                }
                @if (Model.User.IsSuperAdminProtected)
                {
                    <span class="badge bg-dark text-white rounded-pill px-3 py-1">Protected Root SuperAdmin</span>
                }
            </div>
            <p class="text-muted small mb-0">Institutional profile, assigned security roles, and activity ledger.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.User.Id" class="btn btn-outline-secondary px-3 py-2 rounded-pill shadow-sm">
                Edit Profile
            </a>
            <a asp-action="Index" class="btn btn-light px-3 py-2 rounded-pill shadow-sm border">
                Back to Users
            </a>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center gap-2 mb-4" role="alert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success flex-shrink-0">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center gap-2 mb-4" role="alert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-danger flex-shrink-0">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="15" y1="9" x2="9" y2="15"></line>
                <line x1="9" y1="9" x2="15" y2="15"></line>
            </svg>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="text-muted small fw-semibold text-uppercase">Authored Events</div>
                <h3 class="fw-bold text-dark mt-1 mb-0">@Model.User.CreatedEventsCount</h3>
                <span class="text-muted smaller">Created by this account</span>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="text-muted small fw-semibold text-uppercase">Assigned Coordinated Events</div>
                <h3 class="fw-bold text-dark mt-1 mb-0">@Model.User.CoordinatedEventsCount</h3>
                <span class="text-muted smaller">Active coordinator assignments</span>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="text-muted small fw-semibold text-uppercase">Event Registrations</div>
                <h3 class="fw-bold text-dark mt-1 mb-0">@Model.User.RegistrationsCount</h3>
                <span class="text-muted smaller">Tickets / registrations recorded</span>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Profile Info -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 py-3 px-4">
                    <h5 class="fw-bold text-dark mb-0">Account Profile &amp; Demographics</h5>
                </div>
                <div class="card-body p-4 pt-0">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="form-label text-muted small text-uppercase fw-semibold mb-1">Full Legal Name</label>
                            <div class="fw-bold text-dark">@Model.User.FullName</div>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label text-muted small text-uppercase fw-semibold mb-1">Email Address</label>
                            <div class="fw-bold text-dark font-monospace">@Model.User.Email</div>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label text-muted small text-uppercase fw-semibold mb-1">Department / Faculty</label>
                            <div class="fw-bold text-dark">@(string.IsNullOrEmpty(Model.User.Department) ? "Not Specified" : Model.User.Department)</div>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label text-muted small text-uppercase fw-semibold mb-1">College / Campus</label>
                            <div class="fw-bold text-dark">@(string.IsNullOrEmpty(Model.User.CollegeName) ? "VAP UNIVERSITY" : Model.User.CollegeName)</div>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label text-muted small text-uppercase fw-semibold mb-1">Roll / Employee Number</label>
                            <div class="fw-bold text-dark font-monospace">@(string.IsNullOrEmpty(Model.User.RollNumber) ? "None" : Model.User.RollNumber)</div>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label text-muted small text-uppercase fw-semibold mb-1">Year of Study</label>
                            <div class="fw-bold text-dark">@(Model.User.YearOfStudy.HasValue ? $"Year {Model.User.YearOfStudy.Value}" : "N/A (Staff/Faculty)")</div>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label text-muted small text-uppercase fw-semibold mb-1">Contact Phone</label>
                            <div class="fw-bold text-dark">@(string.IsNullOrEmpty(Model.User.PhoneNumber) ? "Not Registered" : Model.User.PhoneNumber)</div>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label text-muted small text-uppercase fw-semibold mb-1">Account Created At</label>
                            <div class="fw-bold text-dark">@Model.User.CreatedAt.ToString("f")</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Audit Trail Card -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 py-3 px-4">
                    <h5 class="fw-bold text-dark mb-0">Recent Activity &amp; Audit Trail</h5>
                </div>
                <div class="card-body p-4 pt-0">
                    @if (!Model.User.RecentAuditLogs.Any())
                    {
                        <div class="text-muted small py-3">No recent audit log entries recorded for this account.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light small text-muted">
                                    <tr>
                                        <th>Timestamp</th>
                                        <th>Action</th>
                                        <th>Entity</th>
                                        <th>Details</th>
                                    </tr>
                                </thead>
                                <tbody class="small">
                                    @foreach (var log in Model.User.RecentAuditLogs)
                                    {
                                        <tr>
                                            <td class="text-muted">@log.Timestamp.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td><span class="badge bg-secondary-subtle text-secondary">@log.Action</span></td>
                                            <td>@log.EntityName</td>
                                            <td class="text-truncate" style="max-width: 280px;" title="@log.NewValues">@log.NewValues</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sidebar Actions & Role Assignment -->
        <div class="col-lg-4">
            <!-- Role Assignment Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 py-3 px-4">
                    <h5 class="fw-bold text-dark mb-0">Security Role Assignment</h5>
                </div>
                <div class="card-body p-4 pt-0">
                    <div class="mb-3">
                        <label class="form-label text-muted small text-uppercase fw-semibold mb-1">Active Roles</label>
                        <div>
                            @foreach (var r in Model.User.Roles)
                            {
                                <span class="badge bg-primary px-3 py-2 fs-6 me-1 mb-1">@r</span>
                            }
                        </div>
                    </div>

                    @if (Model.CanChangeRole)
                    {
                        <form asp-action="ChangeRole" method="post" class="mt-4 pt-3 border-top" onsubmit="return confirm('Confirm changing security role for this user?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="UserId" value="@Model.User.Id" />

                            <div class="mb-3">
                                <label class="form-label fw-semibold small text-muted">Reassign System Role</label>
                                <select name="NewRole" class="form-select bg-light border-0 py-2">
                                    @foreach (var r in Model.AvailableRoles)
                                    {
                                        <option value="@r.Value" selected="@(Model.User.Roles.Contains(r.Value))">@r.Text</option>
                                    }
                                </select>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 rounded-pill py-2">
                                Update Assigned Role
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-light border small text-muted mt-3 mb-0">
                            Role changes are disabled for the system-protected root SuperAdmin.
                        </div>
                    }
                </div>
            </div>

            <!-- Account Status Card -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 py-3 px-4">
                    <h5 class="fw-bold text-dark mb-0">Account Lifecycle</h5>
                </div>
                <div class="card-body p-4 pt-0">
                    <p class="small text-muted mb-3">
                        Active accounts can authenticate and perform assigned functions. Deactivating immediately blocks login access.
                    </p>

                    @if (Model.CanToggleStatus)
                    {
                        <form asp-action="ToggleStatus" asp-route-id="@Model.User.Id" method="post"
                              onsubmit="return confirm('Are you sure you want to @(Model.User.IsActive ? "deactivate" : "activate") this account?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn w-100 rounded-pill py-2 @(Model.User.IsActive ? "btn-outline-danger" : "btn-success")">
                                @(Model.User.IsActive ? "Deactivate Account" : "Activate Account")
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-light border small text-muted mb-0">
                            Status changes cannot be applied to this account (self-deactivation or protected account).
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
