@model CollegeEventRegistration.Web.Areas.Student.Models.StudentEventDetailsViewModel
@using CollegeEventRegistration.Core.Enums
@{
    Layout = "_StudentPortalLayout";
    ViewData["Title"] = $"{Model.Title} - Event Details";

    string GetThemeClass(string catName)
    {
        var lower = (catName ?? "").ToLowerInvariant();
        if (lower.Contains("technical") || lower.Contains("workshop") || lower.Contains("code")) return "sp-banner-theme-tech";
        if (lower.Contains("hackathon") || lower.Contains("contest") || lower.Contains("compet")) return "sp-banner-theme-hackathon";
        if (lower.Contains("seminar") || lower.Contains("lecture") || lower.Contains("guest")) return "sp-banner-theme-seminar";
        if (lower.Contains("symposium") || lower.Contains("conference")) return "sp-banner-theme-symposium";
        if (lower.Contains("cultural") || lower.Contains("arts") || lower.Contains("music")) return "sp-banner-theme-arts";
        return "sp-banner-theme-default";
    }

    var themeClass = GetThemeClass(Model.CategoryName);
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item">
            <a asp-area="Student" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">Dashboard</a>
        </li>
        <li class="breadcrumb-item">
            <a asp-area="Student" asp-controller="Events" asp-action="Index" class="text-decoration-none">Discover Events</a>
        </li>
        <li class="breadcrumb-item active text-truncate" style="max-width: 320px;" aria-current="page">@Model.Title</li>
    </ol>
</nav>

<!-- Feedback Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <div class="d-flex align-items-center gap-2">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            <span>@TempData["SuccessMessage"]</span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <div class="d-flex align-items-center gap-2">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <span>@TempData["ErrorMessage"]</span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Details Hero Banner -->
<div class="sp-details-hero shadow-sm">
    @if (!string.IsNullOrWhiteSpace(Model.BannerImageUrl))
    {
        <img src="@Url.Content(Model.BannerImageUrl)" alt="@Model.Title" class="sp-details-hero-img" />
    }
    else
    {
        <div class="sp-banner-theme @themeClass sp-details-hero-img">
            @if (themeClass.Contains("tech"))
            {
                <svg class="sp-banner-watermark" style="width: 220px; height: 220px; opacity: 0.15;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <polyline points="16 18 22 12 16 6"></polyline>
                    <polyline points="8 6 2 12 8 18"></polyline>
                </svg>
            }
            else if (themeClass.Contains("hackathon"))
            {
                <svg class="sp-banner-watermark" style="width: 220px; height: 220px; opacity: 0.15;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path>
                    <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path>
                    <path d="M4 22h16"></path>
                    <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"></path>
                </svg>
            }
            else if (themeClass.Contains("seminar"))
            {
                <svg class="sp-banner-watermark" style="width: 220px; height: 220px; opacity: 0.15;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"></path>
                    <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                    <line x1="12" y1="19" x2="12" y2="22"></line>
                </svg>
            }
            else if (themeClass.Contains("symposium"))
            {
                <svg class="sp-banner-watermark" style="width: 220px; height: 220px; opacity: 0.15;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="12" cy="5" r="3"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <circle cx="6" cy="19" r="3"></circle>
                    <circle cx="18" cy="19" r="3"></circle>
                    <line x1="12" y1="12" x2="6" y2="16"></line>
                    <line x1="12" y1="12" x2="18" y2="16"></line>
                </svg>
            }
            else if (themeClass.Contains("arts"))
            {
                <svg class="sp-banner-watermark" style="width: 220px; height: 220px; opacity: 0.15;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"></circle>
                    <circle cx="17.5" cy="10.5" r=".5" fill="currentColor"></circle>
                    <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.563-2.512 5.563-5.563C22 6.5 17.5 2 12 2Z"></path>
                </svg>
            }
            else
            {
                <svg class="sp-banner-watermark" style="width: 220px; height: 220px; opacity: 0.15;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                    <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                </svg>
            }
        </div>
    }

    <div class="sp-details-hero-overlay">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            <span class="badge bg-primary text-white py-1 px-3 shadow-sm" style="font-size: 0.78rem;">
                @Model.CategoryName
            </span>
            <span class="badge bg-light text-dark py-1 px-3 shadow-sm" style="font-size: 0.78rem;">
                @Model.DepartmentName (@Model.DepartmentCode)
            </span>
            <span class="badge bg-dark bg-opacity-75 text-white py-1 px-3 border border-light border-opacity-25" style="font-size: 0.78rem;">
                Mode: @Model.EventMode
            </span>
            @if (Model.EventType == EventType.Free || Model.RegistrationFee <= 0)
            {
                <span class="badge bg-success text-white py-1 px-3 shadow-sm" style="font-size: 0.78rem;">
                    Free Admission
                </span>
            }
            else
            {
                <span class="badge bg-warning text-dark py-1 px-3 shadow-sm fw-bold" style="font-size: 0.78rem;">
                    &#8377;@Model.RegistrationFee.ToString("F2")
                </span>
            }
        </div>

        <h1 class="fw-bold mb-2 text-white" style="font-size: 2.15rem; letter-spacing: -0.02em; line-height: 1.25;">
            @Model.Title
        </h1>

        <p class="text-white text-opacity-90 lead mb-3" style="font-size: 1rem; max-width: 850px; line-height: 1.55;">
            @(string.IsNullOrWhiteSpace(Model.ShortDescription) ? $"Official campus event organized by the Department of {Model.DepartmentName} at VAP UNIVERSITY." : Model.ShortDescription)
        </p>

        <!-- Hero Sub-Specs Bar -->
        <div class="d-flex flex-wrap align-items-center gap-4 text-white-50 small pt-2 border-top border-white border-opacity-10">
            <div class="d-flex align-items-center gap-2 text-white">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary-light">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span>@Model.FormattedEventStart until @Model.FormattedEventEnd</span>
            </div>
            <div class="d-flex align-items-center gap-2 text-white">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-secondary-light">
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span>@(string.IsNullOrWhiteSpace(Model.Venue) ? Model.EventMode.ToString() : Model.Venue)</span>
            </div>
            <div class="d-flex align-items-center gap-2 text-white">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
                <span>Capacity: @Model.RegisteredCount / @Model.TotalCapacity seats reserved</span>
            </div>
        </div>
    </div>
</div>

<!-- Main Content & Sidebar Grid -->
<div class="row g-4">
    <!-- Left Column (8 cols): Overview, Schedule, Eligibility -->
    <div class="col-lg-8">
        <!-- 1. Event Overview -->
        <div class="sp-panel">
            <div class="sp-panel-header">
                <h5 class="sp-panel-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                        <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                    <span>About this Event</span>
                </h5>
            </div>
            <div class="sp-panel-body">
                <div class="text-dark" style="font-size: 0.95rem; line-height: 1.7; white-space: pre-line;">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "Detailed schedule, prerequisites, and workshop guidelines will be provided by the organizing department faculty coordinators." : Model.Description)
                </div>
            </div>
        </div>

        <!-- 2. Event Sessions Timeline -->
        <div class="sp-panel">
            <div class="sp-panel-header">
                <h5 class="sp-panel-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <span>Event Schedule &amp; Session Tracks</span>
                </h5>
                <span class="badge bg-light text-muted border">@(Model.Sessions?.Count ?? 0) Sessions</span>
            </div>
            <div class="sp-panel-body">
                @if (Model.Sessions != null && Model.Sessions.Any())
                {
                    <ul class="sp-timeline">
                        @foreach (var session in Model.Sessions)
                        {
                            <li class="sp-timeline-item">
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
                                    <span class="sp-timeline-time">@session.FormattedDate &bull; @session.FormattedTimeRange</span>
                                    @if (!string.IsNullOrWhiteSpace(session.VenueOrRoom))
                                    {
                                        <span class="badge bg-light text-muted border" style="font-size: 0.72rem;">
                                            Room: @session.VenueOrRoom
                                        </span>
                                    }
                                </div>

                                <h4 class="mb-1 text-dark">@session.SessionTitle</h4>

                                @if (!string.IsNullOrWhiteSpace(session.Description))
                                {
                                    <p class="text-muted small mb-2" style="line-height: 1.55;">@session.Description</p>
                                }

                                @if (!string.IsNullOrWhiteSpace(session.SpeakerName))
                                {
                                    <div class="d-flex align-items-center gap-2 pt-2 border-top border-light">
                                        <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 28px; height: 28px; font-size: 0.75rem;">
                                            @(session.SpeakerName.Substring(0, 1).ToUpper())
                                        </div>
                                        <div class="small">
                                            <span class="fw-semibold text-dark">@session.SpeakerName</span>
                                            @if (!string.IsNullOrWhiteSpace(session.SpeakerDesignation) || !string.IsNullOrWhiteSpace(session.SpeakerOrganization))
                                            {
                                                <span class="text-muted">
                                                    &mdash; @(string.Join(", ", new[] { session.SpeakerDesignation, session.SpeakerOrganization }.Where(x => !string.IsNullOrWhiteSpace(x))))
                                                </span>
                                            }
                                        </div>
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="p-4 bg-light rounded text-center text-muted small">
                        Full agenda and session details will be published by the organizing department prior to event commencement.
                    </div>
                }
            </div>
        </div>

        <!-- 3. Eligibility & Criteria -->
        <div class="sp-panel">
            <div class="sp-panel-header">
                <h5 class="sp-panel-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                    <span>Eligibility &amp; Requirements</span>
                </h5>
            </div>
            <div class="sp-panel-body">
                @if (Model.EligibilityResult.IsEligible)
                {
                    <div class="alert alert-success d-flex align-items-start gap-3 mb-3 border-0 shadow-sm" role="alert">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-success flex-shrink-0 mt-1">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        <div>
                            <div class="fw-bold">You are eligible to enroll in this event</div>
                            <div class="small">@Model.EligibilityResult.Message</div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning d-flex align-items-start gap-3 mb-3 border-0 shadow-sm" role="alert">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-warning-emphasis flex-shrink-0 mt-1">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        <div>
                            <div class="fw-bold">Eligibility Notice</div>
                            <div class="small">@Model.EligibilityResult.Message</div>
                        </div>
                    </div>
                }

                <div class="table-responsive">
                    <table class="table table-sm table-borderless mb-0">
                        <tbody>
                            <tr>
                                <th class="text-muted fw-normal" style="width: 35%;">Eligible Departments:</th>
                                <td class="fw-semibold text-dark">@(Model.EligibilityResult.EligibleDepartmentsDescription ?? "All University Departments")</td>
                            </tr>
                            <tr>
                                <th class="text-muted fw-normal">Academic Year / Semester:</th>
                                <td class="fw-semibold text-dark">@(Model.EligibilityResult.YearOfStudyDescription ?? "All Academic Years (1st, 2nd, 3rd, 4th)")</td>
                            </tr>
                            <tr>
                                <th class="text-muted fw-normal">Inter-College Scope:</th>
                                <td class="fw-semibold text-dark">@(Model.EligibilityResult.CollegeScopeDescription ?? "Open to VAP UNIVERSITY Students & External Colleges")</td>
                            </tr>
                            @if (!string.IsNullOrWhiteSpace(Model.EligibilityResult.MinimumCgpaDescription))
                            {
                                <tr>
                                    <th class="text-muted fw-normal">Academic Standing:</th>
                                    <td class="fw-semibold text-dark">@Model.EligibilityResult.MinimumCgpaDescription</td>
                                </tr>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.EligibilityResult.SpecialRemarks))
                            {
                                <tr>
                                    <th class="text-muted fw-normal">Special Instructions:</th>
                                    <td class="fw-semibold text-dark">@Model.EligibilityResult.SpecialRemarks</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column (4 cols): Registration Card & Details -->
    <div class="col-lg-4">
        <div class="sp-panel sticky-top" style="top: 80px;">
            <div class="sp-panel-body">
                <!-- Registration Fee / Pricing -->
                <div class="mb-3">
                    <div class="text-muted small fw-semibold text-uppercase letter-spacing mb-1">Registration Fee</div>
                    @if (Model.EventType == EventType.Free || Model.RegistrationFee <= 0)
                    {
                        <div class="h3 fw-bold text-success mb-0">FREE</div>
                        <div class="text-muted small">No registration charge required</div>
                    }
                    else
                    {
                        <div class="h3 fw-bold text-dark mb-0">&#8377;@Model.RegistrationFee.ToString("F2")</div>
                        <div class="text-muted small">Includes session materials and verified admission pass</div>
                    }
                </div>

                <!-- Registration Status Indicator -->
                <div class="mb-3 p-3 rounded bg-light border">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="small fw-semibold text-dark">Registration Status</span>
                        @if (Model.IsSoldOut)
                        {
                            <span class="badge bg-danger text-white">Capacity Full</span>
                        }
                        else if (Model.IsRegistrationOpen)
                        {
                            <span class="badge bg-success text-white">Open Now</span>
                        }
                        else if (Model.IsRegistrationUpcoming)
                        {
                            <span class="badge bg-info text-dark">Upcoming</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary text-white">Closed</span>
                        }
                    </div>
                    <div class="text-muted small">
                        @if (Model.IsRegistrationOpen)
                        {
                            <span>Closes: @Model.FormattedRegistrationEnd</span>
                        }
                        else if (Model.IsRegistrationUpcoming)
                        {
                            <span>Opens: @Model.FormattedRegistrationStart</span>
                        }
                        else
                        {
                            <span>Deadline passed on @Model.FormattedRegistrationEnd</span>
                        }
                    </div>
                </div>

                <!-- Seat Capacity -->
                <div class="mb-4">
                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>Seat Capacity</span>
                        <span class="fw-bold text-dark">@Model.RegisteredCount / @Model.TotalCapacity</span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        @{
                            var percent = Model.TotalCapacity > 0 ? (int)((double)Model.RegisteredCount / Model.TotalCapacity * 100) : 0;
                        }
                        <div class="progress-bar bg-primary" role="progressbar" style="width: @percent%;" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="text-muted small mt-1">
                        @(Model.RemainingSeats > 0 ? $"{Model.RemainingSeats} seats currently remaining" : "Event has reached maximum seat capacity")
                    </div>
                </div>

                <!-- Registration Actions -->
                @if (Model.IsUserRegistered && Model.UserRegistration != null)
                {
                    <div class="card border-success bg-success-subtle mb-3 p-3">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-success"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                            <span class="fw-bold text-success">You Are Registered!</span>
                        </div>
                        <div class="small text-muted mb-2">
                            Pass: <strong class="font-monospace text-dark">@Model.UserRegistration.RegistrationNumber</strong>
                        </div>
                        <div class="d-flex align-items-center justify-content-between pt-2 border-top border-success-subtle mb-2">
                            <span class="badge bg-success">@Model.UserRegistration.Status</span>
                            <a asp-area="Student" asp-controller="Registrations" asp-action="Details" asp-route-id="@Model.UserRegistration.Id" class="btn btn-sm btn-outline-success fw-semibold">
                                View Pass &rarr;
                            </a>
                        </div>

                        <!-- Direct Cancellation Form -->
                        @if (Model.UserRegistration.Status == RegistrationStatus.Confirmed || Model.UserRegistration.Status == RegistrationStatus.Pending)
                        {
                            <form asp-area="Student" asp-controller="Registrations" asp-action="Cancel" asp-route-id="@Model.UserRegistration.Id" method="post" onsubmit="return confirm('Are you sure you want to cancel your registration for this event?');" class="pt-2 border-top border-success-subtle">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="cancellationReason" value="Cancelled by student via Event Details" />
                                <button type="submit" class="btn btn-link text-danger p-0 small text-decoration-none d-flex align-items-center gap-1" style="font-size: 0.78rem;">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <line x1="18" y1="6" x2="6" y2="18"></line>
                                        <line x1="6" y1="6" x2="18" y2="18"></line>
                                    </svg>
                                    <span>Cancel Registration</span>
                                </button>
                            </form>
                        }
                    </div>
                }
                else
                {
                    @if (!Model.EligibilityResult.IsEligible)
                    {
                        <div class="mb-3">
                            <button type="button" class="btn btn-secondary w-100 py-3 fw-bold disabled" disabled>
                                Not Eligible to Register
                            </button>
                            <div class="alert alert-warning border small mt-2 mb-0">
                                <strong>Eligibility Notice:</strong> @Model.EligibilityResult.Message
                            </div>
                        </div>
                    }
                    else if (Model.IsRegistrationUpcoming)
                    {
                        <div class="mb-3">
                            <button type="button" class="btn btn-outline-primary w-100 py-3 fw-bold disabled" disabled>
                                Registration Opens Soon
                            </button>
                            <div class="text-muted small text-center mt-1">Opens @Model.FormattedRegistrationStart</div>
                        </div>
                    }
                    else if (Model.IsRegistrationClosed)
                    {
                        <div class="mb-3">
                            <button type="button" class="btn btn-secondary w-100 py-3 fw-bold disabled" disabled>
                                Registration Closed
                            </button>
                            <div class="text-muted small text-center mt-1">Deadline passed on @Model.FormattedRegistrationEnd</div>
                        </div>
                    }
                    else if (Model.IsSoldOut)
                    {
                        <div class="mb-3">
                            <button type="button" class="btn btn-danger w-100 py-3 fw-bold disabled" disabled>
                                Seat Capacity Full
                            </button>
                            <div class="text-muted small text-center mt-1">All @Model.TotalCapacity seats have been reserved.</div>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <form asp-area="Student" asp-controller="Registrations" asp-action="Register" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="eventId" value="@Model.Id" />
                                <button type="submit" class="btn-sp-primary w-100 py-3 justify-content-center shadow-sm">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="19" y1="8" x2="19" y2="14"></line><line x1="22" y1="11" x2="16" y2="11"></line></svg>
                                    <span>Register for Event</span>
                                </button>
                            </form>
                        </div>
                    }
                }

                <!-- Quick Information -->
                <div class="d-flex flex-column gap-3 small border-top pt-3 text-muted">
                    <div class="d-flex align-items-start gap-2">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary mt-1">
                            <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        <div>
                            <div class="text-dark fw-semibold">Event Dates (IST)</div>
                            <div>@Model.FormattedEventStart</div>
                            <div style="font-size: 0.76rem;">until @Model.FormattedEventEnd</div>
                        </div>
                    </div>

                    <div class="d-flex align-items-start gap-2">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-secondary mt-1">
                            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                        <div>
                            <div class="text-dark fw-semibold">Location / Mode</div>
                            <div>@Model.EventMode</div>
                            @if (!string.IsNullOrWhiteSpace(Model.Venue))
                            {
                                <div>Venue: @Model.Venue</div>
                            }
                        </div>
                    </div>

                    <div class="d-flex align-items-start gap-2">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary mt-1">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                        </svg>
                        <div>
                            <div class="text-dark fw-semibold">Organizing Department</div>
                            <div>@Model.DepartmentName (@Model.DepartmentCode)</div>
                        </div>
                    </div>

                    <div class="d-flex align-items-start gap-2">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-success mt-1">
                            <circle cx="12" cy="8" r="6"></circle>
                            <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"></path>
                        </svg>
                        <div>
                            <div class="text-dark fw-semibold">Verified Credentials</div>
                            <div style="font-size: 0.76rem;">Eligible attendees will receive an automated, cryptographically verifiable certificate.</div>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top text-center">
                    <a asp-area="Student" asp-controller="Events" asp-action="Index" class="text-decoration-none small text-muted d-inline-flex align-items-center gap-1">
                        &larr; Return to Event Discovery
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
