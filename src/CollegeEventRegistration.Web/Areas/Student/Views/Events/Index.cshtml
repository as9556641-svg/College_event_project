@model CollegeEventRegistration.Web.Areas.Student.Models.StudentEventCatalogViewModel
@using CollegeEventRegistration.Core.Enums
@{
    Layout = "_StudentPortalLayout";
    ViewData["Title"] = "Explore Events";
    var activeCategory = Model.Categories.FirstOrDefault(c => c.Id == Model.Criteria.CategoryId);

    string GetThemeClass(string catName)
    {
        var lower = (catName ?? "").ToLowerInvariant();
        if (lower.Contains("technical") || lower.Contains("workshop") || lower.Contains("code")) return "sp-banner-theme-tech";
        if (lower.Contains("hackathon") || lower.Contains("contest") || lower.Contains("compet")) return "sp-banner-theme-hackathon";
        if (lower.Contains("seminar") || lower.Contains("lecture") || lower.Contains("guest")) return "sp-banner-theme-seminar";
        if (lower.Contains("symposium") || lower.Contains("conference")) return "sp-banner-theme-symposium";
        if (lower.Contains("cultural") || lower.Contains("arts") || lower.Contains("music")) return "sp-banner-theme-arts";
        return "sp-banner-theme-default";
    }
}

<!-- Compact Information Header -->
<div class="sp-explore-header">
    <!-- Small Breadcrumb -->
    <div class="sp-breadcrumb-subtle">
        <span>VAP UNIVERSITY</span>
        <span>/</span>
        <span class="sp-crumb-active">STUDENT PORTAL</span>
    </div>

    <!-- Main Heading -->
    <h1 class="sp-explore-title">
        Explore Events
    </h1>

    <!-- Supporting Description -->
    <p class="sp-explore-desc">
        Discover workshops, seminars, hackathons, academic conferences, and campus experiences.
    </p>

    <!-- Search Bar Input Form -->
    <form method="get" asp-area="Student" asp-controller="Events" asp-action="Index" class="mb-3">
        @if (Model.Criteria.CategoryId.HasValue)
        {
            <input type="hidden" name="CategoryId" value="@Model.Criteria.CategoryId" />
        }
        @if (Model.Criteria.DepartmentId.HasValue)
        {
            <input type="hidden" name="DepartmentId" value="@Model.Criteria.DepartmentId" />
        }
        @if (Model.Criteria.EventMode.HasValue)
        {
            <input type="hidden" name="EventMode" value="@Model.Criteria.EventMode" />
        }
        @if (Model.Criteria.EventType.HasValue)
        {
            <input type="hidden" name="EventType" value="@Model.Criteria.EventType" />
        }
        @if (!string.IsNullOrWhiteSpace(Model.Criteria.DateFilter))
        {
            <input type="hidden" name="DateFilter" value="@Model.Criteria.DateFilter" />
        }
        @if (Model.Criteria.OnlyRegistrationOpen)
        {
            <input type="hidden" name="OnlyRegistrationOpen" value="true" />
        }
        @if (!string.IsNullOrWhiteSpace(Model.Criteria.SortBy))
        {
            <input type="hidden" name="SortBy" value="@Model.Criteria.SortBy" />
        }

        <div class="sp-search-card d-flex align-items-center p-1" style="max-width: 680px;">
            <span class="ps-3 pe-2 text-muted d-flex align-items-center">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </span>
            <input type="text" name="SearchTerm" value="@Model.Criteria.SearchTerm" 
                   class="form-control border-0 shadow-none py-2" 
                   placeholder="Search by event title, topic, workshop, or venue..." 
                   aria-label="Search events" style="font-size: 0.92rem; background: transparent;" />
            <button type="submit" class="btn-sp-primary px-4 py-2 fw-semibold flex-shrink-0">
                Search
            </button>
        </div>
    </form>

    <!-- Category Filters -->
    @if (Model.Categories != null && Model.Categories.Any())
    {
        <div class="sp-cat-rail">
            <a asp-area="Student" asp-controller="Events" asp-action="Index" 
               asp-route-SearchTerm="@Model.Criteria.SearchTerm"
               asp-route-DepartmentId="@Model.Criteria.DepartmentId"
               asp-route-EventMode="@Model.Criteria.EventMode"
               asp-route-EventType="@Model.Criteria.EventType"
               asp-route-DateFilter="@Model.Criteria.DateFilter"
               asp-route-OnlyRegistrationOpen="@Model.Criteria.OnlyRegistrationOpen"
               asp-route-SortBy="@Model.Criteria.SortBy"
               class="sp-cat-pill @(!Model.Criteria.CategoryId.HasValue ? "active" : "")">
                <span>All Categories</span>
                <span class="sp-cat-count">@Model.TotalEventsCount</span>
            </a>
            @foreach (var cat in Model.Categories)
            {
                var isSelected = Model.Criteria.CategoryId == cat.Id;
                <a asp-area="Student" asp-controller="Events" asp-action="Index" 
                   asp-route-CategoryId="@cat.Id"
                   asp-route-SearchTerm="@Model.Criteria.SearchTerm"
                   asp-route-DepartmentId="@Model.Criteria.DepartmentId"
                   asp-route-EventMode="@Model.Criteria.EventMode"
                   asp-route-EventType="@Model.Criteria.EventType"
                   asp-route-DateFilter="@Model.Criteria.DateFilter"
                   asp-route-OnlyRegistrationOpen="@Model.Criteria.OnlyRegistrationOpen"
                   asp-route-SortBy="@Model.Criteria.SortBy"
                   class="sp-cat-pill @(isSelected ? "active" : "")">
                    <span>@cat.Name</span>
                    @if (cat.PublishedCount > 0)
                    {
                        <span class="sp-cat-count">@cat.PublishedCount</span>
                    }
                </a>
            }
        </div>
    }
</div>

<!-- Main Catalog Container -->
<div class="mb-5">
    <!-- Filter & Sort Toolbar -->
    <div class="sp-panel mb-4">
        <div class="p-3 p-md-4">
            <form method="get" asp-area="Student" asp-controller="Events" asp-action="Index" id="filterForm">
                @if (Model.Criteria.CategoryId.HasValue)
                {
                    <input type="hidden" name="CategoryId" value="@Model.Criteria.CategoryId" />
                }
                @if (!string.IsNullOrWhiteSpace(Model.Criteria.SearchTerm))
                {
                    <input type="hidden" name="SearchTerm" value="@Model.Criteria.SearchTerm" />
                }
                <div class="row g-3 align-items-end">
                    <!-- Department Filter -->
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label small fw-semibold text-muted mb-1" for="deptSelect">Department</label>
                        <select name="DepartmentId" id="deptSelect" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="">All Departments</option>
                            @foreach (var dept in Model.Departments)
                            {
                                <option value="@dept.Id" selected="@(Model.Criteria.DepartmentId == dept.Id)">
                                    @dept.Name (@dept.Code)
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Event Mode Filter -->
                    <div class="col-sm-6 col-md-2">
                        <label class="form-label small fw-semibold text-muted mb-1" for="modeSelect">Mode</label>
                        <select name="EventMode" id="modeSelect" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="">All Modes</option>
                            <option value="@((int)EventMode.Offline)" selected="@(Model.Criteria.EventMode == EventMode.Offline)">In-Person (Offline)</option>
                            <option value="@((int)EventMode.Online)" selected="@(Model.Criteria.EventMode == EventMode.Online)">Virtual (Online)</option>
                            <option value="@((int)EventMode.Hybrid)" selected="@(Model.Criteria.EventMode == EventMode.Hybrid)">Hybrid</option>
                        </select>
                    </div>

                    <!-- Fee Type -->
                    <div class="col-sm-6 col-md-2">
                        <label class="form-label small fw-semibold text-muted mb-1" for="typeSelect">Admission Fee</label>
                        <select name="EventType" id="typeSelect" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="">All Events</option>
                            <option value="@((int)EventType.Free)" selected="@(Model.Criteria.EventType == EventType.Free)">Free Events</option>
                            <option value="@((int)EventType.Paid)" selected="@(Model.Criteria.EventType == EventType.Paid)">Paid Workshops</option>
                        </select>
                    </div>

                    <!-- Timeline Filter -->
                    <div class="col-sm-6 col-md-2">
                        <label class="form-label small fw-semibold text-muted mb-1" for="dateFilterSelect">Timeline</label>
                        <select name="DateFilter" id="dateFilterSelect" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="all" selected="@(Model.Criteria.DateFilter == "all")">All Dates</option>
                            <option value="today" selected="@(Model.Criteria.DateFilter == "today")">Happening Today</option>
                            <option value="this_week" selected="@(Model.Criteria.DateFilter == "this_week")">This Week</option>
                            <option value="this_month" selected="@(Model.Criteria.DateFilter == "this_month")">This Month</option>
                        </select>
                    </div>

                    <!-- Sort Order -->
                    <div class="col-sm-12 col-md-3">
                        <label class="form-label small fw-semibold text-muted mb-1" for="sortSelect">Sort By</label>
                        <select name="SortBy" id="sortSelect" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="upcoming" selected="@(Model.Criteria.SortBy == "upcoming")">Upcoming First</option>
                            <option value="latest" selected="@(Model.Criteria.SortBy == "latest")">Recently Published</option>
                            <option value="date_asc" selected="@(Model.Criteria.SortBy == "date_asc")">Date (Earliest First)</option>
                            <option value="date_desc" selected="@(Model.Criteria.SortBy == "date_desc")">Date (Furthest First)</option>
                            <option value="title_asc" selected="@(Model.Criteria.SortBy == "title_asc")">Title (A - Z)</option>
                            <option value="title_desc" selected="@(Model.Criteria.SortBy == "title_desc")">Title (Z - A)</option>
                        </select>
                    </div>
                </div>

                <!-- Registration Open Checkbox & Reset -->
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mt-3 pt-3 border-top">
                    <div class="form-check mb-0">
                        <input class="form-check-input" type="checkbox" name="OnlyRegistrationOpen" value="true" 
                                id="regOpenCheck" @(Model.Criteria.OnlyRegistrationOpen ? "checked" : "") 
                                onchange="this.form.submit()">
                        <label class="form-check-label small fw-semibold text-dark" for="regOpenCheck">
                            Show only events with registration currently open
                        </label>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small">
                            Showing <strong>@Model.Events.Items.Count</strong> of <strong>@Model.TotalEventsCount</strong> events
                        </span>
                        @if (Model.HasActiveFilters)
                        {
                            <a asp-area="Student" asp-controller="Events" asp-action="Index" class="btn btn-outline-secondary btn-sm px-3 ms-2">
                                Reset Filters
                            </a>
                        }
                    </div>
                </div>

                <!-- Active Filter Badges Bar -->
                @if (Model.HasActiveFilters)
                {
                    <div class="d-flex flex-wrap align-items-center gap-2 mt-3 pt-2 border-top">
                        <span class="small fw-semibold text-muted me-1">Active:</span>
                        @if (!string.IsNullOrWhiteSpace(Model.Criteria.SearchTerm))
                        {
                            <span class="badge bg-light text-dark border d-inline-flex align-items-center gap-1 py-1 px-2">
                                Search: "@Model.Criteria.SearchTerm"
                                <a asp-area="Student" asp-controller="Events" asp-action="Index" 
                                   asp-route-CategoryId="@Model.Criteria.CategoryId"
                                   asp-route-DepartmentId="@Model.Criteria.DepartmentId"
                                   asp-route-EventMode="@Model.Criteria.EventMode"
                                   asp-route-EventType="@Model.Criteria.EventType"
                                   asp-route-DateFilter="@Model.Criteria.DateFilter"
                                   asp-route-OnlyRegistrationOpen="@Model.Criteria.OnlyRegistrationOpen"
                                   asp-route-SortBy="@Model.Criteria.SortBy"
                                   class="text-muted text-decoration-none ms-1">&times;</a>
                            </span>
                        }
                        @if (activeCategory != null)
                        {
                            <span class="badge bg-light text-dark border d-inline-flex align-items-center gap-1 py-1 px-2">
                                Category: @activeCategory.Name
                                <a asp-area="Student" asp-controller="Events" asp-action="Index" 
                                   asp-route-SearchTerm="@Model.Criteria.SearchTerm"
                                   asp-route-DepartmentId="@Model.Criteria.DepartmentId"
                                   asp-route-EventMode="@Model.Criteria.EventMode"
                                   asp-route-EventType="@Model.Criteria.EventType"
                                   asp-route-DateFilter="@Model.Criteria.DateFilter"
                                   asp-route-OnlyRegistrationOpen="@Model.Criteria.OnlyRegistrationOpen"
                                   asp-route-SortBy="@Model.Criteria.SortBy"
                                   class="text-muted text-decoration-none ms-1">&times;</a>
                            </span>
                        }
                        @if (Model.Criteria.DepartmentId.HasValue)
                        {
                            var activeDept = Model.Departments.FirstOrDefault(d => d.Id == Model.Criteria.DepartmentId.Value);
                            <span class="badge bg-light text-dark border d-inline-flex align-items-center gap-1 py-1 px-2">
                                Dept: @(activeDept?.Name ?? Model.Criteria.DepartmentId.ToString())
                                <a asp-area="Student" asp-controller="Events" asp-action="Index" 
                                   asp-route-SearchTerm="@Model.Criteria.SearchTerm"
                                   asp-route-CategoryId="@Model.Criteria.CategoryId"
                                   asp-route-EventMode="@Model.Criteria.EventMode"
                                   asp-route-EventType="@Model.Criteria.EventType"
                                   asp-route-DateFilter="@Model.Criteria.DateFilter"
                                   asp-route-OnlyRegistrationOpen="@Model.Criteria.OnlyRegistrationOpen"
                                   asp-route-SortBy="@Model.Criteria.SortBy"
                                   class="text-muted text-decoration-none ms-1">&times;</a>
                            </span>
                        }
                        @if (Model.Criteria.EventMode.HasValue)
                        {
                            <span class="badge bg-light text-dark border d-inline-flex align-items-center gap-1 py-1 px-2">
                                Mode: @Model.Criteria.EventMode
                                <a asp-area="Student" asp-controller="Events" asp-action="Index" 
                                   asp-route-SearchTerm="@Model.Criteria.SearchTerm"
                                   asp-route-CategoryId="@Model.Criteria.CategoryId"
                                   asp-route-DepartmentId="@Model.Criteria.DepartmentId"
                                   asp-route-EventType="@Model.Criteria.EventType"
                                   asp-route-DateFilter="@Model.Criteria.DateFilter"
                                   asp-route-OnlyRegistrationOpen="@Model.Criteria.OnlyRegistrationOpen"
                                   asp-route-SortBy="@Model.Criteria.SortBy"
                                   class="text-muted text-decoration-none ms-1">&times;</a>
                            </span>
                        }
                        @if (Model.Criteria.OnlyRegistrationOpen)
                        {
                            <span class="badge bg-light text-dark border d-inline-flex align-items-center gap-1 py-1 px-2">
                                Open Registrations Only
                                <a asp-area="Student" asp-controller="Events" asp-action="Index" 
                                   asp-route-SearchTerm="@Model.Criteria.SearchTerm"
                                   asp-route-CategoryId="@Model.Criteria.CategoryId"
                                   asp-route-DepartmentId="@Model.Criteria.DepartmentId"
                                   asp-route-EventMode="@Model.Criteria.EventMode"
                                   asp-route-EventType="@Model.Criteria.EventType"
                                   asp-route-DateFilter="@Model.Criteria.DateFilter"
                                   asp-route-SortBy="@Model.Criteria.SortBy"
                                   class="text-muted text-decoration-none ms-1">&times;</a>
                            </span>
                        }
                    </div>
                }
            </form>
        </div>
    </div>

    <!-- Event Cards Grid -->
    @if (Model.Events.Items != null && Model.Events.Items.Any())
    {
        <div class="row g-4 mb-4">
            @foreach (var ev in Model.Events.Items)
            {
                var themeClass = GetThemeClass(ev.CategoryName);
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="sp-event-card">
                        <!-- Banner Media Container -->
                        <div class="sp-event-banner-wrap">
                            @if (!string.IsNullOrWhiteSpace(ev.BannerImageUrl))
                            {
                                <img src="@Url.Content(ev.BannerImageUrl)" alt="@ev.Title" class="sp-event-banner-img" loading="lazy" />
                                <div class="position-absolute bottom-0 start-0 end-0 p-3" style="background: linear-gradient(180deg, transparent 0%, rgba(10, 15, 29, 0.8) 100%);">
                                    <span class="badge bg-dark bg-opacity-75 text-white border border-light border-opacity-25 py-1 px-2" style="font-size: 0.72rem;">
                                        @ev.CategoryName
                                    </span>
                                </div>
                            }
                            else
                            {
                                <div class="sp-banner-theme @themeClass">
                                    <!-- Dynamic Watermark SVG -->
                                    @if (themeClass.Contains("tech"))
                                    {
                                        <svg class="sp-banner-watermark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                            <polyline points="16 18 22 12 16 6"></polyline>
                                            <polyline points="8 6 2 12 8 18"></polyline>
                                        </svg>
                                    }
                                    else if (themeClass.Contains("hackathon"))
                                    {
                                        <svg class="sp-banner-watermark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                            <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path>
                                            <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path>
                                            <path d="M4 22h16"></path>
                                            <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"></path>
                                        </svg>
                                    }
                                    else if (themeClass.Contains("seminar"))
                                    {
                                        <svg class="sp-banner-watermark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                            <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"></path>
                                            <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                                            <line x1="12" y1="19" x2="12" y2="22"></line>
                                        </svg>
                                    }
                                    else if (themeClass.Contains("symposium"))
                                    {
                                        <svg class="sp-banner-watermark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                            <circle cx="12" cy="5" r="3"></circle>
                                            <line x1="12" y1="8" x2="12" y2="12"></line>
                                            <circle cx="6" cy="19" r="3"></circle>
                                            <circle cx="18" cy="19" r="3"></circle>
                                            <line x1="12" y1="12" x2="6" y2="16"></line>
                                            <line x1="12" y1="12" x2="18" y2="16"></line>
                                        </svg>
                                    }
                                    else if (themeClass.Contains("arts"))
                                    {
                                        <svg class="sp-banner-watermark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                            <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"></circle>
                                            <circle cx="17.5" cy="10.5" r=".5" fill="currentColor"></circle>
                                            <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.563-2.512 5.563-5.563C22 6.5 17.5 2 12 2Z"></path>
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg class="sp-banner-watermark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                            <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                                            <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                                        </svg>
                                    }

                                    <div class="position-relative z-1">
                                        <span class="badge bg-white bg-opacity-20 text-white backdrop-blur border border-white border-opacity-25 py-1 px-2" style="font-size: 0.72rem;">
                                            @ev.CategoryName
                                        </span>
                                    </div>
                                </div>
                            }

                            <!-- Floating Date Calendar Chip (Top-Left) -->
                            <div class="position-absolute top-0 start-0 p-3 z-2">
                                <div class="sp-date-chip">
                                    <span class="sp-date-chip-month">@ev.EventStartDate.ToString("MMM")</span>
                                    <span class="sp-date-chip-day">@ev.EventStartDate.ToString("dd")</span>
                                </div>
                            </div>

                            <!-- Floating Registration Status (Top-Right) -->
                            <div class="position-absolute top-0 end-0 p-3 z-2">
                                <span class="badge @ev.RegistrationBadgeCssClass py-1 px-2 shadow-sm" style="font-size: 0.72rem;">
                                    @ev.RegistrationBadgeText
                                </span>
                            </div>
                        </div>

                        <!-- Card Body -->
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex align-items-center justify-content-between gap-2 mb-2 text-muted small">
                                <span class="text-primary fw-semibold text-truncate" title="@ev.DepartmentName">@ev.DepartmentName</span>
                                <span class="badge bg-light text-muted border flex-shrink-0" style="font-size: 0.7rem;">@ev.EventMode</span>
                            </div>

                            <h3 class="fw-normal text-dark mb-2" style="font-family: var(--sp-font-display); font-size: 1.22rem; line-height: 1.3; min-height: 3.1rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;" title="@ev.Title">
                                <a asp-area="Student" asp-controller="Events" asp-action="Details" asp-route-id="@ev.Id" class="text-dark text-decoration-none hover-primary">
                                    @ev.Title
                                </a>
                            </h3>

                            <p class="text-muted small mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.55; min-height: 2.5rem;">
                                @(string.IsNullOrWhiteSpace(ev.ShortDescription) ? $"Official campus event organized by the Department of {ev.DepartmentName}. Open for student registration." : ev.ShortDescription)
                            </p>

                            <!-- Specifications Grid -->
                            <div class="d-flex flex-column gap-2 small text-muted pt-3 border-top mb-3" style="font-variant-numeric: tabular-nums;">
                                <div class="d-flex align-items-center gap-2">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary flex-shrink-0">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <polyline points="12 6 12 12 16 14"></polyline>
                                    </svg>
                                    <span>@ev.FormattedEventDate &bull; @ev.FormattedEventTime</span>
                                </div>

                                <div class="d-flex align-items-center gap-2">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-secondary flex-shrink-0">
                                        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                                        <circle cx="12" cy="10" r="3"></circle>
                                    </svg>
                                    <span class="text-truncate">@(string.IsNullOrWhiteSpace(ev.Venue) ? ev.EventMode.ToString() : ev.Venue)</span>
                                </div>

                                <div class="d-flex align-items-center justify-content-between pt-1">
                                    <span class="@(ev.RemainingSeats > 0 ? "text-success fw-medium" : "text-danger fw-medium")">
                                        @(ev.RemainingSeats > 0 ? $"{ev.RemainingSeats} seats left" : "Capacity Full")
                                    </span>
                                    <span class="text-muted" style="font-size: 0.72rem;">Deadline: @ev.FormattedRegistrationDeadline</span>
                                </div>
                            </div>

                            <!-- Card Footer -->
                            <div class="d-flex align-items-center justify-content-between pt-3 border-top mt-auto">
                                <div>
                                    @if (ev.EventType == EventType.Free || ev.RegistrationFee <= 0)
                                    {
                                        <span class="sp-badge sp-badge-confirmed fs-6 px-2.5 py-1">FREE</span>
                                    }
                                    else
                                    {
                                        <span class="fw-bold text-dark fs-5" style="font-variant-numeric: tabular-nums;">&#8377;@ev.RegistrationFee.ToString("F2")</span>
                                    }
                                </div>
                                <a asp-area="Student" asp-controller="Events" asp-action="Details" asp-route-id="@ev.Id" class="btn-sp-primary btn-sm px-3 shadow-sm d-inline-flex align-items-center gap-1.5 text-decoration-none">
                                    <span>Details</span>
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                        <polyline points="12 5 19 12 12 19"></polyline>
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination Controls -->
        @if (Model.Events.TotalPages > 1)
        {
            <nav aria-label="Catalog pagination" class="mt-4">
                <ul class="pagination justify-content-center">
                    <!-- Previous Page -->
                    <li class="page-item @(!Model.Events.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" asp-area="Student" asp-controller="Events" asp-action="Index"
                           asp-route-pageNumber="@(Model.Events.PageNumber - 1)"
                           asp-route-pageSize="@Model.Events.PageSize"
                           asp-route-SearchTerm="@Model.Criteria.SearchTerm"
                           asp-route-CategoryId="@Model.Criteria.CategoryId"
                           asp-route-DepartmentId="@Model.Criteria.DepartmentId"
                           asp-route-EventMode="@Model.Criteria.EventMode"
                           asp-route-EventType="@Model.Criteria.EventType"
                           asp-route-DateFilter="@Model.Criteria.DateFilter"
                           asp-route-OnlyRegistrationOpen="@Model.Criteria.OnlyRegistrationOpen"
                           asp-route-SortBy="@Model.Criteria.SortBy">
                            &laquo; Previous
                        </a>
                    </li>

                    <!-- Page Numbers -->
                    @for (int p = 1; p <= Model.Events.TotalPages; p++)
                    {
                        var isCurrent = p == Model.Events.PageNumber;
                        if (p == 1 || p == Model.Events.TotalPages || (p >= Model.Events.PageNumber - 2 && p <= Model.Events.PageNumber + 2))
                        {
                            <li class="page-item @(isCurrent ? "active" : "")">
                                <a class="page-link" asp-area="Student" asp-controller="Events" asp-action="Index"
                                   asp-route-pageNumber="@p"
                                   asp-route-pageSize="@Model.Events.PageSize"
                                   asp-route-SearchTerm="@Model.Criteria.SearchTerm"
                                   asp-route-CategoryId="@Model.Criteria.CategoryId"
                                   asp-route-DepartmentId="@Model.Criteria.DepartmentId"
                                   asp-route-EventMode="@Model.Criteria.EventMode"
                                   asp-route-EventType="@Model.Criteria.EventType"
                                   asp-route-DateFilter="@Model.Criteria.DateFilter"
                                   asp-route-OnlyRegistrationOpen="@Model.Criteria.OnlyRegistrationOpen"
                                   asp-route-SortBy="@Model.Criteria.SortBy">
                                    @p
                                </a>
                            </li>
                        }
                        else if (p == Model.Events.PageNumber - 3 || p == Model.Events.PageNumber + 3)
                        {
                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                        }
                    }

                    <!-- Next Page -->
                    <li class="page-item @(!Model.Events.HasNextPage ? "disabled" : "")">
                        <a class="page-link" asp-area="Student" asp-controller="Events" asp-action="Index"
                           asp-route-pageNumber="@(Model.Events.PageNumber + 1)"
                           asp-route-pageSize="@Model.Events.PageSize"
                           asp-route-SearchTerm="@Model.Criteria.SearchTerm"
                           asp-route-CategoryId="@Model.Criteria.CategoryId"
                           asp-route-DepartmentId="@Model.Criteria.DepartmentId"
                           asp-route-EventMode="@Model.Criteria.EventMode"
                           asp-route-EventType="@Model.Criteria.EventType"
                           asp-route-DateFilter="@Model.Criteria.DateFilter"
                           asp-route-OnlyRegistrationOpen="@Model.Criteria.OnlyRegistrationOpen"
                           asp-route-SortBy="@Model.Criteria.SortBy">
                            Next &raquo;
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <!-- Empty State Container -->
        <div class="sp-panel py-5 text-center">
            <div class="sp-empty-icon mb-3" style="width: 72px; height: 72px; border-radius: 50%; background: #EFF6FF; color: #2563EB; display: inline-flex; align-items: center; justify-content: center;">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </div>
            <h4 class="fw-bold text-dark mb-2">No Campus Events Found</h4>
            <p class="text-muted mx-auto mb-4" style="max-width: 480px; font-size: 0.95rem;">
                We could not find any active events matching your filter criteria. Try resetting filters or searching with different terms.
            </p>
            <a asp-area="Student" asp-controller="Events" asp-action="Index" class="btn btn-primary btn-sm px-4 py-2 fw-semibold">
                Clear Filters &amp; View All
            </a>
        </div>
    }
</div>
