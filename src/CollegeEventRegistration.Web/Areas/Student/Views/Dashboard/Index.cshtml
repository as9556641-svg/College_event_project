@model CollegeEventRegistration.Core.Entities.ApplicationUser
@{
    ViewData["Title"] = "Student Portal";
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge badge-role badge-role-student">Student Portal</span>
            <span class="text-muted small">My Events, Tickets & Certificates</span>
        </div>
        <h2 class="fw-bold mb-0">Welcome, @(Model?.FullName ?? "Student")</h2>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-6">
        <div class="card card-3d p-4 h-100">
            <span class="text-muted small text-uppercase fw-semibold">My Registrations</span>
            <h3 class="fw-bold my-2 text-primary">@ViewBag.RegistrationsCount</h3>
            <span class="text-muted small">Total events enrolled</span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card card-3d p-4 h-100">
            <span class="text-muted small text-uppercase fw-semibold">Confirmed Passes</span>
            <h3 class="fw-bold my-2 text-success">@ViewBag.ConfirmedCount</h3>
            <span class="text-muted small">Ready for QR check-in</span>
        </div>
    </div>
</div>
