@model CollegeEventRegistration.Web.Areas.Student.Models.StudentDashboardViewModel
@{
    ViewData["Title"] = "Student Dashboard";
}

<!-- Compact Dashboard Information Header -->
<div class="sp-dashboard-header d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
    <div>
        <!-- Small Breadcrumb -->
        <div class="sp-breadcrumb-subtle">
            <span>VAP UNIVERSITY</span>
            <span>/</span>
            <span class="sp-crumb-active">STUDENT PORTAL</span>
            @if (!string.IsNullOrWhiteSpace(Model?.CurrentUser?.Department))
            {
                <span class="text-slate-300">&bull;</span>
                <span class="text-slate-500">@Model.CurrentUser.Department</span>
            }
            @if (!string.IsNullOrWhiteSpace(Model?.CurrentUser?.RollNumber))
            {
                <span class="text-slate-300">&bull;</span>
                <span class="text-slate-500">@Model.CurrentUser.RollNumber</span>
            }
        </div>

        <!-- Main Heading -->
        <h1 class="sp-dashboard-title">
            Welcome back, @(Model?.CurrentUser?.FirstName ?? Model?.CurrentUser?.FullName ?? "Student")!
        </h1>

        <!-- Supporting Description -->
        <p class="sp-dashboard-desc">
            Your campus activities, registrations and academic achievements at a glance.
        </p>
    </div>

    <!-- Quick Action Navigation Link -->
    <div class="flex-shrink-0">
        <a asp-area="Student" asp-controller="Events" asp-action="Index" class="btn-sp-primary d-inline-flex align-items-center gap-2 text-decoration-none">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <span>Browse Event Catalog</span>
        </a>
    </div>
</div>

<!-- Primary Metric Cards Grid (4 KPIs) -->
<div class="row g-3 g-xl-4 mb-4">
    <!-- 1. Upcoming Events -->
    <div class="col-sm-6 col-xl-3">
        <div class="sp-kpi-card">
            <div class="sp-kpi-icon-wrap sp-kpi-icon-blue">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
            </div>
            <div>
                <div class="sp-kpi-label">Upcoming Events</div>
                <div class="sp-kpi-val text-primary">@(Model?.UpcomingRegisteredEventsCount ?? 0)</div>
                <p class="sp-kpi-sub">Scheduled future sessions</p>
            </div>
        </div>
    </div>

    <!-- 2. Enrolled Events -->
    <div class="col-sm-6 col-xl-3">
        <div class="sp-kpi-card">
            <div class="sp-kpi-icon-wrap sp-kpi-icon-green">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <polyline points="16 11 18 13 22 9"></polyline>
                </svg>
            </div>
            <div>
                <div class="sp-kpi-label">Enrolled Events</div>
                <div class="sp-kpi-val" style="color: #059669;">@(Model?.TotalRegistrationsCount ?? 0)</div>
                <p class="sp-kpi-sub">Lifetime workshop registrations</p>
            </div>
        </div>
    </div>

    <!-- 3. Completed Events -->
    <div class="col-sm-6 col-xl-3">
        <div class="sp-kpi-card">
            <div class="sp-kpi-icon-wrap sp-kpi-icon-purple">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
            </div>
            <div>
                <div class="sp-kpi-label">Completed Events</div>
                <div class="sp-kpi-val" style="color: #7C3AED;">@(Model?.CompletedEventsCount ?? 0)</div>
                <p class="sp-kpi-sub">Past sessions attended</p>
            </div>
        </div>
    </div>

    <!-- 4. Certificates Earned -->
    <div class="col-sm-6 col-xl-3">
        <div class="sp-kpi-card">
            <div class="sp-kpi-icon-wrap sp-kpi-icon-amber">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="8" r="6"></circle>
                    <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"></path>
                </svg>
            </div>
            <div>
                <div class="sp-kpi-label">Certificates Earned</div>
                <div class="sp-kpi-val text-warning">@(Model?.AvailableCertificatesCount ?? 0)</div>
                <p class="sp-kpi-sub">Verified completion credentials</p>
            </div>
        </div>
    </div>
</div>

<!-- Main Activity & Management Section -->
<div class="row g-4 mb-4">
    <!-- Left Column (8 cols): Registrations & Attendance -->
    <div class="col-lg-8">
        <div class="d-flex flex-column gap-4">
            <!-- 1. My Enrolled Events Panel -->
            <div class="sp-panel">
                <div class="sp-panel-header">
                    <h2 class="sp-panel-title">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <polyline points="16 11 18 13 22 9"></polyline>
                        </svg>
                        <span>My Enrolled Events &amp; Admission Passes</span>
                    </h2>
                    <a asp-area="Student" asp-controller="Registrations" asp-action="Index" class="btn btn-sm btn-link text-decoration-none fw-semibold">
                        View All &rarr;
                    </a>
                </div>
                <div class="p-0">
                    @if (Model?.MyRegistrations != null && Model.MyRegistrations.Any())
                    {
                        <div class="sp-table-wrap">
                            <table class="sp-table">
                                <thead>
                                    <tr>
                                        <th>Event Title</th>
                                        <th>Department</th>
                                        <th>Event Date</th>
                                        <th>Registration #</th>
                                        <th>Pass Code</th>
                                        <th>Status</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var reg in Model.MyRegistrations)
                                    {
                                        <tr>
                                            <td class="fw-semibold text-dark">@reg.Event?.Title</td>
                                            <td>
                                                <span class="badge bg-light text-muted border">@reg.Event?.Department?.Code</span>
                                            </td>
                                            <td class="small text-muted text-nowrap">@reg.Event?.EventStartDate.ToString("MMM dd, yyyy")</td>
                                            <td class="font-monospace small text-primary fw-semibold">@reg.RegistrationNumber</td>
                                            <td>
                                                <span class="badge bg-light text-dark border font-monospace">
                                                    @(reg.Ticket?.TicketCode ?? "Pending")
                                                </span>
                                            </td>
                                            <td>
                                                @{
                                                    var statusClass = reg.Status switch
                                                    {
                                                        CollegeEventRegistration.Core.Enums.RegistrationStatus.Confirmed => "sp-badge-confirmed",
                                                        CollegeEventRegistration.Core.Enums.RegistrationStatus.Pending => "sp-badge-pending",
                                                        CollegeEventRegistration.Core.Enums.RegistrationStatus.Waitlisted => "sp-badge-waitlisted",
                                                        CollegeEventRegistration.Core.Enums.RegistrationStatus.Cancelled => "sp-badge-cancelled",
                                                        _ => "sp-badge-info"
                                                    };
                                                }
                                                <span class="sp-badge @statusClass">
                                                    @reg.Status
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <a asp-area="Student" asp-controller="Registrations" asp-action="Details" asp-route-id="@reg.Id" class="btn-sp-outline py-1 px-2.5 text-decoration-none" style="font-size: 0.78rem;">
                                                    Details
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="sp-empty-state">
                            <div class="sp-empty-icon">
                                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"></path>
                                </svg>
                            </div>
                            <h6 class="sp-empty-title">No Event Registrations Yet</h6>
                            <p class="sp-empty-desc">
                                You haven't enrolled in any university workshops yet. Explore technical symposiums, hackathons, and guest seminars in the event catalog.
                            </p>
                            <a asp-area="Student" asp-controller="Events" asp-action="Index" class="btn-sp-primary">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                                <span>Explore Event Catalog</span>
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- 2. Participation & Attendance History Panel -->
            <div class="sp-panel">
                <div class="sp-panel-header">
                    <h2 class="sp-panel-title">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary">
                            <path d="M9 11l3 3L22 4"></path>
                            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                        </svg>
                        <span>Recent Attendance Records</span>
                    </h2>
                    <span class="badge bg-light text-muted border">Verified Log</span>
                </div>
                <div class="p-0">
                    @if (Model?.AttendanceHistory != null && Model.AttendanceHistory.Any())
                    {
                        <div class="sp-table-wrap">
                            <table class="sp-table">
                                <thead>
                                    <tr>
                                        <th>Event Title</th>
                                        <th>Check-In Timestamp</th>
                                        <th>Verification Method</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var att in Model.AttendanceHistory)
                                    {
                                        <tr>
                                            <td class="fw-semibold text-dark">@att.Registration?.Event?.Title</td>
                                            <td class="small text-muted text-nowrap">@att.CheckedInAt.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td>
                                                <span class="badge bg-light text-dark border">
                                                    @att.CheckInMethod
                                                </span>
                                            </td>
                                            <td>
                                                <span class="sp-badge sp-badge-attended">
                                                    @att.Status
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="sp-empty-state py-4">
                            <div class="sp-empty-icon" style="width: 44px; height: 44px;">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <path d="M9 11l3 3L22 4"></path>
                                    <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                                </svg>
                            </div>
                            <h6 class="sp-empty-title" style="font-size: 0.95rem;">No Check-In Records Yet</h6>
                            <p class="sp-empty-desc mb-0" style="font-size: 0.8rem;">
                                When you attend events and scan your digital QR pass at venue admission desks, verified attendance records will appear here.
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column (4 cols): Discovery Highlights & Certificate Status -->
    <div class="col-lg-4">
        <div class="d-flex flex-column gap-4">
            <!-- Discover Campus Events Widget -->
            <div class="sp-panel">
                <div class="sp-panel-header">
                    <h2 class="sp-panel-title">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                        <span>Open Campus Registrations</span>
                    </h2>
                    <a asp-area="Student" asp-controller="Events" asp-action="Index" class="small text-decoration-none fw-semibold">
                        View All &rarr;
                    </a>
                </div>
                <div class="p-3">
                    @if (Model?.DiscoverEvents != null && Model.DiscoverEvents.Any())
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var ev in Model.DiscoverEvents)
                            {
                                <a asp-area="Student" asp-controller="Events" asp-action="Details" asp-route-id="@ev.Id" 
                                   class="sp-discover-item">
                                    <div class="overflow-hidden me-2">
                                        <div class="sp-discover-title text-truncate">@ev.Title</div>
                                        <div class="text-muted" style="font-size: 0.72rem; font-variant-numeric: tabular-nums;">
                                            @ev.Department?.Name &bull; @ev.EventStartDate.ToString("MMM dd")
                                        </div>
                                    </div>
                                    <span class="sp-badge sp-badge-info text-nowrap" style="font-size: 0.68rem;">
                                        @ev.EventType
                                    </span>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted small">
                            No events currently open for registration.
                        </div>
                    }
                </div>
            </div>

            <!-- Digital Certificates Credential Card -->
            <div class="sp-panel">
                <div class="sp-panel-header">
                    <h2 class="sp-panel-title">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-warning">
                            <circle cx="12" cy="8" r="6"></circle>
                            <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"></path>
                        </svg>
                        <span>Academic Credentials</span>
                    </h2>
                    <span class="badge bg-warning-subtle text-warning-emphasis border">Verified</span>
                </div>
                <div class="sp-panel-body">
                    <div class="p-3 rounded-3 bg-light border text-center mb-3">
                        <div class="d-inline-flex align-items-center justify-content-center bg-white rounded-circle p-2 shadow-sm mb-2 text-warning" style="width: 44px; height: 44px;">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="8" r="6"></circle>
                                <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"></path>
                            </svg>
                        </div>
                        <div class="fw-bold small text-dark">University Verified Credentials</div>
                        <div class="text-muted" style="font-size: 0.75rem;">Cryptographically verifiable PDF certificates</div>
                    </div>
                    <div class="small text-muted mb-3">
                        <strong>Earning Requirements:</strong>
                        <ul class="ps-3 mb-0 mt-1" style="font-size: 0.76rem;">
                            <li>Confirmed event registration.</li>
                            <li>QR verified venue check-in.</li>
                            <li>Immediate certificate release upon event conclusion.</li>
                        </ul>
                    </div>
                    <a asp-area="Student" asp-controller="Certificates" asp-action="Index" class="btn-sp-outline w-100 btn-sm fw-semibold justify-content-center text-decoration-none">
                        View My Certificates &rarr;
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
