@model List<CollegeEventRegistration.Core.DTOs.CertificateEligibilityDto>
@using CollegeEventRegistration.Core.Enums

@{
    Layout = "_StudentPortalLayout";
    ViewData["Title"] = "My Certificates";
}

<!-- Header & Breadcrumb -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-primary-subtle text-primary border">Credentials</span>
            <span class="text-muted small">VAP UNIVERSITY Campus Event Hub</span>
        </div>
        <h2 class="fw-bold text-dark mb-0" style="letter-spacing: -0.02em;">My Certificates</h2>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="Student" asp-controller="Registrations" asp-action="Index" class="btn-sp-outline text-decoration-none d-inline-flex align-items-center gap-2">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><polyline points="16 11 18 13 22 9"></polyline></svg>
            <span>My Registrations</span>
        </a>
        <a asp-controller="Certificates" asp-action="Verify" asp-area="" target="_blank" class="btn-sp-primary text-decoration-none d-inline-flex align-items-center gap-2 shadow-sm">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="6"></circle><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"></path></svg>
            <span>Public Verification Portal</span>
        </a>
    </div>
</div>

<!-- Alert Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <div class="d-flex align-items-center gap-2">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            <span>@TempData["SuccessMessage"]</span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <div class="d-flex align-items-center gap-2">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <span>@TempData["ErrorMessage"]</span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Certificates List -->
@if (Model == null || !Model.Any())
{
    <div class="sp-panel text-center py-5">
        <div class="sp-empty-icon" style="width: 56px; height: 56px;">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="12" cy="8" r="6"></circle>
                <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"></path>
            </svg>
        </div>
        <h5 class="fw-bold text-dark mb-1">No Certificates Found</h5>
        <p class="text-muted small mb-3">You do not have any registered events yet. Attend and complete events to earn verified credentials.</p>
        <a asp-area="Student" asp-controller="Events" asp-action="Index" class="btn-sp-primary">Explore Events</a>
    </div>
}
else
{
    <div class="sp-panel mb-4">
        <div class="sp-table-wrap">
            <table class="sp-table">
                <thead>
                    <tr>
                        <th class="ps-4">Event Details</th>
                        <th>Registration</th>
                        <th>Status</th>
                        <th>Certificate Details</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 py-3">
                                <div class="fw-bold text-dark" style="font-family: var(--sp-font-display); font-size: 1.05rem;">@item.EventTitle</div>
                                <div class="text-muted small">
                                    Concluded: @(item.EventEndDate != DateTime.MinValue ? item.EventEndDate.ToString("dd MMM yyyy") : "N/A")
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border font-monospace">@item.RegistrationNumber</span>
                            </td>
                            <td>
                                @if (item.IsIssued)
                                {
                                    if (item.Status == CertificateStatus.Revoked)
                                    {
                                        <span class="sp-badge sp-badge-cancelled">Revoked</span>
                                    }
                                    else
                                    {
                                        <span class="sp-badge sp-badge-confirmed">Issued &amp; Active</span>
                                    }
                                }
                                else if (item.IsEligible)
                                {
                                    <span class="sp-badge sp-badge-waitlisted">Eligible to Claim</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-muted border">@item.EligibilityReason</span>
                                }
                            </td>
                            <td>
                                @if (item.IsIssued)
                                {
                                    <div class="font-monospace small fw-bold text-primary">@item.CertificateNumber</div>
                                }
                                else
                                {
                                    <span class="text-muted small">Not Issued</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                @if (item.IsIssued && item.CertificateId.HasValue)
                                {
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.CertificateId.Value" class="btn btn-outline-primary py-1 px-2">
                                            View
                                        </a>
                                        <a asp-action="Download" asp-route-id="@item.CertificateId.Value" class="btn btn-primary py-1 px-2">
                                            PDF
                                        </a>
                                    </div>
                                }
                                else if (item.IsEligible)
                                {
                                    <form asp-action="Claim" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="registrationId" value="@item.RegistrationId" />
                                        <button type="submit" class="btn btn-sm btn-success fw-semibold py-1 px-3">
                                            Claim Certificate
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-light border py-1 px-2" disabled title="@item.EligibilityReason">
                                        Unavailable
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
