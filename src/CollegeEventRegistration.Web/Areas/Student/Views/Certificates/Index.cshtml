@model List<CollegeEventRegistration.Core.DTOs.CertificateEligibilityDto>
@using CollegeEventRegistration.Core.Enums

@{
    Layout = "_StudentPortalLayout";
    ViewData["Title"] = "My Certificates";
}

<div class="container-xl my-4">
    <!-- Header & Breadcrumb -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary border">Credentials</span>
                <span class="text-muted small">VAP UNIVERSITY Campus Event Hub</span>
            </div>
            <h2 class="fw-bold text-dark mb-0" style="letter-spacing: -0.02em;">My Certificates</h2>
        </div>
        <div class="d-flex gap-2">
            <a asp-area="Student" asp-controller="Registrations" asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 shadow-sm">
                <i class="bi bi-card-checklist"></i>
                <span>My Registrations</span>
            </a>
            <a asp-controller="Certificates" asp-action="Verify" asp-area="" target="_blank" class="btn btn-outline-primary d-inline-flex align-items-center gap-2 shadow-sm">
                <i class="bi bi-patch-check"></i>
                <span>Public Verification Portal</span>
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <span>@TempData["ErrorMessage"]</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Certificates List -->
    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm border-0 text-center py-5">
            <div class="card-body">
                <div class="d-inline-flex align-items-center justify-content-center bg-light text-muted rounded-circle p-3 mb-3" style="width: 64px; height: 64px;">
                    <i class="bi bi-award fs-1"></i>
                </div>
                <h5 class="fw-bold text-dark">No Certificates Found</h5>
                <p class="text-muted mb-3">You do not have any registered events yet. Attend and complete events to earn verified credentials.</p>
                <a asp-area="Student" asp-controller="Events" asp-action="Index" class="btn btn-primary">Explore Events</a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Event Details</th>
                            <th>Registration</th>
                            <th>Status</th>
                            <th>Certificate Details</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="fw-bold text-dark">@item.EventTitle</div>
                                    <div class="text-muted small">
                                        Concluded: @(item.EventEndDate != DateTime.MinValue ? item.EventEndDate.ToString("dd MMM yyyy") : "N/A")
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border font-monospace">@item.RegistrationNumber</span>
                                </td>
                                <td>
                                    @if (item.IsIssued)
                                    {
                                        if (item.Status == CertificateStatus.Revoked)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger">Revoked</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success">Issued & Active</span>
                                        }
                                    }
                                    else if (item.IsEligible)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary">Eligible to Claim</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-muted border">@item.EligibilityReason</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsIssued)
                                    {
                                        <div class="font-monospace small fw-bold text-dark">@item.CertificateNumber</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Not Issued</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    @if (item.IsIssued && item.CertificateId.HasValue)
                                    {
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@item.CertificateId.Value" class="btn btn-outline-primary">
                                                <i class="bi bi-eye"></i> View
                                            </a>
                                            <a asp-action="Download" asp-route-id="@item.CertificateId.Value" class="btn btn-primary">
                                                <i class="bi bi-download"></i> PDF
                                            </a>
                                        </div>
                                    }
                                    else if (item.IsEligible)
                                    {
                                        <form asp-action="Claim" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="registrationId" value="@item.RegistrationId" />
                                            <button type="submit" class="btn btn-sm btn-success fw-semibold">
                                                <i class="bi bi-patch-check"></i> Claim Certificate
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-light border" disabled title="@item.EligibilityReason">
                                            Unavailable
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
