@model CollegeEventRegistration.Core.DTOs.TicketDto
@using CollegeEventRegistration.Core.DTOs
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admission Ticket - @Model.TicketCode - VAP UNIVERSITY</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background-color: #f8fafc;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            color: #0f172a;
            padding: 30px 0;
        }
        .ticket-sheet {
            max-width: 800px;
            margin: 0 auto;
            background: #ffffff;
            border: 2px dashed #cbd5e1;
            border-radius: 14px;
            box-shadow: 0 10px 25px rgba(15, 23, 42, 0.08);
            overflow: hidden;
        }
        .ticket-header {
            background: linear-gradient(135deg, #0a0f1d 0%, #1e3a8a 100%);
            color: #ffffff;
            padding: 24px 32px;
        }
        .ticket-stub {
            border-left: 2px dashed #e2e8f0;
            background: #f8fafc;
        }
        @@media print {
            body {
                background: #ffffff !important;
                padding: 0 !important;
            }
            .ticket-sheet {
                box-shadow: none !important;
                border: 2px dashed #94a3b8 !important;
                margin: 0 auto !important;
                page-break-inside: avoid;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body>
    <!-- Action Controls (Hidden on Print) -->
    <div class="container text-center mb-4 no-print">
        <button onclick="window.print()" class="btn btn-primary btn-lg px-4 me-2 shadow-sm fw-semibold">
            Print Ticket / Save PDF
        </button>
        <button onclick="window.close()" class="btn btn-outline-secondary btn-lg px-4">
            Close Window
        </button>
    </div>

    <!-- Official Ticket Sheet -->
    <div class="ticket-sheet">
        <!-- Header -->
        <div class="ticket-header d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <img src="~/images/branding/vap-university-logo.png" alt="VAP Logo" style="height: 48px; background: white; border-radius: 8px; padding: 4px;" />
                <div>
                    <h5 class="fw-bold mb-0 text-white" style="letter-spacing: -0.01em;">VAP UNIVERSITY</h5>
                    <div class="small text-white-50">Campus Event Hub &bull; Official Admission Pass</div>
                </div>
            </div>
            <div class="text-end">
                @if (Model.Status == TicketStatus.Valid)
                {
                    <span class="badge bg-success fs-6 px-3 py-2">VALID ADMISSION PASS</span>
                }
                else
                {
                    <span class="badge bg-danger fs-6 px-3 py-2">@Model.StatusMessage</span>
                }
            </div>
        </div>

        <!-- Main Body -->
        <div class="row g-0">
            <!-- Left Info Pane -->
            <div class="col-8 p-4 p-md-5">
                <div class="badge bg-light text-primary border mb-2">@Model.EventDepartmentCode &bull; @Model.EventMode</div>
                <h3 class="fw-bold text-dark mb-4">@Model.EventTitle</h3>

                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <div class="text-muted small">Ticket Reference</div>
                        <div class="fw-bold font-monospace fs-5 text-primary">@Model.TicketCode</div>
                    </div>
                    <div class="col-6">
                        <div class="text-muted small">Registration Number</div>
                        <div class="fw-bold font-monospace text-dark">@Model.RegistrationNumber</div>
                    </div>
                    <div class="col-6">
                        <div class="text-muted small">Event Date</div>
                        <div class="fw-semibold text-dark">@Model.EventStartDate.ToString("dddd, MMMM dd, yyyy")</div>
                    </div>
                    <div class="col-6">
                        <div class="text-muted small">Schedule (UTC)</div>
                        <div class="fw-semibold text-dark">@Model.EventStartDate.ToString("HH:mm") - @Model.EventEndDate.ToString("HH:mm") UTC</div>
                    </div>
                    <div class="col-12">
                        <div class="text-muted small">Venue / Location</div>
                        <div class="fw-semibold text-dark">@(Model.EventVenue ?? "Campus Auditorium")</div>
                    </div>
                </div>

                <div class="border-top pt-3">
                    <div class="row g-2 small text-muted">
                        <div class="col-6"><strong>Student:</strong> @Model.StudentName</div>
                        <div class="col-6"><strong>Roll #:</strong> @(Model.StudentRollNumber ?? "N/A")</div>
                        <div class="col-6"><strong>Department:</strong> @(Model.StudentDepartment ?? "General")</div>
                        <div class="col-6"><strong>College:</strong> @(Model.StudentCollegeName ?? "VAP UNIVERSITY")</div>
                    </div>
                </div>
            </div>

            <!-- Right QR Stub -->
            <div class="col-4 ticket-stub p-4 d-flex flex-column align-items-center justify-content-center text-center">
                <div class="p-2 bg-white border rounded shadow-sm mb-3">
                    <img src="@Model.QrCodeBase64" alt="QR Code" style="width: 170px; height: 170px; image-rendering: pixelated;" />
                </div>
                <div class="fw-bold text-dark font-monospace" style="font-size: 0.9rem;">@Model.TicketCode</div>
                <div class="text-muted" style="font-size: 0.75rem;">Scan for Entry Check-In</div>
                <div class="text-muted mt-2" style="font-size: 0.7rem;">Issued: @Model.IssuedAt.ToString("yyyy-MM-dd HH:mm") UTC</div>
            </div>
        </div>

        <!-- Perforated Rule -->
        <div class="bg-light border-top p-3 px-4 text-muted" style="font-size: 0.75rem;">
            <div><strong>Instructions:</strong> Please present this official admission ticket along with your student ID card at the entrance desk. Non-transferable. Cryptographically signed.</div>
        </div>
    </div>
</body>
</html>
