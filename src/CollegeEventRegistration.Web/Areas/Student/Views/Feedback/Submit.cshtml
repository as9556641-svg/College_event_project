@model CollegeEventRegistration.Core.DTOs.FeedbackSubmissionDto
@{
    Layout = "_StudentPortalLayout";
    ViewData["Title"] = "Submit Event Feedback";
    var eligibility = ViewBag.Eligibility as CollegeEventRegistration.Core.DTOs.StudentFeedbackEligibilityDto;
}

<!-- Breadcrumb -->
<div class="mb-3">
    <a asp-action="Index" class="btn btn-sm btn-link text-decoration-none text-muted ps-0 d-inline-flex align-items-center gap-1">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        <span>Back to My Feedback</span>
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <!-- Header Card -->
        <div class="sp-panel mb-4">
            <div class="sp-panel-body">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="sp-badge sp-badge-confirmed">
                        Verified Attendance
                    </span>
                    <span class="text-muted small">Pass: @(eligibility?.RegistrationNumber ?? $"Reg #{Model.RegistrationId}")</span>
                </div>
                <h3 class="fw-bold text-dark mb-1">@(eligibility?.EventTitle ?? "Event Evaluation")</h3>
                <p class="text-muted mb-0 small">
                    Share your experience to help us improve campus workshops and academic symposiums. Your constructive feedback is deeply appreciated.
                </p>
            </div>
        </div>

        <!-- Feedback Submission Form -->
        <div class="sp-panel mb-4">
            <div class="sp-panel-body">
                <form asp-action="Submit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="RegistrationId" />

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2 mb-4" role="alert">
                            <div asp-validation-summary="All" class="small mb-0"></div>
                        </div>
                    }

                    <!-- 1. Overall Rating -->
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark d-block mb-1">
                            Overall Event Experience <span class="text-danger">*</span>
                        </label>
                        <div class="small text-muted mb-2">How satisfied were you overall with this campus event?</div>
                        
                        <div class="d-flex flex-wrap gap-2">
                            @for (int score = 5; score >= 1; score--)
                            {
                                var label = score switch
                                {
                                    5 => "5 ★ Excellent",
                                    4 => "4 ★ Very Good",
                                    3 => "3 ★ Good",
                                    2 => "2 ★ Fair",
                                    _ => "1 ★ Poor"
                                };
                                <div class="form-check form-check-inline sp-rating-option m-0 @(Model.OverallRating == score ? "selected" : "")">
                                    <input class="form-check-input" type="radio" asp-for="OverallRating" value="@score" id="overallRating_@score" />
                                    <label class="form-check-label fw-medium text-dark small" for="overallRating_@score">
                                        @label
                                    </label>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="OverallRating" class="text-danger small"></span>
                    </div>

                    <hr class="my-4 text-muted" />

                    <!-- 2. Dimensional Ratings -->
                    <h5 class="fw-bold text-dark mb-3">Detailed Assessment</h5>
                    <div class="row g-3 mb-4">
                        <!-- Content Quality -->
                        <div class="col-md-4">
                            <label class="form-label fw-medium text-dark small mb-1">Content Quality</label>
                            <select asp-for="ContentQualityRating" class="form-select form-select-sm">
                                <option value="5">5 ★ Excellent</option>
                                <option value="4">4 ★ Very Good</option>
                                <option value="3">3 ★ Good</option>
                                <option value="2">2 ★ Fair</option>
                                <option value="1">1 ★ Poor</option>
                            </select>
                            <div class="text-muted" style="font-size: 0.75rem;">Relevance &amp; depth</div>
                        </div>

                        <!-- Speaker / Presenter -->
                        <div class="col-md-4">
                            <label class="form-label fw-medium text-dark small mb-1">Speaker / Presenter</label>
                            <select asp-for="SpeakerRating" class="form-select form-select-sm">
                                <option value="5">5 ★ Excellent</option>
                                <option value="4">4 ★ Very Good</option>
                                <option value="3">3 ★ Good</option>
                                <option value="2">2 ★ Fair</option>
                                <option value="1">1 ★ Poor</option>
                            </select>
                            <div class="text-muted" style="font-size: 0.75rem;">Clarity &amp; delivery</div>
                        </div>

                        <!-- Venue / Organization -->
                        <div class="col-md-4">
                            <label class="form-label fw-medium text-dark small mb-1">Venue &amp; Facilities</label>
                            <select asp-for="VenueRating" class="form-select form-select-sm">
                                <option value="5">5 ★ Excellent</option>
                                <option value="4">4 ★ Very Good</option>
                                <option value="3">3 ★ Good</option>
                                <option value="2">2 ★ Fair</option>
                                <option value="1">1 ★ Poor</option>
                            </select>
                            <div class="text-muted" style="font-size: 0.75rem;">Comfort &amp; logistics</div>
                        </div>
                    </div>

                    <hr class="my-4 text-muted" />

                    <!-- 3. Qualitative Comments -->
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark mb-1">
                            Comments, Key Takeaways &amp; Suggestions
                        </label>
                        <div class="small text-muted mb-2">What did you enjoy most? What could our coordinators improve next time? (Max 1,000 characters)</div>
                        <textarea asp-for="Comments" class="form-control" rows="4" maxlength="1000" id="feedbackComments"
                                  placeholder="Write your feedback, highlights, or suggestions for the organizers..."></textarea>
                        <div class="d-flex justify-content-between mt-1">
                            <span asp-validation-for="Comments" class="text-danger small"></span>
                            <span class="text-muted small" id="charCount">0 / 1000</span>
                        </div>
                    </div>

                    <!-- 4. Anonymous Submission Option -->
                    <div class="card bg-light border-0 p-3 mb-4">
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" asp-for="IsAnonymous" id="isAnonymousSwitch" />
                            <label class="form-check-label fw-medium text-dark small" for="isAnonymousSwitch">
                                Submit anonymously
                            </label>
                            <div class="text-muted" style="font-size: 0.8rem;">
                                Your name and roll number will be masked on coordinator and attendee feedback views.
                            </div>
                        </div>
                    </div>

                    <!-- 5. Actions -->
                    <div class="d-flex align-items-center justify-content-between pt-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn-sp-primary px-4">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            <span>Submit Feedback</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const commentBox = document.getElementById('feedbackComments');
        const countSpan = document.getElementById('charCount');
        if (commentBox && countSpan) {
            const updateCount = () => {
                countSpan.textContent = `${commentBox.value.length} / 1000`;
            };
            commentBox.addEventListener('input', updateCount);
            updateCount();
        }
    </script>
}
