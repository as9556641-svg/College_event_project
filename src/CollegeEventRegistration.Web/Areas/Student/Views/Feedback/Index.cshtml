@model IReadOnlyList<CollegeEventRegistration.Core.DTOs.StudentFeedbackEligibilityDto>
@{
    Layout = "_StudentPortalLayout";
    ViewData["Title"] = "My Feedback";

    var pendingFeedback = Model.Where(m => m.IsEligible).ToList();
    var submittedFeedback = Model.Where(m => m.HasSubmittedFeedback).ToList();
    var ineligibleEvents = Model.Where(m => !m.IsEligible && !m.HasSubmittedFeedback).ToList();
}

<!-- Header -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-primary-subtle text-primary border">Evaluation &amp; Ratings</span>
            <span class="text-muted small">Campus Event Hub</span>
        </div>
        <h2 class="fw-bold text-dark mb-0" style="letter-spacing: -0.02em;">Event Feedback &amp; Ratings</h2>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="Student" asp-controller="Registrations" asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 shadow-sm">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
            <span>My Registrations</span>
        </a>
        <a asp-area="Student" asp-controller="Tickets" asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 shadow-sm">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M7 7h10v10H7z"></path></svg>
            <span>My Tickets</span>
        </a>
    </div>
</div>

<!-- Feedback Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <div class="d-flex align-items-center gap-2">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            <span>@TempData["SuccessMessage"]</span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <div class="d-flex align-items-center gap-2">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <span>@TempData["ErrorMessage"]</span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["InfoMessage"] != null)
{
    <div class="alert alert-info alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <div class="d-flex align-items-center gap-2">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <span>@TempData["InfoMessage"]</span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="sp-kpi-card">
            <div class="sp-kpi-icon-wrap sp-kpi-icon-amber">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            </div>
            <div>
                <div class="sp-kpi-label">Pending Feedback</div>
                <div class="sp-kpi-val text-warning">@pendingFeedback.Count</div>
                <p class="sp-kpi-sub">Attended events awaiting evaluation</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="sp-kpi-card">
            <div class="sp-kpi-icon-wrap sp-kpi-icon-green">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            </div>
            <div>
                <div class="sp-kpi-label">Feedbacks Submitted</div>
                <div class="sp-kpi-val" style="color: #059669;">@submittedFeedback.Count</div>
                <p class="sp-kpi-sub">Completed event reviews</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="sp-kpi-card">
            <div class="sp-kpi-icon-wrap sp-kpi-icon-blue">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            </div>
            <div>
                <div class="sp-kpi-label">Total Events</div>
                <div class="sp-kpi-val text-primary">@Model.Count</div>
                <p class="sp-kpi-sub">Confirmed registrations</p>
            </div>
        </div>
    </div>
</div>

<!-- Section 1: Ready for Feedback -->
<div class="sp-panel mb-4">
    <div class="sp-panel-header">
        <h5 class="sp-panel-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-warning">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
            <span>Events Ready for Your Feedback</span>
        </h5>
        <span class="sp-badge sp-badge-pending">@pendingFeedback.Count Available</span>
    </div>
    <div class="p-0">
        @if (pendingFeedback.Any())
        {
            <div class="sp-table-wrap">
                <table class="sp-table">
                    <thead>
                        <tr>
                            <th class="ps-4">Event</th>
                            <th>Registration</th>
                            <th>Concluded At</th>
                            <th>Attendance</th>
                            <th class="text-end pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in pendingFeedback)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@item.EventTitle</div>
                                    <div class="text-muted small">Event #@item.EventId</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border font-monospace">@item.RegistrationNumber</span>
                                </td>
                                <td>
                                    <div class="small text-muted">@item.EventEndDate.ToString("MMM dd, yyyy HH:mm") UTC</div>
                                </td>
                                <td>
                                    <span class="sp-badge sp-badge-confirmed">
                                        Verified Attended
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Submit" asp-route-registrationId="@item.RegistrationId" class="btn btn-sm btn-primary fw-bold shadow-sm d-inline-flex align-items-center gap-1">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                                        <span>Leave Feedback</span>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="sp-empty-state py-4">
                <div class="sp-empty-icon" style="width: 44px; height: 44px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                </div>
                <h6 class="sp-empty-title" style="font-size: 0.95rem;">No Pending Evaluations</h6>
                <p class="sp-empty-desc mb-0" style="font-size: 0.8rem;">
                    You have submitted feedback for all attended, completed events or no eligible events are currently awaiting review.
                </p>
            </div>
        }
    </div>
</div>

<!-- Section 2: Submitted Feedback History -->
<div class="sp-panel mb-4">
    <div class="sp-panel-header">
        <h5 class="sp-panel-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-success">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <span>Your Submitted Feedback</span>
        </h5>
        <span class="sp-badge sp-badge-confirmed">@submittedFeedback.Count Submitted</span>
    </div>
    <div class="p-0">
        @if (submittedFeedback.Any())
        {
            <div class="sp-table-wrap">
                <table class="sp-table">
                    <thead>
                        <tr>
                            <th class="ps-4">Event</th>
                            <th>Registration</th>
                            <th>Your Rating</th>
                            <th>Submitted On</th>
                            <th class="text-end pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in submittedFeedback)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@item.EventTitle</div>
                                    <div class="text-muted small">Event #@item.EventId</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border font-monospace">@item.RegistrationNumber</span>
                                </td>
                                <td>
                                    <div class="text-warning fw-bold d-flex align-items-center gap-1">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= (item.ExistingOverallRating ?? 0))
                                            {
                                                <span>&#9733;</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted opacity-25">&#9733;</span>
                                            }
                                        }
                                        <span class="text-dark small ms-1">(@(item.ExistingOverallRating ?? 0)/5)</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="small text-muted">@item.SubmittedAt?.ToString("MMM dd, yyyy HH:mm") UTC</div>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-registrationId="@item.RegistrationId" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                        <span>View Details</span>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-4 text-center text-muted small">
                No feedback records submitted yet.
            </div>
        }
    </div>
</div>

<!-- Section 3: Upcoming / Ineligible Events Guidance -->
@if (ineligibleEvents.Any())
{
    <div class="sp-panel" style="background: var(--sp-slate-50);">
        <div class="p-3">
            <div class="fw-bold text-secondary small mb-2">Upcoming or Unattended Events:</div>
            <ul class="mb-0 small text-muted ps-3">
                @foreach (var ev in ineligibleEvents)
                {
                    <li>
                        <strong>@ev.EventTitle</strong>: @ev.IneligibilityReason
                    </li>
                }
            </ul>
        </div>
    </div>
}
