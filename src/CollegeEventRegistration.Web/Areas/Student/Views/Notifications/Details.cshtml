@model CollegeEventRegistration.Core.DTOs.NotificationDto

@{
    Layout = "_StudentPortalLayout";
    ViewData["Title"] = Model.Title;
}

<div class="container-xl my-4">
    <div class="mb-4">
        <a asp-area="Student" asp-controller="Notifications" asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Notifications
        </a>
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-primary-subtle text-primary border">@Model.TypeName</span>
                    <span class="text-muted small">@Model.CreatedAt.ToString("f")</span>
                </div>
                <h3 class="fw-bold text-dark mb-3">@Model.Title</h3>
                <p class="text-secondary fs-6 mb-4">@Model.Message</p>

                @if (!string.IsNullOrEmpty(Model.EventTitle))
                {
                    <div class="p-3 bg-light rounded-3 mb-4">
                        <small class="text-muted text-uppercase fw-semibold">Related Event</small>
                        <h6 class="fw-bold text-dark mb-0 mt-1">@Model.EventTitle</h6>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.ActionUrl))
                {
                    <a href="@Model.ActionUrl" class="btn btn-primary d-inline-flex align-items-center gap-2">
                        <span>Continue</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                }
            </div>
        </div>
    </div>
</div>
