@model CollegeEventRegistration.Core.DTOs.PagedResult<CollegeEventRegistration.Core.DTOs.NotificationDto>
@using CollegeEventRegistration.Core.Enums

@{
    Layout = "_StudentPortalLayout";
    ViewData["Title"] = "Notification Inbox";
    var isUnreadOnly = (bool)(ViewBag.UnreadOnly ?? false);
    var totalUnread = (int)(ViewBag.TotalUnread ?? 0);
}

<div class="container-xl my-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary border">Inbox</span>
                <span class="text-muted small">Campus Communications</span>
            </div>
            <h2 class="fw-bold text-dark mb-0" style="letter-spacing: -0.02em;">
                Notifications
                @if (totalUnread > 0)
                {
                    <span class="badge bg-danger rounded-pill fs-6 align-middle ms-1">@totalUnread unread</span>
                }
            </h2>
        </div>
        <div class="d-flex gap-2">
            @if (totalUnread > 0)
            {
                <form asp-area="Student" asp-controller="Notifications" asp-action="MarkAllAsRead" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 shadow-sm">
                        <i class="bi bi-check2-all"></i>
                        <span>Mark All as Read</span>
                    </button>
                </form>
            }
            <a asp-area="Student" asp-controller="Announcements" asp-action="Index" class="btn btn-outline-primary d-inline-flex align-items-center gap-2 shadow-sm">
                <i class="bi bi-megaphone"></i>
                <span>Announcements</span>
            </a>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-2 d-flex gap-2">
            <a asp-area="Student" asp-controller="Notifications" asp-action="Index" asp-route-unreadOnly="false"
               class="btn btn-sm @(!isUnreadOnly ? "btn-primary" : "btn-light text-muted")">
                All (@Model.TotalCount)
            </a>
            <a asp-area="Student" asp-controller="Notifications" asp-action="Index" asp-route-unreadOnly="true"
               class="btn btn-sm @(isUnreadOnly ? "btn-primary" : "btn-light text-muted")">
                Unread (@totalUnread)
            </a>
        </div>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <div class="display-6 text-muted mb-3"><i class="bi bi-bell-slash"></i></div>
                <h5 class="fw-bold text-dark">No Notifications</h5>
                <p class="text-muted mb-0">
                    @(isUnreadOnly ? "You're all caught up! No unread notifications found." : "You do not have any notifications yet.")
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="list-group shadow-sm border-0 mb-4">
            @foreach (var item in Model.Items)
            {
                var iconClass = item.Type switch
                {
                    NotificationType.RegistrationConfirmation => "bi-check-circle-fill text-success",
                    NotificationType.RegistrationCancelled => "bi-x-circle-fill text-danger",
                    NotificationType.WaitlistPromoted => "bi-arrow-up-circle-fill text-primary",
                    NotificationType.PaymentSuccess => "bi-currency-rupee text-success",
                    NotificationType.PaymentFailed => "bi-exclamation-triangle-fill text-danger",
                    NotificationType.TicketIssued => "bi-qr-code text-info",
                    NotificationType.AttendanceConfirmed => "bi-person-check-fill text-primary",
                    NotificationType.CertificateAvailable => "bi-patch-check-fill text-warning",
                    NotificationType.CertificateRevoked => "bi-patch-exclamation-fill text-danger",
                    NotificationType.Announcement => "bi-megaphone-fill text-info",
                    _ => "bi-bell-fill text-secondary"
                };

                <div class="list-group-item list-group-item-action p-3 @(!item.IsRead ? "bg-light border-start border-primary border-4" : "")">
                    <div class="d-flex w-100 justify-content-between align-items-start gap-3">
                        <div class="d-flex align-items-start gap-3">
                            <div class="fs-4 mt-1"><i class="bi @iconClass"></i></div>
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <h6 class="mb-0 fw-bold @(!item.IsRead ? "text-dark" : "text-muted")">@item.Title</h6>
                                    @if (!item.IsRead)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border" style="font-size: 0.7rem;">NEW</span>
                                    }
                                </div>
                                <p class="mb-2 text-secondary small">@item.Message</p>
                                <div class="d-flex flex-wrap align-items-center gap-3 text-muted" style="font-size: 0.8rem;">
                                    <span><i class="bi bi-clock me-1"></i>@item.TimeAgo</span>
                                    @if (!string.IsNullOrEmpty(item.EventTitle))
                                    {
                                        <span><i class="bi bi-calendar-event me-1"></i>@item.EventTitle</span>
                                    }
                                    @if (!string.IsNullOrEmpty(item.ActionUrl))
                                    {
                                        <a href="@item.ActionUrl" class="text-primary fw-medium text-decoration-none">
                                            View Details <i class="bi bi-arrow-right"></i>
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            @if (!item.IsRead)
                            {
                                <form asp-area="Student" asp-controller="Notifications" asp-action="MarkAsRead" asp-route-id="@item.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="Mark as read">
                                        <i class="bi bi-check2"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Notification pagination">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)" asp-route-unreadOnly="@isUnreadOnly">Previous</a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-unreadOnly="@isUnreadOnly">@p</a>
                        </li>
                    }
                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)" asp-route-unreadOnly="@isUnreadOnly">Next</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>
