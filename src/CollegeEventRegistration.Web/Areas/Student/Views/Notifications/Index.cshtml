@model CollegeEventRegistration.Core.DTOs.PagedResult<CollegeEventRegistration.Core.DTOs.NotificationDto>
@using CollegeEventRegistration.Core.Enums

@{
    Layout = "_StudentPortalLayout";
    ViewData["Title"] = "Notification Inbox";
    var isUnreadOnly = (bool)(ViewBag.UnreadOnly ?? false);
    var totalUnread = (int)(ViewBag.TotalUnread ?? 0);
}

<!-- Header -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-primary-subtle text-primary border">Inbox</span>
            <span class="text-muted small">Campus Communications</span>
        </div>
        <h2 class="fw-bold text-dark mb-0" style="letter-spacing: -0.02em;">
            Notifications
            @if (totalUnread > 0)
            {
                <span class="badge bg-danger rounded-pill fs-6 align-middle ms-1">@totalUnread unread</span>
            }
        </h2>
    </div>
    <div class="d-flex gap-2">
        @if (totalUnread > 0)
        {
            <form asp-area="Student" asp-controller="Notifications" asp-action="MarkAllAsRead" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-sp-outline d-inline-flex align-items-center gap-2">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    <span>Mark All as Read</span>
                </button>
            </form>
        }
        <a asp-area="Student" asp-controller="Announcements" asp-action="Index" class="btn-sp-primary text-decoration-none d-inline-flex align-items-center gap-2 shadow-sm">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 11 18-5v12L3 14v-3z"></path><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"></path></svg>
            <span>Announcements</span>
        </a>
    </div>
</div>

<!-- Filter Bar -->
<div class="sp-panel mb-4">
    <div class="p-2 d-flex gap-2">
        <a asp-area="Student" asp-controller="Notifications" asp-action="Index" asp-route-unreadOnly="false"
           class="btn btn-sm @(!isUnreadOnly ? "btn-primary" : "btn-light text-muted")">
            All (@Model.TotalCount)
        </a>
        <a asp-area="Student" asp-controller="Notifications" asp-action="Index" asp-route-unreadOnly="true"
           class="btn btn-sm @(isUnreadOnly ? "btn-primary" : "btn-light text-muted")">
            Unread (@totalUnread)
        </a>
    </div>
</div>

@if (!Model.Items.Any())
{
    <div class="sp-panel text-center py-5">
        <div class="sp-empty-icon" style="width: 56px; height: 56px;">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
                <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
            </svg>
        </div>
        <h5 class="fw-bold text-dark mb-1">No Notifications</h5>
        <p class="text-muted small mb-0">
            @(isUnreadOnly ? "You're all caught up! No unread notifications found." : "You do not have any notifications yet.")
        </p>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3 mb-4">
        @foreach (var item in Model.Items)
        {
            <div class="sp-panel mb-0 @(!item.IsRead ? "border-start border-4 border-primary" : "")">
                <div class="p-3 d-flex w-100 justify-content-between align-items-start gap-3">
                    <div class="d-flex align-items-start gap-3">
                        <div class="p-2 rounded bg-light text-primary mt-1">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
                                <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
                            </svg>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <h6 class="mb-0 fw-bold @(!item.IsRead ? "text-dark" : "text-muted")">@item.Title</h6>
                                @if (!item.IsRead)
                                {
                                    <span class="badge bg-primary-subtle text-primary border" style="font-size: 0.7rem;">NEW</span>
                                }
                            </div>
                            <p class="mb-2 text-secondary small">@item.Message</p>
                            <div class="d-flex flex-wrap align-items-center gap-3 text-muted small" style="font-size: 0.78rem;">
                                <span>@item.TimeAgo</span>
                                @if (!string.IsNullOrEmpty(item.EventTitle))
                                {
                                    <span>&bull;</span>
                                    <span>@item.EventTitle</span>
                                }
                                @if (!string.IsNullOrEmpty(item.ActionUrl))
                                {
                                    <span>&bull;</span>
                                    <a href="@item.ActionUrl" class="text-primary fw-medium text-decoration-none">
                                        View Details &rarr;
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        @if (!item.IsRead)
                        {
                            <form asp-area="Student" asp-controller="Notifications" asp-action="MarkAsRead" asp-route-id="@item.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-secondary py-1 px-2" title="Mark as read">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Notification pagination">
            <ul class="pagination justify-content-center">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)" asp-route-unreadOnly="@isUnreadOnly">Previous</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-unreadOnly="@isUnreadOnly">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)" asp-route-unreadOnly="@isUnreadOnly">Next</a>
                </li>
            </ul>
        </nav>
    }
}
