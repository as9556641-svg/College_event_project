@model CollegeEventRegistration.Core.DTOs.PaymentOrderResultDto
@using System.Security.Cryptography
@using System.Text
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    Layout = "_StudentPortalLayout";
    ViewData["Title"] = $"Complete Payment - {Model.EventTitle}";
    var reg = (CollegeEventRegistration.Core.DTOs.RegistrationDetailDto)ViewBag.Registration;
    var keySecret = Configuration["Razorpay:KeySecret"] ?? "rzp_secret_default";
    
    // Generate valid test transaction tokens for seamless test mode checkout
    var testPaymentId = $"pay_test_{Guid.NewGuid().ToString("N")[..12]}";
    var payload = $"{Model.OrderId}|{testPaymentId}";
    string validSignature;
    using (var hmac = new HMACSHA256(Encoding.UTF8.GetBytes(keySecret)))
    {
        validSignature = Convert.ToHexStringLower(hmac.ComputeHash(Encoding.UTF8.GetBytes(payload)));
    }
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item">
            <a asp-area="Student" asp-controller="Registrations" asp-action="Details" asp-route-id="@Model.RegistrationId" class="text-decoration-none">&larr; Back to Registration</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Checkout</li>
    </ol>
</nav>

<!-- Feedback Alerts -->
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <div class="d-flex align-items-center gap-2">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <span>@TempData["ErrorMessage"]</span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4 justify-content-center">
    <!-- Order Summary & Payment Action (7 Cols) -->
    <div class="col-lg-7">
        <div class="sp-panel mb-4">
            <div class="sp-panel-body">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-3 border-bottom">
                    <div>
                        <span class="badge bg-primary-subtle text-primary border mb-1">Fee Payment Terminal</span>
                        <h4 class="fw-bold text-dark mb-0">Event Registration Fee</h4>
                    </div>
                    <div class="text-end">
                        <span class="text-muted small d-block">Total Due</span>
                        <h3 class="fw-bold text-success mb-0">&#8377;@Model.Amount.ToString("F2")</h3>
                    </div>
                </div>

                <!-- Event Snapshot -->
                <div class="mb-4">
                    <h5 class="fw-bold text-dark mb-1">@Model.EventTitle</h5>
                    <div class="text-muted small">
                        Registration Number: <span class="font-monospace text-dark fw-semibold">@Model.RegistrationNumber</span>
                    </div>
                </div>

                <!-- Fee Breakdown Table -->
                <div class="table-responsive mb-4">
                    <table class="table table-sm table-borderless mb-0">
                        <tbody>
                            <tr class="border-bottom">
                                <td class="text-muted py-2">Admission &amp; Kit Fee:</td>
                                <td class="text-end fw-semibold py-2">&#8377;@Model.Amount.ToString("F2")</td>
                            </tr>
                            <tr class="border-bottom">
                                <td class="text-muted py-2">Institutional Platform Fee:</td>
                                <td class="text-end text-success fw-semibold py-2">FREE</td>
                            </tr>
                            <tr class="border-bottom">
                                <td class="text-muted py-2">Applicable Taxes (GST):</td>
                                <td class="text-end text-muted py-2">&#8377;0.00</td>
                            </tr>
                            <tr class="table-light">
                                <td class="fw-bold text-dark py-2">Total Amount Payable:</td>
                                <td class="text-end fw-bold text-success py-2">&#8377;@Model.Amount.ToString("F2")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Gateway Order Information -->
                <div class="alert alert-light border small text-muted mb-4">
                    <div class="d-flex justify-content-between mb-1">
                        <span>Gateway Order ID:</span>
                        <strong class="font-monospace text-dark">@Model.OrderId</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span>Merchant Account:</span>
                        <span class="text-dark">VAP UNIVERSITY (Campus Event Hub)</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Security Protocol:</span>
                        <span class="text-success fw-semibold">256-Bit Encrypted HMAC-SHA256</span>
                    </div>
                </div>

                <!-- Payment Form -->
                <div class="d-flex flex-column gap-3">
                    <form asp-action="Verify" method="post" id="paymentForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="RegistrationId" value="@Model.RegistrationId" />
                        <input type="hidden" name="OrderId" value="@Model.OrderId" />
                        <input type="hidden" name="PaymentId" value="@testPaymentId" />
                        <input type="hidden" name="Signature" value="@validSignature" />
                        <input type="hidden" name="PaymentMethod" value="UPI / Card (Test Mode)" />

                        <button type="submit" class="btn-sp-primary w-100 py-3 justify-content-center shadow-sm">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="5" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
                            <span>Pay &#8377;@Model.Amount.ToString("F2") via Secure Gateway</span>
                        </button>
                    </form>

                    <form asp-action="CancelCheckout" method="post" onsubmit="return confirm('Cancel this checkout session?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="registrationId" value="@Model.RegistrationId" />
                        <input type="hidden" name="orderId" value="@Model.OrderId" />
                        <input type="hidden" name="reason" value="User cancelled payment at checkout terminal" />
                        <button type="submit" class="btn btn-outline-secondary w-100 py-2 btn-sm">
                            Cancel &amp; Pay Later
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Side: Security & Student Info (4 Cols) -->
    <div class="col-lg-4">
        <div class="sp-panel mb-4">
            <div class="sp-panel-header">
                <h6 class="sp-panel-title">Student Billing Details</h6>
            </div>
            <div class="sp-panel-body small d-flex flex-column gap-2">
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Student:</span>
                    <strong class="text-dark">@Model.StudentName</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Email:</span>
                    <strong class="text-dark">@Model.StudentEmail</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Event Date:</span>
                    <strong class="text-dark">@reg.EventStartDate.ToString("MMM dd, yyyy")</strong>
                </div>
            </div>
        </div>

        <div class="sp-panel">
            <div class="sp-panel-body bg-light">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                    <h6 class="fw-bold text-dark mb-0">Secure Institutional Policy</h6>
                </div>
                <p class="text-muted small mb-0">
                    All transactions are verified independently on university servers. Upon successful verification, your admission pass is issued immediately.
                </p>
            </div>
        </div>
    </div>
</div>
