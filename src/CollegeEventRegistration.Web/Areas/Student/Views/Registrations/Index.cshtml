@model CollegeEventRegistration.Core.DTOs.PagedResult<CollegeEventRegistration.Core.DTOs.RegistrationSummaryDto>
@using CollegeEventRegistration.Core.Enums
@{
    Layout = "_StudentPortalLayout";
    ViewData["Title"] = "My Registrations";
    var criteria = (CollegeEventRegistration.Core.DTOs.StudentRegistrationFilterCriteria)(ViewBag.Criteria ?? new CollegeEventRegistration.Core.DTOs.StudentRegistrationFilterCriteria());
}

<!-- Header -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-primary-subtle text-primary border">Student Enrollment</span>
            <span class="text-muted small">Campus Event Hub</span>
        </div>
        <h2 class="fw-bold text-dark mb-0" style="letter-spacing: -0.02em;">My Event Registrations</h2>
    </div>
    <div>
        <a asp-area="Student" asp-controller="Events" asp-action="Index" class="btn-sp-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <span>Browse More Events</span>
        </a>
    </div>
</div>

<!-- Feedback Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <div class="d-flex align-items-center gap-2">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            <span>@TempData["SuccessMessage"]</span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <div class="d-flex align-items-center gap-2">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <span>@TempData["ErrorMessage"]</span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Filter Toolbar -->
<div class="sp-panel mb-4">
    <div class="p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    </span>
                    <input type="text" name="SearchTerm" class="form-control border-start-0" placeholder="Search by event title or registration number..." value="@criteria.SearchTerm" />
                </div>
            </div>
            <div class="col-md-4">
                <select name="Status" class="form-select">
                    <option value="">All Registration Statuses</option>
                    <option value="@RegistrationStatus.Confirmed" selected="@(criteria.Status == RegistrationStatus.Confirmed)">Confirmed</option>
                    <option value="@RegistrationStatus.Pending" selected="@(criteria.Status == RegistrationStatus.Pending)">Pending Approval</option>
                    <option value="@RegistrationStatus.Waitlisted" selected="@(criteria.Status == RegistrationStatus.Waitlisted)">Waitlisted</option>
                    <option value="@RegistrationStatus.Cancelled" selected="@(criteria.Status == RegistrationStatus.Cancelled)">Cancelled</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn-sp-primary w-100 justify-content-center">Filter</button>
                @if (criteria.Status.HasValue || !string.IsNullOrWhiteSpace(criteria.SearchTerm))
                {
                    <a asp-action="Index" class="btn-sp-outline">Reset</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Registrations Grid -->
@if (Model.Items.Count > 0)
{
    <div class="sp-panel mb-4">
        <div class="sp-table-wrap">
            <table class="sp-table">
                <thead>
                    <tr>
                        <th class="ps-4">Registration #</th>
                        <th>Event Details</th>
                        <th>Schedule</th>
                        <th>Status</th>
                        <th>Registered On</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reg in Model.Items)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="font-monospace fw-semibold text-primary">@reg.RegistrationNumber</span>
                            </td>
                            <td>
                                <div class="fw-bold text-dark" style="font-family: var(--sp-font-display); font-size: 1.05rem;">@reg.EventTitle</div>
                                <div class="small text-muted mt-0.5">
                                    <span class="badge bg-light text-dark border me-1">@reg.EventDepartmentCode</span>
                                    <span>Mode: @reg.EventMode</span>
                                </div>
                            </td>
                            <td class="small text-nowrap" style="font-variant-numeric: tabular-nums;">
                                <div>@reg.EventStartDate.ToString("MMM dd, yyyy")</div>
                                <div class="text-muted">@reg.EventStartDate.ToString("hh:mm tt") UTC</div>
                            </td>
                            <td>
                                @switch (reg.Status)
                                {
                                    case RegistrationStatus.Confirmed:
                                        <span class="sp-badge sp-badge-confirmed">Confirmed</span>
                                        break;
                                    case RegistrationStatus.Pending:
                                        <span class="sp-badge sp-badge-pending">Pending Approval</span>
                                        break;
                                    case RegistrationStatus.Waitlisted:
                                        <span class="sp-badge sp-badge-waitlisted">Waitlisted</span>
                                        break;
                                    case RegistrationStatus.Cancelled:
                                        <span class="sp-badge sp-badge-cancelled">Cancelled</span>
                                        break;
                                }
                            </td>
                            <td class="small text-muted text-nowrap" style="font-variant-numeric: tabular-nums;">
                                @reg.RegisteredAt.ToString("MMM dd, yyyy")
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Details" asp-route-id="@reg.Id" class="btn-sp-outline py-1 px-3 text-decoration-none" style="font-size: 0.8rem;">
                                    View Details &rarr;
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="p-3 bg-white border-top d-flex justify-content-between align-items-center">
                <span class="text-muted small">Showing @Model.Items.Count of @Model.TotalCount registrations</span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-route-PageNumber="@(Model.PageNumber - 1)" asp-route-Status="@criteria.Status" asp-route-SearchTerm="@criteria.SearchTerm">&laquo;</a>
                        </li>
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-PageNumber="@p" asp-route-Status="@criteria.Status" asp-route-SearchTerm="@criteria.SearchTerm">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-route-PageNumber="@(Model.PageNumber + 1)" asp-route-Status="@criteria.Status" asp-route-SearchTerm="@criteria.SearchTerm">&raquo;</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
}
else
{
    <div class="sp-panel text-center py-5">
        <div class="sp-empty-icon" style="width: 56px; height: 56px;">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <line x1="17" y1="8" x2="22" y2="13"></line>
                <line x1="22" y1="8" x2="17" y2="13"></line>
            </svg>
        </div>
        <h5 class="fw-bold text-dark mb-1">No Registrations Found</h5>
        <p class="text-muted small mb-3">You haven't registered for any events matching your filter criteria.</p>
        <a asp-area="Student" asp-controller="Events" asp-action="Index" class="btn-sp-primary">
            Discover Campus Events
        </a>
    </div>
}
