      },
      "html": "<style>\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n:root{\n  --navy:#1F2C58; --ink:#0F172A; --muted:#4A5768; --soft:#6B7A90;\n  --line:#E4E8F0; --line-faint:#EFF2F7; --canvas:#F4F6FA; --surface:#F6F8FB;\n  --teal:#08898E; --blue:#2563EB; --blue-dark:#1D4ED8; --white:#fff;\n  --shadow:0 12px 28px -12px rgba(15,23,42,.14);\n  --sans:system-ui,-apple-system,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial,sans-serif;\n}\n*{box-sizing:border-box;}\nhtml{scroll-behavior:smooth;}\nbody{margin:0;background:#fff;color:var(--ink);font-family:var(--sans);font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased;}\nh1,h2,h3,h4{margin:0;font-weight:650;letter-spacing:-0.03em;color:var(--navy);}\np{margin:0;}\na{text-decoration:none;color:inherit;}\nimg{display:block;max-width:100%;}\n.wrap{max-width:1320px;margin:0 auto;padding:0 48px;}\n.tnum{font-variant-numeric:tabular-nums;font-feature-settings:\"tnum\";}\n\n/* hero */\n.hero{position:relative;height:520px;background:#0A101E url('https://kombai-assets.b-cdn.net/generated_assets/3318e320c1d04d84af2434a89b1bd18f.jpg') center right/cover no-repeat;display:flex;flex-direction:column;overflow:hidden;}\n.hero::after{content:\"\";position:absolute;inset:0;background:linear-gradient(96deg,rgba(7,12,24,.9) 0%,rgba(7,12,24,.74) 34%,rgba(7,12,24,.3) 66%,rgba(7,12,24,.04) 92%);pointer-events:none;}\n.hero-inner{position:relative;z-index:2;display:flex;flex-direction:column;height:100%;}\n.nav{display:flex;align-items:center;gap:22px;height:64px;border-bottom:1px solid rgba(255,255,255,.13);}\n.brand{display:flex;align-items:center;gap:10px;}\n.chip{background:#fff;border-radius:6px;padding:4px 7px;display:flex;align-items:center;}\n.chip img{height:24px;width:auto;}\n.brand-words{display:flex;flex-direction:column;line-height:1.15;}\n.brand-words b{font-size:14px;font-weight:700;color:#fff;letter-spacing:-0.01em;}\n.brand-words span{font-size:9px;font-weight:700;letter-spacing:.14em;color:#3FD6D9;text-transform:uppercase;}\n.nav-main{display:flex;align-items:center;gap:20px;margin-left:26px;flex:1;}\n.nav-links{display:flex;align-items:center;gap:1px;}\n.nav-links a{font-size:13px;font-weight:500;color:rgba(255,255,255,.78);padding:8px 11px;border-radius:5px;transition:background-color .18s ease,color .18s ease;}\n.nav-links a:hover{color:#fff;background:rgba(255,255,255,.1);}\n.nav-links a.on{color:#fff;background:rgba(255,255,255,.12);}\n.nav-auth{margin-left:auto;display:flex;align-items:center;gap:8px;}\n.a-ghost{display:inline-flex;align-items:center;height:36px;padding:0 14px;border-radius:6px;border:1px solid rgba(255,255,255,.3);color:#fff;font-size:13px;font-weight:600;}\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:38px;padding:0 16px;border-radius:7px;background:var(--blue);color:#fff!important;font-size:13.5px;font-weight:600;transition:background-color .18s ease;}\n.btn:hover{background:var(--blue-dark);}\n.btn-lg{height:46px;padding:0 22px;border-radius:8px;font-size:14.5px;}\n.nav-toggle{display:none;margin-left:auto;background:none;border:0;color:#fff;font-size:22px;padding:8px;cursor:pointer;}\n.hero-copy{margin-top:auto;margin-bottom:56px;max-width:520px;}\n.hero h1{font-size:50px;line-height:1.06;color:#fff;font-weight:680;letter-spacing:-0.035em;}\n.hero-sub{margin-top:14px;font-size:16px;color:rgba(255,255,255,.76);max-width:400px;line-height:1.58;}\n.hero-actions{margin-top:26px;display:flex;align-items:center;gap:20px;flex-wrap:wrap;}\n.hero-quiet{display:inline-flex;align-items:center;gap:7px;font-size:14px;font-weight:600;color:rgba(255,255,255,.9);}\n.hero-quiet i{font-size:15px;}\n.hero-quiet:hover{color:#fff;}\n\n/* shells */\n.sec{padding:64px 0;}\n.head{display:flex;align-items:flex-end;justify-content:space-between;gap:32px;}\nh2{font-size:30px;line-height:1.18;}\n.lede{margin-top:10px;font-size:14.5px;color:var(--muted);max-width:600px;}\n.link{display:inline-flex;align-items:center;gap:7px;font-size:13.5px;font-weight:600;color:var(--blue);white-space:nowrap;}\n.ctl-row{display:flex;gap:8px;}\n.ctl{width:38px;height:38px;border-radius:8px;border:1px solid var(--line);background:#fff;color:var(--navy);font-size:16px;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;transition:border-color .18s ease;}\n.ctl:hover{border-color:#B9C5D6;}\n\n/* categories */\n.rail{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;padding:26px 2px 4px;scrollbar-width:none;}\n.rail::-webkit-scrollbar{display:none;}\n.cat{flex:0 0 264px;scroll-snap-align:start;background:#fff;border:1px solid var(--line);border-radius:14px;padding:18px 18px 16px;display:flex;flex-direction:column;min-height:150px;transition:border-color .18s ease,box-shadow .18s ease;}\n.cat:hover{border-color:#CBD6E6;box-shadow:var(--shadow);}\n.cat-name{font-size:18px;line-height:1.28;font-weight:650;color:var(--navy);letter-spacing:-0.02em;}\n.cat-foot{margin-top:auto;padding-top:20px;display:flex;align-items:center;justify-content:space-between;gap:10px;}\n.count{font-size:13px;color:var(--soft);font-variant-numeric:tabular-nums;}\n.count b{font-size:19px;font-weight:650;color:var(--ink);letter-spacing:-0.02em;}\n.count i{font-style:normal;font-size:12.5px;display:block;color:var(--soft);}\n.count-col{display:flex;align-items:baseline;gap:6px;}\n.cat i.cat-icon{font-size:17px;color:#9AA9BF;}\n.cat-go{margin-top:14px;font-size:12.5px;font-weight:600;color:var(--blue);display:inline-flex;align-items:center;gap:5px;}\n.cat-go i{font-size:13px;}\n\n/* accredited — connected process strip */\n.process{margin-top:34px;border-top:1px solid var(--line);}\n.p-stage{display:grid;grid-template-columns:56px 1.1fr 1.6fr;gap:24px;align-items:start;padding:22px 0;border-bottom:1px solid var(--line);}\n.p-num{font-size:12px;font-weight:700;letter-spacing:.1em;color:var(--teal);font-variant-numeric:tabular-nums;padding-top:3px;}\n.p-stage h3{font-size:17px;line-height:1.35;font-weight:650;letter-spacing:-0.015em;}\n.p-stage p{font-size:13.6px;line-height:1.62;color:var(--muted);}\n.p-note{display:inline-flex;align-items:center;gap:7px;margin-top:8px;font-size:12.5px;font-weight:600;color:var(--soft);}\n.p-note i{font-size:14px;color:var(--teal);}\n\n/* programme */\n.prog-sec{background:var(--canvas);border-top:1px solid #E9EDF4;border-bottom:1px solid #E9EDF4;}\n.prog-head{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:26px;}\n.prog{background:#fff;border:1px solid #E6EAF2;border-radius:16px;box-shadow:var(--shadow);padding:6px 30px 12px;}\n.month{display:flex;align-items:center;gap:14px;padding:18px 0 8px;font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--soft);}\n.month::after{content:\"\";flex:1;height:1px;background:var(--line-faint);}\n.prow{display:grid;grid-template-columns:110px 1fr 120px 26px;gap:26px;align-items:start;padding:20px 0;border-bottom:1px solid var(--line-faint);}\n.prow:last-child{border-bottom:0;}\n.dategate{display:flex;flex-direction:column;align-items:flex-start;font-variant-numeric:tabular-nums;}\n.dg-wd{font-size:11px;font-weight:700;letter-spacing:.13em;color:var(--soft);text-transform:uppercase;}\n.dg-d{font-size:34px;line-height:1.05;font-weight:650;color:var(--navy);letter-spacing:-0.035em;margin:2px 0 0;}\n.dg-m{font-size:11px;font-weight:700;letter-spacing:.13em;color:var(--soft);text-transform:uppercase;}\n.pmain{min-width:0;}\n.pcat{font-size:12px;font-weight:600;color:var(--teal);letter-spacing:.01em;}\n.pmain h3{font-size:19px;line-height:1.3;margin-top:5px;font-weight:650;letter-spacing:-0.02em;}\n.pmain p{margin-top:7px;font-size:13.4px;line-height:1.6;color:var(--muted);max-width:600px;}\n.pfacts{margin-top:10px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:12.8px;color:var(--soft);font-variant-numeric:tabular-nums;}\n.pfacts .sep{width:3px;height:3px;border-radius:50%;background:#C6D0DF;}\n.plead{grid-template-columns:110px 1fr 430px;align-items:start;}\n.pmedia{margin-top:2px;border-radius:12px;overflow:hidden;height:270px;background:#0F172A;grid-column:3;}\n.pmedia img{width:100%;height:100%;object-fit:cover;}\n.plead .pgo{grid-column:3;display:flex;align-items:center;justify-content:space-between;margin-top:-40px;padding:0 2px;}\n.pgo{display:flex;align-items:flex-end;justify-content:flex-end;}\n.pgo-link{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:600;color:var(--blue);}\n.pprice{font-size:13.5px;font-weight:650;color:var(--ink);font-variant-numeric:tabular-nums;text-align:right;padding-top:2px;}\n.prow > i{font-size:15px;color:#A6B2C6;margin-top:4px;}\n.plead .pprice{display:none;}\n.plead-cta{grid-column:3;display:flex;align-items:center;justify-content:flex-end;margin-top:14px;}\n\n/* institution */\n.split{display:grid;grid-template-columns:1fr 1fr;gap:72px;align-items:start;}\n.split h2{font-size:34px;line-height:1.14;}\n.split .lede{max-width:420px;margin-top:14px;}\n.seq{display:flex;flex-direction:column;gap:0;}\n.seq-item{padding:18px 0;border-top:1px solid var(--line);}\n.seq-item:first-child{border-top:0;padding-top:0;}\n.seq-item h3{font-size:17px;font-weight:650;letter-spacing:-0.015em;display:flex;align-items:baseline;gap:12px;}\n.seq-item h3 em{font-style:normal;font-size:11px;font-weight:700;letter-spacing:.12em;color:var(--teal);font-variant-numeric:tabular-nums;}\n.seq-item p{margin-top:7px;font-size:13.8px;line-height:1.6;color:var(--muted);max-width:520px;}\n\n/* capabilities */\n.caps-sec{background:var(--surface);border-top:1px solid #E9EDF4;}\n.caps{display:grid;grid-template-columns:repeat(4,1fr);gap:0;margin-top:26px;border-top:1px solid var(--line);}\n.cap{padding:20px 24px 4px 0;border-right:1px solid var(--line);}\n.cap:last-child{border-right:0;padding-right:0;}\n.cap h3{font-size:15px;font-weight:650;letter-spacing:-0.01em;}\n.cap p{margin-top:6px;font-size:13px;line-height:1.55;color:var(--muted);}\n.cap i{font-size:16px;color:var(--teal);display:block;margin-bottom:12px;}\n\n/* account */\n.join{display:flex;align-items:center;justify-content:space-between;gap:40px;}\n.join h2{font-size:28px;}\n.join p{margin-top:8px;font-size:14px;color:var(--muted);}\n.join-actions{display:flex;align-items:center;gap:12px;flex:0 0 auto;}\n.a-outline{display:inline-flex;align-items:center;height:46px;padding:0 20px;border-radius:8px;border:1px solid #C9D3E2;color:var(--navy);font-size:14px;font-weight:600;background:#fff;}\n.a-outline:hover{border-color:#9FB0C8;background:#F8FAFC;}\n\n/* footer */\n.foot{background:#0F172A;color:#CBD5E1;padding:52px 0 0;}\n.foot-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1.2fr;gap:40px;padding-bottom:36px;}\n.foot-brand{display:flex;align-items:center;gap:10px;margin-bottom:16px;}\n.foot-brand .chip img{height:26px;}\n.foot-brand b{display:block;font-size:13.5px;color:#fff;font-weight:700;line-height:1.2;}\n.foot-brand span{font-size:9px;letter-spacing:.14em;color:#3FD6D9;font-weight:700;text-transform:uppercase;}\n.foot p{font-size:13px;line-height:1.65;color:#94A3B8;max-width:300px;}\n.foot h4{font-size:11px;font-weight:700;letter-spacing:.11em;text-transform:uppercase;color:#fff;margin-bottom:13px;}\n.foot ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px;font-size:13px;}\n.foot ul a{color:#94A3B8;}\n.foot ul a:hover{color:#fff;}\n.foot-contact{display:flex;flex-direction:column;gap:9px;font-size:13px;color:#94A3B8;}\n.foot-contact div{display:flex;gap:8px;align-items:flex-start;}\n.foot-contact i{color:#3FD6D9;font-size:14px;margin-top:2px;}\n.foot-base{border-top:1px solid rgba(148,163,184,.16);padding:16px 0 20px;display:flex;align-items:center;justify-content:space-between;gap:18px;font-size:12.5px;color:#94A3B8;}\n.foot-base a{color:#94A3B8;}\n\n@media (max-width:1100px){\n  .wrap{padding:0 28px;}\n  .hero h1{font-size:42px;}\n  .plead{grid-template-columns:96px 1fr;}\n  .pmedia{grid-column:1 / -1;height:240px;margin-top:14px;}\n  .plead-cta{grid-column:1 / -1;justify-content:flex-start;}\n  .caps{grid-template-columns:1fr 1fr;}\n  .cap:nth-child(2){border-right:0;}\n  .cap:nth-child(n+3){border-top:1px solid var(--line);}\n  .split{grid-template-columns:1fr;gap:32px;}\n  .split h2{font-size:28px;}\n  .foot-grid{grid-template-columns:1fr 1fr;gap:30px;}\n  .join{flex-direction:column;align-items:flex-start;gap:22px;}\n}\n@media (max-width:860px){\n  .nav-main{display:none;position:absolute;top:64px;left:0;right:0;background:#0A1120;border-bottom:1px solid rgba(255,255,255,.12);padding:16px 28px 20px;flex-direction:column;align-items:stretch;gap:12px;z-index:20;box-shadow:0 18px 30px rgba(0,0,0,.35);}\n  .nav-main.open{display:flex;}\n  .nav-links{flex-direction:column;align-items:stretch;}\n  .nav-links a{padding:11px 10px;font-size:14px;}\n  .nav-auth{margin-left:0;padding-top:12px;border-top:1px solid rgba(255,255,255,.12);}\n  .nav-auth a{flex:1;}\n  .nav-toggle{display:inline-flex;}\n  .sec{padding:48px 0;}\n  .head{flex-direction:column;align-items:flex-start;gap:16px;}\n  h2,.split h2,.join h2{font-size:25px;}\n  .hero{height:480px;}\n  .hero h1{font-size:35px;}\n  .hero-copy{margin-bottom:40px;}\n  .p-stage{grid-template-columns:38px 1fr;gap:14px;}\n  .p-stage p{grid-column:1 / -1;margin-top:-6px;}\n  .prog{padding:4px 18px 10px;}\n  .prow{grid-template-columns:78px 1fr 22px;gap:16px;padding:16px 0;}\n  .dg-d{font-size:27px;}\n  .pprice{display:none;}\n  .pmain h3{font-size:17px;}\n  .caps{grid-template-columns:1fr;}\n  .cap{border-right:0;border-top:1px solid var(--line);padding:16px 0 0;}\n  .cap:first-child{border-top:0;}\n  .foot-base{flex-direction:column;align-items:flex-start;gap:8px;}\n}\n@media (max-width:560px){\n  .wrap{padding:0 16px;}\n  .hero{height:460px;}\n  .hero h1{font-size:31px;}\n  .btn-lg{width:100%;}\n  .hero-actions{gap:14px;}\n  .cat{flex:0 0 240px;min-height:140px;}\n  .prow{grid-template-columns:1fr 22px;}\n  .dategate{grid-column:1 / -1;flex-direction:row;align-items:baseline;gap:8px;}\n  .dg-d{font-size:20px;}\n  .pmain{grid-column:1 / 2;}\n  .join-actions{flex-direction:column;align-items:stretch;width:100%;}\n  .join-actions a{width:100%;justify-content:center;}\n  .foot-grid{grid-template-columns:1fr;gap:26px;}\n}\n/* refinement */\n@media (min-width:1101px){\n  .p-stage{grid-template-columns:48px 290px 1fr;gap:22px;}\n}\n.plead-cta{justify-content:flex-start;}\n.pmedia{height:262px;}\n</style>\n<header class=\"hero\" data-kid=\"1\" data-name=\"hero banner with event photo background\">\n<div class=\"wrap hero-inner\" data-kid=\"1-1\" data-name=\"hero inner content container\">\n<nav aria-label=\"Public\" class=\"nav\" data-kid=\"1-1-1\" data-name=\"top navigation bar\">\n<a class=\"brand\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"/\">\n<span class=\"chip\" data-kid=\"1-1-1-1-1\" data-name=\"logo chip container\"><img alt=\"VAP UNIVERSITY\" data-kid=\"1-1-1-1-1-1\" data-name=\"university logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/CollegeEventRegistration.Web/wwwroot/images/branding/vap-university-logo.png\"/></span>\n<span class=\"brand-words\" data-kid=\"1-1-1-1-2\" data-name=\"brand wordmark block\"><b data-kid=\"1-1-1-1-2-1\" data-name=\"product name title\">Campus Event Hub</b><span data-kid=\"1-1-1-1-2-2\" data-name=\"university tagline\">VAP University</span></span>\n</a>\n<button aria-label=\"Open menu\" class=\"nav-toggle\" data-kid=\"1-1-1-2\" data-name=\"mobile menu toggle button\" onclick=\"document.getElementById('v2nav').classList.toggle('open')\" type=\"button\"><i class=\"icon-menu\" data-kid=\"1-1-1-2-1\" data-name=\"menu hamburger icon\"></i></button>\n<div class=\"nav-main\" data-kid=\"1-1-1-3\" data-name=\"collapsed main nav container\" id=\"v2nav\">\n<div class=\"nav-links\" data-kid=\"1-1-1-3-1\" data-name=\"primary navigation links\">\n<a class=\"on\" data-kid=\"1-1-1-3-1-1\" data-name=\"home nav link\" href=\"/\">Home</a>\n<a data-kid=\"1-1-1-3-1-2\" data-name=\"categories nav link\" href=\"#categories\">Categories</a>\n<a data-kid=\"1-1-1-3-1-3\" data-name=\"accredited schedule nav link\" href=\"#accredited-schedule\">Accredited schedule</a>\n<a data-kid=\"1-1-1-3-1-4\" data-name=\"events nav link\" href=\"#programme\">Events</a>\n<a data-kid=\"1-1-1-3-1-5\" data-name=\"about nav link\" href=\"#about\">About</a>\n</div>\n<div class=\"nav-auth\" data-kid=\"1-1-1-3-2\" data-name=\"navigation sign-in controls\">\n<a class=\"a-ghost\" data-kid=\"1-1-1-3-2-1\" data-name=\"nav sign-in ghost button\" href=\"/Account/Login\">Sign in</a>\n<a class=\"btn\" data-kid=\"1-1-1-3-2-2\" data-name=\"nav create account button\" href=\"/Account/Register\">Create account</a>\n</div>\n</div>\n</nav>\n<div class=\"hero-copy\" data-kid=\"1-1-2\" data-name=\"hero copy block\">\n<h1 data-kid=\"1-1-2-1\" data-name=\"hero headline text\">Upcoming campus events, in date order.</h1>\n<p class=\"hero-sub\" data-kid=\"1-1-2-2\" data-name=\"hero subtitle description\">Workshops, contests, lectures and symposiums from VAP UNIVERSITY departments, with fees, capacity and registration windows.</p>\n<div class=\"hero-actions\" data-kid=\"1-1-2-3\" data-name=\"hero action buttons row\">\n<a class=\"btn btn-lg\" data-kid=\"1-1-2-3-1\" data-name=\"primary see programme button\" href=\"#programme\">See the programme <i class=\"icon-arrow-right\" data-kid=\"1-1-2-3-1-1\" data-name=\"arrow right icon\"></i></a>\n<a class=\"hero-quiet\" data-kid=\"1-1-2-3-2\" data-name=\"quiet browse categories link\" href=\"#categories\">Browse categories <i class=\"icon-arrow-right\" data-kid=\"1-1-2-3-2-1\" data-name=\"arrow right icon\"></i></a>\n</div>\n</div>\n</div>\n</header>\n<section class=\"sec\" data-kid=\"2\" data-name=\"events categories section\" id=\"categories\">\n<div class=\"wrap\" data-kid=\"2-1\" data-name=\"section content wrapper\">\n<div class=\"head\" data-kid=\"2-1-1\" data-name=\"section header row\">\n<div data-kid=\"2-1-1-1\" data-name=\"section heading block\">\n<h2 data-kid=\"2-1-1-1-1\" data-name=\"section heading title\">Event categories</h2>\n<p class=\"lede\" data-kid=\"2-1-1-1-2\" data-name=\"section description lead text\">Five categories. Each card opens the filtered catalogue.</p>\n</div>\n<div class=\"ctl-row\" data-kid=\"2-1-1-2\" data-name=\"category carousel scroll controls\">\n<button aria-label=\"Previous categories\" class=\"ctl\" data-kid=\"2-1-1-2-1\" data-name=\"scroll previous categories button\" onclick=\"document.getElementById('v2rail').scrollBy({left:-280,behavior:'smooth'})\" type=\"button\"><i class=\"icon-chevron-left\" data-kid=\"2-1-1-2-1-1\" data-name=\"chevron left icon\"></i></button>\n<button aria-label=\"Next categories\" class=\"ctl\" data-kid=\"2-1-1-2-2\" data-name=\"scroll next categories button\" onclick=\"document.getElementById('v2rail').scrollBy({left:280,behavior:'smooth'})\" type=\"button\"><i class=\"icon-chevron-right\" data-kid=\"2-1-1-2-2-1\" data-name=\"chevron right icon\"></i></button>\n</div>\n</div>\n<div class=\"rail\" data-kid=\"2-1-2\" data-name=\"horizontally scrollable category rail\" id=\"v2rail\">\n<a class=\"cat\" data-kid=\"2-1-2-1\" data-name=\"technical workshop category card\" href=\"/Student/Events\">\n<div class=\"cat-name\" data-kid=\"2-1-2-1-1\" data-name=\"category card title\">Technical Workshop</div>\n<div class=\"cat-foot\" data-kid=\"2-1-2-1-2\" data-name=\"category card footer\">\n<span class=\"count\" data-kid=\"2-1-2-1-2-1\" data-name=\"category event count label\"><b class=\"tnum\" data-kid=\"2-1-2-1-2-1-1\" data-name=\"category event count number\">24</b> events</span>\n<i class=\"cat-icon icon-code\" data-kid=\"2-1-2-1-2-2\" data-name=\"code / workshop icon\"></i>\n</div>\n<span class=\"cat-go\" data-kid=\"2-1-2-1-3\" data-name=\"open category call-to-action link\">Open category <i class=\"icon-arrow-right\" data-kid=\"2-1-2-1-3-1\" data-name=\"arrow right icon\"></i></span>\n</a>\n<a class=\"cat\" data-kid=\"2-1-2-2\" data-name=\"hackathon &amp; contest category card\" href=\"/Student/Events\">\n<div class=\"cat-name\" data-kid=\"2-1-2-2-1\" data-name=\"category card title\">Hackathon &amp; Contest</div>\n<div class=\"cat-foot\" data-kid=\"2-1-2-2-2\" data-name=\"category card footer\">\n<span class=\"count\" data-kid=\"2-1-2-2-2-1\" data-name=\"category event count label\"><b class=\"tnum\" data-kid=\"2-1-2-2-2-1-1\" data-name=\"category event count number\">9</b> events</span>\n<i class=\"cat-icon icon-trophy\" data-kid=\"2-1-2-2-2-2\" data-name=\"trophy icon\"></i>\n</div>\n<span class=\"cat-go\" data-kid=\"2-1-2-2-3\" data-name=\"open category call-to-action link\">Open category <i class=\"icon-arrow-right\" data-kid=\"2-1-2-2-3-1\" data-name=\"arrow right icon\"></i></span>\n</a>\n<a class=\"cat\" data-kid=\"2-1-2-3\" data-name=\"guest lecture &amp; seminar category card\" href=\"/Student/Events\">\n<div class=\"cat-name\" data-kid=\"2-1-2-3-1\" data-name=\"category card title\">Guest Lecture &amp; Seminar</div>\n<div class=\"cat-foot\" data-kid=\"2-1-2-3-2\" data-name=\"category card footer\">\n<span class=\"count\" data-kid=\"2-1-2-3-2-1\" data-name=\"category event count label\"><b class=\"tnum\" data-kid=\"2-1-2-3-2-1-1\" data-name=\"category event count number\">17</b> events</span>\n<i class=\"cat-icon icon-mic\" data-kid=\"2-1-2-3-2-2\" data-name=\"microphone icon\"></i>\n</div>\n<span class=\"cat-go\" data-kid=\"2-1-2-3-3\" data-name=\"open category call-to-action link\">Open category <i class=\"icon-arrow-right\" data-kid=\"2-1-2-3-3-1\" data-name=\"arrow right icon\"></i></span>\n</a>\n<a class=\"cat\" data-kid=\"2-1-2-4\" data-name=\"national symposium category card\" href=\"/Student/Events\">\n<div class=\"cat-name\" data-kid=\"2-1-2-4-1\" data-name=\"category card title\">National Symposium</div>\n<div class=\"cat-foot\" data-kid=\"2-1-2-4-2\" data-name=\"category card footer\">\n<span class=\"count\" data-kid=\"2-1-2-4-2-1\" data-name=\"category event count label\"><b class=\"tnum\" data-kid=\"2-1-2-4-2-1-1\" data-name=\"category event count number\">6</b> events</span>\n<i class=\"cat-icon icon-globe\" data-kid=\"2-1-2-4-2-2\" data-name=\"globe icon\"></i>\n</div>\n<span class=\"cat-go\" data-kid=\"2-1-2-4-3\" data-name=\"open category call-to-action link\">Open category <i class=\"icon-arrow-right\" data-kid=\"2-1-2-4-3-1\" data-name=\"arrow right icon\"></i></span>\n</a>\n<a class=\"cat\" data-kid=\"2-1-2-5\" data-name=\"cultural &amp; arts category card\" href=\"/Student/Events\">\n<div class=\"cat-name\" data-kid=\"2-1-2-5-1\" data-name=\"category card title\">Cultural &amp; Arts</div>\n<div class=\"cat-foot\" data-kid=\"2-1-2-5-2\" data-name=\"category card footer\">\n<span class=\"count\" data-kid=\"2-1-2-5-2-1\" data-name=\"category event count label\"><b class=\"tnum\" data-kid=\"2-1-2-5-2-1-1\" data-name=\"category event count number\">12</b> events</span>\n<i class=\"cat-icon icon-palette\" data-kid=\"2-1-2-5-2-2\" data-name=\"palette icon\"></i>\n</div>\n<span class=\"cat-go\" data-kid=\"2-1-2-5-3\" data-name=\"open category call-to-action link\">Open category <i class=\"icon-arrow-right\" data-kid=\"2-1-2-5-3-1\" data-name=\"arrow right icon\"></i></span>\n</a>\n</div>\n</div>\n</section>\n<section class=\"sec\" data-kid=\"3\" data-name=\"accredited schedule section\" id=\"accredited-schedule\">\n<div class=\"wrap\" data-kid=\"3-1\" data-name=\"section content wrapper\">\n<div class=\"head\" data-kid=\"3-1-1\" data-name=\"section header row\" style=\"margin-bottom:8px;\">\n<div data-kid=\"3-1-1-1\" data-name=\"section heading block\">\n<h2 data-kid=\"3-1-1-1-1\" data-name=\"section heading title\">Accredited schedule</h2>\n<p class=\"lede\" data-kid=\"3-1-1-1-2\" data-name=\"section description lead text\">The four stages every event passes through before a certificate is issued.</p>\n</div>\n</div>\n<div class=\"process\" data-kid=\"3-1-2\" data-name=\"scheduled process stepper\">\n<div class=\"p-stage\" data-kid=\"3-1-2-1\" data-name=\"process stage 01 row\">\n<div class=\"p-num\" data-kid=\"3-1-2-1-1\" data-name=\"process stage number\">01</div>\n<h3 data-kid=\"3-1-2-1-2\" data-name=\"process stage title\">Faculty proposal &amp; department review</h3>\n<div data-kid=\"3-1-2-1-3\" data-name=\"process stage content group\">\n<p data-kid=\"3-1-2-1-3-1\" data-name=\"process stage description\">Coordinators submit the outline, venue, capacity and eligibility. The academic committee reviews it before scheduling.</p>\n<span class=\"p-note\" data-kid=\"3-1-2-1-3-2\" data-name=\"process stage note badge\"><i class=\"icon-file-text\" data-kid=\"3-1-2-1-3-2-1\" data-name=\"document icon\"></i> Reviewed by the department</span>\n</div>\n</div>\n<div class=\"p-stage\" data-kid=\"3-1-2-2\" data-name=\"process stage 02 row\">\n<div class=\"p-num\" data-kid=\"3-1-2-2-1\" data-name=\"process stage number\">02</div>\n<h3 data-kid=\"3-1-2-2-2\" data-name=\"process stage title\">Approval &amp; publication</h3>\n<div data-kid=\"3-1-2-2-3\" data-name=\"process stage content group\">\n<p data-kid=\"3-1-2-2-3-1\" data-name=\"process stage description\">An administrator approves the event and publishes it with its registration window, fee and mode.</p>\n<span class=\"p-note\" data-kid=\"3-1-2-2-3-2\" data-name=\"process stage note badge\"><i class=\"icon-check\" data-kid=\"3-1-2-2-3-2-1\" data-name=\"checkmark icon\"></i> Appears in the catalogue</span>\n</div>\n</div>\n<div class=\"p-stage\" data-kid=\"3-1-2-3\" data-name=\"process stage 03 row\">\n<div class=\"p-num\" data-kid=\"3-1-2-3-1\" data-name=\"process stage number\">03</div>\n<h3 data-kid=\"3-1-2-3-2\" data-name=\"process stage title\">Registration &amp; QR admission pass</h3>\n<div data-kid=\"3-1-2-3-3\" data-name=\"process stage content group\">\n<p data-kid=\"3-1-2-3-3-1\" data-name=\"process stage description\">Students register inside the window. Each confirmed registration reserves a seat and issues a pass.</p>\n<span class=\"p-note\" data-kid=\"3-1-2-3-3-2\" data-name=\"process stage note badge\"><i class=\"icon-qr-code\" data-kid=\"3-1-2-3-3-2-1\" data-name=\"QR code icon\"></i> Pass in the student portal</span>\n</div>\n</div>\n<div class=\"p-stage\" data-kid=\"3-1-2-4\" data-name=\"process stage 04 row\">\n<div class=\"p-num\" data-kid=\"3-1-2-4-1\" data-name=\"process stage number\">04</div>\n<h3 data-kid=\"3-1-2-4-2\" data-name=\"process stage title\">Attendance &amp; certificate</h3>\n<div data-kid=\"3-1-2-4-3\" data-name=\"process stage content group\">\n<p data-kid=\"3-1-2-4-3-1\" data-name=\"process stage description\">Passes are scanned at the venue door. Attendance is recorded and the certificate is issued to the student.</p>\n<span class=\"p-note\" data-kid=\"3-1-2-4-3-2\" data-name=\"process stage note badge\"><i class=\"icon-award\" data-kid=\"3-1-2-4-3-2-1\" data-name=\"award icon\"></i> Certificate available after the event</span>\n</div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"sec prog-sec\" data-kid=\"4\" data-name=\"programme events section\" id=\"programme\">\n<div class=\"wrap\" data-kid=\"4-1\" data-name=\"section content wrapper\">\n<div class=\"prog-head\" data-kid=\"4-1-1\" data-name=\"section header row\">\n<div data-kid=\"4-1-1-1\" data-name=\"section heading block\">\n<h2 data-kid=\"4-1-1-1-1\" data-name=\"section heading title\">Programme</h2>\n<p class=\"lede\" data-kid=\"4-1-1-1-2\" data-name=\"section description lead text\">Upcoming and featured events, grouped by month. Registration closes on the date shown on each event page.</p>\n</div>\n<a class=\"link\" data-kid=\"4-1-1-2\" data-name=\"full catalogue link with arrow\" href=\"/Student/Events\">Full catalogue <i class=\"icon-arrow-right\" data-kid=\"4-1-1-2-1\" data-name=\"arrow right icon\"></i></a>\n</div>\n<div class=\"prog\" data-kid=\"4-1-2\" data-name=\"programme schedule container\">\n<div class=\"month\" data-kid=\"4-1-2-1\" data-name=\"November 2026 month label\">November 2026</div>\n<article class=\"prow plead\" data-kid=\"4-1-2-2\" data-name=\"featured STEM32 workshop event row\">\n<div class=\"dategate\" data-kid=\"4-1-2-2-1\" data-name=\"date column block\">\n<span class=\"dg-wd\" data-kid=\"4-1-2-2-1-1\" data-name=\"weekday label\">Tue</span>\n<span class=\"dg-d tnum\" data-kid=\"4-1-2-2-1-2\" data-name=\"day number\">24</span>\n<span class=\"dg-m\" data-kid=\"4-1-2-2-1-3\" data-name=\"month abbreviation\">Nov</span>\n</div>\n<div class=\"pmain\" data-kid=\"4-1-2-2-2\" data-name=\"event main content block\">\n<span class=\"pcat\" data-kid=\"4-1-2-2-2-1\" data-name=\"event category label\">Technical Workshop</span>\n<h3 data-kid=\"4-1-2-2-2-2\" data-name=\"event title\">Embedded systems prototyping with STM32</h3>\n<p data-kid=\"4-1-2-2-2-3\" data-name=\"event description text\">Two-day lab covering GPIO, interrupts, timers and sensor integration on the STM32F4 board. Laptop and ST-Link required.</p>\n<div class=\"pfacts\" data-kid=\"4-1-2-2-2-4\" data-name=\"event facts row (dept · venue · fee · capacity)\">\n<span data-kid=\"4-1-2-2-2-4-1\" data-name=\"department fact label\">ECE</span><span class=\"sep\" data-kid=\"4-1-2-2-2-4-2\" data-name=\"separator dot\"></span>\n<span data-kid=\"4-1-2-2-2-4-3\" data-name=\"mode and venue fact label\">Offline · Seminar Hall B</span><span class=\"sep\" data-kid=\"4-1-2-2-2-4-4\" data-name=\"separator dot\"></span>\n<span data-kid=\"4-1-2-2-2-4-5\" data-name=\"fee fact label\">₹450</span><span class=\"sep\" data-kid=\"4-1-2-2-2-4-6\" data-name=\"separator dot\"></span>\n<span data-kid=\"4-1-2-2-2-4-7\" data-name=\"capacity fact label\">Capacity 60</span>\n</div>\n<div class=\"plead-cta\" data-kid=\"4-1-2-2-2-5\" data-name=\"featured event call-to-action row\"><a class=\"btn\" data-kid=\"4-1-2-2-2-5-1\" data-name=\"view event button\" href=\"/Student/Events/Details/1\">View event <i class=\"icon-arrow-right\" data-kid=\"4-1-2-2-2-5-1-1\" data-name=\"arrow right icon\"></i></a></div>\n</div>\n<div class=\"pmedia\" data-kid=\"4-1-2-2-3\" data-name=\"featured event media container\">\n<img alt=\"Students assembling an electronics prototype at a workshop bench\" data-kid=\"4-1-2-2-3-1\" data-name=\"workshop preview image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/d12c95df160946de8ab6272adbb21bc6.jpg\"/>\n</div>\n</article>\n<article class=\"prow\" data-kid=\"4-1-2-3\" data-name=\"robotics line-follower event row\">\n<div class=\"dategate\" data-kid=\"4-1-2-3-1\" data-name=\"date column block\"><span class=\"dg-wd\" data-kid=\"4-1-2-3-1-1\" data-name=\"weekday label\">Fri</span><span class=\"dg-d tnum\" data-kid=\"4-1-2-3-1-2\" data-name=\"day number\">27</span><span class=\"dg-m\" data-kid=\"4-1-2-3-1-3\" data-name=\"month abbreviation\">Nov</span></div>\n<div class=\"pmain\" data-kid=\"4-1-2-3-2\" data-name=\"event main content block\">\n<span class=\"pcat\" data-kid=\"4-1-2-3-2-1\" data-name=\"event category label\">Technical Workshop</span>\n<h3 data-kid=\"4-1-2-3-2-2\" data-name=\"event title\">Robotics line-follower sprint</h3>\n<p data-kid=\"4-1-2-3-2-3\" data-name=\"event description text\">Team build in the Mechatronics Lab, followed by timed runs on the competition track.</p>\n<div class=\"pfacts\" data-kid=\"4-1-2-3-2-4\" data-name=\"event facts row\"><span data-kid=\"4-1-2-3-2-4-1\" data-name=\"department fact label\">Mechanical Engineering</span><span class=\"sep\" data-kid=\"4-1-2-3-2-4-2\" data-name=\"separator dot\"></span><span data-kid=\"4-1-2-3-2-4-3\" data-name=\"mode and venue fact label\">Offline · Mechatronics Lab</span><span class=\"sep\" data-kid=\"4-1-2-3-2-4-4\" data-name=\"separator dot\"></span><span data-kid=\"4-1-2-3-2-4-5\" data-name=\"capacity fact label\">Capacity 80</span></div>\n</div>\n<div class=\"pprice\" data-kid=\"4-1-2-3-3\" data-name=\"event price\">₹300</div>\n<i class=\"icon-chevron-right\" data-kid=\"4-1-2-3-4\" data-name=\"chevron right affordance icon\"></i>\n</article>\n<div class=\"month\" data-kid=\"4-1-2-4\" data-name=\"December 2026 month label\">December 2026</div>\n<article class=\"prow\" data-kid=\"4-1-2-5\" data-name=\"CodeSprint 24 hackathon event row\">\n<div class=\"dategate\" data-kid=\"4-1-2-5-1\" data-name=\"date column block\"><span class=\"dg-wd\" data-kid=\"4-1-2-5-1-1\" data-name=\"weekday label\">Fri</span><span class=\"dg-d tnum\" data-kid=\"4-1-2-5-1-2\" data-name=\"day number\">04</span><span class=\"dg-m\" data-kid=\"4-1-2-5-1-3\" data-name=\"month abbreviation\">Dec</span></div>\n<div class=\"pmain\" data-kid=\"4-1-2-5-2\" data-name=\"event main content block\">\n<span class=\"pcat\" data-kid=\"4-1-2-5-2-1\" data-name=\"event category label\">Hackathon &amp; Contest</span>\n<h3 data-kid=\"4-1-2-5-2-2\" data-name=\"event title\">CodeSprint 24: campus hackathon</h3>\n<p data-kid=\"4-1-2-5-2-3\" data-name=\"event description text\">24-hour build across three tracks, with faculty mentors on the floor through the night.</p>\n<div class=\"pfacts\" data-kid=\"4-1-2-5-2-4\" data-name=\"event facts row\"><span data-kid=\"4-1-2-5-2-4-1\" data-name=\"department fact label\">Computer Science &amp; Engineering</span><span class=\"sep\" data-kid=\"4-1-2-5-2-4-2\" data-name=\"separator dot\"></span><span data-kid=\"4-1-2-5-2-4-3\" data-name=\"mode fact label\">Hybrid</span><span class=\"sep\" data-kid=\"4-1-2-5-2-4-4\" data-name=\"separator dot\"></span><span data-kid=\"4-1-2-5-2-4-5\" data-name=\"capacity fact label\">Capacity 200</span></div>\n</div>\n<div class=\"pprice\" data-kid=\"4-1-2-5-3\" data-name=\"event price label\">Free</div>\n<i class=\"icon-chevron-right\" data-kid=\"4-1-2-5-4\" data-name=\"chevron right affordance icon\"></i>\n</article>\n<article class=\"prow\" data-kid=\"4-1-2-6\" data-name=\"operating at scale lecture event row\">\n<div class=\"dategate\" data-kid=\"4-1-2-6-1\" data-name=\"date column block\"><span class=\"dg-wd\" data-kid=\"4-1-2-6-1-1\" data-name=\"weekday label\">Tue</span><span class=\"dg-d tnum\" data-kid=\"4-1-2-6-1-2\" data-name=\"day number\">08</span><span class=\"dg-m\" data-kid=\"4-1-2-6-1-3\" data-name=\"month abbreviation\">Dec</span></div>\n<div class=\"pmain\" data-kid=\"4-1-2-6-2\" data-name=\"event main content block\">\n<span class=\"pcat\" data-kid=\"4-1-2-6-2-1\" data-name=\"event category label\">Guest Lecture &amp; Seminar</span>\n<h3 data-kid=\"4-1-2-6-2-2\" data-name=\"event title\">Operating at scale: reliability talk</h3>\n<p data-kid=\"4-1-2-6-2-3\" data-name=\"event description text\">Systems reliability session for third and fourth year students, followed by an open Q&amp;A.</p>\n<div class=\"pfacts\" data-kid=\"4-1-2-6-2-4\" data-name=\"event facts row\"><span data-kid=\"4-1-2-6-2-4-1\" data-name=\"department fact label\">Information Technology</span><span class=\"sep\" data-kid=\"4-1-2-6-2-4-2\" data-name=\"separator dot\"></span><span data-kid=\"4-1-2-6-2-4-3\" data-name=\"mode fact label\">Hybrid</span><span class=\"sep\" data-kid=\"4-1-2-6-2-4-4\" data-name=\"separator dot\"></span><span data-kid=\"4-1-2-6-2-4-5\" data-name=\"capacity fact label\">Capacity 150</span></div>\n</div>\n<div class=\"pprice\" data-kid=\"4-1-2-6-3\" data-name=\"event price label\">Free</div>\n<i class=\"icon-chevron-right\" data-kid=\"4-1-2-6-4\" data-name=\"chevron right affordance icon\"></i>\n</article>\n<article class=\"prow\" data-kid=\"4-1-2-7\" data-name=\"national symposium event row\">\n<div class=\"dategate\" data-kid=\"4-1-2-7-1\" data-name=\"date column block\"><span class=\"dg-wd\" data-kid=\"4-1-2-7-1-1\" data-name=\"weekday label\">Fri</span><span class=\"dg-d tnum\" data-kid=\"4-1-2-7-1-2\" data-name=\"day number\">11</span><span class=\"dg-m\" data-kid=\"4-1-2-7-1-3\" data-name=\"month abbreviation\">Dec</span></div>\n<div class=\"pmain\" data-kid=\"4-1-2-7-2\" data-name=\"event main content block\">\n<span class=\"pcat\" data-kid=\"4-1-2-7-2-1\" data-name=\"event category label\">National Symposium</span>\n<h3 data-kid=\"4-1-2-7-2-2\" data-name=\"event title\">National symposium on sustainable systems</h3>\n<p data-kid=\"4-1-2-7-2-3\" data-name=\"event description text\">Paper presentations and a closing panel across three department tracks.</p>\n<div class=\"pfacts\" data-kid=\"4-1-2-7-2-4\" data-name=\"event facts row\"><span data-kid=\"4-1-2-7-2-4-1\" data-name=\"department fact label\">Computer Science &amp; Engineering</span><span class=\"sep\" data-kid=\"4-1-2-7-2-4-2\" data-name=\"separator dot\"></span><span data-kid=\"4-1-2-7-2-4-3\" data-name=\"mode and venue fact label\">Offline · Main Auditorium</span><span class=\"sep\" data-kid=\"4-1-2-7-2-4-4\" data-name=\"separator dot\"></span><span data-kid=\"4-1-2-7-2-4-5\" data-name=\"capacity fact label\">Capacity 300</span></div>\n</div>\n<div class=\"pprice\" data-kid=\"4-1-2-7-3\" data-name=\"event price label\">₹750</div>\n<i class=\"icon-chevron-right\" data-kid=\"4-1-2-7-4\" data-name=\"chevron right affordance icon\"></i>\n</article>\n<article class=\"prow\" data-kid=\"4-1-2-8\" data-name=\"campus cultural night event row\">\n<div class=\"dategate\" data-kid=\"4-1-2-8-1\" data-name=\"date column block\"><span class=\"dg-wd\" data-kid=\"4-1-2-8-1-1\" data-name=\"weekday label\">Fri</span><span class=\"dg-d tnum\" data-kid=\"4-1-2-8-1-2\" data-name=\"day number\">18</span><span class=\"dg-m\" data-kid=\"4-1-2-8-1-3\" data-name=\"month abbreviation\">Dec</span></div>\n<div class=\"pmain\" data-kid=\"4-1-2-8-2\" data-name=\"event main content block\">\n<span class=\"pcat\" data-kid=\"4-1-2-8-2-1\" data-name=\"event category label\">Cultural &amp; Arts</span>\n<h3 data-kid=\"4-1-2-8-2-2\" data-name=\"event title\">Campus cultural night</h3>\n<p data-kid=\"4-1-2-8-2-3\" data-name=\"event description text\">Student ensembles and department performances at the open air amphitheatre.</p>\n<div class=\"pfacts\" data-kid=\"4-1-2-8-2-4\" data-name=\"event facts row\"><span data-kid=\"4-1-2-8-2-4-1\" data-name=\"department fact label\">Student Activities</span><span class=\"sep\" data-kid=\"4-1-2-8-2-4-2\" data-name=\"separator dot\"></span><span data-kid=\"4-1-2-8-2-4-3\" data-name=\"mode and venue fact label\">Offline · Amphitheatre</span><span class=\"sep\" data-kid=\"4-1-2-8-2-4-4\" data-name=\"separator dot\"></span><span data-kid=\"4-1-2-8-2-4-5\" data-name=\"capacity fact label\">Capacity 500</span></div>\n</div>\n<div class=\"pprice\" data-kid=\"4-1-2-8-3\" data-name=\"event price label\">₹200</div>\n<i class=\"icon-chevron-right\" data-kid=\"4-1-2-8-4\" data-name=\"chevron right affordance icon\"></i>\n</article>\n</div>\n</div>\n</section>\n<section class=\"sec\" data-kid=\"5\" data-name=\"about section\" id=\"about\">\n<div class=\"wrap split\" data-kid=\"5-1\" data-name=\"split content wrapper\">\n<div data-kid=\"5-1-1\" data-name=\"about section heading block\">\n<h2 data-kid=\"5-1-1-1\" data-name=\"about section heading title\">What the department reviews, and what you receive</h2>\n<p class=\"lede\" data-kid=\"5-1-1-2\" data-name=\"about section description lead text\">The Campus Event Hub is run by the Directorate of Student Co-Curricular Affairs with each academic department.</p>\n</div>\n<div class=\"seq\" data-kid=\"5-1-2\" data-name=\"about steps vertical list\">\n<div class=\"seq-item\" data-kid=\"5-1-2-1\" data-name=\"About step Review item\">\n<h3 data-kid=\"5-1-2-1-1\" data-name=\"step title with label\"><em data-kid=\"5-1-2-1-1-1\" data-name=\"step label badge\">Review</em> Academic approval</h3>\n<p data-kid=\"5-1-2-1-2\" data-name=\"step description text\">Committee review of syllabus alignment, venue capacity and speaker credentials before an event is scheduled.</p>\n</div>\n<div class=\"seq-item\" data-kid=\"5-1-2-2\" data-name=\"About step Practice item\">\n<h3 data-kid=\"5-1-2-2-1\" data-name=\"step title with label\"><em data-kid=\"5-1-2-2-1-1\" data-name=\"step label badge\">Practice</em> Lab and studio sessions</h3>\n<p data-kid=\"5-1-2-2-2\" data-name=\"step description text\">Workshops and contests held in department labs, with faculty coordinators and visiting practitioners leading sessions.</p>\n</div>\n<div class=\"seq-item\" data-kid=\"5-1-2-3\" data-name=\"About step Record item\">\n<h3 data-kid=\"5-1-2-3-1\" data-name=\"step title with label\"><em data-kid=\"5-1-2-3-1-1\" data-name=\"step label badge\">Record</em> Attendance and certificates</h3>\n<p data-kid=\"5-1-2-3-2\" data-name=\"step description text\">Door scanning writes attendance against your registration. The certificate is issued from that record.</p>\n</div>\n</div>\n</div>\n</section>\n<section class=\"sec caps-sec\" data-kid=\"6\" data-name=\"capabilities section\">\n<div class=\"wrap\" data-kid=\"6-1\" data-name=\"section content wrapper\">\n<h2 data-kid=\"6-1-1\" data-name=\"section heading title\" style=\"font-size:26px;\">What you can do with an account</h2>\n<div class=\"caps\" data-kid=\"6-1-2\" data-name=\"capabilities 4-column grid\">\n<div class=\"cap\" data-kid=\"6-1-2-1\" data-name=\"find events capability card\">\n<i class=\"icon-search\" data-kid=\"6-1-2-1-1\" data-name=\"search icon\"></i>\n<h3 data-kid=\"6-1-2-1-2\" data-name=\"capability card title\">Find events</h3>\n<p data-kid=\"6-1-2-1-3\" data-name=\"capability card description\">Filter the catalogue by department, category, mode and registration status.</p>\n</div>\n<div class=\"cap\" data-kid=\"6-1-2-2\" data-name=\"register capability card\">\n<i class=\"icon-ticket\" data-kid=\"6-1-2-2-1\" data-name=\"ticket icon\"></i>\n<h3 data-kid=\"6-1-2-2-2\" data-name=\"capability card title\">Register and hold a seat</h3>\n<p data-kid=\"6-1-2-2-3\" data-name=\"capability card description\">Confirm a registration inside the window; the seat is reserved against your profile.</p>\n</div>\n<div class=\"cap\" data-kid=\"6-1-2-3\" data-name=\"follow schedule capability card\">\n<i class=\"icon-calendar-days\" data-kid=\"6-1-2-3-1\" data-name=\"calendar icon\"></i>\n<h3 data-kid=\"6-1-2-3-2\" data-name=\"capability card title\">Follow the schedule</h3>\n<p data-kid=\"6-1-2-3-3\" data-name=\"capability card description\">Session times, venues and speaker details for every event you registered for.</p>\n</div>\n<div class=\"cap\" data-kid=\"6-1-2-4\" data-name=\"collect certificates capability card\">\n<i class=\"icon-award\" data-kid=\"6-1-2-4-1\" data-name=\"award icon\"></i>\n<h3 data-kid=\"6-1-2-4-2\" data-name=\"capability card title\">Collect certificates</h3>\n<p data-kid=\"6-1-2-4-3\" data-name=\"capability card description\">Download the certificate issued for each event you attended, or verify one by code.</p>\n</div>\n</div>\n</div>\n</section>\n<section class=\"sec\" data-kid=\"7\" data-name=\"account sign-up call-to-action section\">\n<div class=\"wrap join\" data-kid=\"7-1\" data-name=\"sign-up CTA container\">\n<div data-kid=\"7-1-1\" data-name=\"sign-up prompt block\">\n<h2 data-kid=\"7-1-1-1\" data-name=\"sign-up heading title\">Create a student account</h2>\n<p data-kid=\"7-1-1-2\" data-name=\"sign-up description text\">One account for registration, admission passes and certificates.</p>\n</div>\n<div class=\"join-actions\" data-kid=\"7-1-2\" data-name=\"sign-up action buttons\">\n<a class=\"btn btn-lg\" data-kid=\"7-1-2-1\" data-name=\"create student account primary button\" href=\"/Account/Register\">Create student account <i class=\"icon-arrow-right\" data-kid=\"7-1-2-1-1\" data-name=\"arrow right icon\"></i></a>\n<a class=\"a-outline\" data-kid=\"7-1-2-2\" data-name=\"sign-in outline button\" href=\"/Account/Login\">Sign in</a>\n</div>\n</div>\n</section>\n<footer class=\"foot\" data-kid=\"8\" data-name=\"site footer\">\n<div class=\"wrap\" data-kid=\"8-1\" data-name=\"footer inner layout\">\n<div class=\"foot-grid\" data-kid=\"8-1-1\" data-name=\"footer link columns grid\">\n<div data-kid=\"8-1-1-1\" data-name=\"footer brand and blurb column\">\n<div class=\"foot-brand\" data-kid=\"8-1-1-1-1\" data-name=\"footer brand logo row\">\n<span class=\"chip\" data-kid=\"8-1-1-1-1-1\" data-name=\"footer logo chip container\"><img alt=\"VAP UNIVERSITY\" data-kid=\"8-1-1-1-1-1-1\" data-name=\"footer logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/CollegeEventRegistration.Web/wwwroot/images/branding/vap-university-logo.png\"/></span>\n<div data-kid=\"8-1-1-1-1-2\" data-name=\"footer brand wordmark block\"><b data-kid=\"8-1-1-1-1-2-1\" data-name=\"footer product name\">Campus Event Hub</b><span data-kid=\"8-1-1-1-1-2-2\" data-name=\"footer university tagline\">VAP University</span></div>\n</div>\n<p data-kid=\"8-1-1-1-2\" data-name=\"footer brand description\">Event registration for VAP UNIVERSITY students, faculty coordinators and academic departments.</p>\n</div>\n<div data-kid=\"8-1-1-2\" data-name=\"footer sections column\">\n<h4 data-kid=\"8-1-1-2-1\" data-name=\"footer column heading\">Sections</h4>\n<ul data-kid=\"8-1-1-2-2\" data-name=\"footer sections link list\">\n<li data-kid=\"8-1-1-2-2-1\" data-name=\"Home footer link item\"><a data-kid=\"8-1-1-2-2-1-1\" data-name=\"Home footer link\" href=\"/\">Home</a></li>\n<li data-kid=\"8-1-1-2-2-2\" data-name=\"Categories footer link item\"><a data-kid=\"8-1-1-2-2-2-1\" data-name=\"Categories footer link\" href=\"#categories\">Categories</a></li>\n<li data-kid=\"8-1-1-2-2-3\" data-name=\"Accredited schedule footer link item\"><a data-kid=\"8-1-1-2-2-3-1\" data-name=\"Accredited schedule footer link\" href=\"#accredited-schedule\">Accredited schedule</a></li>\n<li data-kid=\"8-1-1-2-2-4\" data-name=\"Programme footer link item\"><a data-kid=\"8-1-1-2-2-4-1\" data-name=\"Programme footer link\" href=\"#programme\">Programme</a></li>\n</ul>\n</div>\n<div data-kid=\"8-1-1-3\" data-name=\"footer portals column\">\n<h4 data-kid=\"8-1-1-3-1\" data-name=\"footer column heading\">Portals</h4>\n<ul data-kid=\"8-1-1-3-2\" data-name=\"footer portals link list\">\n<li data-kid=\"8-1-1-3-2-1\" data-name=\"student portal link item\"><a data-kid=\"8-1-1-3-2-1-1\" data-name=\"student portal link\" href=\"/Student/Dashboard\">Student portal</a></li>\n<li data-kid=\"8-1-1-3-2-2\" data-name=\"coordinator workspace link item\"><a data-kid=\"8-1-1-3-2-2-1\" data-name=\"coordinator workspace link\" href=\"/Coordinator/Dashboard\">Coordinator workspace</a></li>\n<li data-kid=\"8-1-1-3-2-3\" data-name=\"administration link item\"><a data-kid=\"8-1-1-3-2-3-1\" data-name=\"admin dashboard link\" href=\"/Admin/Dashboard\">Administration</a></li>\n<li data-kid=\"8-1-1-3-2-4\" data-name=\"verify certificate link item\"><a data-kid=\"8-1-1-3-2-4-1\" data-name=\"verify certificate link\" href=\"/Certificates/Verify\">Verify a certificate</a></li>\n</ul>\n</div>\n<div data-kid=\"8-1-1-4\" data-name=\"footer contact column\">\n<h4 data-kid=\"8-1-1-4-1\" data-name=\"footer column heading\">Campus &amp; support</h4>\n<div class=\"foot-contact\" data-kid=\"8-1-1-4-2\" data-name=\"contact details list\">\n<div data-kid=\"8-1-1-4-2-1\" data-name=\"address contact row\"><i class=\"icon-map-pin\" data-kid=\"8-1-1-4-2-1-1\" data-name=\"map pin icon\"></i><span data-kid=\"8-1-1-4-2-1-2\" data-name=\"address text\">Directorate of Student Co-Curricular Affairs<br data-kid=\"8-1-1-4-2-1-2-1\" data-name=\"line break\"/>VAP UNIVERSITY Main Campus</span></div>\n<div data-kid=\"8-1-1-4-2-2\" data-name=\"email contact row\"><i class=\"icon-mail\" data-kid=\"8-1-1-4-2-2-1\" data-name=\"mail icon\"></i><span data-kid=\"8-1-1-4-2-2-2\" data-name=\"email address text\">admin@college.edu</span></div>\n<div data-kid=\"8-1-1-4-2-3\" data-name=\"office hours row\"><i class=\"icon-clock\" data-kid=\"8-1-1-4-2-3-1\" data-name=\"clock icon\"></i><span data-kid=\"8-1-1-4-2-3-2\" data-name=\"office hours text\">Mon – Fri, 9:00 AM – 5:00 PM IST</span></div>\n</div>\n</div>\n</div>\n<div class=\"foot-base\" data-kid=\"8-1-2\" data-name=\"footer bottom bar\">\n<span data-kid=\"8-1-2-1\" data-name=\"footer copyright notice\">© 2026 VAP UNIVERSITY · Campus Event Hub</span>\n<span data-kid=\"8-1-2-2\" data-name=\"footer privacy link text\"><a data-kid=\"8-1-2-2-1\" data-name=\"Data privacy footer link\" href=\"/Home/Privacy\">Data privacy</a></span>\n</div>\n</div>\n</footer>\n",
