      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n\n:root{\n  --navy:#1F2C58; --navy-deep:#16203E; --ink:#0F172A; --muted:#475569; --soft:#64748B;\n  --line:#E3E8F1; --line-soft:#EEF2F7; --surface:#F5F7FB; --white:#FFFFFF;\n  --teal:#0BA9AC; --teal-dark:#08898E; --blue:#2563EB; --blue-dark:#1D4ED8;\n  --shadow-card:0 10px 25px -5px rgba(15,23,42,.07), 0 8px 10px -6px rgba(15,23,42,.04);\n  --shadow-lift:0 22px 40px -12px rgba(15,23,42,.16), 0 8px 14px -8px rgba(15,23,42,.08);\n  --serif:'Newsreader', Georgia, 'Times New Roman', serif;\n  --mvr:0.25rem;\n}\n*{box-sizing:border-box;}\nbody{margin:0;background:#fff;color:var(--ink);font-family:system-ui,-apple-system,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial,sans-serif;font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased;}\nhtml{scroll-behavior:smooth;}\nh1,h2,h3,h4{margin:0;font-family:var(--serif);font-weight:500;color:var(--navy);letter-spacing:-0.012em;}\np{margin:0;}\na{text-decoration:none;color:inherit;}\nimg{display:block;max-width:100%;}\n.wrap{max-width:1320px;margin:0 auto;padding:0 48px;}\n.tnum{font-variant-numeric:tabular-nums;}\n\n/* ---------- HERO ---------- */\n.hero{position:relative;height:552px;background:#0C1220 url('https://kombai-assets.b-cdn.net/generated_assets/1269be8ad23b42e79e115bdd8afcaaa8.jpg') center right/cover no-repeat;display:flex;flex-direction:column;overflow:hidden;}\n.hero::after{content:\"\";position:absolute;inset:0;background:linear-gradient(99deg,rgba(8,13,26,.88) 0%,rgba(8,13,26,.72) 30%,rgba(8,13,26,.34) 58%,rgba(8,13,26,.06) 86%,rgba(8,13,26,.02) 100%);pointer-events:none;}\n.hero-inner{position:relative;z-index:2;display:flex;flex-direction:column;height:100%;}\n\n/* nav over the same image */\n.nav{display:flex;align-items:center;gap:24px;height:72px;border-bottom:1px solid rgba(255,255,255,.14);}\n.brand{display:flex;align-items:center;gap:10px;}\n.brand-chip{background:#fff;border-radius:8px;padding:5px 8px;display:flex;align-items:center;}\n.brand-chip img{height:26px;width:auto;}\n.brand-words{display:flex;flex-direction:column;line-height:1.12;}\n.brand-words b{font-family:system-ui,sans-serif;font-size:14.5px;font-weight:700;color:#fff;letter-spacing:-0.01em;}\n.brand-words span{font-size:9.5px;font-weight:700;letter-spacing:.13em;color:#3FD6D9;text-transform:uppercase;}\n.nav-main{display:flex;align-items:center;gap:24px;margin-left:28px;flex:1;}\n.nav-links{display:flex;align-items:center;gap:2px;}\n.nav-links a{font-size:13.5px;font-weight:500;color:rgba(255,255,255,.8);padding:8px 12px;border-radius:6px;transition:background-color .18s ease,color .18s ease;}\n.nav-links a:hover{color:#fff;background:rgba(255,255,255,.1);}\n.nav-links a.is-current{color:#fff;}\n.nav-links a.is-current::after{content:\"\";display:block;height:2px;width:16px;margin-top:5px;background:var(--teal);border-radius:2px;}\n.nav-auth{display:flex;align-items:center;gap:10px;margin-left:auto;}\n.btn-ghost-light{display:inline-flex;align-items:center;justify-content:center;height:38px;padding:0 16px;border-radius:8px;border:1px solid rgba(255,255,255,.32);color:#fff;font-size:13.5px;font-weight:600;transition:background-color .18s ease,border-color .18s ease;}\n.btn-ghost-light:hover{background:rgba(255,255,255,.14);border-color:rgba(255,255,255,.5);}\n.btn-solid{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:38px;padding:0 18px;border-radius:8px;background:var(--blue);color:#fff!important;font-size:13.5px;font-weight:600;box-shadow:0 4px 12px rgba(37,99,235,.28);transition:background-color .18s ease,transform .18s ease;}\n.btn-solid:hover{background:var(--blue-dark);transform:translateY(-1px);}\n.nav-toggle{display:none;margin-left:auto;background:none;border:0;color:#fff;font-size:22px;padding:8px;cursor:pointer;}\n.hero-copy{margin-top:auto;margin-bottom:64px;max-width:560px;}\n.hero h1{font-size:54px;line-height:1.05;color:#fff;font-weight:500;}\n.hero-sub{margin-top:16px;font-size:16.5px;line-height:1.6;color:rgba(255,255,255,.78);max-width:430px;}\n.hero-actions{margin-top:28px;display:flex;align-items:center;gap:22px;flex-wrap:wrap;}\n.btn-lg{height:48px;padding:0 24px;border-radius:10px;font-size:15px;}\n.hero-quiet{display:inline-flex;align-items:center;gap:8px;font-size:14.5px;font-weight:600;color:rgba(255,255,255,.9);}\n.hero-quiet i{font-size:16px;transition:transform .18s ease;}\n.hero-quiet:hover i{transform:translateX(3px);}\n.hero-quiet:hover{color:#fff;}\n\n/* ---------- SECTION SHELL ---------- */\nsection{position:relative;}\n.sec{padding:72px 0;}\n.sec-head{display:flex;align-items:flex-end;justify-content:space-between;gap:32px;}\n.sec-head h2{font-size:34px;line-height:1.15;}\n.sec-head p{margin-top:8px;font-size:15px;color:var(--muted);max-width:560px;}\n.sec-link{display:inline-flex;align-items:center;gap:8px;font-size:14px;font-weight:600;color:var(--blue);white-space:nowrap;padding-bottom:4px;}\n.sec-link i{font-size:15px;transition:transform .18s ease;}\n.sec-link:hover i{transform:translateX(3px);}\n.rail-ctl{display:flex;gap:8px;}\n.ctl{width:42px;height:42px;border-radius:50%;border:1px solid var(--line);background:#fff;color:var(--navy);display:inline-flex;align-items:center;justify-content:center;font-size:18px;cursor:pointer;transition:border-color .18s ease,box-shadow .18s ease,transform .18s ease;}\n.ctl:hover{border-color:#C6D0E0;box-shadow:0 6px 14px -6px rgba(15,23,42,.25);transform:translateY(-1px);}\n\n/* ---------- CATEGORIES ---------- */\n.cats .rail-track{display:flex;gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;padding:28px 4px 6px;margin:0 -4px;scrollbar-width:none;}\n.rail-track::-webkit-scrollbar{display:none;}\n.cat-card{flex:0 0 276px;scroll-snap-align:start;background:#fff;border:1px solid var(--line);border-radius:16px;padding:22px;display:flex;flex-direction:column;min-height:196px;transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease;}\n.cat-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-card);border-color:#CED8E8;}\n.cat-top{display:flex;align-items:center;justify-content:space-between;color:var(--teal);font-size:20px;margin-bottom:26px;}\n.cat-top span{font-family:system-ui,sans-serif;font-variant-numeric:tabular-nums;font-size:12.5px;font-weight:600;color:var(--soft);letter-spacing:.01em;}\n.cat-card h3{font-size:25px;line-height:1.2;margin-bottom:auto;}\n.cat-card .go{margin-top:18px;display:inline-flex;align-items:center;gap:7px;font-size:13.5px;font-weight:600;color:var(--blue);}\n.cat-card .go i{font-size:14px;transition:transform .18s ease;}\n.cat-card:hover .go i{transform:translateX(3px);}\n.cat-card.is-empty h3{color:#48566E;}\n\n/* ---------- ACCREDITED SCHEDULE ---------- */\n.accred{background:var(--surface);border-top:1px solid var(--line-soft);border-bottom:1px solid var(--line-soft);}\n.process{margin-top:36px;background:#fff;border:1px solid var(--line);border-radius:20px;box-shadow:var(--shadow-card);display:grid;grid-template-columns:repeat(4,1fr);overflow:hidden;}\n.stage{padding:28px 26px 32px;border-left:1px solid var(--line-soft);}\n.stage:first-child{border-left:0;}\n.stage-num{font-family:system-ui,sans-serif;font-size:12px;font-weight:700;letter-spacing:.12em;color:var(--teal-dark);font-variant-numeric:tabular-nums;}\n.stage h3{font-size:19px;line-height:1.25;margin:14px 0 10px;}\n.stage p{font-size:13.8px;line-height:1.62;color:var(--muted);}\n.stage-foot{margin-top:16px;display:inline-flex;align-items:center;gap:6px;font-size:12.5px;font-weight:600;color:var(--navy);opacity:.72;}\n.stage-foot i{font-size:14px;color:var(--teal);}\n\n/* ---------- EVENTS ---------- */\n.ev-grid{margin-top:32px;display:grid;grid-template-columns:7fr 5fr;gap:24px;align-items:stretch;}\n.lead{background:#fff;border:1px solid var(--line);border-radius:20px;overflow:hidden;display:flex;flex-direction:column;transition:transform .2s ease,box-shadow .2s ease;}\n.lead:hover{transform:translateY(-3px);box-shadow:var(--shadow-lift);}\n.lead-media{position:relative;height:296px;overflow:hidden;background:#0F172A;}\n.lead-media img{width:100%;height:100%;object-fit:cover;}\n.tag{position:absolute;left:16px;top:16px;background:rgba(15,23,42,.82);backdrop-filter:blur(6px);color:#fff;font-size:11.5px;font-weight:600;letter-spacing:.02em;padding:6px 10px;border-radius:6px;}\n.lead-body{padding:24px 26px 26px;display:flex;flex-direction:column;flex:1;}\n.meta{display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:12.5px;color:var(--soft);font-variant-numeric:tabular-nums;}\n.meta i{font-size:14px;color:#94A3B8;}\n.meta .dot{width:3px;height:3px;border-radius:50%;background:#C8D1E0;}\n.lead-body h3{font-size:29px;line-height:1.2;margin:12px 0 10px;}\n.lead-body p{font-size:14.5px;line-height:1.6;color:var(--muted);}\n.lead-foot{margin-top:auto;padding-top:20px;display:flex;align-items:center;justify-content:space-between;gap:16px;border-top:1px solid var(--line-soft);margin-top:22px;}\n.facts{display:flex;align-items:center;gap:14px;font-size:13px;color:var(--muted);font-variant-numeric:tabular-nums;}\n.facts b{color:var(--navy);font-weight:650;}\n.btn-sm{display:inline-flex;align-items:center;gap:7px;height:40px;padding:0 16px;border-radius:9px;background:var(--blue);color:#fff!important;font-size:13.5px;font-weight:600;transition:background-color .18s ease;}\n.btn-sm:hover{background:var(--blue-dark);}\n.side{display:flex;flex-direction:column;gap:24px;}\n.side-card{flex:1;display:flex;gap:18px;padding:16px;background:#fff;border:1px solid var(--line);border-radius:18px;transition:transform .2s ease,box-shadow .2s ease;}\n.side-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-card);}\n.side-thumb{width:150px;flex:0 0 150px;border-radius:12px;overflow:hidden;background:#0F172A;}\n.side-thumb img{width:100%;height:100%;object-fit:cover;}\n.side-body{display:flex;flex-direction:column;padding:2px 0;}\n.side-body h3{font-size:20px;line-height:1.25;margin:8px 0 8px;}\n.side-body p{font-size:13px;line-height:1.55;color:var(--muted);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}\n.side-foot{margin-top:auto;display:flex;align-items:center;justify-content:space-between;gap:12px;padding-top:12px;font-size:12.5px;color:var(--muted);}\n.side-foot a{display:inline-flex;align-items:center;gap:6px;font-weight:600;color:var(--blue);font-size:13px;}\n.side-foot a i{font-size:13px;}\n\n.cont{margin-top:24px;border-top:1px solid var(--line);}\n.cont-row{display:grid;grid-template-columns:112px 1fr auto 24px;align-items:center;gap:24px;padding:16px 4px;border-bottom:1px solid var(--line-soft);transition:background-color .16s ease;}\n.cont-row:hover{background:#FAFBFD;}\n.cont-date{font-size:12px;font-weight:700;letter-spacing:.06em;color:var(--navy);text-transform:uppercase;font-variant-numeric:tabular-nums;line-height:1.35;}\n.cont-date span{display:block;font-weight:500;color:var(--soft);letter-spacing:.02em;text-transform:none;font-size:12px;}\n.cont-main h3{font-size:18px;line-height:1.3;}\n.cont-main .meta{margin-top:4px;}\n.cont-price{font-size:13px;font-weight:650;color:var(--navy);font-variant-numeric:tabular-nums;white-space:nowrap;}\n.cont-row > i{font-size:16px;color:#9AA7BB;}\n\n/* ---------- INSTITUTIONAL ---------- */\n.inst{background:var(--surface);border-top:1px solid var(--line-soft);}\n.inst-grid{display:grid;grid-template-columns:5fr 7fr;gap:64px;align-items:start;}\n.inst-head h2{font-size:34px;line-height:1.16;}\n.inst-head p{margin-top:14px;font-size:14.5px;color:var(--muted);max-width:340px;}\n.inst-item{padding:0 0 22px;margin-bottom:22px;border-bottom:1px solid var(--line);}\n.inst-item:last-of-type{border-bottom:0;margin-bottom:0;padding-bottom:0;}\n.inst-item h3{font-size:20px;display:flex;align-items:center;gap:10px;}\n.inst-item h3 i{font-size:17px;color:var(--teal);}\n.inst-item p{margin-top:8px;font-size:14px;line-height:1.62;color:var(--muted);max-width:560px;}\n.chain{margin-top:26px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-size:12.5px;font-weight:600;color:var(--navy);}\n.chain span{background:#fff;border:1px solid var(--line);border-radius:20px;padding:6px 12px;}\n.chain i{font-size:13px;color:#A8B4C6;}\n\n/* ---------- ACCOUNT ---------- */\n.join-row{display:flex;align-items:center;justify-content:space-between;gap:48px;}\n.join-row h2{font-size:32px;line-height:1.18;}\n.join-row p{margin-top:10px;font-size:14.5px;color:var(--muted);max-width:520px;}\n.join-actions{display:flex;align-items:center;gap:14px;flex:0 0 auto;}\n.btn-outline{display:inline-flex;align-items:center;height:48px;padding:0 22px;border-radius:10px;border:1px solid #C9D3E2;background:#fff;color:var(--navy);font-size:14.5px;font-weight:600;transition:border-color .18s ease,background-color .18s ease;}\n.btn-outline:hover{border-color:#9FB0C8;background:#F8FAFC;}\n.btn-primary-lg{display:inline-flex;align-items:center;gap:8px;height:48px;padding:0 24px;border-radius:10px;background:var(--blue);color:#fff!important;font-size:14.5px;font-weight:600;box-shadow:0 4px 14px rgba(37,99,235,.26);transition:background-color .18s ease,transform .18s ease;}\n.btn-primary-lg:hover{background:var(--blue-dark);transform:translateY(-1px);}\n\n/* ---------- FOOTER ---------- */\n.foot{background:#0F172A;color:#CBD5E1;padding:56px 0 0;}\n.foot-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr 1.2fr;gap:40px;padding-bottom:40px;}\n.foot-brand{display:flex;align-items:center;gap:10px;margin-bottom:18px;}\n.foot-brand .brand-chip img{height:28px;}\n.foot-brand b{display:block;font-size:14px;color:#fff;font-weight:700;line-height:1.2;}\n.foot-brand span{font-size:9.5px;letter-spacing:.13em;color:#3FD6D9;font-weight:700;text-transform:uppercase;}\n.foot p{font-size:13.5px;line-height:1.65;color:#94A3B8;max-width:320px;}\n.foot h4{font-family:system-ui,sans-serif;font-size:11.5px;font-weight:700;letter-spacing:.11em;text-transform:uppercase;color:#fff;margin-bottom:14px;}\n.foot ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:9px;font-size:13.5px;}\n.foot ul a{color:#94A3B8;transition:color .16s ease;}\n.foot ul a:hover{color:#fff;}\n.foot-contact{display:flex;flex-direction:column;gap:10px;font-size:13.5px;color:#94A3B8;}\n.foot-contact div{display:flex;gap:9px;align-items:flex-start;}\n.foot-contact i{color:#3FD6D9;font-size:15px;margin-top:2px;}\n.foot-base{border-top:1px solid rgba(148,163,184,.16);padding:18px 0 22px;display:flex;align-items:center;justify-content:space-between;gap:20px;font-size:12.5px;color:#94A3B8;}\n.foot-base a{color:#94A3B8;}\n.foot-base a:hover{color:#fff;}\n\n@media (max-width:1100px){\n  .wrap{padding:0 28px;}\n  .hero h1{font-size:46px;}\n  .ev-grid{grid-template-columns:1fr;}\n  .inst-grid{grid-template-columns:1fr;gap:32px;}\n  .inst-head p{max-width:560px;}\n  .join-row{flex-direction:column;align-items:flex-start;gap:24px;}\n  .foot-grid{grid-template-columns:1fr 1fr;gap:32px;}\n  .process{grid-template-columns:1fr 1fr;}\n  .stage:nth-child(3){border-left:0;}\n  .stage:nth-child(n+3){border-top:1px solid var(--line-soft);}\n}\n@media (max-width:860px){\n  .nav-main{display:none;position:absolute;top:72px;left:0;right:0;background:#0B1223;border-bottom:1px solid rgba(255,255,255,.12);padding:18px 28px 22px;flex-direction:column;align-items:stretch;gap:14px;z-index:20;box-shadow:0 18px 30px rgba(0,0,0,.35);}\n  .nav-main.open{display:flex;}\n  .nav-links{flex-direction:column;align-items:stretch;gap:2px;}\n  .nav-links a{padding:11px 10px;font-size:14.5px;}\n  .nav-links a.is-current::after{display:none;}\n  .nav-auth{margin-left:0;padding-top:14px;border-top:1px solid rgba(255,255,255,.12);}\n  .nav-auth a{flex:1;}\n  .nav-toggle{display:inline-flex;}\n  .nav{margin-right:-8px;}\n  .sec{padding:52px 0;}\n  .sec-head{flex-direction:column;align-items:flex-start;gap:18px;}\n  .sec-head h2,.inst-head h2,.join-row h2{font-size:28px;}\n  .hero{height:500px;}\n  .hero-copy{margin-bottom:44px;}\n  .hero h1{font-size:38px;}\n  .hero-sub{font-size:15px;}\n  .lead-media{height:230px;}\n  .lead-body h3{font-size:24px;}\n  .side-card{flex-direction:row;}\n  .side-thumb{width:112px;flex:0 0 112px;}\n  .cont-row{grid-template-columns:92px 1fr 18px;gap:16px;}\n  .cont-price{display:none;}\n  .foot-base{flex-direction:column;align-items:flex-start;gap:10px;}\n}\n@media (max-width:560px){\n  .wrap{padding:0 16px;}\n  .hero{height:480px;}\n  .hero h1{font-size:33px;}\n  .hero-actions{gap:16px;}\n  .btn-lg{width:100%;}\n  .hero-quiet{font-size:14px;}\n  .cat-card{flex:0 0 264px;min-height:180px;}\n  .cat-card h3{font-size:22px;}\n  .process{grid-template-columns:1fr;}\n  .stage{border-left:0;border-top:1px solid var(--line-soft);}\n  .stage:first-child{border-top:0;}\n  .side-card{flex-direction:column;padding:14px;}\n  .side-thumb{width:100%;flex:0 0 148px;}\n  .cont-row{grid-template-columns:1fr 18px;gap:12px;padding:14px 2px;}\n  .cont-date{grid-column:1 / -1;display:flex;gap:6px;align-items:baseline;}\n  .cont-date span{display:inline;}\n  .join-actions{flex-direction:column;align-items:stretch;width:100%;gap:10px;}\n  .join-actions a{width:100%;justify-content:center;}\n  .foot-grid{grid-template-columns:1fr;gap:28px;}\n}\n</style>\n<header class=\"hero\" data-kid=\"1\" data-name=\"hero section with background image\">\n<div class=\"wrap hero-inner\" data-kid=\"1-1\" data-name=\"hero inner content container\">\n<nav aria-label=\"Public\" class=\"nav\" data-kid=\"1-1-1\" data-name=\"main navigation bar\">\n<a class=\"brand\" data-kid=\"1-1-1-1\" data-name=\"brand logo and wordmark link\" href=\"/\">\n<span class=\"brand-chip\" data-kid=\"1-1-1-1-1\" data-name=\"logo image chip\"><img alt=\"VAP UNIVERSITY\" data-kid=\"1-1-1-1-1-1\" data-name=\"university logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/CollegeEventRegistration.Web/wwwroot/images/branding/vap-university-logo.png\"/></span>\n<span class=\"brand-words\" data-kid=\"1-1-1-1-2\" data-name=\"brand wordmark container\"><b data-kid=\"1-1-1-1-2-1\" data-name=\"brand product name text\">Campus Event Hub</b><span data-kid=\"1-1-1-1-2-2\" data-name=\"university name tag text\">VAP University</span></span>\n</a>\n<button aria-label=\"Open menu\" class=\"nav-toggle\" data-kid=\"1-1-1-2\" data-name=\"mobile menu hamburger button\" onclick=\"document.getElementById('navMain').classList.toggle('open')\" type=\"button\"><i class=\"icon-menu\" data-kid=\"1-1-1-2-1\" data-name=\"menu hamburger icon\"></i></button>\n<div class=\"nav-main\" data-kid=\"1-1-1-3\" data-name=\"primary navigation container (collapsible on mobile)\" id=\"navMain\">\n<div class=\"nav-links\" data-kid=\"1-1-1-3-1\" data-name=\"navigation link group\">\n<a class=\"is-current\" data-kid=\"1-1-1-3-1-1\" data-name=\"nav link to home (currently active)\" href=\"/\">Home</a>\n<a data-kid=\"1-1-1-3-1-2\" data-name=\"nav link to categories\" href=\"#categories\">Categories</a>\n<a data-kid=\"1-1-1-3-1-3\" data-name=\"nav link to accredited schedule\" href=\"#accredited-schedule\">Accredited schedule</a>\n<a data-kid=\"1-1-1-3-1-4\" data-name=\"nav link to events\" href=\"#upcoming-events\">Events</a>\n<a data-kid=\"1-1-1-3-1-5\" data-name=\"nav link to about\" href=\"#about\">About</a>\n</div>\n<div class=\"nav-auth\" data-kid=\"1-1-1-3-2\" data-name=\"navigation auth actions\">\n<a class=\"btn-ghost-light\" data-kid=\"1-1-1-3-2-1\" data-name=\"sign in ghost button\" href=\"/Account/Login\">Sign in</a>\n<a class=\"btn-solid\" data-kid=\"1-1-1-3-2-2\" data-name=\"create account primary button\" href=\"/Account/Register\">Create account</a>\n</div>\n</div>\n</nav>\n<div class=\"hero-copy\" data-kid=\"1-1-2\" data-name=\"hero copy block\">\n<h1 data-kid=\"1-1-2-1\" data-name=\"hero headline text\">All campus events.<br data-kid=\"1-1-2-1-1\" data-name=\"line break in headline\"/>One schedule.</h1>\n<p class=\"hero-sub\" data-kid=\"1-1-2-2\" data-name=\"hero subtitle description\">Workshops, hackathons, lectures and symposiums published by VAP UNIVERSITY departments, with registration dates and seat counts.</p>\n<div class=\"hero-actions\" data-kid=\"1-1-2-3\" data-name=\"hero call-to-action group\">\n<a class=\"btn-solid btn-lg\" data-kid=\"1-1-2-3-1\" data-name=\"primary browse events button\" href=\"#upcoming-events\">Browse upcoming events <i class=\"icon-arrow-right\" data-kid=\"1-1-2-3-1-1\" data-name=\"arrow right icon\"></i></a>\n<a class=\"hero-quiet\" data-kid=\"1-1-2-3-2\" data-name=\"secondary explore categories link\" href=\"#categories\">Explore categories <i class=\"icon-arrow-right\" data-kid=\"1-1-2-3-2-1\" data-name=\"arrow right icon\"></i></a>\n</div>\n</div>\n</div>\n</header>\n<section class=\"sec cats\" data-kid=\"2\" data-name=\"events categories section\" id=\"categories\">\n<div class=\"wrap\" data-kid=\"2-1\" data-name=\"section content wrapper\">\n<div class=\"sec-head\" data-kid=\"2-1-1\" data-name=\"section header with controls\">\n<div data-kid=\"2-1-1-1\" data-name=\"section heading wrapper\">\n<h2 data-kid=\"2-1-1-1-1\" data-name=\"section heading text\">Explore by event category</h2>\n</div>\n<div class=\"rail-ctl\" data-kid=\"2-1-1-2\" data-name=\"category carousel scroll controls\">\n<button aria-label=\"Previous categories\" class=\"ctl\" data-kid=\"2-1-1-2-1\" data-name=\"previous categories scroll button\" onclick=\"document.getElementById('catRail').scrollBy({left:-320,behavior:'smooth'})\" type=\"button\"><i class=\"icon-chevron-left\" data-kid=\"2-1-1-2-1-1\" data-name=\"chevron left icon\"></i></button>\n<button aria-label=\"Next categories\" class=\"ctl\" data-kid=\"2-1-1-2-2\" data-name=\"next categories scroll button\" onclick=\"document.getElementById('catRail').scrollBy({left:320,behavior:'smooth'})\" type=\"button\"><i class=\"icon-chevron-right\" data-kid=\"2-1-1-2-2-1\" data-name=\"chevron right icon\"></i></button>\n</div>\n</div>\n<div class=\"rail-track\" data-kid=\"2-1-2\" data-name=\"horizontally scrolling category carousel\" id=\"catRail\">\n<a class=\"cat-card\" data-kid=\"2-1-2-1\" data-name=\"technical workshop category card\" href=\"/Student/Events\">\n<div class=\"cat-top\" data-kid=\"2-1-2-1-1\" data-name=\"category card header\"><i class=\"icon-code\" data-kid=\"2-1-2-1-1-1\" data-name=\"code icon\"></i><span data-kid=\"2-1-2-1-1-2\" data-name=\"category event count label\">24 events</span></div>\n<h3 data-kid=\"2-1-2-1-2\" data-name=\"category card title\">Technical Workshop</h3>\n<span class=\"go\" data-kid=\"2-1-2-1-3\" data-name=\"browse events link\">Browse events <i class=\"icon-arrow-right\" data-kid=\"2-1-2-1-3-1\" data-name=\"arrow right icon\"></i></span>\n</a>\n<a class=\"cat-card\" data-kid=\"2-1-2-2\" data-name=\"hackathon category card\" href=\"/Student/Events\">\n<div class=\"cat-top\" data-kid=\"2-1-2-2-1\" data-name=\"category card header\"><i class=\"icon-trophy\" data-kid=\"2-1-2-2-1-1\" data-name=\"trophy icon\"></i><span data-kid=\"2-1-2-2-1-2\" data-name=\"category event count label\">9 events</span></div>\n<h3 data-kid=\"2-1-2-2-2\" data-name=\"category card title\">Hackathon &amp; Contest</h3>\n<span class=\"go\" data-kid=\"2-1-2-2-3\" data-name=\"browse events link\">Browse events <i class=\"icon-arrow-right\" data-kid=\"2-1-2-2-3-1\" data-name=\"arrow right icon\"></i></span>\n</a>\n<a class=\"cat-card\" data-kid=\"2-1-2-3\" data-name=\"guest lecture category card\" href=\"/Student/Events\">\n<div class=\"cat-top\" data-kid=\"2-1-2-3-1\" data-name=\"category card header\"><i class=\"icon-mic\" data-kid=\"2-1-2-3-1-1\" data-name=\"microphone icon\"></i><span data-kid=\"2-1-2-3-1-2\" data-name=\"category event count label\">17 events</span></div>\n<h3 data-kid=\"2-1-2-3-2\" data-name=\"category card title\">Guest Lecture &amp; Seminar</h3>\n<span class=\"go\" data-kid=\"2-1-2-3-3\" data-name=\"browse events link\">Browse events <i class=\"icon-arrow-right\" data-kid=\"2-1-2-3-3-1\" data-name=\"arrow right icon\"></i></span>\n</a>\n<a class=\"cat-card\" data-kid=\"2-1-2-4\" data-name=\"national symposium category card\" href=\"/Student/Events\">\n<div class=\"cat-top\" data-kid=\"2-1-2-4-1\" data-name=\"category card header\"><i class=\"icon-globe\" data-kid=\"2-1-2-4-1-1\" data-name=\"globe icon\"></i><span data-kid=\"2-1-2-4-1-2\" data-name=\"category event count label\">6 events</span></div>\n<h3 data-kid=\"2-1-2-4-2\" data-name=\"category card title\">National Symposium</h3>\n<span class=\"go\" data-kid=\"2-1-2-4-3\" data-name=\"browse events link\">Browse events <i class=\"icon-arrow-right\" data-kid=\"2-1-2-4-3-1\" data-name=\"arrow right icon\"></i></span>\n</a>\n<a class=\"cat-card\" data-kid=\"2-1-2-5\" data-name=\"cultural and arts category card\" href=\"/Student/Events\">\n<div class=\"cat-top\" data-kid=\"2-1-2-5-1\" data-name=\"category card header\"><i class=\"icon-palette\" data-kid=\"2-1-2-5-1-1\" data-name=\"palette icon\"></i><span data-kid=\"2-1-2-5-1-2\" data-name=\"category event count label\">12 events</span></div>\n<h3 data-kid=\"2-1-2-5-2\" data-name=\"category card title\">Cultural &amp; Arts</h3>\n<span class=\"go\" data-kid=\"2-1-2-5-3\" data-name=\"browse events link\">Browse events <i class=\"icon-arrow-right\" data-kid=\"2-1-2-5-3-1\" data-name=\"arrow right icon\"></i></span>\n</a>\n</div>\n</div>\n</section>\n<section class=\"sec accred\" data-kid=\"3\" data-name=\"accredited schedule section\" id=\"accredited-schedule\">\n<div class=\"wrap\" data-kid=\"3-1\" data-name=\"section content wrapper\">\n<div class=\"sec-head\" data-kid=\"3-1-1\" data-name=\"section header\">\n<div data-kid=\"3-1-1-1\" data-name=\"section heading wrapper\">\n<h2 data-kid=\"3-1-1-1-1\" data-name=\"section heading text\">Accredited schedule</h2>\n<p data-kid=\"3-1-1-1-2\" data-name=\"section description text\">Every event follows the same four stages, from faculty review to the certificate in your account.</p>\n</div>\n</div>\n<div class=\"process\" data-kid=\"3-1-2\" data-name=\"four-step process card\">\n<div class=\"stage\" data-kid=\"3-1-2-1\" data-name=\"process step one container\">\n<div class=\"stage-num\" data-kid=\"3-1-2-1-1\" data-name=\"step number label\">01</div>\n<h3 data-kid=\"3-1-2-1-2\" data-name=\"process step title\">Faculty proposal &amp; review</h3>\n<p data-kid=\"3-1-2-1-3\" data-name=\"process step description\">Coordinators submit the outline, venue, capacity, eligibility and speakers. The department academic committee reviews the proposal before it is scheduled.</p>\n<span class=\"stage-foot\" data-kid=\"3-1-2-1-4\" data-name=\"step footer badge\"><i class=\"icon-file-text\" data-kid=\"3-1-2-1-4-1\" data-name=\"document text icon\"></i> Department review</span>\n</div>\n<div class=\"stage\" data-kid=\"3-1-2-2\" data-name=\"process step two container\">\n<div class=\"stage-num\" data-kid=\"3-1-2-2-1\" data-name=\"step number label\">02</div>\n<h3 data-kid=\"3-1-2-2-2\" data-name=\"process step title\">Approval &amp; publication</h3>\n<p data-kid=\"3-1-2-2-3\" data-name=\"process step description\">An administrator approves the event. It is published to the catalogue with its registration window, fee and mode.</p>\n<span class=\"stage-foot\" data-kid=\"3-1-2-2-4\" data-name=\"step footer badge\"><i class=\"icon-check\" data-kid=\"3-1-2-2-4-1\" data-name=\"checkmark icon\"></i> Listed in the catalogue</span>\n</div>\n<div class=\"stage\" data-kid=\"3-1-2-3\" data-name=\"process step three container\">\n<div class=\"stage-num\" data-kid=\"3-1-2-3-1\" data-name=\"step number label\">03</div>\n<h3 data-kid=\"3-1-2-3-2\" data-name=\"process step title\">Enrollment &amp; admission pass</h3>\n<p data-kid=\"3-1-2-3-3\" data-name=\"process step description\">Students register inside the window. Each confirmed registration reserves a seat and issues a QR admission pass.</p>\n<span class=\"stage-foot\" data-kid=\"3-1-2-3-4\" data-name=\"step footer badge\"><i class=\"icon-qr-code\" data-kid=\"3-1-2-3-4-1\" data-name=\"QR code icon\"></i> QR pass issued</span>\n</div>\n<div class=\"stage\" data-kid=\"3-1-2-4\" data-name=\"process step four container\">\n<div class=\"stage-num\" data-kid=\"3-1-2-4-1\" data-name=\"step number label\">04</div>\n<h3 data-kid=\"3-1-2-4-2\" data-name=\"process step title\">Attendance &amp; certificate</h3>\n<p data-kid=\"3-1-2-4-3\" data-name=\"process step description\">Coordinators scan passes at the venue door. Attendance is recorded against the registration and the certificate becomes available in the student portal.</p>\n<span class=\"stage-foot\" data-kid=\"3-1-2-4-4\" data-name=\"step footer badge\"><i class=\"icon-award\" data-kid=\"3-1-2-4-4-1\" data-name=\"award icon\"></i> Certificate in the portal</span>\n</div>\n</div>\n</div>\n</section>\n<section class=\"sec\" data-kid=\"4\" data-name=\"upcoming events section\" id=\"upcoming-events\">\n<div class=\"wrap\" data-kid=\"4-1\" data-name=\"section content wrapper\">\n<div class=\"sec-head\" data-kid=\"4-1-1\" data-name=\"section header with link\">\n<div data-kid=\"4-1-1-1\" data-name=\"section heading wrapper\">\n<h2 data-kid=\"4-1-1-1-1\" data-name=\"section heading text\">Upcoming &amp; featured events</h2>\n<p data-kid=\"4-1-1-1-2\" data-name=\"section description text\">Open for registration, ordered by start date.</p>\n</div>\n<a class=\"sec-link\" data-kid=\"4-1-1-2\" data-name=\"all events section link\" href=\"/Student/Events\">All events <i class=\"icon-arrow-right\" data-kid=\"4-1-1-2-1\" data-name=\"arrow right icon\"></i></a>\n</div>\n<div class=\"ev-grid\" data-kid=\"4-1-2\" data-name=\"events grid layout\">\n<article class=\"lead\" data-kid=\"4-1-2-1\" data-name=\"lead featured event article\">\n<div class=\"lead-media\" data-kid=\"4-1-2-1-1\" data-name=\"lead event image container\">\n<img alt=\"Students assembling an electronics prototype at a workshop bench\" data-kid=\"4-1-2-1-1-1\" data-name=\"lead event hero image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/d12c95df160946de8ab6272adbb21bc6.jpg\"/>\n<span class=\"tag\" data-kid=\"4-1-2-1-1-2\" data-name=\"event category tag\">Technical Workshop</span>\n</div>\n<div class=\"lead-body\" data-kid=\"4-1-2-1-2\" data-name=\"lead event body\">\n<div class=\"meta\" data-kid=\"4-1-2-1-2-1\" data-name=\"event date and location meta row\">\n<i class=\"icon-calendar-days\" data-kid=\"4-1-2-1-2-1-1\" data-name=\"calendar icon\"></i><span data-kid=\"4-1-2-1-2-1-2\" data-name=\"event date text\">Tue 24 Nov 2026</span>\n<span class=\"dot\" data-kid=\"4-1-2-1-2-1-3\" data-name=\"meta separator dot\"></span><span data-kid=\"4-1-2-1-2-1-4\" data-name=\"department name text\">ECE</span>\n<span class=\"dot\" data-kid=\"4-1-2-1-2-1-5\" data-name=\"meta separator dot\"></span><span data-kid=\"4-1-2-1-2-1-6\" data-name=\"mode and venue text\">Offline · Seminar Hall B</span>\n</div>\n<h3 data-kid=\"4-1-2-1-2-2\" data-name=\"lead event title\">Embedded systems prototyping with STM32</h3>\n<p data-kid=\"4-1-2-1-2-3\" data-name=\"lead event description\">Two-day lab covering GPIO, interrupts, timers and sensor integration on the STM32F4 board. Laptop and ST-Link required; boards are provided.</p>\n<div class=\"lead-foot\" data-kid=\"4-1-2-1-2-4\" data-name=\"lead event footer\">\n<div class=\"facts\" data-kid=\"4-1-2-1-2-4-1\" data-name=\"event facts (price and capacity)\">\n<span data-kid=\"4-1-2-1-2-4-1-1\" data-name=\"price value wrapper\"><b data-kid=\"4-1-2-1-2-4-1-1-1\" data-name=\"event price amount\">₹450</b></span>\n<span class=\"dot\" data-kid=\"4-1-2-1-2-4-1-2\" data-name=\"meta separator dot\"></span>\n<span data-kid=\"4-1-2-1-2-4-1-3\" data-name=\"capacity label and count\">Capacity <b data-kid=\"4-1-2-1-2-4-1-3-1\" data-name=\"capacity count value\">60</b></span>\n</div>\n<a class=\"btn-sm\" data-kid=\"4-1-2-1-2-4-2\" data-name=\"view event button\" href=\"/Student/Events/Details/1\">View event <i class=\"icon-arrow-right\" data-kid=\"4-1-2-1-2-4-2-1\" data-name=\"arrow right icon\"></i></a>\n</div>\n</div>\n</article>\n<div class=\"side\" data-kid=\"4-1-2-2\" data-name=\"side events column\">\n<article class=\"side-card\" data-kid=\"4-1-2-2-1\" data-name=\"side hackathon event card\">\n<div class=\"side-thumb\" data-kid=\"4-1-2-2-1-1\" data-name=\"side event thumbnail container\"><img alt=\"Student team working together around laptops\" data-kid=\"4-1-2-2-1-1-1\" data-name=\"side event thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/67e3d4b44e3d47c2950c028a868fde3c.jpg\"/></div>\n<div class=\"side-body\" data-kid=\"4-1-2-2-1-2\" data-name=\"side event body\">\n<div class=\"meta\" data-kid=\"4-1-2-2-1-2-1\" data-name=\"event date meta\"><i class=\"icon-calendar-days\" data-kid=\"4-1-2-2-1-2-1-1\" data-name=\"calendar icon\"></i><span data-kid=\"4-1-2-2-1-2-1-2\" data-name=\"event date text\">Fri 04 Dec 2026</span></div>\n<h3 data-kid=\"4-1-2-2-1-2-2\" data-name=\"side event title\">CodeSprint 24: campus hackathon</h3>\n<p data-kid=\"4-1-2-2-1-2-3\" data-name=\"side event description\">24-hour build across three tracks with faculty mentors on the floor.</p>\n<div class=\"side-foot\" data-kid=\"4-1-2-2-1-2-4\" data-name=\"side event footer\"><span data-kid=\"4-1-2-2-1-2-4-1\" data-name=\"price and capacity text\">Free · Capacity 200</span><a data-kid=\"4-1-2-2-1-2-4-2\" data-name=\"view event link\" href=\"/Student/Events/Details/3\">View event <i class=\"icon-arrow-right\" data-kid=\"4-1-2-2-1-2-4-2-1\" data-name=\"arrow right icon\"></i></a></div>\n</div>\n</article>\n<article class=\"side-card\" data-kid=\"4-1-2-2-2\" data-name=\"side guest lecture event card\">\n<div class=\"side-thumb\" data-kid=\"4-1-2-2-2-1\" data-name=\"side event thumbnail container\"><img alt=\"Students taking notes during a lecture\" data-kid=\"4-1-2-2-2-1-1\" data-name=\"side event thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/28ae93c6bf6f482cb0140825a4d5e40a.jpg\"/></div>\n<div class=\"side-body\" data-kid=\"4-1-2-2-2-2\" data-name=\"side event body\">\n<div class=\"meta\" data-kid=\"4-1-2-2-2-2-1\" data-name=\"event date meta\"><i class=\"icon-calendar-days\" data-kid=\"4-1-2-2-2-2-1-1\" data-name=\"calendar icon\"></i><span data-kid=\"4-1-2-2-2-2-1-2\" data-name=\"event date text\">Tue 08 Dec 2026</span></div>\n<h3 data-kid=\"4-1-2-2-2-2-2\" data-name=\"side event title\">Guest lecture: operating at scale</h3>\n<p data-kid=\"4-1-2-2-2-2-3\" data-name=\"side event description\">Systems reliability talk for third and fourth year students, followed by a Q&amp;A.</p>\n<div class=\"side-foot\" data-kid=\"4-1-2-2-2-2-4\" data-name=\"side event footer\"><span data-kid=\"4-1-2-2-2-2-4-1\" data-name=\"price and capacity text\">Free · Capacity 150</span><a data-kid=\"4-1-2-2-2-2-4-2\" data-name=\"view event link\" href=\"/Student/Events/Details/4\">View event <i class=\"icon-arrow-right\" data-kid=\"4-1-2-2-2-2-4-2-1\" data-name=\"arrow right icon\"></i></a></div>\n</div>\n</article>\n</div>\n</div>\n<div class=\"cont\" data-kid=\"4-1-3\" data-name=\"continued events list\">\n<a class=\"cont-row\" data-kid=\"4-1-3-1\" data-name=\"events list row one\" href=\"/Student/Events/Details/2\">\n<div class=\"cont-date\" data-kid=\"4-1-3-1-1\" data-name=\"event date block\">Fri 27 Nov<span data-kid=\"4-1-3-1-1-1\" data-name=\"event date year text\">2026</span></div>\n<div class=\"cont-main\" data-kid=\"4-1-3-1-2\" data-name=\"event main info block\">\n<h3 data-kid=\"4-1-3-1-2-1\" data-name=\"event title\">Robotics line-follower sprint</h3>\n<div class=\"meta\" data-kid=\"4-1-3-1-2-2\" data-name=\"event category and detail meta\"><span data-kid=\"4-1-3-1-2-2-1\" data-name=\"category name text\">Technical Workshop</span><span class=\"dot\" data-kid=\"4-1-3-1-2-2-2\" data-name=\"meta separator dot\"></span><span data-kid=\"4-1-3-1-2-2-3\" data-name=\"department text\">Mechanical Engineering</span><span class=\"dot\" data-kid=\"4-1-3-1-2-2-4\" data-name=\"meta separator dot\"></span><span data-kid=\"4-1-3-1-2-2-5\" data-name=\"mode text\">Offline</span></div>\n</div>\n<div class=\"cont-price\" data-kid=\"4-1-3-1-3\" data-name=\"event price text\">₹300</div>\n<i class=\"icon-chevron-right\" data-kid=\"4-1-3-1-4\" data-name=\"chevron right navigation icon\"></i>\n</a>\n<a class=\"cont-row\" data-kid=\"4-1-3-2\" data-name=\"events list row two\" href=\"/Student/Events/Details/5\">\n<div class=\"cont-date\" data-kid=\"4-1-3-2-1\" data-name=\"event date block\">Fri 11 Dec<span data-kid=\"4-1-3-2-1-1\" data-name=\"event date year text\">2026</span></div>\n<div class=\"cont-main\" data-kid=\"4-1-3-2-2\" data-name=\"event main info block\">\n<h3 data-kid=\"4-1-3-2-2-1\" data-name=\"event title\">National symposium on sustainable systems</h3>\n<div class=\"meta\" data-kid=\"4-1-3-2-2-2\" data-name=\"event category and detail meta\"><span data-kid=\"4-1-3-2-2-2-1\" data-name=\"category name text\">National Symposium</span><span class=\"dot\" data-kid=\"4-1-3-2-2-2-2\" data-name=\"meta separator dot\"></span><span data-kid=\"4-1-3-2-2-2-3\" data-name=\"department text\">Computer Science &amp; Engineering</span><span class=\"dot\" data-kid=\"4-1-3-2-2-2-4\" data-name=\"meta separator dot\"></span><span data-kid=\"4-1-3-2-2-2-5\" data-name=\"mode text\">Offline</span></div>\n</div>\n<div class=\"cont-price\" data-kid=\"4-1-3-2-3\" data-name=\"event price text\">₹750</div>\n<i class=\"icon-chevron-right\" data-kid=\"4-1-3-2-4\" data-name=\"chevron right navigation icon\"></i>\n</a>\n<a class=\"cont-row\" data-kid=\"4-1-3-3\" data-name=\"events list row three\" href=\"/Student/Events/Details/6\">\n<div class=\"cont-date\" data-kid=\"4-1-3-3-1\" data-name=\"event date block\">Fri 18 Dec<span data-kid=\"4-1-3-3-1-1\" data-name=\"event date year text\">2026</span></div>\n<div class=\"cont-main\" data-kid=\"4-1-3-3-2\" data-name=\"event main info block\">\n<h3 data-kid=\"4-1-3-3-2-1\" data-name=\"event title\">Campus cultural night</h3>\n<div class=\"meta\" data-kid=\"4-1-3-3-2-2\" data-name=\"event category and detail meta\"><span data-kid=\"4-1-3-3-2-2-1\" data-name=\"category name text\">Cultural &amp; Arts</span><span class=\"dot\" data-kid=\"4-1-3-3-2-2-2\" data-name=\"meta separator dot\"></span><span data-kid=\"4-1-3-3-2-2-3\" data-name=\"department text\">Student Activities</span><span class=\"dot\" data-kid=\"4-1-3-3-2-2-4\" data-name=\"meta separator dot\"></span><span data-kid=\"4-1-3-3-2-2-5\" data-name=\"mode text\">Offline</span></div>\n</div>\n<div class=\"cont-price\" data-kid=\"4-1-3-3-3\" data-name=\"event price text\">₹200</div>\n<i class=\"icon-chevron-right\" data-kid=\"4-1-3-3-4\" data-name=\"chevron right navigation icon\"></i>\n</a>\n</div>\n</div>\n</section>\n<section class=\"sec inst\" data-kid=\"5\" data-name=\"about institutional section\" id=\"about\">\n<div class=\"wrap inst-grid\" data-kid=\"5-1\" data-name=\"about section grid wrapper\">\n<div class=\"inst-head\" data-kid=\"5-1-1\" data-name=\"about section heading block\">\n<h2 data-kid=\"5-1-1-1\" data-name=\"about section heading\">Review, participation<br data-kid=\"5-1-1-1-1\" data-name=\"line break in heading\"/>and certificates</h2>\n<p data-kid=\"5-1-1-2\" data-name=\"about section intro text\">Events here are proposed by faculty, approved by the department, and recorded against your student profile.</p>\n</div>\n<div data-kid=\"5-1-2\" data-name=\"about section content items\">\n<div class=\"inst-item\" data-kid=\"5-1-2-1\" data-name=\"about feature item one\">\n<h3 data-kid=\"5-1-2-1-1\" data-name=\"about feature title\"><i class=\"icon-shield-check\" data-kid=\"5-1-2-1-1-1\" data-name=\"shield check icon\"></i> Academic review before publication</h3>\n<p data-kid=\"5-1-2-1-2\" data-name=\"about feature description\">Department committees check syllabus alignment, venue capacity and speaker credentials. Nothing appears in the catalogue before approval.</p>\n</div>\n<div class=\"inst-item\" data-kid=\"5-1-2-2\" data-name=\"about feature item two\">\n<h3 data-kid=\"5-1-2-2-1\" data-name=\"about feature title\"><i class=\"icon-flask-conical\" data-kid=\"5-1-2-2-1-1\" data-name=\"flask conical icon\"></i> Practice-based sessions</h3>\n<p data-kid=\"5-1-2-2-2\" data-name=\"about feature description\">Workshops and contests run in department labs and studios, with faculty coordinators and visiting practitioners leading the sessions.</p>\n</div>\n<div class=\"inst-item\" data-kid=\"5-1-2-3\" data-name=\"about feature item three\">\n<h3 data-kid=\"5-1-2-3-1\" data-name=\"about feature title\"><i class=\"icon-award\" data-kid=\"5-1-2-3-1-1\" data-name=\"award icon\"></i> Verifiable certificates</h3>\n<p data-kid=\"5-1-2-3-2\" data-name=\"about feature description\">Attendance is scanned at the door. Certificates of participation are generated from the attendance record and stay in the student portal.</p>\n</div>\n<div class=\"chain\" data-kid=\"5-1-2-4\" data-name=\"student journey flow chain\">\n<span data-kid=\"5-1-2-4-1\" data-name=\"journey step one label\">Find events</span><i class=\"icon-arrow-right\" data-kid=\"5-1-2-4-2\" data-name=\"arrow right icon\"></i>\n<span data-kid=\"5-1-2-4-3\" data-name=\"journey step two label\">Register</span><i class=\"icon-arrow-right\" data-kid=\"5-1-2-4-4\" data-name=\"arrow right icon\"></i>\n<span data-kid=\"5-1-2-4-5\" data-name=\"journey step three label\">Attend with QR pass</span><i class=\"icon-arrow-right\" data-kid=\"5-1-2-4-6\" data-name=\"arrow right icon\"></i>\n<span data-kid=\"5-1-2-4-7\" data-name=\"journey step four label\">Download certificate</span>\n</div>\n</div>\n</div>\n</section>\n<section class=\"sec\" data-kid=\"6\" data-name=\"call-to-action section\">\n<div class=\"wrap join-row\" data-kid=\"6-1\" data-name=\"call-to-action row wrapper\">\n<div data-kid=\"6-1-1\" data-name=\"call-to-action text block\">\n<h2 data-kid=\"6-1-1-1\" data-name=\"call-to-action heading\">Create a student account</h2>\n<p data-kid=\"6-1-1-2\" data-name=\"call-to-action description\">One account covers event registration, admission passes and every certificate you earn.</p>\n</div>\n<div class=\"join-actions\" data-kid=\"6-1-2\" data-name=\"call-to-action button group\">\n<a class=\"btn-primary-lg\" data-kid=\"6-1-2-1\" data-name=\"create account primary button\" href=\"/Account/Register\">Create student account <i class=\"icon-arrow-right\" data-kid=\"6-1-2-1-1\" data-name=\"arrow right icon\"></i></a>\n<a class=\"btn-outline\" data-kid=\"6-1-2-2\" data-name=\"sign in outline button\" href=\"/Account/Login\">Sign in</a>\n</div>\n</div>\n</section>\n<footer class=\"foot\" data-kid=\"7\" data-name=\"site footer\">\n<div class=\"wrap\" data-kid=\"7-1\" data-name=\"footer content wrapper\">\n<div class=\"foot-grid\" data-kid=\"7-1-1\" data-name=\"footer link grid\">\n<div data-kid=\"7-1-1-1\" data-name=\"footer brand column\">\n<div class=\"foot-brand\" data-kid=\"7-1-1-1-1\" data-name=\"footer brand logo and wordmark\">\n<span class=\"brand-chip\" data-kid=\"7-1-1-1-1-1\" data-name=\"logo image chip\"><img alt=\"VAP UNIVERSITY\" data-kid=\"7-1-1-1-1-1-1\" data-name=\"university logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/CollegeEventRegistration.Web/wwwroot/images/branding/vap-university-logo.png\"/></span>\n<div data-kid=\"7-1-1-1-1-2\" data-name=\"footer brand wordmark container\"><b data-kid=\"7-1-1-1-1-2-1\" data-name=\"brand product name text\">Campus Event Hub</b><span data-kid=\"7-1-1-1-1-2-2\" data-name=\"university name tag text\">VAP University</span></div>\n</div>\n<p data-kid=\"7-1-1-1-2\" data-name=\"footer brand description text\">Event registration for VAP UNIVERSITY students, faculty coordinators and academic departments.</p>\n</div>\n<div data-kid=\"7-1-1-2\" data-name=\"footer sections links column\">\n<h4 data-kid=\"7-1-1-2-1\" data-name=\"footer sections column heading\">Sections</h4>\n<ul data-kid=\"7-1-1-2-2\" data-name=\"sections links list\">\n<li data-kid=\"7-1-1-2-2-1\" data-name=\"list item for home link\"><a data-kid=\"7-1-1-2-2-1-1\" data-name=\"footer home link\" href=\"/\">Home</a></li>\n<li data-kid=\"7-1-1-2-2-2\" data-name=\"list item for categories link\"><a data-kid=\"7-1-1-2-2-2-1\" data-name=\"footer categories link\" href=\"#categories\">Categories</a></li>\n<li data-kid=\"7-1-1-2-2-3\" data-name=\"list item for accredited schedule link\"><a data-kid=\"7-1-1-2-2-3-1\" data-name=\"footer accredited schedule link\" href=\"#accredited-schedule\">Accredited schedule</a></li>\n<li data-kid=\"7-1-1-2-2-4\" data-name=\"list item for upcoming events link\"><a data-kid=\"7-1-1-2-2-4-1\" data-name=\"footer upcoming events link\" href=\"#upcoming-events\">Upcoming events</a></li>\n</ul>\n</div>\n<div data-kid=\"7-1-1-3\" data-name=\"footer portals links column\">\n<h4 data-kid=\"7-1-1-3-1\" data-name=\"footer portals column heading\">Portals</h4>\n<ul data-kid=\"7-1-1-3-2\" data-name=\"portals links list\">\n<li data-kid=\"7-1-1-3-2-1\" data-name=\"list item for student portal link\"><a data-kid=\"7-1-1-3-2-1-1\" data-name=\"footer student portal link\" href=\"/Student/Dashboard\">Student portal</a></li>\n<li data-kid=\"7-1-1-3-2-2\" data-name=\"list item for coordinator workspace link\"><a data-kid=\"7-1-1-3-2-2-1\" data-name=\"footer coordinator workspace link\" href=\"/Coordinator/Dashboard\">Coordinator workspace</a></li>\n<li data-kid=\"7-1-1-3-2-3\" data-name=\"list item for administration link\"><a data-kid=\"7-1-1-3-2-3-1\" data-name=\"footer administration link\" href=\"/Admin/Dashboard\">Administration</a></li>\n<li data-kid=\"7-1-1-3-2-4\" data-name=\"list item for verify certificate link\"><a data-kid=\"7-1-1-3-2-4-1\" data-name=\"footer verify certificate link\" href=\"/Certificates/Verify\">Verify a certificate</a></li>\n</ul>\n</div>\n<div data-kid=\"7-1-1-4\" data-name=\"footer contact column\">\n<h4 data-kid=\"7-1-1-4-1\" data-name=\"footer contact column heading\">Campus &amp; support</h4>\n<div class=\"foot-contact\" data-kid=\"7-1-1-4-2\" data-name=\"footer contact details list\">\n<div data-kid=\"7-1-1-4-2-1\" data-name=\"contact address row\"><i class=\"icon-map-pin\" data-kid=\"7-1-1-4-2-1-1\" data-name=\"map pin icon\"></i><span data-kid=\"7-1-1-4-2-1-2\" data-name=\"contact address text\">Directorate of Student Co-Curricular Affairs<br data-kid=\"7-1-1-4-2-1-2-1\" data-name=\"line break in address\"/>VAP UNIVERSITY Main Campus</span></div>\n<div data-kid=\"7-1-1-4-2-2\" data-name=\"contact email row\"><i class=\"icon-mail\" data-kid=\"7-1-1-4-2-2-1\" data-name=\"email icon\"></i><span data-kid=\"7-1-1-4-2-2-2\" data-name=\"contact email text\">admin@college.edu</span></div>\n<div data-kid=\"7-1-1-4-2-3\" data-name=\"contact hours row\"><i class=\"icon-clock\" data-kid=\"7-1-1-4-2-3-1\" data-name=\"clock icon\"></i><span data-kid=\"7-1-1-4-2-3-2\" data-name=\"contact hours text\">Mon – Fri, 9:00 AM – 5:00 PM IST</span></div>\n</div>\n</div>\n</div>\n<div class=\"foot-base\" data-kid=\"7-1-2\" data-name=\"footer base bar\">\n<span data-kid=\"7-1-2-1\" data-name=\"footer copyright text\">© 2026 VAP UNIVERSITY · Campus Event Hub</span>\n<span data-kid=\"7-1-2-2\" data-name=\"footer legal link wrapper\"><a data-kid=\"7-1-2-2-1\" data-name=\"data privacy link\" href=\"/Home/Privacy\">Data privacy</a></span>\n</div>\n</div>\n</footer>\n",
