    "var_d054a536c693": {
      "type": "variant",
      "label": "V3 — Browse by category",
      "parentId": "var_887e5172ad2d",
      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n:root{\n  --navy:#1F2C58; --navy-deep:#152040; --ink:#0F172A; --muted:#46536A; --soft:#68768D;\n  --line:#E3E8F1; --faint:#EEF2F7; --surface:#F5F7FB; --canvas:#F3F5F9;\n  --teal:#08898E; --teal-bright:#3FD6D9; --blue:#2563EB; --blue-dark:#1D4ED8;\n  --serif:'Newsreader',Georgia,serif;\n  --shadow:0 12px 30px -14px rgba(15,23,42,.18);\n}\n*{box-sizing:border-box;}\nhtml{scroll-behavior:smooth;}\nbody{margin:0;background:#fff;color:var(--ink);font-family:system-ui,-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif;font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased;}\nh1,h2,h3,h4{margin:0;font-family:var(--serif);font-weight:500;color:var(--navy);letter-spacing:-0.014em;}\np{margin:0;}\na{text-decoration:none;color:inherit;}\nimg{display:block;max-width:100%;}\nbutton{font-family:inherit;}\n.wrap{max-width:1320px;margin:0 auto;padding:0 48px;}\n.tnum{font-variant-numeric:tabular-nums;}\n\n/* hero */\n.hero{position:relative;height:536px;background:#0B1220 url('https://kombai-assets.b-cdn.net/generated_assets/65d9914e5b1e4fbabfc3eeed743dafae.jpg') center right/cover no-repeat;display:flex;flex-direction:column;overflow:hidden;}\n.hero::after{content:\"\";position:absolute;inset:0;background:linear-gradient(97deg,rgba(8,13,26,.9) 0%,rgba(8,13,26,.72) 32%,rgba(8,13,26,.26) 64%,rgba(8,13,26,.02) 94%);pointer-events:none;}\n.hero-inner{position:relative;z-index:2;display:flex;flex-direction:column;height:100%;}\n.nav{display:flex;align-items:center;gap:22px;height:68px;border-bottom:1px solid rgba(255,255,255,.13);}\n.brand{display:flex;align-items:center;gap:10px;}\n.chip{background:#fff;border-radius:7px;padding:5px 8px;display:flex;align-items:center;}\n.chip img{height:25px;width:auto;}\n.brand-words{display:flex;flex-direction:column;line-height:1.15;}\n.brand-words b{font-family:system-ui,sans-serif;font-size:14px;font-weight:700;color:#fff;letter-spacing:-0.01em;}\n.brand-words span{font-size:9px;font-weight:700;letter-spacing:.14em;color:var(--teal-bright);text-transform:uppercase;}\n.nav-main{display:flex;align-items:center;gap:22px;margin-left:26px;flex:1;}\n.nav-links{display:flex;align-items:center;gap:1px;}\n.nav-links a{font-size:13px;font-weight:500;color:rgba(255,255,255,.8);padding:8px 11px;border-radius:5px;transition:background-color .18s ease,color .18s ease;}\n.nav-links a:hover{color:#fff;background:rgba(255,255,255,.1);}\n.nav-links a.on{color:#fff;}\n.nav-links a.on::after{content:\"\";display:block;width:14px;height:2px;background:var(--teal-bright);border-radius:2px;margin-top:4px;}\n.nav-auth{margin-left:auto;display:flex;align-items:center;gap:9px;}\n.a-ghost{display:inline-flex;align-items:center;height:36px;padding:0 14px;border-radius:7px;border:1px solid rgba(255,255,255,.3);color:#fff;font-size:13px;font-weight:600;transition:background-color .18s ease;}\n.a-ghost:hover{background:rgba(255,255,255,.14);}\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:38px;padding:0 16px;border-radius:7px;background:var(--blue);color:#fff!important;font-size:13.5px;font-weight:600;transition:background-color .18s ease,transform .18s ease;}\n.btn:hover{background:var(--blue-dark);}\n.btn-lg{height:46px;padding:0 22px;border-radius:9px;font-size:14.5px;}\n.nav-toggle{display:none;margin-left:auto;background:none;border:0;color:#fff;font-size:22px;padding:8px;cursor:pointer;}\n.hero-copy{margin-top:auto;margin-bottom:58px;max-width:520px;}\n.hero h1{font-size:52px;line-height:1.06;color:#fff;}\n.hero-sub{margin-top:14px;font-size:16px;color:rgba(255,255,255,.76);max-width:400px;line-height:1.58;}\n.hero-actions{margin-top:26px;display:flex;align-items:center;gap:20px;flex-wrap:wrap;}\n.hero-quiet{display:inline-flex;align-items:center;gap:7px;font-size:14px;font-weight:600;color:rgba(255,255,255,.9);}\n.hero-quiet i{font-size:15px;transition:transform .18s ease;}\n.hero-quiet:hover i{transform:translateX(3px);}\n\n/* shell */\n.sec{padding:68px 0;}\n.head{display:flex;align-items:flex-end;justify-content:space-between;gap:32px;}\nh2{font-size:33px;line-height:1.16;}\n.lede{margin-top:9px;font-size:14.5px;color:var(--muted);max-width:560px;}\n.link{display:inline-flex;align-items:center;gap:7px;font-size:13.5px;font-weight:600;color:var(--blue);white-space:nowrap;}\n.link i{font-size:14px;transition:transform .18s ease;}\n.link:hover i{transform:translateX(3px);}\n.ctl-row{display:flex;gap:8px;}\n.ctl{width:40px;height:40px;border-radius:50%;border:1px solid var(--line);background:#fff;color:var(--navy);font-size:17px;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;transition:border-color .18s ease,box-shadow .18s ease;}\n.ctl:hover{border-color:#C3CEDF;box-shadow:0 6px 14px -8px rgba(15,23,42,.4);}\n\n/* categories — the light-area centrepiece */\n.cats{background:var(--surface);border-bottom:1px solid var(--faint);}\n.rail{display:flex;gap:18px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;padding:30px 3px 4px;scrollbar-width:none;}\n.rail::-webkit-scrollbar{display:none;}\n.cat{flex:0 0 276px;scroll-snap-align:start;background:#fff;border:1px solid var(--line);border-radius:18px;padding:22px 22px 18px;display:flex;flex-direction:column;min-height:206px;transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease;}\n.cat:hover{border-color:#C9D4E5;box-shadow:var(--shadow);transform:translateY(-2px);}\n.cat-icon{font-size:22px;color:var(--teal);margin-bottom:26px;}\n.cat h3{font-size:28px;line-height:1.16;margin-bottom:auto;}\n.cat-foot{margin-top:20px;display:flex;align-items:center;justify-content:space-between;gap:14px;padding-top:16px;border-top:1px solid var(--faint);}\n.cat-count{font-size:13px;color:var(--soft);font-variant-numeric:tabular-nums;}\n.cat-count b{font-size:16px;font-weight:650;color:var(--ink);}\n.cat-arrow{width:30px;height:30px;border-radius:50%;border:1px solid var(--line);display:inline-flex;align-items:center;justify-content:center;font-size:14px;color:var(--navy);transition:background-color .18s ease,border-color .18s ease,color .18s ease;}\n.cat:hover .cat-arrow{background:var(--navy);border-color:var(--navy);color:#fff;}\n\n/* accredited — left heading, vertical connected sequence */\n.acc-grid{display:grid;grid-template-columns:4fr 8fr;gap:56px;align-items:start;}\n.acc-left h2{font-size:33px;line-height:1.15;}\n.acc-left p{margin-top:12px;font-size:14px;color:var(--muted);max-width:300px;}\n.acc-left .note{margin-top:22px;display:inline-flex;align-items:center;gap:8px;font-size:12.5px;font-weight:600;color:var(--navy);}\n.acc-left .note i{font-size:15px;color:var(--teal);}\n.seq{position:relative;padding-left:30px;}\n.seq::before{content:\"\";position:absolute;left:5px;top:10px;bottom:18px;width:1px;background:var(--line);}\n.item{position:relative;padding:0 0 26px;}\n.item:last-child{padding-bottom:0;}\n.item::before{content:\"\";position:absolute;left:-30px;top:8px;width:11px;height:11px;border-radius:50%;background:#fff;border:2px solid var(--teal);}\n.item h3{font-size:20px;line-height:1.28;display:flex;align-items:baseline;gap:10px;}\n.item h3 em{font-style:normal;font-family:system-ui,sans-serif;font-size:11px;font-weight:700;letter-spacing:.12em;color:var(--soft);font-variant-numeric:tabular-nums;}\n.item p{margin-top:6px;font-size:14px;line-height:1.62;color:var(--muted);max-width:600px;}\n\n/* events — image-led mosaic + continuation list */\n.mosaic{margin-top:30px;display:grid;grid-template-columns:1.22fr 1fr 1fr;gap:22px;align-items:stretch;}\n.card{background:#fff;border:1px solid var(--line);border-radius:18px;overflow:hidden;display:flex;flex-direction:column;transition:transform .2s ease,box-shadow .2s ease;}\n.card:hover{transform:translateY(-3px);box-shadow:var(--shadow);}\n.media{position:relative;overflow:hidden;background:#0F172A;}\n.media.tall{height:296px;}\n.media.mid{height:214px;}\n.media img{width:100%;height:100%;object-fit:cover;}\n.cat-pill{position:absolute;left:14px;top:14px;background:rgba(15,23,42,.82);color:#fff;font-size:11px;font-weight:600;padding:5px 9px;border-radius:5px;backdrop-filter:blur(6px);}\n.body{padding:20px 22px 22px;display:flex;flex-direction:column;flex:1;}\n.date{font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--soft);font-variant-numeric:tabular-nums;}\n.cat h3,.card-title{margin-top:9px;}\n.card h3{font-size:23px;line-height:1.22;font-family:var(--serif);font-weight:500;color:var(--navy);}\n.cat h3{font-family:var(--serif);}\n.card p{margin-top:9px;font-size:13.5px;line-height:1.58;color:var(--muted);}\n.cat-card-foot{margin-top:auto;display:flex;align-items:center;justify-content:space-between;gap:12px;padding-top:16px;border-top:1px solid var(--faint);margin-top:18px;}\n.cat-facts{display:flex;align-items:center;gap:12px;font-size:12.5px;color:var(--muted);font-variant-numeric:tabular-nums;}\n.cat-facts b{color:var(--navy);font-weight:650;}\n.visit{display:inline-flex;align-items:center;gap:6px;font-size:12.5px;font-weight:600;color:var(--blue);}\n.visit i{font-size:13px;}\n\n.cont{margin-top:26px;border-top:1px solid var(--line);}\n.row{display:grid;grid-template-columns:120px 1fr auto 22px;gap:22px;align-items:center;padding:15px 2px;border-bottom:1px solid var(--faint);transition:background-color .16s ease;}\n.row:hover{background:#FAFBFD;}\n.row-date{font-size:12px;font-weight:650;letter-spacing:.05em;text-transform:uppercase;color:var(--navy);font-variant-numeric:tabular-nums;}\n.row h3{font-size:17px;font-family:var(--serif);font-weight:500;line-height:1.3;color:var(--navy);}\n.row .meta{margin-top:3px;font-size:12.5px;color:var(--soft);}\n.row-price{font-size:13px;font-weight:650;color:var(--navy);font-variant-numeric:tabular-nums;white-space:nowrap;}\n.row > i{font-size:15px;color:#A3B0C4;}\n\n/* institutional tab panel */\n.inst{background:var(--canvas);border-top:1px solid var(--faint);}\n.panel{margin-top:28px;background:#fff;border:1px solid var(--line);border-radius:20px;box-shadow:var(--shadow);display:grid;grid-template-columns:300px 1fr;overflow:hidden;}\n.topics{border-right:1px solid var(--faint);padding:16px;display:flex;flex-direction:column;gap:4px;background:#FBFCFE;}\n.topic{appearance:none;text-align:left;background:transparent;border:0;padding:14px 14px;border-radius:10px;font-size:14px;font-weight:600;color:var(--mut);color:#3E4C63;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:10px;transition:background-color .16s ease,color .16s ease;}\n.topic:hover{background:#F1F4FA;}\n.topic.is-on{background:#fff;color:var(--navy);box-shadow:0 2px 8px rgba(15,23,42,.07);}\n.topic i{font-size:15px;color:var(--teal);}\n.topic-panels{padding:32px 36px 34px;}\n.tp{display:none;}\n.tp.is-on{display:block;}\n.tp h3{font-size:26px;line-height:1.24;margin-bottom:12px;}\n.tp p{font-size:14.5px;line-height:1.68;color:var(--muted);max-width:660px;}\n.tp-facts{margin-top:20px;display:flex;flex-direction:column;gap:9px;}\n.tp-facts span{display:flex;align-items:center;gap:9px;font-size:13.5px;color:var(--navy);font-weight:500;}\n.tp-facts i{font-size:15px;color:var(--teal);}\n\n/* account */\n.join{display:flex;align-items:center;justify-content:space-between;gap:40px;}\n.join h2{font-size:30px;}\n.join p{margin-top:8px;font-size:14px;color:var(--muted);}\n.join-actions{display:flex;align-items:center;gap:12px;flex:0 0 auto;}\n.a-outline{display:inline-flex;align-items:center;height:46px;padding:0 20px;border-radius:9px;border:1px solid #C9D3E2;color:var(--navy);font-size:14px;font-weight:600;background:#fff;}\n.a-outline:hover{border-color:#9FB0C8;background:#F8FAFC;}\n\n/* footer */\n.foot{background:#0F172A;color:#CBD5E1;padding:52px 0 0;}\n.foot-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1.2fr;gap:40px;padding-bottom:36px;}\n.foot-brand{display:flex;align-items:center;gap:10px;margin-bottom:16px;}\n.foot-brand .chip img{height:26px;}\n.foot-brand b{display:block;font-size:13.5px;color:#fff;font-weight:700;line-height:1.2;font-family:system-ui,sans-serif;}\n.foot-brand span{font-size:9px;letter-spacing:.14em;color:var(--teal-bright);font-weight:700;text-transform:uppercase;}\n.foot p{font-size:13px;line-height:1.65;color:#94A3B8;max-width:300px;}\n.foot h4{font-family:system-ui,sans-serif;font-size:11px;font-weight:700;letter-spacing:.11em;text-transform:uppercase;color:#fff;margin-bottom:13px;}\n.foot ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px;font-size:13px;}\n.foot ul a{color:#94A3B8;}\n.foot ul a:hover{color:#fff;}\n.foot-contact{display:flex;flex-direction:column;gap:9px;font-size:13px;color:#94A3B8;}\n.foot-contact div{display:flex;gap:8px;align-items:flex-start;}\n.foot-contact i{color:var(--teal-bright);font-size:14px;margin-top:2px;}\n.foot-base{border-top:1px solid rgba(148,163,184,.16);padding:16px 0 20px;display:flex;align-items:center;justify-content:space-between;gap:18px;font-size:12.5px;color:#94A3B8;}\n.foot-base a{color:#94A3B8;}\n\n@media (max-width:1100px){\n  .wrap{padding:0 28px;}\n  .hero h1{font-size:44px;}\n  .acc-grid{grid-template-columns:1fr;gap:28px;}\n  .acc-left p{max-width:520px;}\n  .mosaic{grid-template-columns:1fr 1fr;}\n  .mosaic .card:first-child{grid-column:1 / -1;}\n  .inst .panel{grid-template-columns:1fr;}\n  .topics{border-right:0;border-bottom:1px solid var(--faint);flex-direction:row;overflow-x:auto;gap:6px;padding:12px;}\n  .topic{white-space:nowrap;padding:11px 13px;font-size:13px;}\n  .topic-panels{padding:26px}\n  .foot-grid{grid-template-columns:1fr 1fr;gap:30px;}\n  .join{flex-direction:column;align-items:flex-start;gap:22px;}\n}\n@media (max-width:860px){\n  .nav-main{display:none;position:absolute;top:68px;left:0;right:0;background:#0A1120;border-bottom:1px solid rgba(255,255,255,.12);padding:16px 28px 20px;flex-direction:column;align-items:stretch;gap:12px;z-index:20;box-shadow:0 18px 30px rgba(0,0,0,.35);}\n  .nav-main.open{display:flex;}\n  .nav-links{flex-direction:column;align-items:stretch;}\n  .nav-links a{padding:11px 10px;font-size:14px;}\n  .nav-links a.on::after{display:none;}\n  .nav-auth{margin-left:0;padding-top:12px;border-top:1px solid rgba(255,255,255,.12);}\n  .nav-auth a{flex:1;}\n  .nav-toggle{display:inline-flex;}\n  .sec{padding:50px 0;}\n  .head{flex-direction:column;align-items:flex-start;gap:16px;}\n  h2,.acc-left h2,.join h2{font-size:26px;}\n  .hero{height:490px;}\n  .hero h1{font-size:36px;}\n  .hero-copy{margin-bottom:42px;}\n  .mosaic{grid-template-columns:1fr;}\n  .mosaic .card:first-child{grid-column:auto;}\n  .media.tall{height:240px;}\n  .media.mid{height:200px;}\n  .cat{flex:0 0 280px;min-height:186px;}\n  .cat h3{font-size:24px;}\n  .row{grid-template-columns:96px 1fr 20px;gap:16px;}\n  .row-price{display:none;}\n  .foot-base{flex-direction:column;align-items:flex-start;gap:8px;}\n}\n@media (max-width:560px){\n  .wrap{padding:0 16px;}\n  .hero{height:470px;}\n  .hero h1{font-size:32px;}\n  .btn-lg{width:100%;}\n  .hero-actions{gap:14px;}\n  .cat{flex:0 0 268px;min-height:176px;}\n  .cat h3{font-size:22px;}\n  .cat-icon{margin-bottom:20px;}\n  .row{grid-template-columns:1fr 20px;}\n  .row-date{grid-column:1 / -1;}\n  .join-actions{flex-direction:column;align-items:stretch;width:100%;}\n  .join-actions a{width:100%;justify-content:center;}\n  .foot-grid{grid-template-columns:1fr;gap:26px;}\n  .topic-panels{padding:22px 18px 26px;}\n  .tp h3{font-size:22px;}\n}\n/* refinement */\n.cat{min-height:188px;padding-bottom:18px;}\n.cat-icon{margin-bottom:22px;}\n.media.tall{height:282px;}\n.media.mid{height:212px;}\n</style>\n<header class=\"hero\" data-kid=\"1\" data-name=\"hero section with image and gradient\">\n<div class=\"wrap hero-inner\" data-kid=\"1-1\" data-name=\"hero inner container\">\n<nav aria-label=\"Public\" class=\"nav\" data-kid=\"1-1-1\" data-name=\"top navigation bar\">\n<a class=\"brand\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"/\">\n<span class=\"chip\" data-kid=\"1-1-1-1-1\" data-name=\"logo image container\"><img alt=\"VAP UNIVERSITY\" data-kid=\"1-1-1-1-1-1\" data-name=\"VAP University logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/CollegeEventRegistration.Web/wwwroot/images/branding/vap-university-logo.png\"/></span>\n<span class=\"brand-words\" data-kid=\"1-1-1-1-2\" data-name=\"brand wordmark\"><b data-kid=\"1-1-1-1-2-1\" data-name=\"brand name text\">Campus Event Hub</b><span data-kid=\"1-1-1-1-2-2\" data-name=\"brand institution tag\">VAP University</span></span>\n</a>\n<button aria-label=\"Open menu\" class=\"nav-toggle\" data-kid=\"1-1-1-2\" data-name=\"mobile menu toggle button\" onclick=\"document.getElementById('v3nav').classList.toggle('open')\" type=\"button\"><i class=\"icon-menu\" data-kid=\"1-1-1-2-1\" data-name=\"menu hamburger icon\"></i></button>\n<div class=\"nav-main\" data-kid=\"1-1-1-3\" data-name=\"navigation content container\" id=\"v3nav\">\n<div class=\"nav-links\" data-kid=\"1-1-1-3-1\" data-name=\"primary navigation links\">\n<a class=\"on\" data-kid=\"1-1-1-3-1-1\" data-name=\"home navigation link\" href=\"/\">Home</a>\n<a data-kid=\"1-1-1-3-1-2\" data-name=\"categories navigation link\" href=\"#categories\">Categories</a>\n<a data-kid=\"1-1-1-3-1-3\" data-name=\"accredited schedule navigation link\" href=\"#accredited-schedule\">Accredited schedule</a>\n<a data-kid=\"1-1-1-3-1-4\" data-name=\"events navigation link\" href=\"#upcoming-events\">Events</a>\n<a data-kid=\"1-1-1-3-1-5\" data-name=\"about navigation link\" href=\"#about\">About</a>\n</div>\n<div class=\"nav-auth\" data-kid=\"1-1-1-3-2\" data-name=\"navigation auth actions\">\n<a class=\"a-ghost\" data-kid=\"1-1-1-3-2-1\" data-name=\"sign in ghost button link\" href=\"/Account/Login\">Sign in</a>\n<a class=\"btn\" data-kid=\"1-1-1-3-2-2\" data-name=\"create account primary button link\" href=\"/Account/Register\">Create account</a>\n</div>\n</div>\n</nav>\n<div class=\"hero-copy\" data-kid=\"1-1-2\" data-name=\"hero copy block\">\n<h1 data-kid=\"1-1-2-1\" data-name=\"hero headline text\">Choose a category,<br data-kid=\"1-1-2-1-1\" data-name=\"line break\"/>then the event.</h1>\n<p class=\"hero-sub\" data-kid=\"1-1-2-2\" data-name=\"hero subheadline description\">Campus events are grouped into five categories, maintained by VAP UNIVERSITY departments and reviewed before publication.</p>\n<div class=\"hero-actions\" data-kid=\"1-1-2-3\" data-name=\"hero action buttons container\">\n<a class=\"btn btn-lg\" data-kid=\"1-1-2-3-1\" data-name=\"primary browse categories button\" href=\"#categories\">Browse categories <i class=\"icon-arrow-right\" data-kid=\"1-1-2-3-1-1\" data-name=\"right arrow icon\"></i></a>\n<a class=\"hero-quiet\" data-kid=\"1-1-2-3-2\" data-name=\"secondary see events link\" href=\"#upcoming-events\">See upcoming events <i class=\"icon-arrow-right\" data-kid=\"1-1-2-3-2-1\" data-name=\"right arrow icon\"></i></a>\n</div>\n</div>\n</div>\n</header>\n<section class=\"sec cats\" data-kid=\"2\" data-name=\"categories section\" id=\"categories\">\n<div class=\"section-anchor\" data-kid=\"2-1\" data-name=\"section scroll anchor\"></div>\n<div class=\"wrap\" data-kid=\"2-2\" data-name=\"categories content container\">\n<div class=\"head\" data-kid=\"2-2-1\" data-name=\"section header row\">\n<div data-kid=\"2-2-1-1\" data-name=\"section heading block\">\n<h2 data-kid=\"2-2-1-1-1\" data-name=\"section heading text\">Explore by event category</h2>\n<p class=\"lede\" data-kid=\"2-2-1-1-2\" data-name=\"section description text\">Each category opens the catalogue filtered to that category.</p>\n</div>\n<div class=\"ctl-row\" data-kid=\"2-2-1-2\" data-name=\"carousel control buttons\">\n<button aria-label=\"Previous categories\" class=\"ctl\" data-kid=\"2-2-1-2-1\" data-name=\"scroll left carousel button\" onclick=\"document.getElementById('v3rail').scrollBy({left:-340,behavior:'smooth'})\" type=\"button\"><i class=\"icon-chevron-left\" data-kid=\"2-2-1-2-1-1\" data-name=\"left chevron icon\"></i></button>\n<button aria-label=\"Next categories\" class=\"ctl\" data-kid=\"2-2-1-2-2\" data-name=\"scroll right carousel button\" onclick=\"document.getElementById('v3rail').scrollBy({left:340,behavior:'smooth'})\" type=\"button\"><i class=\"icon-chevron-right\" data-kid=\"2-2-1-2-2-1\" data-name=\"right chevron icon\"></i></button>\n</div>\n</div>\n<div class=\"rail\" data-kid=\"2-2-2\" data-name=\"horizontal category card rail\" id=\"v3rail\">\n<a class=\"cat\" data-kid=\"2-2-2-1\" data-name=\"technical workshop category card\" href=\"/Student/Events\">\n<i class=\"cat-icon icon-code\" data-kid=\"2-2-2-1-1\" data-name=\"code icon for category\"></i>\n<h3 data-kid=\"2-2-2-1-2\" data-name=\"category card title\">Technical Workshop</h3>\n<div class=\"cat-foot\" data-kid=\"2-2-2-1-3\" data-name=\"category card footer\">\n<span class=\"cat-count\" data-kid=\"2-2-2-1-3-1\" data-name=\"event count display\"><b class=\"tnum\" data-kid=\"2-2-2-1-3-1-1\" data-name=\"node count bold number\">24</b> events</span>\n<span class=\"cat-arrow\" data-kid=\"2-2-2-1-3-2\" data-name=\"navigate arrow button\"><i class=\"icon-arrow-right\" data-kid=\"2-2-2-1-3-2-1\" data-name=\"right arrow icon\"></i></span>\n</div>\n</a>\n<a class=\"cat\" data-kid=\"2-2-2-2\" data-name=\"hackathon category card\" href=\"/Student/Events\">\n<i class=\"cat-icon icon-trophy\" data-kid=\"2-2-2-2-1\" data-name=\"trophy icon for category\"></i>\n<h3 data-kid=\"2-2-2-2-2\" data-name=\"category card title\">Hackathon &amp; Contest</h3>\n<div class=\"cat-foot\" data-kid=\"2-2-2-2-3\" data-name=\"category card footer\">\n<span class=\"cat-count\" data-kid=\"2-2-2-2-3-1\" data-name=\"event count display\"><b class=\"tnum\" data-kid=\"2-2-2-2-3-1-1\" data-name=\"node count bold number\">9</b> events</span>\n<span class=\"cat-arrow\" data-kid=\"2-2-2-2-3-2\" data-name=\"navigate arrow button\"><i class=\"icon-arrow-right\" data-kid=\"2-2-2-2-3-2-1\" data-name=\"right arrow icon\"></i></span>\n</div>\n</a>\n<a class=\"cat\" data-kid=\"2-2-2-3\" data-name=\"guest lecture category card\" href=\"/Student/Events\">\n<i class=\"cat-icon icon-mic\" data-kid=\"2-2-2-3-1\" data-name=\"microphone icon for category\"></i>\n<h3 data-kid=\"2-2-2-3-2\" data-name=\"category card title\">Guest Lecture &amp; Seminar</h3>\n<div class=\"cat-foot\" data-kid=\"2-2-2-3-3\" data-name=\"category card footer\">\n<span class=\"cat-count\" data-kid=\"2-2-2-3-3-1\" data-name=\"event count display\"><b class=\"tnum\" data-kid=\"2-2-2-3-3-1-1\" data-name=\"node count bold number\">17</b> events</span>\n<span class=\"cat-arrow\" data-kid=\"2-2-2-3-3-2\" data-name=\"navigate arrow button\"><i class=\"icon-arrow-right\" data-kid=\"2-2-2-3-3-2-1\" data-name=\"right arrow icon\"></i></span>\n</div>\n</a>\n<a class=\"cat\" data-kid=\"2-2-2-4\" data-name=\"national symposium category card\" href=\"/Student/Events\">\n<i class=\"cat-icon icon-globe\" data-kid=\"2-2-2-4-1\" data-name=\"globe icon for category\"></i>\n<h3 data-kid=\"2-2-2-4-2\" data-name=\"category card title\">National Symposium</h3>\n<div class=\"cat-foot\" data-kid=\"2-2-2-4-3\" data-name=\"category card footer\">\n<span class=\"cat-count\" data-kid=\"2-2-2-4-3-1\" data-name=\"event count display\"><b class=\"tnum\" data-kid=\"2-2-2-4-3-1-1\" data-name=\"node count bold number\">6</b> events</span>\n<span class=\"cat-arrow\" data-kid=\"2-2-2-4-3-2\" data-name=\"navigate arrow button\"><i class=\"icon-arrow-right\" data-kid=\"2-2-2-4-3-2-1\" data-name=\"right arrow icon\"></i></span>\n</div>\n</a>\n<a class=\"cat\" data-kid=\"2-2-2-5\" data-name=\"cultural and arts category card\" href=\"/Student/Events\">\n<i class=\"cat-icon icon-palette\" data-kid=\"2-2-2-5-1\" data-name=\"palette icon for category\"></i>\n<h3 data-kid=\"2-2-2-5-2\" data-name=\"category card title\">Cultural &amp; Arts</h3>\n<div class=\"cat-foot\" data-kid=\"2-2-2-5-3\" data-name=\"category card footer\">\n<span class=\"cat-count\" data-kid=\"2-2-2-5-3-1\" data-name=\"event count display\"><b class=\"tnum\" data-kid=\"2-2-2-5-3-1-1\" data-name=\"node count bold number\">12</b> events</span>\n<span class=\"cat-arrow\" data-kid=\"2-2-2-5-3-2\" data-name=\"navigate arrow button\"><i class=\"icon-arrow-right\" data-kid=\"2-2-2-5-3-2-1\" data-name=\"right arrow icon\"></i></span>\n</div>\n</a>\n</div>\n</div>\n</section>\n<section class=\"sec\" data-kid=\"3\" data-name=\"accredited schedule section\" id=\"accredited-schedule\">\n<div class=\"wrap acc-grid\" data-kid=\"3-1\" data-name=\"accredited schedule layout grid\">\n<div class=\"acc-left\" data-kid=\"3-1-1\" data-name=\"schedule left heading column\">\n<h2 data-kid=\"3-1-1-1\" data-name=\"schedule section heading\">Accredited schedule</h2>\n<p data-kid=\"3-1-1-2\" data-name=\"schedule description text\">Four stages run between a faculty proposal and the certificate in your student record.</p>\n<span class=\"note\" data-kid=\"3-1-1-3\" data-name=\"department review note badge\"><i class=\"icon-shield-check\" data-kid=\"3-1-1-3-1\" data-name=\"shield check icon\"></i> Department review on every event</span>\n</div>\n<div class=\"seq\" data-kid=\"3-1-2\" data-name=\"vertical connected stage sequence\">\n<div class=\"item\" data-kid=\"3-1-2-1\" data-name=\"stage 1 timeline item\">\n<h3 data-kid=\"3-1-2-1-1\" data-name=\"stage 1 title\"><em data-kid=\"3-1-2-1-1-1\" data-name=\"stage number label\">Stage 1</em> Faculty proposal and department review</h3>\n<p data-kid=\"3-1-2-1-2\" data-name=\"stage 1 description\">Coordinators submit the outline, venue, capacity and eligibility. The department academic committee reviews the proposal before the date is fixed.</p>\n</div>\n<div class=\"item\" data-kid=\"3-1-2-2\" data-name=\"stage 2 timeline item\">\n<h3 data-kid=\"3-1-2-2-1\" data-name=\"stage 2 title\"><em data-kid=\"3-1-2-2-1-1\" data-name=\"stage number label\">Stage 2</em> Approval and publication</h3>\n<p data-kid=\"3-1-2-2-2\" data-name=\"stage 2 description\">An administrator approves the event. It is published to the catalogue with its registration window, fee, mode and seat count.</p>\n</div>\n<div class=\"item\" data-kid=\"3-1-2-3\" data-name=\"stage 3 timeline item\">\n<h3 data-kid=\"3-1-2-3-1\" data-name=\"stage 3 title\"><em data-kid=\"3-1-2-3-1-1\" data-name=\"stage number label\">Stage 3</em> Registration and QR admission pass</h3>\n<p data-kid=\"3-1-2-3-2\" data-name=\"stage 3 description\">Students register inside the window. Each confirmed registration reserves a seat and issues an admission pass to the student portal.</p>\n</div>\n<div class=\"item\" data-kid=\"3-1-2-4\" data-name=\"stage 4 timeline item\">\n<h3 data-kid=\"3-1-2-4-1\" data-name=\"stage 4 title\"><em data-kid=\"3-1-2-4-1-1\" data-name=\"stage number label\">Stage 4</em> Attendance and certificate</h3>\n<p data-kid=\"3-1-2-4-2\" data-name=\"stage 4 description\">Coordinators scan passes at the venue door. Attendance is written against the registration and the certificate is issued from it.</p>\n</div>\n</div>\n</div>\n</section>\n<section class=\"sec\" data-kid=\"4\" data-name=\"upcoming events section\" id=\"upcoming-events\">\n<div class=\"wrap\" data-kid=\"4-1\" data-name=\"events content container\">\n<div class=\"head\" data-kid=\"4-1-1\" data-name=\"events section header\">\n<div data-kid=\"4-1-1-1\" data-name=\"events heading block\">\n<h2 data-kid=\"4-1-1-1-1\" data-name=\"events section heading\">Upcoming &amp; featured events</h2>\n<p class=\"lede\" data-kid=\"4-1-1-1-2\" data-name=\"events section description\">Open for registration, ordered by start date.</p>\n</div>\n<a class=\"link\" data-kid=\"4-1-1-2\" data-name=\"all events link\" href=\"/Student/Events\">All events <i class=\"icon-arrow-right\" data-kid=\"4-1-1-2-1\" data-name=\"right arrow icon\"></i></a>\n</div>\n<div class=\"mosaic\" data-kid=\"4-1-2\" data-name=\"featured events mosaic grid\">\n<article class=\"card\" data-kid=\"4-1-2-1\" data-name=\"featured event card with image\">\n<div class=\"media tall\" data-kid=\"4-1-2-1-1\" data-name=\"event card media with category tag\">\n<img alt=\"Students assembling an electronics prototype at a workshop bench\" data-kid=\"4-1-2-1-1-1\" data-name=\"event descriptive image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/d12c95df160946de8ab6272adbb21bc6.jpg\"/>\n<span class=\"cat-pill\" data-kid=\"4-1-2-1-1-2\" data-name=\"category tag pill\">Technical Workshop</span>\n</div>\n<div class=\"body\" data-kid=\"4-1-2-1-2\" data-name=\"event card body\">\n<span class=\"date\" data-kid=\"4-1-2-1-2-1\" data-name=\"event date and department\">Tue 24 Nov 2026 · ECE</span>\n<h3 data-kid=\"4-1-2-1-2-2\" data-name=\"featured event title\">Embedded systems prototyping with STM32</h3>\n<p data-kid=\"4-1-2-1-2-3\" data-name=\"featured event description\">Two-day lab covering GPIO, interrupts, timers and sensor integration on the STM32F4 board.</p>\n<div class=\"cat-card-foot\" data-kid=\"4-1-2-1-2-4\" data-name=\"featured event card footer\">\n<div class=\"cat-facts\" data-kid=\"4-1-2-1-2-4-1\" data-name=\"price and capacity facts\"><span data-kid=\"4-1-2-1-2-4-1-1\" data-name=\"price fact\"><b data-kid=\"4-1-2-1-2-4-1-1-1\" data-name=\"price bold value\">₹450</b></span><span data-kid=\"4-1-2-1-2-4-1-2\" data-name=\"capacity fact\">Capacity <b data-kid=\"4-1-2-1-2-4-1-2-1\" data-name=\"capacity bold value\">60</b></span></div>\n<a class=\"visit\" data-kid=\"4-1-2-1-2-4-2\" data-name=\"view event link\" href=\"/Student/Events/Details/1\">View event <i class=\"icon-arrow-right\" data-kid=\"4-1-2-1-2-4-2-1\" data-name=\"right arrow icon\"></i></a>\n</div>\n</div>\n</article>\n<article class=\"card\" data-kid=\"4-1-2-2\" data-name=\"featured event card with image\">\n<div class=\"media mid\" data-kid=\"4-1-2-2-1\" data-name=\"event card media with category tag\">\n<img alt=\"Students working together around laptops at a hackathon table\" data-kid=\"4-1-2-2-1-1\" data-name=\"event descriptive image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/a431ba6a8c824f4b9b7db67aa3b66e24.jpg\"/>\n<span class=\"cat-pill\" data-kid=\"4-1-2-2-1-2\" data-name=\"category tag pill\">Hackathon &amp; Contest</span>\n</div>\n<div class=\"body\" data-kid=\"4-1-2-2-2\" data-name=\"event card body\">\n<span class=\"date\" data-kid=\"4-1-2-2-2-1\" data-name=\"event date and department\">Fri 04 Dec 2026 · CSE</span>\n<h3 data-kid=\"4-1-2-2-2-2\" data-name=\"featured event title\">CodeSprint 24: campus hackathon</h3>\n<p data-kid=\"4-1-2-2-2-3\" data-name=\"featured event description\">24-hour build across three tracks, with faculty mentors on the floor through the night.</p>\n<div class=\"cat-card-foot\" data-kid=\"4-1-2-2-2-4\" data-name=\"featured event card footer\">\n<div class=\"cat-facts\" data-kid=\"4-1-2-2-2-4-1\" data-name=\"price and capacity facts\"><span data-kid=\"4-1-2-2-2-4-1-1\" data-name=\"price fact\"><b data-kid=\"4-1-2-2-2-4-1-1-1\" data-name=\"price bold value\">Free</b></span><span data-kid=\"4-1-2-2-2-4-1-2\" data-name=\"capacity fact\">Capacity <b data-kid=\"4-1-2-2-2-4-1-2-1\" data-name=\"capacity bold value\">200</b></span></div>\n<a class=\"visit\" data-kid=\"4-1-2-2-2-4-2\" data-name=\"view event link\" href=\"/Student/Events/Details/3\">View event <i class=\"icon-arrow-right\" data-kid=\"4-1-2-2-2-4-2-1\" data-name=\"right arrow icon\"></i></a>\n</div>\n</div>\n</article>\n<article class=\"card\" data-kid=\"4-1-2-3\" data-name=\"featured event card with image\">\n<div class=\"media mid\" data-kid=\"4-1-2-3-1\" data-name=\"event card media with category tag\">\n<img alt=\"Speakers seated at a table during a symposium session\" data-kid=\"4-1-2-3-1-1\" data-name=\"event descriptive image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/aa76d100-98f7-4af9-a957-de68f683e1d2/6a6b44b892f844ab83d84a9b58760f14.jpg\"/>\n<span class=\"cat-pill\" data-kid=\"4-1-2-3-1-2\" data-name=\"category tag pill\">National Symposium</span>\n</div>\n<div class=\"body\" data-kid=\"4-1-2-3-2\" data-name=\"event card body\">\n<span class=\"date\" data-kid=\"4-1-2-3-2-1\" data-name=\"event date and department\">Fri 11 Dec 2026 · CSE</span>\n<h3 data-kid=\"4-1-2-3-2-2\" data-name=\"featured event title\">National symposium on sustainable systems</h3>\n<p data-kid=\"4-1-2-3-2-3\" data-name=\"featured event description\">Paper presentations and a closing panel across three department tracks.</p>\n<div class=\"cat-card-foot\" data-kid=\"4-1-2-3-2-4\" data-name=\"featured event card footer\">\n<div class=\"cat-facts\" data-kid=\"4-1-2-3-2-4-1\" data-name=\"price and capacity facts\"><span data-kid=\"4-1-2-3-2-4-1-1\" data-name=\"price fact\"><b data-kid=\"4-1-2-3-2-4-1-1-1\" data-name=\"price bold value\">₹750</b></span><span data-kid=\"4-1-2-3-2-4-1-2\" data-name=\"capacity fact\">Capacity <b data-kid=\"4-1-2-3-2-4-1-2-1\" data-name=\"capacity bold value\">300</b></span></div>\n<a class=\"visit\" data-kid=\"4-1-2-3-2-4-2\" data-name=\"view event link\" href=\"/Student/Events/Details/5\">View event <i class=\"icon-arrow-right\" data-kid=\"4-1-2-3-2-4-2-1\" data-name=\"right arrow icon\"></i></a>\n</div>\n</div>\n</article>\n</div>\n<div class=\"cont\" data-kid=\"4-1-3\" data-name=\"continuation event list\">\n<a class=\"row\" data-kid=\"4-1-3-1\" data-name=\"compact event list row\" href=\"/Student/Events/Details/2\">\n<div class=\"row-date\" data-kid=\"4-1-3-1-1\" data-name=\"event date\">Fri 27 Nov 2026</div>\n<div data-kid=\"4-1-3-1-2\" data-name=\"event title and meta block\">\n<h3 data-kid=\"4-1-3-1-2-1\" data-name=\"compact event title\">Robotics line-follower sprint</h3>\n<div class=\"meta\" data-kid=\"4-1-3-1-2-2\" data-name=\"event category and department meta\">Technical Workshop · Mechanical Engineering · Mechatronics Lab</div>\n</div>\n<div class=\"row-price\" data-kid=\"4-1-3-1-3\" data-name=\"event price\">₹300</div>\n<i class=\"icon-chevron-right\" data-kid=\"4-1-3-1-4\" data-name=\"right chevron icon\"></i>\n</a>\n<a class=\"row\" data-kid=\"4-1-3-2\" data-name=\"compact event list row\" href=\"/Student/Events/Details/4\">\n<div class=\"row-date\" data-kid=\"4-1-3-2-1\" data-name=\"event date\">Tue 08 Dec 2026</div>\n<div data-kid=\"4-1-3-2-2\" data-name=\"event title and meta block\">\n<h3 data-kid=\"4-1-3-2-2-1\" data-name=\"compact event title\">Operating at scale: reliability talk</h3>\n<div class=\"meta\" data-kid=\"4-1-3-2-2-2\" data-name=\"event category and department meta\">Guest Lecture &amp; Seminar · Information Technology · Hybrid</div>\n</div>\n<div class=\"row-price\" data-kid=\"4-1-3-2-3\" data-name=\"event price\">Free</div>\n<i class=\"icon-chevron-right\" data-kid=\"4-1-3-2-4\" data-name=\"right chevron icon\"></i>\n</a>\n<a class=\"row\" data-kid=\"4-1-3-3\" data-name=\"compact event list row\" href=\"/Student/Events/Details/6\">\n<div class=\"row-date\" data-kid=\"4-1-3-3-1\" data-name=\"event date\">Fri 18 Dec 2026</div>\n<div data-kid=\"4-1-3-3-2\" data-name=\"event title and meta block\">\n<h3 data-kid=\"4-1-3-3-2-1\" data-name=\"compact event title\">Campus cultural night</h3>\n<div class=\"meta\" data-kid=\"4-1-3-3-2-2\" data-name=\"event category and department meta\">Cultural &amp; Arts · Student Activities · Amphitheatre</div>\n</div>\n<div class=\"row-price\" data-kid=\"4-1-3-3-3\" data-name=\"event price\">₹200</div>\n<i class=\"icon-chevron-right\" data-kid=\"4-1-3-3-4\" data-name=\"right chevron icon\"></i>\n</a>\n</div>\n</div>\n</section>\n<section class=\"sec inst\" data-kid=\"5\" data-name=\"how the hub works section\" id=\"about\">\n<div class=\"wrap\" data-kid=\"5-1\" data-name=\"section content container\">\n<div class=\"head\" data-kid=\"5-1-1\" data-name=\"section header\">\n<div data-kid=\"5-1-1-1\" data-name=\"section heading block\">\n<h2 data-kid=\"5-1-1-1-1\" data-name=\"section heading text\">How the hub works</h2>\n<p class=\"lede\" data-kid=\"5-1-1-1-2\" data-name=\"section description text\">Academic review, practical sessions and the certificate record.</p>\n</div>\n</div>\n<div class=\"panel\" data-kid=\"5-1-2\" data-name=\"tabbed panel layout\">\n<div aria-label=\"How the hub works\" class=\"topics\" data-kid=\"5-1-2-1\" data-name=\"topic tab list\" role=\"tablist\">\n<button aria-selected=\"true\" class=\"topic is-on\" data-dynamic=\"true\" data-kid=\"5-1-2-1-1\" data-name=\"academic review tab button\" data-reason=\"aria-selected attribute toggled by v3tab script on click\" data-tab=\"t1\" onclick=\"v3tab('t1',this)\" role=\"tab\" type=\"button\">Academic review <i class=\"icon-shield-check\" data-kid=\"5-1-2-1-1-1\" data-name=\"shield check tab icon\"></i></button>\n<button aria-selected=\"false\" class=\"topic\" data-dynamic=\"true\" data-kid=\"5-1-2-1-2\" data-name=\"practical sessions tab button\" data-reason=\"aria-selected attribute toggled by v3tab script on click\" data-tab=\"t2\" onclick=\"v3tab('t2',this)\" role=\"tab\" type=\"button\">Practical sessions <i class=\"icon-flask-conical\" data-kid=\"5-1-2-1-2-1\" data-name=\"flask tab icon\"></i></button>\n<button aria-selected=\"false\" class=\"topic\" data-dynamic=\"true\" data-kid=\"5-1-2-1-3\" data-name=\"certificates tab button\" data-reason=\"aria-selected attribute toggled by v3tab script on click\" data-tab=\"t3\" onclick=\"v3tab('t3',this)\" role=\"tab\" type=\"button\">Certificates <i class=\"icon-award\" data-kid=\"5-1-2-1-3-1\" data-name=\"award tab icon\"></i></button>\n</div>\n<div class=\"topic-panels\" data-dynamic=\"true\" data-kid=\"5-1-2-2\" data-name=\"topic panels container\" data-reason=\"child panels display toggled by v3tab script on click\">\n<div class=\"tp is-on\" data-dynamic=\"true\" data-kid=\"5-1-2-2-1\" data-name=\"academic review tab panel\" data-reason=\"display toggled by v3tab script on click\" id=\"t1\">\n<h3 data-kid=\"5-1-2-2-1-1\" data-name=\"tab panel heading\">Every event is reviewed before it is listed</h3>\n<p data-kid=\"5-1-2-2-1-2\" data-name=\"tab panel paragraph\">Department committees check syllabus alignment, venue capacity and speaker credentials. An administrator then approves publication and fixes the registration window.</p>\n<div class=\"tp-facts\" data-kid=\"5-1-2-2-1-3\" data-name=\"feature fact list\">\n<span data-kid=\"5-1-2-2-1-3-1\" data-name=\"feature fact item\"><i class=\"icon-check\" data-kid=\"5-1-2-2-1-3-1-1\" data-name=\"checkmark icon\"></i> Department academic committee review</span>\n<span data-kid=\"5-1-2-2-1-3-2\" data-name=\"feature fact item\"><i class=\"icon-check\" data-kid=\"5-1-2-2-1-3-2-1\" data-name=\"checkmark icon\"></i> Administrator approval before publication</span>\n<span data-kid=\"5-1-2-2-1-3-3\" data-name=\"feature fact item\"><i class=\"icon-check\" data-kid=\"5-1-2-2-1-3-3-1\" data-name=\"checkmark icon\"></i> Eligibility rules set per event</span>\n</div>\n</div>\n<div class=\"tp\" data-dynamic=\"true\" data-kid=\"5-1-2-2-2\" data-name=\"practical sessions tab panel\" data-reason=\"display toggled by v3tab script on click\" id=\"t2\">\n<h3 data-kid=\"5-1-2-2-2-1\" data-name=\"tab panel heading\">Sessions run in department labs and studios</h3>\n<p data-kid=\"5-1-2-2-2-2\" data-name=\"tab panel paragraph\">Workshops, contests and symposiums are held in department facilities, led by faculty coordinators with visiting practitioners where the proposal specifies them.</p>\n<div class=\"tp-facts\" data-kid=\"5-1-2-2-2-3\" data-name=\"feature fact list\">\n<span data-kid=\"5-1-2-2-2-3-1\" data-name=\"feature fact item\"><i class=\"icon-check\" data-kid=\"5-1-2-2-2-3-1-1\" data-name=\"checkmark icon\"></i> Session schedule with venue and speaker</span>\n<span data-kid=\"5-1-2-2-2-3-2\" data-name=\"feature fact item\"><i class=\"icon-check\" data-kid=\"5-1-2-2-2-3-2-1\" data-name=\"checkmark icon\"></i> Capacity fixed at approval</span>\n<span data-kid=\"5-1-2-2-2-3-3\" data-name=\"feature fact item\"><i class=\"icon-check\" data-kid=\"5-1-2-2-2-3-3-1\" data-name=\"checkmark icon\"></i> Offline, online or hybrid mode</span>\n</div>\n</div>\n<div class=\"tp\" data-dynamic=\"true\" data-kid=\"5-1-2-2-3\" data-name=\"certificates tab panel\" data-reason=\"display toggled by v3tab script on click\" id=\"t3\">\n<h3 data-kid=\"5-1-2-2-3-1\" data-name=\"tab panel heading\">Certificates come from the attendance record</h3>\n<p data-kid=\"5-1-2-2-3-2\" data-name=\"tab panel paragraph\">Passes are scanned at the venue door and attendance is written against the registration. The certificate is generated from that record and stays in the student portal.</p>\n<div class=\"tp-facts\" data-kid=\"5-1-2-2-3-3\" data-name=\"feature fact list\">\n<span data-kid=\"5-1-2-2-3-3-1\" data-name=\"feature fact item\"><i class=\"icon-check\" data-kid=\"5-1-2-2-3-3-1-1\" data-name=\"checkmark icon\"></i> QR admission pass per registration</span>\n<span data-kid=\"5-1-2-2-3-3-2\" data-name=\"feature fact item\"><i class=\"icon-check\" data-kid=\"5-1-2-2-3-3-2-1\" data-name=\"checkmark icon\"></i> Certificate available after the event</span>\n<span data-kid=\"5-1-2-2-3-3-3\" data-name=\"feature fact item\"><i class=\"icon-check\" data-kid=\"5-1-2-2-3-3-3-1\" data-name=\"checkmark icon\"></i> Certificate verification by code</span>\n</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"sec\" data-kid=\"6\" data-name=\"account CTA section\">\n<div class=\"wrap join\" data-kid=\"6-1\" data-name=\"account CTA layout\">\n<div data-kid=\"6-1-1\" data-name=\"CTA text block\">\n<h2 data-kid=\"6-1-1-1\" data-name=\"CTA heading\">Create a student account</h2>\n<p data-kid=\"6-1-1-2\" data-name=\"CTA description\">One account for event registration, admission passes and certificates.</p>\n</div>\n<div class=\"join-actions\" data-kid=\"6-1-2\" data-name=\"CTA action buttons\">\n<a class=\"btn btn-lg\" data-kid=\"6-1-2-1\" data-name=\"create account primary button\" href=\"/Account/Register\">Create student account <i class=\"icon-arrow-right\" data-kid=\"6-1-2-1-1\" data-name=\"right arrow icon\"></i></a>\n<a class=\"a-outline\" data-kid=\"6-1-2-2\" data-name=\"sign in outline button\" href=\"/Account/Login\">Sign in</a>\n</div>\n</div>\n</section>\n<footer class=\"foot\" data-kid=\"7\" data-name=\"footer\">\n<div class=\"wrap\" data-kid=\"7-1\" data-name=\"footer content container\">\n<div class=\"foot-grid\" data-kid=\"7-1-1\" data-name=\"footer grid layout\">\n<div data-kid=\"7-1-1-1\" data-name=\"footer brand column\">\n<div class=\"foot-brand\" data-kid=\"7-1-1-1-1\" data-name=\"footer brand mark\">\n<span class=\"chip\" data-kid=\"7-1-1-1-1-1\" data-name=\"logo image container\"><img alt=\"VAP UNIVERSITY\" data-kid=\"7-1-1-1-1-1-1\" data-name=\"VAP University logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/CollegeEventRegistration.Web/wwwroot/images/branding/vap-university-logo.png\"/></span>\n<div data-kid=\"7-1-1-1-1-2\" data-name=\"brand wordmark\"><b data-kid=\"7-1-1-1-1-2-1\" data-name=\"brand name text\">Campus Event Hub</b><span data-kid=\"7-1-1-1-1-2-2\" data-name=\"brand institution tag\">VAP University</span></div>\n</div>\n<p data-kid=\"7-1-1-1-2\" data-name=\"footer tagline description\">Event registration for VAP UNIVERSITY students, faculty coordinators and academic departments.</p>\n</div>\n<div data-kid=\"7-1-1-2\" data-name=\"sections links column\">\n<h4 data-kid=\"7-1-1-2-1\" data-name=\"sections column heading\">Sections</h4>\n<ul data-kid=\"7-1-1-2-2\" data-name=\"sections link list\">\n<li data-kid=\"7-1-1-2-2-1\" data-name=\"list item\"><a data-kid=\"7-1-1-2-2-1-1\" data-name=\"home footer link\" href=\"/\">Home</a></li>\n<li data-kid=\"7-1-1-2-2-2\" data-name=\"list item\"><a data-kid=\"7-1-1-2-2-2-1\" data-name=\"categories footer link\" href=\"#categories\">Categories</a></li>\n<li data-kid=\"7-1-1-2-2-3\" data-name=\"list item\"><a data-kid=\"7-1-1-2-2-3-1\" data-name=\"accredited schedule footer link\" href=\"#accredited-schedule\">Accredited schedule</a></li>\n<li data-kid=\"7-1-1-2-2-4\" data-name=\"list item\"><a data-kid=\"7-1-1-2-2-4-1\" data-name=\"upcoming events footer link\" href=\"#upcoming-events\">Upcoming events</a></li>\n</ul>\n</div>\n<div data-kid=\"7-1-1-3\" data-name=\"portals column\">\n<h4 data-kid=\"7-1-1-3-1\" data-name=\"portals column heading\">Portals</h4>\n<ul data-kid=\"7-1-1-3-2\" data-name=\"portals link list\">\n<li data-kid=\"7-1-1-3-2-1\" data-name=\"list item\"><a data-kid=\"7-1-1-3-2-1-1\" data-name=\"student portal link\" href=\"/Student/Dashboard\">Student portal</a></li>\n<li data-kid=\"7-1-1-3-2-2\" data-name=\"list item\"><a data-kid=\"7-1-1-3-2-2-1\" data-name=\"coordinator workspace link\" href=\"/Coordinator/Dashboard\">Coordinator workspace</a></li>\n<li data-kid=\"7-1-1-3-2-3\" data-name=\"list item\"><a data-kid=\"7-1-1-3-2-3-1\" data-name=\"administration link\" href=\"/Admin/Dashboard\">Administration</a></li>\n<li data-kid=\"7-1-1-3-2-4\" data-name=\"list item\"><a data-kid=\"7-1-1-3-2-4-1\" data-name=\"verify certificate link\" href=\"/Certificates/Verify\">Verify a certificate</a></li>\n</ul>\n</div>\n<div data-kid=\"7-1-1-4\" data-name=\"campus and support column\">\n<h4 data-kid=\"7-1-1-4-1\" data-name=\"campus and support heading\">Campus &amp; support</h4>\n<div class=\"foot-contact\" data-kid=\"7-1-1-4-2\" data-name=\"contact details list\">\n<div data-kid=\"7-1-1-4-2-1\" data-name=\"address contact row\"><i class=\"icon-map-pin\" data-kid=\"7-1-1-4-2-1-1\" data-name=\"map pin icon\"></i><span data-kid=\"7-1-1-4-2-1-2\" data-name=\"address text\">Directorate of Student Co-Curricular Affairs<br data-kid=\"7-1-1-4-2-1-2-1\" data-name=\"line break\"/>VAP UNIVERSITY Main Campus</span></div>\n<div data-kid=\"7-1-1-4-2-2\" data-name=\"email contact row\"><i class=\"icon-mail\" data-kid=\"7-1-1-4-2-2-1\" data-name=\"mail icon\"></i><span data-kid=\"7-1-1-4-2-2-2\" data-name=\"email address text\">admin@college.edu</span></div>\n<div data-kid=\"7-1-1-4-2-3\" data-name=\"hours contact row\"><i class=\"icon-clock\" data-kid=\"7-1-1-4-2-3-1\" data-name=\"clock icon\"></i><span data-kid=\"7-1-1-4-2-3-2\" data-name=\"office hours text\">Mon – Fri, 9:00 AM – 5:00 PM IST</span></div>\n</div>\n</div>\n</div>\n<div class=\"foot-base\" data-kid=\"7-1-2\" data-name=\"footer bottom bar\">\n<span data-kid=\"7-1-2-1\" data-name=\"copyright notice text\">© 2026 VAP UNIVERSITY · Campus Event Hub</span>\n<span data-kid=\"7-1-2-2\" data-name=\"data privacy link wrapper\"><a data-kid=\"7-1-2-2-1\" data-name=\"data privacy link\" href=\"/Home/Privacy\">Data privacy</a></span>\n</div>\n</div>\n</footer>\n<script>\nfunction v3tab(id, btn){\n  document.querySelectorAll('.tp').forEach(function(el){ el.classList.remove('is-on'); });\n  document.querySelectorAll('.topic').forEach(function(el){ el.classList.remove('is-on'); el.setAttribute('aria-selected','false'); });\n  document.getElementById(id).classList.add('is-on');\n  btn.classList.add('is-on');\n  btn.setAttribute('aria-selected','true');\n}\n</script>\n",
